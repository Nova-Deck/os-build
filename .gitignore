# Vendored upstream reference (cloned separately, has its own .git)
/_vendor/

# Build outputs
/out/
/work/
# build/ is the docker build CONTEXT (a source dir, not an output): track its inputs
# (Dockerfile) but ignore any stray artifacts that land in it.
/build/*
!/build/Dockerfile
*.img
*.img.*
*.raw
*.iso
*.tar
*.tar.*
*.squashfs
*.erofs
*.caibx
*.caidx
*.castr/
*.raucb

# Pacman/devtools build artifacts
*.pkg.tar.zst
*.pkg.tar.xz
src/
pkg/
/.makepkg/

# Extracted vendor firmware blobs (never commit proprietary blobs)
/firmware/blobs/
/firmware/extracted/
# Open linux-firmware blobs, fetched on demand + verified against firmware/LINUX_FW.pin
/firmware/linux-fw/

# Local Claude Code settings (keep .claude/plans/ tracked)
/.claude/settings.local.json

# Local secrets / signing material
*.key
*.pem
cosign.key
*.gpg
/secrets/

# Editor / OS noise
*.swp
*~
.DS_Store
