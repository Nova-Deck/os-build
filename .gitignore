# reference sources
/_reference/

# Build outputs
/out/
/work/
# build/ is the docker build CONTEXT (a source dir, not an output): track its inputs
# (Dockerfile) but ignore any stray artifacts that land in it.
/build/*
!/build/Dockerfile
*.img
*.img.*
*.raw
*.iso
*.tar
*.tar.*
*.squashfs
*.erofs
*.caibx
*.caidx
*.castr/
*.raucb

# Decky plugin frontend build (make decky-plugin); the lockfile IS committed
/apps/decky/*/node_modules/
/apps/decky/*/dist/

# Pacman/devtools build artifacts
*.pkg.tar.zst
*.pkg.tar.xz
src/
pkg/
/.makepkg/
# ... but the Decky plugin's TypeScript SOURCE is repo content, not a makepkg build dir.
# (An excluded directory's children cannot be re-included, so the dir itself is negated.)
!/apps/decky/*/src/

# Device-proprietary firmware, fetched on demand from the pinned Nova-Deck/qcom-firmwares
# repo + verified against its sha256sums.txt (never committed here — only in that repo).
/firmware/blobs/
/firmware/qcom-fw/
# Open linux-firmware blobs, fetched on demand + verified against firmware/LINUX_FW.pin
/firmware/linux-fw/

# Local Claude Code settings (keep .claude/plans/ tracked)
/.claude/settings.local.json

# Local secrets / signing material
*.key
*.pem
cosign.key
*.gpg
/secrets/
# ...with exactly ONE exception: the RAUC device keyring is a public CA CERTIFICATE, and it is
# the thing every device trusts (it ships as /etc/rauc/keyring.pem). It has to be committed, or
# what the image trusts is not reviewable. Private key material lives under out/pki -- covered
# by /out/ above, and ci/gen-signing-ca.sh refuses to write a key anywhere else in the tree.
# The negation works only because no parent directory of this path is itself excluded. Verify
# with `git status --short`: the keyring must appear as `??` (untracked). Note `git check-ignore
# -v` is NOT the check -- it prints this negation line and exits 0 for a file it does not ignore.
!/ota/rauc/novadeck-ca.pem
# ...and ONE more, on the same reasoning: the release SIGNING certificate is public too (a cert is
# what you hand out; the key is what you keep), and committing it is what lets CI prove the keyring
# above is the CA behind the cert that signs releases -- a check that otherwise needs the private
# key and therefore never runs on a push. A cert whose key we no longer hold ships a device that
# rejects every future bundle, and nothing else in the repo can see that. Rotation becomes a commit,
# which is an audit trail rather than a chore. Two negations is where this stops: every PEM under
# ota/rauc/ is asserted to contain no PRIVATE KEY by tests/test-verify-signing.sh, so the
# exception is policed by a test and not by care.
!/ota/rauc/release.cert.pem
# Dev-card Wi-Fi credentials for throwaway dev cards (NOVADECK_DEV=1) — never committed.
# ./dev.env IS tracked and holds no secrets; it sources this file when it exists. The split is
# what lets a fresh clone run `set -a; . ./dev.env; set +a` with nothing to edit, while a PSK
# never sits in a tracked file (where --skip-worktree would not survive a stash or a rebase).
/dev.env.local

# Editor / OS noise
*.swp
*~
.DS_Store

# Python bytecode. Nothing in rootfs/overlay/ is imported as a module at runtime — the clients are
# executed — so a __pycache__ there only ever comes from a host-side test importing one of them.
#
# THIS RULE DOES NOT KEEP IT OUT OF AN IMAGE, which is what the comment here used to claim.
# rootfs/overlay/ is injected with `cp -a` of the WORKING TREE (rootfs/assemble-rootfs.sh), and a copy
# does not consult .gitignore — so v0.2.x dev cards shipped host-CPython 3.14 .pyc into an image
# running 3.13, dead bytes the device can never load. Found on hardware 2026-08-10. The image is
# kept clean by three other things: the suites redirect bytecode via PYTHONPYCACHEPREFIX, the
# assembler prunes __pycache__ after the copy, and guard-rootfs.sh asserts none survived. This
# rule only keeps the repo clean.
__pycache__/
*.pyc
