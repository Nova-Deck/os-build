# Fork carries the arm64 port (committed on top of upstream master):
#   chainloader/bootload.c       EFI_STUB_ARCH 0xaa64 on __aarch64__
#   chainloader/util.h           \EFI\steamos\grubaa64.efi / bootaa64.efi paths
#   util/steamcl-install.in      removable-media bootaa64.efi from uname -m
#   configure.ac                 efi_cpu AC_SUBST (arm64->aarch64), TARGET_LD, AS_CASE comma
#   Makefile.am                  steamcl_elf_LINK = $(TARGET_LD)
#   bootconf/config-extra.c      ftruncate return check
# plus .github/workflows/build.yml (arm64 cross-build CI). Validated 2026-08-01:
# steamcl.efi = PE32+ ARM64; holo-bootconf = aarch64 statically linked.
