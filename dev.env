# novadeck dev-build environment — TRACKED, and deliberately free of secrets.
#
# Usage, from the repo root, before ANY make target (`set -a` is what exports these into make,
# which forwards them into the container via DEV_ENV):
#
#     set -a; . ./dev.env; set +a
#     make sdcard
#
# Chain it into EVERY invocation, not just the first. NOVADECK_DEV changes the image CONTENT, so a
# bare `make verify-card` or `make bundle` afterwards flips the mode stamp and rebuilds RELEASE
# over your dev image.
export NOVADECK_DEV=1

# --- SSH: a throwaway key per checkout, NOT your personal one --------------------------------
# Generated here rather than read from ~/.ssh on purpose. A dev card is disposable and gets handed
# around; putting your daily-driver identity in its authorized_keys means the private key you use
# for everything else is what unlocks it. This key exists only to reach dev cards, so it can be
# deleted or rotated at will (rm -rf work/dev-ssh) and losing a card implicates nothing else.
#
# It lives under work/ (gitignored) and SURVIVES `make distclean` — that target only removes
# work/kernel, work/steam-seed and work/base — so the identity is stable across rebuilds and your
# known_hosts entry keeps working.
#
# Set NOVADECK_SSH_PUBKEY yourself to override (e.g. a hardware token, or a shared lab key).
if [ -z "${NOVADECK_SSH_PUBKEY:-}" ]; then
  if [ ! -f work/dev-ssh/id_ed25519.pub ]; then
    mkdir -p work/dev-ssh
    ssh-keygen -t ed25519 -N '' -C "novadeck-dev@$(hostname -s 2>/dev/null || echo local)" \
               -f work/dev-ssh/id_ed25519 >/dev/null
    echo "dev.env: generated throwaway dev-card SSH key at work/dev-ssh/id_ed25519" >&2
    echo "dev.env: connect with  ssh -i work/dev-ssh/id_ed25519 root@<device>" >&2
  fi
  export NOVADECK_SSH_PUBKEY="$(cat work/dev-ssh/id_ed25519.pub)"
fi

# --- optional: Wi-Fi credentials -------------------------------------------------------------
# A dev card with no Wi-Fi profile cannot be reached over SSH, and this device has no UART, so its
# only debug path is the offline card-mount (`journalctl -D`). That is a legitimate mode — it is
# what the shipping first boot looks like, which is how you test OOBE — but it is not what you
# want most days.
#
# For a card that auto-joins your LAN, create dev.env.local (gitignored) with YOUR values:
#
#     export NOVADECK_WIFI_SSID="my-ssid"
#     export NOVADECK_WIFI_PSK="my-psk"
#
# NEVER put them in THIS file: it is tracked, so a PSK here lands in the history, and the
# --skip-worktree trick meant to hide local edits is undone by a stash, a rebase, or a fresh
# clone. One tracked file without secrets plus one ignored file with them is why there are two.
[ -f ./dev.env.local ] && . ./dev.env.local

# NOVADECK_WIFI is the INTENT knob, needed only to resolve the ambiguous cases:
#
#   unset + creds present  ->  profile baked in (the normal dev loop)
#   unset + no creds       ->  no profile, loud warning (a fresh clone just works)
#   NOVADECK_WIFI=1        ->  profile REQUIRED; missing creds is a hard error instead of a
#                              silently unreachable card (use in anything that relies on SSH)
#   NOVADECK_WIFI=0        ->  no profile even when creds are present, so you can test the
#                              no-network first boot without editing dev.env.local
#
# The build stamps which of these it actually produced (ROOTFS_MODE in the Makefile), so flipping
# between them re-assembles the rootfs instead of handing back the previous card.
export NOVADECK_WIFI="${NOVADECK_WIFI-}"
