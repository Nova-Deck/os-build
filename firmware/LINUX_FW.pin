# novadeck linux-firmware pin — OPEN firmware blobs from the official linux-firmware
# repository, pinned by commit + per-file sha256 (the sha verifies the DOWNLOADED source).
#
# The upstream Holo aarch64 base ships NO /lib/firmware, so these `linux-fw`-class blobs
# (Adreno GPU, WCN7850 Wi-Fi/BT, Iris VPU) must be delivered by us. Device-signed blobs
# (GPU zap, adsp/cdsp) are NOT here — those come from the device via firmware/extract.sh.
#
# Columns:  <src-path-in-linux-firmware>  <install-path-under-/lib/firmware>  <sha256>
# '#' and blank lines are ignored. install-path may rename the file (e.g. the VPU signed
# variant) to the exact name the kernel driver requests.
#
# Fetch + verify with:  firmware/fetch-linux-fw.sh sm8650
commit: e7eb98afc667913acc533ab910c608bee7d08f25
base:   https://git.kernel.org/pub/scm/linux/kernel/git/firmware/linux-firmware.git/plain

# Adreno gen70900 (A750) GPU firmware — also embedded in the kernel Image (CONFIG_EXTRA_FIRMWARE)
qcom/gen70900_aqe.fw       qcom/gen70900_aqe.fw     25237c161d727b8ea92b4beb837a31651b44ea78bfc34d95672af8f346a45825
qcom/gen70900_sqe.fw       qcom/gen70900_sqe.fw     f756bafe5f69a87161c7c53385386374a791861a574c244e845baba677993842
qcom/gmu_gen70900.bin      qcom/gmu_gen70900.bin    9685f62c42543befcaee68d25355e16bf55cdb0d573bddcc9f6633f59eec3f72

# WCN7850 Wi-Fi/BT (qca): Bluetooth firmware + NVM variants (board ID selects the .bNN)
qca/hmtbtfw20.tlv          qca/hmtbtfw20.tlv        f1c00f4640a5c4e5dc36a2574d3d1d0afcfd1ab58a84f217dce4b1bb73cba981
qca/hmtnv20.bin            qca/hmtnv20.bin          c26b340bbc8b617304610c774627ac4879194705eea7a7c7b13e3593903befd9
qca/hmtnv20.b10f           qca/hmtnv20.b10f         f8d027c5f0ea54456d23b903c55e1a87b06df97ff26b83e3fd02ac6b265b5264
qca/hmtnv20.b112           qca/hmtnv20.b112         f8d027c5f0ea54456d23b903c55e1a87b06df97ff26b83e3fd02ac6b265b5264

