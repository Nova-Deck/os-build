#!/usr/bin/env bash
# novadeck-bootctl — Phase 5: the RAUC bootloader backend over SteamOS's steamconf, plus the
# boot-health confirmation. See docs/phase5.md for the chain this belongs to.
#
# Three jobs, one tool:
#
#   1. The RAUC `bootloader=custom` backend (/etc/rauc/system.conf points at this file). Its
#      internals are Valve's bootloader-custom-backend.sh.in nearly verbatim, calling holo-bootconf
#      (installed as /usr/bin/steamos-bootconf) against the shared ESP's /esp/SteamOS/conf and the
#      booted slot's /efi. The RAUC slots ARE the SteamOS images now: `bootname=A|B` in
#      system.conf is literally the conf file name, so there is no mapping layer.
#
#      get-current  -> steamos-bootconf this-image     (A|B)
#      get-primary  -> steamos-bootconf selected-image
#      set-primary  -> steamos-bootconf --image X set-mode reboot   (this STARTS a trial)
#      get-state    -> bad iff boot-attempts >= 1 or image-invalid > 0
#      set-state    -> good: set-mode reboot --set image-invalid 0
#                      bad:  set-mode reboot-other --set image-invalid 1
#
#      `self` is accepted wherever an image name is, and resolves to whichever image this-image
#      reports — that is what the health unit uses to demote the booted slot.
#
#   2. mark-good — the boot-health confirmation (novadeck-boot-good.{service,path}). When a
#      session has proven healthy it runs `steamos-bootconf set-mode booted` (clears boot-attempts,
#      so the stage-2 counter and steamcl's failsafe stop counting this boot). The unit's
#      OnFailure= demotes with `set-state self bad`.
#
#      mark-good [--require-marker] [--wait SECONDS]
#        --require-marker  re-test the session marker before confirming; without it, exit 1
#        --wait SECONDS    hold that long first, and exit 0 WITHOUT a verdict if signalled
#                          during the wait (a shutdown is not evidence of a bad boot)
#
#   3. status — diagnostics over the same bootconf.
#
# THE CONTRACT IS THE EXIT STATUS. RAUC treats a non-zero backend exit as a failed install, so
# every legal call must exit 0 — including no-ops. That is asserted per-subcommand offline by
# tests/test-bootctl.sh, which executes THIS file (not a copy) against a stubbed steamos-bootconf.
#
# SteamOS splits the decision in two, and so do we:
#   * "Is this slot OK?" is OS-arbitrated. The boot service confirms (set-mode booted); a failed
#     health check demotes (novadeck-boot-bad.service -> set-state self bad -> reboot-other +
#     image-invalid=1). The bootloader never decides it.
#   * "Did a slot fail to come up N times?" is the stage-2 boot-attempts counter, which
#     steamcl's failsafe acts on (menu at >=3, auto-pick the other slot at >=6).
#
# BOTH ARE LIVE. The stage-2 grub.cfg calls `novadeck_bootattempts <slot>` on every boot
# (boot/patches/grub/, docs/phase5.md), HW-validated 2026-08-02, so get-state's
# "boot-attempts >= 1" arm does fire.
#
# Beware when testing get-state by hand: mark-good runs `set-mode booted`, which CLEARS
# boot-attempts. A healthy boot therefore leaves 0 whether or not the bootloader counted it, so a
# by-hand check has to mask novadeck-boot-good.{path,service} first or it proves nothing.
set -euo pipefail

# TEST SEAM, as before: the offline suite executes this file and stubs these. BOOTINFO is the
# initramfs handoff (written by image/initramfs/init on every boot, including degraded ones) that
# mark-good uses to tell "a slot boot" from a "cmdline-fallback boot". SESSION_MARKER is the ready
# marker the health service waits on; its default is exactly the path novadeck-boot-good.path
# watches. BC is the bootconf binary; on a device it is /usr/bin/steamos-bootconf (holo-bootconf
# installed by assemble-rootfs.sh). BC_ARGS is a single env string whose word-split expands to the
# flags on every bootconf call; it defaults to the device paths and the suite overrides it to
# redirect bootconf's files into the sandbox.
BOOTINFO=${BOOTINFO:-/run/novadeck/boot}
SESSION_MARKER=${SESSION_MARKER:-/run/novadeck/session/ready}
BC=${BC:-steamos-bootconf}
BC_ARGS=${BC_ARGS:---conf-dir /esp/SteamOS/conf --efi-dir /efi}

PROG=${0##*/}
die()  { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
warn() { printf '%s: WARNING: %s\n' "$PROG" "$*" >&2; }

bc() { "$BC" $BC_ARGS "$@"; }

# --- Valve's backend helpers (bootloader-custom-backend.sh.in) ----------------------------------

current_image=
target_image=

set_current_image() {
  local name=
  if [ -n "$current_image" ]; then return; fi
  name=$(bc this-image)
  case $name in
    A|B|dev) ;;
    *)
      # unexpected image: pick the highest-priority well-known name as primary
      while read -r valid slot x; do
        case $slot in A|B) name=$slot ;; esac
      done < <(bc list-images)
      ;;
  esac
  current_image=$name
}

set_target_image() {  # <A|B|dev|self>
  case ${1:-} in
    self) set_current_image; target_image=$current_image ;;
    A|B|dev) target_image=$1 ;;
    *) die "invalid target image '$1' (expected A, B, dev or self)" ;;
  esac
}

ensure_exists() {  # <image>
  # config without --set/--get creates a missing config (create_missing defaults to on); the
  # explicit `create` is Valve's belt-and-braces, kept verbatim.
  bc config --image "$1" || bc create --image "$1" ||:
}

# --- RAUC backend subcommands -------------------------------------------------------------------

get_current() {
  set_current_image
  case $current_image in
    A|B) echo "$current_image" ;;
    # dev is a valid bootconf image but not a RAUC slot on this system (system.conf has only
    # rootfs.0/rootfs.1). Guessing would hand RAUC a slot nothing verified, so this is the
    # contract's "cannot be determined" signal.
    *) die "this system booted image '$current_image', which has no RAUC slot" ;;
  esac
}

get_primary() {
  set_current_image
  local image
  image=$(bc selected-image)
  if [ "$image" = dev ]; then image=$current_image; fi
  if [ -n "$image" ]; then
    echo "$image"
  elif [ -n "$current_image" ]; then
    echo "$current_image"
  else
    die "cannot determine the primary slot"
  fi
}

set_primary() {  # <A|B|dev|self>
  set_target_image "$1"
  ensure_exists "$target_image"
  bc --image "$target_image" set-mode reboot
}

get_state() {  # <A|B|dev|self>
  local tries= invalid=
  set_target_image "$1"
  while read -r key val x; do
    case $key in
      boot-attempts:) tries=$val ;;
      image-invalid:) invalid=$val ;;
    esac
  done < <(bc --image "$target_image" config --get boot-attempts --get image-invalid)
  if [ -z "$tries" ] || [ -z "$invalid" ]; then
    die "missing boot configuration for image $target_image"
  fi
  # 1 or more unsuccessful/incomplete boot attempts, or the image is flagged invalid:
  if [ "$tries" -ge 1 ] || [ "$invalid" -gt 0 ]; then
    echo bad
  else
    echo good
  fi
}

set_state() {  # <A|B|dev|self> <good|bad>
  set_target_image "$1"
  ensure_exists "$target_image"
  case ${2:-} in
    good)
      # clears boot-other and update, sets boot-requested-at
      bc --image "$target_image" set-mode reboot --set image-invalid 0
      ;;
    bad)
      # clears update, sets boot-other and boot-requested-at
      bc --image "$target_image" set-mode reboot-other --set image-invalid 1
      ;;
    *) die "bad image state value '${2:-}' (expected good or bad)" ;;
  esac
}

# --- boot health --------------------------------------------------------------------------------

# Confirm this boot, called by novadeck-boot-good.service after the session handshake plus a
# --wait re-check. Exiting 0 here is load-bearing on a degraded boot: novadeck-boot-good.service is
# RemainAfterExit=yes so it fires once per boot, and a non-zero exit re-arms the level-triggered
# .path into a failing mark-good every 30s for the rest of the device's uptime (measured on
# hardware in 2026-07, before the handoff guard existed). The handoff names no slot on a
# cmdline-fallback boot, so that is the guard: nothing to confirm -> 0.
#
# --wait OWNS THE RE-CHECK DELAY, and it is here rather than in the unit because being interrupted
# mid-wait must not be a verdict. It used to be `ExecStartPre=/usr/bin/sleep 30`, and powering the
# device off inside that window -- which is every OOBE test, and HW-observed 2026-08-10 on Pocket
# S2 -- killed the sleep with SIGTERM. systemd scores a control process killed by a signal as
# `Failed with result 'signal'`, so a perfectly healthy boot ended in a failed unit on screen AND
# fired OnFailure=novadeck-boot-bad.service. That demote was refused only because the shutdown
# transaction happened to already be queued ("Transaction ... is destructive") -- ordering luck,
# not a guard. Trapping the signal here turns "the system went down before we could judge" into
# what it actually is: no verdict. boot-attempts stays as it is, nothing is confirmed, nothing is
# demoted, and the next boot runs the whole check again from the top.
mark_good() {
  local require_marker=0 wait_secs=0
  while [ $# -gt 0 ]; do
    case $1 in
      --require-marker) require_marker=1 ;;
      --wait) shift; wait_secs=${1:-} ;;
      *) die "mark-good: unknown option '$1'" ;;
    esac
    shift
  done
  case $wait_secs in
    ''|*[!0-9]*) die "mark-good: --wait needs a whole number of seconds, got '${wait_secs}'" ;;
  esac

  local bs src
  bs=$(sed -n 's/^slot=//p' "$BOOTINFO" 2>/dev/null || true)
  src=$(sed -n 's/^source=//p' "$BOOTINFO" 2>/dev/null || true)
  if [ -z "$bs" ]; then
    echo "this boot did not come from a slot (source=${src:-unknown}) -- nothing to confirm"
    return 0
  fi

  # The wait comes AFTER the handoff guard so a degraded boot answers immediately instead of
  # sleeping first to say "nothing to confirm". `sleep` is backgrounded and waited on because bash
  # defers a trap until the current FOREGROUND command returns -- a foreground sleep would swallow
  # the signal for the rest of the window, which is the whole thing being fixed here.
  if [ "$wait_secs" -gt 0 ]; then
    local interrupted=0
    trap 'interrupted=1' TERM INT
    sleep "$wait_secs" & wait $! || true
    trap - TERM INT
    if [ "$interrupted" = 1 ]; then
      echo "interrupted during the ${wait_secs}s re-check -- not confirming, not demoting"
      return 0
    fi
  fi

  if [ "$require_marker" = 1 ] && [ ! -e "$SESSION_MARKER" ]; then
    die "no session marker at $SESSION_MARKER -- refusing to confirm this boot"
  fi

  # set-mode booted clears boot-attempts, bumps boot-count and stamps boot-time — the "this boot
  # was fine" record that keeps the stage-2 counter from failing this slot. It does NOT clear
  # image-invalid (its `invalid` key is not in the bootconf schema), and the failure path
  # (OnFailure: set-state self bad) may have set it, so clear it here or a recovered slot
  # would confirm yet stay demoted.
  bc set-mode booted || die "steamos-bootconf set-mode booted failed"
  local self
  self=$(bc this-image) || die "cannot identify the booted image"
  case "$self" in
    A|B) bc --image "$self" config --set image-invalid 0 || die "cannot clear image-invalid on $self" ;;
  esac
  echo "boot confirmed good (image $self)"
}

# --- diagnostics --------------------------------------------------------------------------------

status() {
  local cur sel i dump
  cur=$(bc this-image 2>/dev/null || true)
  sel=$(bc selected-image 2>/dev/null || true)
  echo "booted image: ${cur:-<unidentifiable>}"
  echo "next boot:    ${sel:-<undetermined>}"
  echo "(needs /esp/SteamOS/conf mounted and the booted slot's /efi partsets; see docs/phase5.md)"
  for i in A B; do
    if dump=$(bc --image "$i" config --get boot-requested-at --get boot-attempts \
                 --get image-invalid --get boot-count 2>/dev/null); then
      echo "image $i:"
      printf '%s\n' "$dump" | sed 's/^/  /'
    else
      echo "image $i: (no config on the ESP)"
    fi
  done
}

usage() {
  # The header comment IS the usage text, printed to wherever it now ends rather than to a hard
  # line number: this used to be `sed -n '2,31p'` against a header that has since grown past 31
  # lines, so `--help` silently stopped halfway through the subcommand list.
  awk 'NR == 1 { next }                      # shebang
       /^#/    { sub(/^# ?/, ""); print; next }
               { exit }' "$0"
  exit 2
}

case "${1:-}" in
  get-current) shift; get_current ;;
  get-primary) shift; get_primary ;;
  set-primary) shift; set_primary "$@" ;;
  get-state)   shift; get_state "$@" ;;
  set-state)   shift; set_state "$@" ;;
  mark-good)   shift; mark_good "$@" ;;
  status)      shift; status ;;
  ''|-h|--help|help) usage ;;
  *) die "unknown command: $1 (try --help)" ;;
esac
