#!/usr/bin/env python3
import configparser
import os
import shutil
import signal
import shlex
import socket
import subprocess
import sys
import time
import warnings
from pathlib import Path

warnings.filterwarnings("ignore", category=DeprecationWarning)

BUS_NAME = "org.novadeck.Power"
OBJECT_PATH = "/org/novadeck/Power"
IFACE = "org.novadeck.Power1"
PROFILES = ["eco", "balanced", "performance"]
STATE_FILE = Path("/var/lib/novadeck/powerd.state")
FACTORY_CONFIG_FILE = Path("/usr/share/novadeck/power-profiles.conf")
CONFIG_FILE = Path("/etc/novadeck/power-profiles.conf")
FAN_SAFE_PWM = 128

# sched_ext. "none" is the in-kernel scheduler (EEVDF; one implementation, not
# runtime-selectable, so it is the whole non-scx half of this vocabulary) with scx.service
# stopped, "lavd" is scx_lavd with it running. Which binary the unit runs comes from
# /etc/default/scx (we ship SCX_SCHEDULER=scx_lavd); editing that file out from under us makes
# the "lavd" label inaccurate, nothing worse.
#
# Deliberately just these two, matching Valve's vocabulary exactly. scx-scheds also ships
# scx_bpfland and scx_rusty, but those stay SSH-only per-title fallbacks rather than QAM
# entries. Not to be confused with the cpufreq governor (schedutil / performance): that is
# frequency policy, a separate axis, and stays owned by the power profile.
#
# THE DEFAULT IS "none", i.e. the stock in-kernel scheduler — same as SteamOS, for a different
# reason. SteamOS defaults to stock because scx there may not be installed at all (its manager
# bails with "scx.service not installed" and holo ships no scx packages); we build both halves
# ourselves (CONFIG_SCHED_CLASS_EXT in kernel/kernel.config, packages/scx-scheds into the
# [novadeck] overlay, scx-scheds in customize-base.sh PKGS), so the capability is always there
# and lavd is one `novadeck-scheduler lavd` away. We default to stock because lavd was REPORTED
# to hurt in-game performance — see the TODO.md item; until that is measured rather than
# reported, the conservative scheduler is the one that ships on. lavd was briefly the default
# (2026-07-30 to 2026-08-03); flipping it back does NOT touch a device that already persisted
# `cpu_scheduler=lavd` in powerd.state — an explicit saved choice outranks this default in both
# directions, so such a device needs one `novadeck-scheduler none`.
#
# THE DEFAULT IS NOT IMPLEMENTED BY ENABLING scx.service, and must not be. The unit ships
# installed but never `enable`d; restore_cpu_scheduler() below is the only thing that starts it
# at boot. That is load-bearing for the --autopower coupling described next: a preset or a
# .wants symlink would start lavd independently of us, before we own the PowerProfiles names,
# which is the one ordering that silently breaks it. See main().
#
# The power profile owns lavd's INTERNAL power mode. We ship scx_lavd with `--autopower`
# (packages/scx-scheds/PKGBUILD writes it into /etc/default/scx), so once lavd is running it
# polls PowerProfiles.ActiveProfile on the system bus once a second and switches its own
# performance/balanced/powersave mode live, no restart. We answer that name ourselves
# (PPD_NAMES below) because we ship no power-profiles-daemon.
CPU_SCHEDULERS = ["none", "lavd"]
DEFAULT_CPU_SCHEDULER = "none"
SCX_UNIT = "scx.service"
SCX_BINARY = Path("/usr/bin/scx_lavd")
SCX_SYSFS = Path("/sys/kernel/sched_ext")
SCX_TIMEOUT = 15

# Resolving a D-Bus sender to a pid costs a round trip to the bus daemon. It only ever happens on
# an actual profile change (a human action), so the cost is irrelevant -- but the timeout must stay
# short, because a wedged bus must not turn a profile set into a hang.
SENDER_LOOKUP_TIMEOUT_MS = 500

# power-profiles-daemon compatibility, served for two independent consumers:
#
#   net.hadess.PowerProfiles              scx_lavd --autopower. It hardcodes interface, service
#                                         AND path (scx_utils/src/autopower.rs) with no fallback
#                                         to the newer name, so this one is load-bearing: drop it
#                                         and the whole coupling above silently stops working.
#   org.freedesktop.UPower.PowerProfiles  glib's GPowerProfileMonitorDBus, which uses only this
#                                         name (no net.hadess reference anywhere in libgio), so
#                                         g_power_profile_monitor_dup_default() is dead without
#                                         it. Also the name real PPD prefers today.
#
# Both expose the same ActiveProfile, so one handler serves both; the table exists so they cannot
# drift. Upstream scx chose the legacy name deliberately (sched-ext/scx#1017: tuned-ppd implements
# net.hadess and not the freedesktop name) and main still hardcodes it, so this is not a
# transitional hack we can retire on the next scx bump.
#
# WHY THE MAPPING MATTERS MORE THAN IT LOOKS: when lavd cannot reach PPD it falls back to reading
# policy0/energy_performance_preference then scaling_governor, and it treats a governor it does
# not recognise as Unknown. A transition from a KNOWN profile into Unknown makes it disable
# autopower permanently, silently, for the life of the process. On this hardware there is no EPP
# file at all and the governors in play are ondemand/performance, so that fallback is worse than
# useless — Performance -> Balanced would kill it outright. Hence: we must own these names BEFORE
# the scheduler we start takes its first tick (see main()).
PPD_NAMES = (
    ("net.hadess.PowerProfiles", "/net/hadess/PowerProfiles", "net.hadess.PowerProfiles"),
    (
        "org.freedesktop.UPower.PowerProfiles",
        "/org/freedesktop/UPower/PowerProfiles",
        "org.freedesktop.UPower.PowerProfiles",
    ),
)
# Our profile ids <-> PPD's. PPD has exactly these three and so do we, which is why this is a
# plain mapping and not a policy. Note these are ids, NOT the UI labels ("Eco") that the
# org.novadeck.Power1 Profile property speaks — do not route one through the other.
PPD_PROFILES = {"eco": "power-saver", "balanced": "balanced", "performance": "performance"}
PPD_PROFILE_IDS = {ppd: ours for ours, ppd in PPD_PROFILES.items()}


def normalize_profile(profile):
    value = profile.strip().lower()
    return value if value in PROFILES else ""


XML = f"""
<node>
  <interface name="{IFACE}">
    <method name="Reload"/>
    <method name="Suspend"/>
    <method name="Resume"/>
    <method name="GetStatus">
      <arg type="a{{sv}}" name="status" direction="out"/>
    </method>
    <property name="AvailableProfiles" type="as" access="read"/>
    <property name="Profile" type="s" access="readwrite"/>
    <property name="SuggestedDefaultProfile" type="s" access="read"/>
    <property name="AvailableGpuPerformanceLevels" type="as" access="read"/>
    <property name="GpuPerformanceLevel" type="s" access="readwrite"/>
    <property name="ManualGpuClock" type="u" access="readwrite"/>
    <property name="ManualGpuClockMin" type="u" access="read"/>
    <property name="ManualGpuClockMax" type="u" access="read"/>
    <property name="AvailableCpuSchedulers" type="as" access="read"/>
    <property name="CpuScheduler" type="s" access="readwrite"/>
    <property name="FanMode" type="s" access="read"/>
    <property name="FanPwm" type="u" access="read"/>
    <property name="FanRpm" type="u" access="read"/>
    <property name="Temperature" type="u" access="read"/>
  </interface>
</node>
"""


# One PPD interface per bus name — same body, different interface name, so it is a template.
# ActiveProfile is readwrite: a PPD client setting it is a legitimate way to change the profile,
# and it lands in exactly the same code path as our own Profile property. Profiles and
# PerformanceDegraded exist so a client can enumerate and reason about us instead of finding a
# stub; PerformanceDegraded is always "" because we never thermally-throttle the profile behind
# the user's back (the fan curve absorbs it). HoldProfile/ReleaseProfile are deliberately absent:
# they need per-sender cookie refcounting with NameOwnerChanged cleanup, and nothing on the device
# asks for them. A client that needs holds sees them missing rather than broken.
def ppd_xml(iface):
    return f"""
<node>
  <interface name="{iface}">
    <property name="ActiveProfile" type="s" access="readwrite"/>
    <property name="Profiles" type="aa{{sv}}" access="read"/>
    <property name="PerformanceDegraded" type="s" access="read"/>
  </interface>
</node>
"""


def read_text(path, default=""):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return default


def write_text(path, value):
    try:
        Path(path).write_text(f"{value}\n")
        return True
    except OSError as exc:
        print(f"novadeck-powerd: write failed {path}: {exc}", file=sys.stderr)
        return False


def restore_factory_config(reason):
    # Remove invalid /etc overrides so factory-only sections keep tracking /usr.
    if not CONFIG_FILE.exists():
        raise reason
    timestamp = time.strftime("%Y%m%d-%H%M%S")
    backup = CONFIG_FILE.with_name(f"{CONFIG_FILE.name}.invalid-{timestamp}")
    try:
        shutil.copy2(CONFIG_FILE, backup)
        CONFIG_FILE.unlink()
    except OSError:
        raise reason
    print(f"novadeck-powerd: dropped invalid {CONFIG_FILE} (backup at {backup}); using factory defaults: {reason}", file=sys.stderr)


def sd_notify(message):
    notify_socket = os.environ.get("NOTIFY_SOCKET")
    if not notify_socket:
        return
    if notify_socket.startswith("@"):
        notify_socket = "\0" + notify_socket[1:]
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as sock:
            sock.connect(notify_socket)
            sock.sendall(message.encode())
    except OSError:
        pass


def shell_env():
    helper = os.environ.get("NOVADECK_DEVICE_ENV", "/usr/lib/novadeck/device-env")
    command = (
        f'eval "$({shlex.quote(helper)})"; '
        'for name in "${!NOVADECK_@}"; do printf "%s=%s\\n" "$name" "${!name}"; done'
    )
    proc = subprocess.run(
        ["bash", "-c", command],
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    env = {}
    for line in proc.stdout.splitlines():
        if "=" in line:
            key, value = line.split("=", 1)
            env[key] = value
    return env


def ints_from_file(path):
    return sorted(int(v) for v in read_text(path).split() if v.isdigit())


def clamp(value, low, high):
    return max(low, min(high, value))


def parse_fan_curve(value):
    curve = []
    for item in value.split(","):
        if ":" not in item:
            continue
        temp, pwm = item.split(":", 1)
        try:
            curve.append((int(temp.strip()), int(pwm.strip())))
        except ValueError:
            continue
    return sorted(curve, reverse=True)


def require_section(parser, section):
    if not parser.has_section(section):
        raise ValueError(f"missing config section [{section}]")


def require_ratio(parser, section, key):
    return clamp(parser.getfloat(section, key), 0.0, 1.0)


def fan_safe_once():
    fan_hwmon = None
    for path in Path("/sys/class/hwmon").glob("hwmon*"):
        if read_text(path / "name") == "pwmfan" and (path / "pwm1").exists():
            fan_hwmon = path
            break
    if not fan_hwmon:
        for path in Path("/sys/class/hwmon").glob("hwmon*"):
            if (path / "pwm1").exists():
                fan_hwmon = path
                break
    if not fan_hwmon:
        return
    enable = fan_hwmon / "pwm1_enable"
    if enable.exists():
        write_text(enable, "1")
    write_text(fan_hwmon / "pwm1", FAN_SAFE_PWM)


class NovadeckPower:
    def __init__(self):
        self.env = shell_env()
        self.profile_config = {}
        self.profile_labels = {}
        self.underclock_config = {}
        self.fan_curves = {}
        self.fan_config = {}
        self.suspend_config = {}
        self.default_profile = ""
        self.profile = ""
        self.gpu_level = "auto"
        self.manual_gpu_clock = 0
        self.cpu_scheduler = DEFAULT_CPU_SCHEDULER
        self.smoothed_temp = 0.0
        self.last_pwm = 0
        self.suspended = False
        self.suspend_fan_active = False
        self.suspend_save = {}
        self.connection = None
        self.load_config()
        self.profile = self.default_profile
        self.discover()
        self.apply_underclock_refs()
        self.load_state()
        if self.fan_pwm:
            current = read_text(self.fan_pwm)
            self.last_pwm = int(current) if current.isdigit() else self.fan_config["min_pwm"]
        self.apply_profile()
        if self.gpu_level == "manual" and self.manual_gpu_clock:
            self.set_gpu_manual_clock(self.manual_gpu_clock)
        # restore_cpu_scheduler() is NOT called here — main() runs it once we own the PPD bus
        # names, because scx_lavd --autopower reads them on its first tick. See main().
        self.fan_tick()
        GLib.timeout_add_seconds(3, self.fan_tick)

    def discover(self):
        self.gpu = self.discover_gpu()
        self.cpu_policies = sorted(Path("/sys/devices/system/cpu/cpufreq").glob("policy*"))
        self.fan_hwmon = self.discover_fan_hwmon()
        self.fan_pwm = self.fan_hwmon / "pwm1" if self.fan_hwmon else None
        self.fan_enable = self.fan_hwmon / "pwm1_enable" if self.fan_hwmon else None
        self.fan_rpm = self.fan_hwmon / "fan1_input" if self.fan_hwmon else None
        self.temp_paths = self.discover_temps()

    def cpu_device_class(self):
        return self.env.get("NOVADECK_SOC_CLASS", "")

    def apply_underclock_refs(self):
        device_class = self.cpu_device_class()
        if not device_class:
            return
        for profile in PROFILES:
            config = self.profile_config[profile]
            if config["cpu_max_policy"]:
                continue
            level = config.get("cpu_underclock", "none")
            if level in ("", "none", "stock"):
                continue
            caps = self.underclock_config.get(device_class, {}).get(level)
            if caps:
                config["cpu_max_policy"] = dict(caps)

    def parse_config(self, include_user=True):
        underclock_config = {}
        fan_curves = {}
        profile_config = {}
        parser = configparser.ConfigParser()
        config_files = [FACTORY_CONFIG_FILE]
        if include_user and CONFIG_FILE.exists():
            config_files.append(CONFIG_FILE)
        if not parser.read(config_files):
            raise FileNotFoundError(FACTORY_CONFIG_FILE)
        require_section(parser, "general")
        default_profile = parser.get("general", "default_profile").strip().lower()
        if default_profile not in PROFILES:
            raise ValueError(f"invalid default_profile: {default_profile}")
        for section in parser.sections():
            if not section.startswith("underclock."):
                continue
            parts = section.split(".")
            if len(parts) != 3:
                continue
            device_class, level = parts[1], parts[2]
            caps = {}
            for key, value in parser.items(section):
                if not key.startswith("cpu_max_policy"):
                    continue
                policy_id = key.removeprefix("cpu_max_policy")
                if not policy_id.isdigit():
                    continue
                try:
                    caps[int(policy_id)] = int(value)
                except ValueError:
                    pass
            if caps:
                underclock_config.setdefault(device_class, {})[level] = caps
        for section in parser.sections():
            if not section.startswith("fan_curve."):
                continue
            parts = section.split(".", 1)
            if len(parts) != 2:
                continue
            curve = parse_fan_curve(parser.get(section, "curve", fallback=""))
            if curve:
                fan_curves[parts[1]] = curve
        if not fan_curves:
            raise ValueError("missing fan curves")
        for profile in PROFILES:
            section = f"profile.{profile}"
            require_section(parser, section)
            fan_curve = parser.get(section, "fan_curve").strip().lower()
            curve = parse_fan_curve(fan_curve)
            config = {
                "label": parser.get(section, "label", fallback="").strip() or profile.replace("_", " ").title(),
                "cpu_governor": parser.get(section, "cpu_governor").strip(),
                "cpu_max": require_ratio(parser, section, "cpu_max"),
                "cpu_underclock": parser.get(section, "cpu_underclock").strip().lower(),
                "gpu_max": require_ratio(parser, section, "gpu_max"),
                "gpu_min": require_ratio(parser, section, "gpu_min"),
                "fan_curve": fan_curve,
                "cpu_max_policy": {},
            }
            if curve:
                config["fan_curve"] = curve
            elif fan_curve in fan_curves:
                config["fan_curve"] = fan_curve
            else:
                raise ValueError(f"unknown fan_curve for {profile}: {fan_curve}")
            for key, value in parser.items(section):
                if not key.startswith("cpu_max_policy"):
                    continue
                policy_id = key.removeprefix("cpu_max_policy")
                if not policy_id.isdigit():
                    continue
                try:
                    config["cpu_max_policy"][int(policy_id)] = int(value)
                except ValueError:
                    pass
            profile_config[profile] = config
        require_section(parser, "fan")
        fan_config = {
            key: parser.getint("fan", key)
            for key in ("min_pwm", "max_pwm", "ramp_up", "ramp_down")
        }
        fan_config["smoothing"] = clamp(parser.getfloat("fan", "smoothing"), 0.0, 0.99)
        fan_config["pwm_quantum"] = clamp(parser.getint("fan", "pwm_quantum", fallback=1), 1, 255)
        fan_config["min_pwm"] = clamp(fan_config["min_pwm"], 0, 255)
        fan_config["max_pwm"] = clamp(fan_config["max_pwm"], fan_config["min_pwm"], 255)

        fan_off_below = clamp(parser.getint("suspend", "fan_off_below", fallback=45), 0, 120)
        fan_on_above = clamp(
            parser.getint("suspend", "fan_on_above", fallback=50),
            fan_off_below,
            120,
        )
        fan_safe_above = clamp(
            parser.getint("suspend", "fan_safe_above", fallback=55),
            fan_on_above,
            120,
        )
        fan_low_pwm = clamp(
            parser.getint("suspend", "fan_low_pwm", fallback=fan_config["min_pwm"]),
            0,
            fan_config["max_pwm"],
        )
        fan_safe_pwm = clamp(
            parser.getint("suspend", "fan_safe_pwm", fallback=FAN_SAFE_PWM),
            fan_low_pwm,
            fan_config["max_pwm"],
        )
        suspend_config = {
            "fan_off_below": fan_off_below,
            "fan_on_above": fan_on_above,
            "fan_safe_above": fan_safe_above,
            "fan_low_pwm": fan_low_pwm,
            "fan_safe_pwm": fan_safe_pwm,
        }
        return default_profile, underclock_config, fan_curves, profile_config, fan_config, suspend_config

    def load_config(self):
        try:
            parsed = self.parse_config()
        except Exception as exc:
            restore_factory_config(exc)
            parsed = self.parse_config(include_user=False)
        (
            self.default_profile,
            self.underclock_config,
            self.fan_curves,
            self.profile_config,
            self.fan_config,
            self.suspend_config,
        ) = parsed
        self.profile_labels = {p: self.profile_config[p].get("label", p) for p in PROFILES}

    def discover_gpu(self):
        for path in Path("/sys/class/devfreq").glob("*.gpu"):
            if (path / "available_frequencies").exists():
                return path
        for path in Path("/sys/class/devfreq").glob("*"):
            if "gpu" in path.name.lower() and (path / "governor").exists() and (path / "available_frequencies").exists():
                return path
        return None

    def discover_fan_hwmon(self):
        for path in Path("/sys/class/hwmon").glob("hwmon*"):
            if read_text(path / "name") == "pwmfan" and (path / "pwm1").exists():
                return path
        for path in Path("/sys/class/hwmon").glob("hwmon*"):
            if (path / "pwm1").exists():
                return path
        return None

    def discover_temps(self):
        control = []
        for zone in Path("/sys/class/thermal").glob("thermal_zone*"):
            kind = read_text(zone / "type").lower()
            temp = zone / "temp"
            if not temp.exists():
                continue
            if kind.startswith(("cpu", "gpu", "gpuss", "video", "mem")):
                control.append(temp)
        return control

    def load_state(self):
        if not STATE_FILE.exists():
            return
        for line in read_text(STATE_FILE).splitlines():
            if "=" not in line:
                continue
            key, value = line.split("=", 1)
            if key == "profile" and value in PROFILES:
                self.profile = value
            elif key == "gpu_level" and value in ("auto", "manual"):
                self.gpu_level = value
            elif key == "manual_gpu_clock" and value.isdigit():
                self.manual_gpu_clock = int(value)
            elif key == "cpu_scheduler" and value in CPU_SCHEDULERS:
                self.cpu_scheduler = value

    def save_state(self):
        STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
        STATE_FILE.write_text(
            f"profile={self.profile}\n"
            f"gpu_level={self.gpu_level}\n"
            f"manual_gpu_clock={self.manual_gpu_clock}\n"
            f"cpu_scheduler={self.cpu_scheduler}\n"
        )

    def available_cpu_schedulers(self):
        # No sched_ext in this kernel, or no scx binary: only the in-kernel scheduler exists.
        # The manager hides its CpuScheduler1 interface entirely when this is the answer.
        if not (SCX_SYSFS.is_dir() and SCX_BINARY.exists()):
            return ["none"]
        return list(CPU_SCHEDULERS)

    def systemctl(self, *args, timeout=SCX_TIMEOUT):
        return subprocess.run(
            ["systemctl", *args],
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=timeout,
        )

    def scx_unit_active(self):
        try:
            return self.systemctl("is-active", SCX_UNIT, timeout=5).stdout.strip() == "active"
        except (OSError, subprocess.SubprocessError) as exc:
            print(f"novadeck-powerd: {SCX_UNIT} is-active failed: {exc}", file=sys.stderr)
            return False

    def reset_scx_failure(self):
        # scx.service carries upstream's StartLimitIntervalSec=30 / StartLimitBurst=2, so a couple
        # of quick none<->lavd flips leave the unit rate-limited and every later start refused with
        # no in-product way to clear it. Clearing first is free when there is nothing to clear.
        try:
            self.systemctl("reset-failed", SCX_UNIT, timeout=5)
        except (OSError, subprocess.SubprocessError) as exc:
            print(f"novadeck-powerd: {SCX_UNIT} reset-failed failed: {exc}", file=sys.stderr)

    def restore_cpu_scheduler(self):
        # Apply the saved choice at daemon start, or DEFAULT_CPU_SCHEDULER ("none") when nothing
        # is saved. scx.service is never `enable`d, so this (and an explicit `systemctl start`) is
        # the only path that loads a BPF scheduler — a fresh device therefore boots on the stock
        # in-kernel scheduler and only a persisted `cpu_scheduler=lavd` starts the unit here.
        # Called from main() once the PPD bus names are owned, NOT from __init__ — scx_lavd runs
        # with --autopower and reads ActiveProfile on its first tick.
        if len(self.available_cpu_schedulers()) == 1:
            self.cpu_scheduler = "none"
            return
        if self.scx_unit_active():
            # Already running — somebody started it by hand, or powerd restarted underneath a
            # live scheduler. Adopt what is actually there instead of stopping their work.
            self.cpu_scheduler = "lavd"
            return
        if self.cpu_scheduler == "none":
            return
        self.reset_scx_failure()
        try:
            # --no-block on purpose: our own systemd start job is still open here (Type=dbus,
            # the bus name is taken after __init__ returns), so do not sit waiting on a second
            # job from inside it. A start that fails is reported by the unit, not by us.
            self.systemctl("start", "--no-block", SCX_UNIT)
        except (OSError, subprocess.SubprocessError) as exc:
            print(f"novadeck-powerd: restoring {SCX_UNIT} failed: {exc}", file=sys.stderr)
            self.cpu_scheduler = "none"

    def set_cpu_scheduler(self, scheduler):
        if scheduler not in self.available_cpu_schedulers():
            raise ValueError(scheduler)
        if scheduler == self.cpu_scheduler:
            return
        action = "stop" if scheduler == "none" else "start"
        if action == "start":
            self.reset_scx_failure()
        try:
            proc = self.systemctl(action, SCX_UNIT)
        except subprocess.TimeoutExpired as exc:
            raise RuntimeError(f"systemctl {action} {SCX_UNIT} timed out") from exc
        if proc.returncode != 0:
            raise RuntimeError(f"systemctl {action} {SCX_UNIT} failed: {proc.stdout.strip()}")
        # Type=simple, so a zero exit only proves scx_lavd was exec'd, not that it attached —
        # attach takes ~1s and lands in the journal. Report the requested scheduler, same as
        # SteamOS does; GetStatus carries the kernel's own view for anyone who needs the truth.
        self.cpu_scheduler = scheduler

    def gpu_freqs(self):
        if not self.gpu:
            return []
        return ints_from_file(self.gpu / "available_frequencies")

    def cpu_available_freqs(self, policy):
        freqs = ints_from_file(policy / "scaling_available_frequencies")
        if freqs:
            return freqs
        low = read_text(policy / "cpuinfo_min_freq")
        high = read_text(policy / "cpuinfo_max_freq")
        if low.isdigit() and high.isdigit():
            return [int(low), int(high)]
        return []

    def closest(self, freqs, target):
        return min(freqs, key=lambda freq: abs(freq - target)) if freqs else 0

    def choose_at_least(self, freqs, target):
        for freq in freqs:
            if freq >= target:
                return freq
        return freqs[-1] if freqs else 0

    def choose_at_most(self, freqs, target):
        below = [freq for freq in freqs if freq <= target]
        return below[-1] if below else freqs[0] if freqs else 0

    def policy_id(self, policy):
        try:
            return int(policy.name.removeprefix("policy"))
        except ValueError:
            return -1

    def cpu_max_target(self, settings, policy_id, freqs):
        if self.cpu_device_class() in self.underclock_config:
            return settings["cpu_max_policy"].get(policy_id, freqs[-1])
        return int(freqs[-1] * settings["cpu_max"])

    def profile_settings(self):
        return self.profile_config.get(self.profile, self.profile_config["balanced"])

    def write_governor(self, path, preferred):
        available = read_text(path / "scaling_available_governors").split()
        if preferred in available:
            write_text(path / "scaling_governor", preferred)
        elif "schedutil" in available:
            write_text(path / "scaling_governor", "schedutil")
        elif "ondemand" in available:
            write_text(path / "scaling_governor", "ondemand")

    def apply_profile(self):
        settings = self.profile_settings()
        for policy in self.cpu_policies:
            freqs = self.cpu_available_freqs(policy)
            if not freqs:
                continue
            self.write_governor(policy, settings["cpu_governor"])
            write_text(policy / "scaling_min_freq", freqs[0])
            target = self.cpu_max_target(settings, self.policy_id(policy), freqs)
            write_text(policy / "scaling_max_freq", self.choose_at_most(freqs, target))
        if self.gpu and self.gpu_level == "auto":
            self.apply_gpu_auto(settings)

    def resolved_cpu_caps(self):
        settings = self.profile_settings()
        caps = {}
        for policy in self.cpu_policies:
            freqs = self.cpu_available_freqs(policy)
            if not freqs:
                continue
            policy_id = self.policy_id(policy)
            target = self.cpu_max_target(settings, policy_id, freqs)
            caps[f"policy{policy_id}"] = self.choose_at_most(freqs, target)
        return caps

    def resolved_gpu_auto_limits(self):
        freqs = self.gpu_freqs()
        if not freqs:
            return (0, 0)
        settings = self.profile_settings()
        max_freq = self.choose_at_most(freqs, int(freqs[-1] * settings["gpu_max"]))
        min_target = int(freqs[-1] * settings["gpu_min"])
        min_freq = self.choose_at_least(freqs, min_target) if min_target else freqs[0]
        return (min(min_freq, max_freq), max_freq)

    def suspend(self):
        if self.suspend_save:
            return
        self.suspended = True
        self.suspend_fan_active = False
        self.suspend_save = {"cpu": [], "gpu": {}}
        for policy in self.cpu_policies:
            freqs = self.cpu_available_freqs(policy)
            if freqs:
                self.suspend_save["cpu"].append(
                    (
                        policy,
                        read_text(policy / "scaling_min_freq"),
                        read_text(policy / "scaling_max_freq"),
                    )
                )
                write_text(policy / "scaling_min_freq", freqs[0])
                write_text(policy / "scaling_max_freq", freqs[0])
        freqs = self.gpu_freqs()
        if self.gpu and freqs:
            self.suspend_save["gpu"] = {
                "governor": read_text(self.gpu / "governor"),
                "min": read_text(self.gpu / "min_freq"),
                "max": read_text(self.gpu / "max_freq"),
            }
            write_text(self.gpu / "min_freq", freqs[0])
            write_text(self.gpu / "max_freq", freqs[0])
        self.fan_tick()

    def resume(self):
        self.suspended = False
        self.suspend_fan_active = False
        self.smoothed_temp = 0.0
        if not self.suspend_save:
            self.apply_profile()
            if self.gpu_level == "manual" and self.manual_gpu_clock:
                self.set_gpu_manual_clock(self.manual_gpu_clock)
            self.fan_tick()
            return
        for policy, min_freq, max_freq in self.suspend_save.get("cpu", []):
            freqs = self.cpu_available_freqs(policy)
            if freqs:
                write_text(policy / "scaling_min_freq", freqs[0])
            if max_freq:
                write_text(policy / "scaling_max_freq", max_freq)
            if min_freq:
                write_text(policy / "scaling_min_freq", min_freq)
        gpu_save = self.suspend_save.get("gpu", {})
        if self.gpu and gpu_save:
            freqs = self.gpu_freqs()
            if freqs:
                write_text(self.gpu / "min_freq", freqs[0])
            if gpu_save.get("max"):
                write_text(self.gpu / "max_freq", gpu_save["max"])
            if gpu_save.get("min"):
                write_text(self.gpu / "min_freq", gpu_save["min"])
            if gpu_save.get("governor"):
                write_text(self.gpu / "governor", gpu_save["governor"])
        self.suspend_save = {}
        self.apply_profile()
        if self.gpu_level == "manual" and self.manual_gpu_clock:
            self.set_gpu_manual_clock(self.manual_gpu_clock)
        self.fan_tick()

    def apply_gpu_auto(self, settings=None):
        freqs = self.gpu_freqs()
        if not freqs:
            return
        settings = settings or self.profile_settings()
        write_text(self.gpu / "governor", "simple_ondemand")
        max_freq = self.choose_at_most(freqs, int(freqs[-1] * settings["gpu_max"]))
        min_target = int(freqs[-1] * settings["gpu_min"])
        min_freq = self.choose_at_least(freqs, min_target) if min_target else freqs[0]
        write_text(self.gpu / "min_freq", freqs[0])
        write_text(self.gpu / "max_freq", max_freq)
        write_text(self.gpu / "min_freq", min(min_freq, max_freq))

    def set_gpu_manual_clock(self, mhz):
        freqs = self.gpu_freqs()
        if not freqs:
            return 0
        hz = self.closest(freqs, mhz * 1000000)
        write_text(self.gpu / "min_freq", freqs[0])
        write_text(self.gpu / "governor", "userspace")
        write_text(self.gpu / "max_freq", hz)
        write_text(self.gpu / "min_freq", hz)
        self.manual_gpu_clock = hz // 1000000
        return self.manual_gpu_clock

    def read_temps(self):
        values = []
        for path in self.temp_paths:
            value = read_text(path)
            if value.isdigit():
                values.append(int(value) // 1000)
        return values

    def read_temp(self):
        values = sorted(self.read_temps(), reverse=True)
        if not values:
            return 0
        values = values[:3]
        return sum(values) // len(values)

    def read_temp_max(self):
        values = self.read_temps()
        return max(values) if values else 0

    def suspend_target_pwm(self, temp):
        config = self.suspend_config
        if not temp:
            return config["fan_safe_pwm"]
        if temp >= config["fan_safe_above"]:
            self.suspend_fan_active = True
            return config["fan_safe_pwm"]
        if self.suspend_fan_active:
            if temp <= config["fan_off_below"]:
                self.suspend_fan_active = False
                return 0
            return config["fan_low_pwm"]
        if temp >= config["fan_on_above"]:
            self.suspend_fan_active = True
            return config["fan_low_pwm"]
        return 0

    def quantize_pwm(self, pwm):
        quantum = self.fan_config["pwm_quantum"]
        if quantum > 1:
            pwm = round(pwm / quantum) * quantum
        return clamp(int(pwm), self.fan_config["min_pwm"], self.fan_config["max_pwm"])

    def target_pwm(self, temp):
        curve = self.profile_settings()["fan_curve"]
        if isinstance(curve, str):
            curve = self.fan_curves[curve]
        curve = sorted(curve)
        if not curve:
            return self.fan_config["min_pwm"]
        if temp <= curve[0][0]:
            return self.quantize_pwm(curve[0][1])
        if temp >= curve[-1][0]:
            return self.quantize_pwm(curve[-1][1])
        for lower, upper in zip(curve, curve[1:]):
            low_temp, low_pwm = lower
            high_temp, high_pwm = upper
            if low_temp <= temp <= high_temp:
                span = high_temp - low_temp
                if not span:
                    return self.quantize_pwm(high_pwm)
                pwm = low_pwm + (high_pwm - low_pwm) * (temp - low_temp) / span
                return self.quantize_pwm(pwm)
        return self.fan_config["min_pwm"]

    def fan_tick(self):
        try:
            if not self.fan_pwm:
                sd_notify("WATCHDOG=1")
                return True
            if self.fan_enable and self.fan_enable.exists():
                write_text(self.fan_enable, "1")

            if self.suspended:
                temp = self.read_temp_max()
                target = self.suspend_target_pwm(temp)
                self.smoothed_temp = float(temp)
                self.last_pwm = clamp(target, 0, self.fan_config["max_pwm"])
            else:
                temp = self.read_temp()
                if temp:
                    weight = self.fan_config["smoothing"]
                    self.smoothed_temp = temp if not self.smoothed_temp else (self.smoothed_temp * weight + temp * (1.0 - weight))
                    target = self.target_pwm(int(self.smoothed_temp))
                else:
                    target = FAN_SAFE_PWM
                if target > self.last_pwm:
                    next_pwm = min(target, self.last_pwm + self.fan_config["ramp_up"])
                else:
                    next_pwm = max(target, self.last_pwm - self.fan_config["ramp_down"])
                self.last_pwm = clamp(next_pwm, self.fan_config["min_pwm"], self.fan_config["max_pwm"])

            write_text(self.fan_pwm, self.last_pwm)
            if self.connection:
                self.emit_properties(
                    {
                        "FanPwm": GLib.Variant("u", self.last_pwm),
                        "FanRpm": GLib.Variant("u", self.fan_rpm_value()),
                        "Temperature": GLib.Variant("u", temp),
                    }
                )
            sd_notify("WATCHDOG=1")
        except Exception as exc:
            print(f"novadeck-powerd: fan tick failed: {exc}", file=sys.stderr)
            self.fan_safe()
            sd_notify("WATCHDOG=1")
        return True

    def fan_safe(self):
        if not self.fan_pwm:
            return
        if self.fan_enable and self.fan_enable.exists():
            write_text(self.fan_enable, "1")
        write_text(self.fan_pwm, FAN_SAFE_PWM)
        self.last_pwm = FAN_SAFE_PWM

    def fan_rpm_value(self):
        value = read_text(self.fan_rpm) if self.fan_rpm else ""
        return int(value) if value.isdigit() else 0

    def label_for(self, profile):
        return self.profile_labels.get(profile, profile)

    def profile_for_label(self, label):
        target = label.strip()
        for pid, lbl in self.profile_labels.items():
            if lbl == target:
                return pid
        return normalize_profile(target)

    def get_property(self, prop):
        freqs = self.gpu_freqs()
        if prop == "AvailableProfiles":
            return GLib.Variant("as", [self.label_for(p) for p in PROFILES])
        if prop == "Profile":
            return GLib.Variant("s", self.label_for(self.profile))
        if prop == "SuggestedDefaultProfile":
            return GLib.Variant("s", self.label_for(self.default_profile))
        if prop == "AvailableGpuPerformanceLevels":
            return GLib.Variant("as", ["auto", "manual"] if self.gpu else [])
        if prop == "GpuPerformanceLevel":
            return GLib.Variant("s", self.gpu_level)
        if prop == "ManualGpuClock":
            value = self.manual_gpu_clock or (freqs[-1] // 1000000 if freqs else 0)
            return GLib.Variant("u", value)
        if prop == "ManualGpuClockMin":
            return GLib.Variant("u", freqs[0] // 1000000 if freqs else 0)
        if prop == "ManualGpuClockMax":
            return GLib.Variant("u", freqs[-1] // 1000000 if freqs else 0)
        if prop == "AvailableCpuSchedulers":
            return GLib.Variant("as", self.available_cpu_schedulers())
        if prop == "CpuScheduler":
            return GLib.Variant("s", self.cpu_scheduler)
        if prop == "FanMode":
            return GLib.Variant("s", "managed" if self.fan_pwm else "unavailable")
        if prop == "FanPwm":
            return GLib.Variant("u", self.last_pwm)
        if prop == "FanRpm":
            return GLib.Variant("u", self.fan_rpm_value())
        if prop == "Temperature":
            return GLib.Variant("u", self.read_temp())
        raise KeyError(prop)

    def describe_sender(self, sender):
        """Best-effort "who asked" for the log line. Never raises: attribution is not worth a
        failed profile set, and a unique name alone is useless after the fact -- by the time anyone
        reads the journal the bus has forgotten which process :1.19 was."""
        if not sender:
            return "powerd itself"
        try:
            reply = self.connection.call_sync(
                "org.freedesktop.DBus",
                "/org/freedesktop/DBus",
                "org.freedesktop.DBus",
                "GetConnectionUnixProcessID",
                GLib.Variant("(s)", (sender,)),
                GLib.VariantType("(u)"),
                Gio.DBusCallFlags.NONE,
                SENDER_LOOKUP_TIMEOUT_MS,
                None,
            )
            pid = reply.get_child_value(0).get_uint32()
        except Exception:
            return sender
        comm = read_text(f"/proc/{pid}/comm") or "?"
        return f"{sender} pid={pid} ({comm})"

    def select_profile(self, profile, sender=None):
        # The single place a profile is applied. Both the org.novadeck.Power1 Profile property
        # (which speaks UI labels) and PPD's ActiveProfile (which speaks ids) come through here,
        # so the two can never apply a profile differently.
        if profile not in PROFILES:
            raise ValueError(profile)
        previous = self.profile
        self.profile = profile
        self.apply_profile()
        # Logged unconditionally, including a re-select of the value already in effect. The
        # question this answers is "what changed my profile, and when" LONG after the fact, and a
        # daemon that logs nothing turns that into a live-capture session every single time. A
        # rewrite back to the same value is precisely the case worth seeing, because that is what
        # an out-of-band writer fighting the user looks like.
        print(
            f"novadeck-powerd: profile {previous} -> {profile} by {self.describe_sender(sender)}",
            file=sys.stderr,
        )
        return {"Profile": GLib.Variant("s", self.label_for(self.profile))}

    def set_property(self, prop, value, sender=None):
        changed = {}
        if prop == "Profile":
            # Resolve first so the error names what the caller actually sent, not "".
            label = value.get_string()
            profile = self.profile_for_label(label)
            if profile not in PROFILES:
                raise ValueError(label)
            changed = self.select_profile(profile, sender)
        elif prop == "GpuPerformanceLevel":
            level = value.get_string()
            if level not in ("auto", "manual"):
                raise ValueError(level)
            self.gpu_level = level
            if level == "auto":
                self.apply_profile()
            else:
                freqs = self.gpu_freqs()
                target = self.manual_gpu_clock or (freqs[-1] // 1000000 if freqs else 0)
                if target:
                    self.set_gpu_manual_clock(target)
            changed["GpuPerformanceLevel"] = GLib.Variant("s", self.gpu_level)
        elif prop == "ManualGpuClock":
            mhz = value.get_uint32()
            self.manual_gpu_clock = mhz
            if self.gpu_level == "manual":
                mhz = self.set_gpu_manual_clock(mhz)
            changed["ManualGpuClock"] = GLib.Variant("u", mhz)
        elif prop == "CpuScheduler":
            self.set_cpu_scheduler(value.get_string())
            changed["CpuScheduler"] = GLib.Variant("s", self.cpu_scheduler)
        else:
            raise KeyError(prop)
        self.save_state()
        self.emit_properties(changed)
        if "Profile" in changed:
            self.emit_ppd_profile()

    def status(self):
        gpu_min, gpu_max = self.resolved_gpu_auto_limits()
        return {
            "profile": self.get_property("Profile"),
            "default_profile": self.get_property("SuggestedDefaultProfile"),
            "cpu_underclock": GLib.Variant("s", self.profile_settings()["cpu_underclock"]),
            "cpu_caps": GLib.Variant("a{su}", self.resolved_cpu_caps()),
            "gpu_level": self.get_property("GpuPerformanceLevel"),
            "gpu_auto_min": GLib.Variant("u", gpu_min // 1000000 if gpu_min else 0),
            "gpu_auto_max": GLib.Variant("u", gpu_max // 1000000 if gpu_max else 0),
            "manual_gpu_clock": self.get_property("ManualGpuClock"),
            "manual_gpu_clock_min": self.get_property("ManualGpuClockMin"),
            "manual_gpu_clock_max": self.get_property("ManualGpuClockMax"),
            "cpu_scheduler": self.get_property("CpuScheduler"),
            # The kernel's own view ("enabled"/"disabled"/absent), which the property above
            # cannot express: it lags a start by ~1s and goes back to "disabled" on its own if
            # a BPF scheduler is ejected. Diagnostics only.
            "sched_ext_state": GLib.Variant("s", read_text(SCX_SYSFS / "state")),
            "fan_mode": self.get_property("FanMode"),
            "fan_pwm": self.get_property("FanPwm"),
            "fan_rpm": self.get_property("FanRpm"),
            "temperature": self.get_property("Temperature"),
            "suspended": GLib.Variant("b", self.suspended),
        }

    def emit_properties(self, changed, path=OBJECT_PATH, iface=IFACE):
        self.connection.emit_signal(
            None,
            path,
            "org.freedesktop.DBus.Properties",
            "PropertiesChanged",
            GLib.Variant("(sa{sv}as)", (iface, changed, [])),
        )

    def emit_ppd_profile(self):
        # lavd polls, so this is not what makes the coupling work — but real PPD emits it and
        # glib's GPowerProfileMonitor subscribes to it rather than polling.
        changed = {"ActiveProfile": GLib.Variant("s", PPD_PROFILES[self.profile])}
        for _bus_name, path, iface in PPD_NAMES:
            self.emit_properties(changed, path=path, iface=iface)

    def handle_method_call(self, _conn, _sender, _path, iface, method, _params, invocation):
        if iface != IFACE:
            invocation.return_dbus_error(f"{BUS_NAME}.Error.UnknownInterface", iface)
            return
        if method == "Reload":
            try:
                self.load_config()
                self.discover()
                self.apply_underclock_refs()
                self.apply_profile()
                if self.gpu_level == "manual" and self.manual_gpu_clock:
                    self.set_gpu_manual_clock(self.manual_gpu_clock)
            except Exception as exc:
                print(f"novadeck-powerd: reload failed: {exc}", file=sys.stderr)
                invocation.return_dbus_error(f"{BUS_NAME}.Error.ReloadFailed", str(exc))
                return
            invocation.return_value(None)
            return
        if method == "Suspend":
            self.suspend()
            invocation.return_value(None)
            return
        if method == "Resume":
            self.resume()
            invocation.return_value(None)
            return
        if method == "GetStatus":
            invocation.return_value(GLib.Variant("(a{sv})", (self.status(),)))
            return
        invocation.return_dbus_error(f"{BUS_NAME}.Error.UnknownMethod", method)

    def handle_get_property(self, _conn, _sender, _path, iface, prop):
        if iface != IFACE:
            return None
        try:
            return self.get_property(prop)
        except Exception:
            return None

    def handle_set_property(self, _conn, sender, _path, iface, prop, value):
        if iface != IFACE:
            return False
        try:
            self.set_property(prop, value, sender)
            return True
        except Exception as exc:
            print(f"novadeck-powerd: set {prop} failed: {exc}", file=sys.stderr)
            return False

    def ppd_get_property(self, _conn, _sender, _path, _iface, prop):
        if prop == "ActiveProfile":
            return GLib.Variant("s", PPD_PROFILES[self.profile])
        if prop == "Profiles":
            return GLib.Variant(
                "aa{sv}",
                [
                    {
                        "Profile": GLib.Variant("s", PPD_PROFILES[profile]),
                        "Driver": GLib.Variant("s", "novadeck-powerd"),
                    }
                    for profile in PROFILES
                ],
            )
        if prop == "PerformanceDegraded":
            return GLib.Variant("s", "")
        return None

    def ppd_set_property(self, _conn, sender, _path, _iface, prop, value):
        if prop != "ActiveProfile":
            return False
        try:
            requested = value.get_string()
            profile = PPD_PROFILE_IDS.get(requested)
            if profile is None:
                raise ValueError(requested)
            changed = self.select_profile(profile, sender)
        except Exception as exc:
            print(f"novadeck-powerd: PPD set {prop} failed: {exc}", file=sys.stderr)
            return False
        self.save_state()
        self.emit_properties(changed)
        self.emit_ppd_profile()
        return True

    def register(self, connection):
        # Called from whichever bus name wins its bus_acquired first — we own several now, and the
        # objects must exist before any of those names becomes visible to clients.
        if self.connection is not None:
            return
        self.connection = connection
        self.node = Gio.DBusNodeInfo.new_for_xml(XML)
        connection.register_object(
            OBJECT_PATH,
            self.node.interfaces[0],
            self.handle_method_call,
            self.handle_get_property,
            self.handle_set_property,
        )
        # Keep a reference to each node: Gio does not own the DBusInterfaceInfo we hand it, and a
        # collected node takes the registration's interface info with it.
        self.ppd_nodes = []
        for _bus_name, path, iface in PPD_NAMES:
            node = Gio.DBusNodeInfo.new_for_xml(ppd_xml(iface))
            self.ppd_nodes.append(node)
            connection.register_object(
                path,
                node.interfaces[0],
                None,
                self.ppd_get_property,
                self.ppd_set_property,
            )


def main():
    if "--fan-safe" in sys.argv:
        fan_safe_once()
        return

    global GLib, Gio
    import gi

    gi.require_version("Gio", "2.0")
    from gi.repository import GLib, Gio

    loop = GLib.MainLoop()
    power = NovadeckPower()

    def bus_acquired(connection, _name):
        power.register(connection)

    def name_lost(_connection, _name):
        loop.quit()

    owner_ids = [
        Gio.bus_own_name(
            Gio.BusType.SYSTEM,
            BUS_NAME,
            Gio.BusNameOwnerFlags.NONE,
            bus_acquired,
            None,
            name_lost,
        )
    ]

    # Restoring the saved CPU scheduler is deliberately NOT done in __init__ any more. scx_lavd
    # runs with --autopower and reads PowerProfiles.ActiveProfile from its very first tick; if we
    # start it before we answer that name it falls through to sysfs, and on this hardware a later
    # profile change into an unrecognised governor makes it disable autopower permanently and
    # silently. So: own the names first, start the scheduler second.
    #
    # The backstop matters. A name we cannot acquire (a real power-profiles-daemon got there first)
    # never fires name_acquired, and the user's scheduler choice must not be collateral damage of
    # that — so a timer restores it regardless. Whichever path runs first wins; the other no-ops.
    pending_ppd_names = {bus_name for bus_name, _path, _iface in PPD_NAMES}
    restored = False

    def restore_scheduler(reason):
        nonlocal restored
        if restored:
            return False
        restored = True
        if reason != "ppd-names-acquired":
            print(
                f"novadeck-powerd: restoring CPU scheduler without full PPD ownership ({reason});"
                f" still unowned: {' '.join(sorted(pending_ppd_names))}",
                file=sys.stderr,
            )
        power.restore_cpu_scheduler()
        return False

    def ppd_name_acquired(_connection, name):
        pending_ppd_names.discard(name)
        if not pending_ppd_names:
            restore_scheduler("ppd-names-acquired")

    for ppd_bus_name, _path, _iface in PPD_NAMES:
        owner_ids.append(
            Gio.bus_own_name(
                Gio.BusType.SYSTEM,
                ppd_bus_name,
                Gio.BusNameOwnerFlags.NONE,
                bus_acquired,
                ppd_name_acquired,
                None,
            )
        )

    GLib.timeout_add_seconds(5, restore_scheduler, "timeout")

    def stop(_signum, _frame):
        power.fan_safe()
        loop.quit()

    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, stop)
    try:
        loop.run()
    finally:
        power.fan_safe()
        for owner_id in owner_ids:
            Gio.bus_unown_name(owner_id)


if __name__ == "__main__":
    main()
