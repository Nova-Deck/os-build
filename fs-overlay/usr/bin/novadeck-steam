#!/bin/sh
# novadeck Steam shell launcher (SteamOS layer D) — the client gamescope hosts.
#
# This is what NOVADECK_SESSION_CMD points at in Phase 3 (replacing the Phase-2 vkcube liveness
# placeholder). novadeck-session execs gamescope, then gamescope execs THIS inside its Wayland
# display. We run the NATIVE arm64 Steam client in Big Picture / gamepad UI mode — the same
# -gamepadui/-steamdeck/-steamos3 flags SteamOS passes for the handheld Deck shell.
# x86 games launched from here go through FEX/Proton (later in Phase 3).
#
# The WHOLE Big Picture shell is baked offline (release can't fetch — Steam owns OOBE Wi-Fi):
# images/make-sdcard.sh pre-seeds the native client+runtime directly into the writable /home at image
# build, and we launch with -noverifyfiles so the client runs exactly the baked bits without
# attempting an (offline, doomed) self-update/repair.
set -eu

STEAM_HOME="${STEAM_HOME:-/home/deck}"
STEAM="${STEAM_HOME}/.local/share/Steam"
CLIENT="${STEAM}/steamrtarm64/steam"

export HOME="${STEAM_HOME}"

if [ ! -x "$CLIENT" ]; then
  echo "[novadeck-steam] native arm64 Steam not staged at ${STEAM}" >&2
  echo "[novadeck-steam] /home was not pre-seeded at image build — reflash the card" >&2
  exit 1
fi

# NOTE: do NOT route through ${STEAM}/steam.sh — that is the x86 wrapper; it execs ubuntu12_32/steam
# and ubuntu12_32/steam-runtime/amd64/* which are amd64 ELFs ("Exec format error" on aarch64).
#
# We launch the native client RAW ON THE HOST — NOT through the bundled SR3 runtime / pressure-vessel.
# This is the system-libs + raw-ELF path. It became possible once gtk2 moved onto the
# host: steamui.so NEEDs libgtk-x11-2.0.so.0 + libgdk_pixbuf-2.0.so.0, which we now BUILD from source
# as a novadeck overlay package (packages/gtk2/) and install into the base (customize-base.sh PKGS),
# so the host /usr/lib resolves them via ld.so.cache. Earlier this client was entered through
# pressure-vessel purely to borrow gtk2 from the runtime container; with gtk2 on the host that
# boundary is gone — and raw-host launch lets a plain LD_LIBRARY_PATH reach the loader (pressure-
# vessel built a fresh container env and DROPPED any LD_LIBRARY_PATH we exported on the host).

# steamrtarm64 holds the client's OWN bundled media stack — libvpx.so.6 + libav{codec,format,util}.so.*
# (pulled in by the first-launch self-update; the seed lacks them), which steamui.so NEEDs — plus the
# libibus shim the bootstrap symlinked into lib/aarch64-linux-gnu. Put these on LD_LIBRARY_PATH; gtk2/
# gdk_pixbuf come from the host /usr/lib (the gtk2 overlay), and ffmpeg's libav* are in the base too
# (customize-base.sh PKGS) as a fallback, but the client prefers its bundled video/ libs listed first.
STEAM_LD_PATH="${STEAM}/steamrtarm64:${STEAM}/steamrtarm64/video:${STEAM}/lib/aarch64-linux-gnu"
export LD_LIBRARY_PATH="${STEAM_LD_PATH}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

# Make the image-resident compat tool discoverable. novadeck bakes the arm64 Proton (its own WoW64
# FEX for x86 Windows games) into the OS slot at /usr/share/steam/compatibilitytools.d so it is
# replaced atomically with the OS and survives a factory reset — but the client only scans the
# per-user compatibilitytools.d and whatever this variable lists, NOT /usr/share by default. Keep
# the user path too, so anything the user drops there still registers.
export STEAM_EXTRA_COMPAT_TOOLS_PATHS="/usr/share/steam/compatibilitytools.d${STEAM_EXTRA_COMPAT_TOOLS_PATHS:+:${STEAM_EXTRA_COMPAT_TOOLS_PATHS}}"

# --- SteamUI QuickAccess / gamescope integration env (SteamOS "gamescope-session" parity) ---------
# ENV GATES SteamUI reads to decide which Quick-Access controls to expose. They pair with the
# gamescope --steam stats channel wired in novadeck-session — without the channel these do nothing,
# and without these the controls may not appear even with the channel. HW-TBD: whether this board has
# an ambient-light sensor (dynamic backlight) before trusting that one.
export STEAM_ENABLE_DYNAMIC_BACKLIGHT=1        # adaptive-brightness toggle (needs an ambient sensor)

# Refresh-rate SLIDER range — NOT the framerate cap (that is STEAM_GAMESCOPE_DYNAMIC_FPSLIMITER
# below; its choices are divisors of the CURRENT refresh and exist regardless of this range, which is
# why a 30/20 fps cap is selectable on a 60Hz board no matter what we put here).
# Per-board from the device-env registry, and set ONLY for a panel that really has more than one
# mode: most panel drivers we ship declare a SINGLE drm_display_mode (60Hz; 144 on the Pocket FIT), so
# there is nothing for gamescope to modeset to and the variable must stay UNSET. The old hardcoded
# Deck-LCD 40,60 was wrong both ways — it invented a 40Hz floor no panel of ours has a mode for, and
# capped the multi-mode boards (60,120 panels) at 60. novadeck-session does not export the NOVADECK_*
# facts (plain eval, no export), so resolve them here too.
DEV_ENV=/usr/lib/novadeck/device-env
if [ -x "$DEV_ENV" ]; then eval "$("$DEV_ENV" 2>/dev/null)" || true; fi
case "${NOVADECK_PANEL_REFRESH_RATES:-}" in
  *,*) export STEAM_DISPLAY_REFRESH_LIMITS="${NOVADECK_PANEL_REFRESH_RATES%%,*},${NOVADECK_PANEL_REFRESH_RATES##*,}" ;;
esac

# gamescope sets the gates below ITSELF in --steam mode (main.cpp UpdateCompatEnvVars) — but only into
# its own environment, so they reach the processes gamescope SPAWNS (mangoapp) and not this client:
# novadeck-session runs gamescope in the background and starts us as its SIBLING. Hence we set them by
# hand, exactly as the upstream SteamOS-derived session scripts do. All use gamescope's own values;
# gamescope's setenv()s are overwrite=0, so a value set here also wins there.
#
# Performance overlay -> mangoapp. Without these the client takes the LEGACY overlay path: it prepends
# `mangohud` to the game launch command (the Vulkan layer inside the game) instead of driving the
# mangoapp window gamescope already spawned, so the QuickAccess toggle/Level misbehave. The paired
# MANGOHUD_CONFIGFILE (the file SteamUI writes `preset=N` into) is exported by novadeck-session and
# inherited here.
export STEAM_USE_MANGOAPP=1
export STEAM_MANGOAPP_PRESETS_SUPPORTED=1      # QuickAccess "Level" selector -> mangoapp presets
export STEAM_MANGOAPP_HORIZONTAL_SUPPORTED=1   # allow the horizontal HUD bar layout
export STEAM_DISABLE_MANGOAPP_ATOM_WORKAROUND=1 # mangoapp sets GAMESCOPE_EXTERNAL_OVERLAY itself now
# QuickAccess frame-rate cap: the client writes the cap, gamescope's WSI layer in the GAME process
# reads GAMESCOPE_LIMITER_FILE (exported by novadeck-session). Both ends need this gate; our WSI layer
# is on (ENABLE_GAMESCOPE_WSI=1 in the session).
export STEAM_GAMESCOPE_DYNAMIC_FPSLIMITER=1
# Scaling controls gamescope implements unconditionally (NIS + integer/fit/fill/stretch).
export STEAM_GAMESCOPE_NIS_SUPPORTED=1
export STEAM_GAMESCOPE_FANCY_SCALING_SUPPORT=1
# Per-game Xwayland isolation. novadeck-session passes --xwayland-count 2, so the second nested
# Xwayland exists and this is what makes the client actually USE it for games (gamescope sets this gate
# itself whenever the count is >1). BISECT POINT: this is the one gate here that changes game-launch
# behaviour rather than just exposing a control — drop it first if a title regresses.
export STEAM_MULTIPLE_XWAYLANDS=1
# SteamRT's xdg-open hands http(s):// to the client instead of a (nonexistent) desktop browser.
export SRT_URLOPEN_PREFER_STEAM=1
#
# DELIBERATELY NOT SET (gamescope/ChimeraOS set some of these; each would advertise a control this
# board cannot honour, or collides with something of ours):
#   STEAM_GAMESCOPE_TEARING_SUPPORTED / _HAS_TEARING_SUPPORT — gamescope gates them on
#     SupportsTearing(), which is FALSE here (msm exposes no DRM_CAP_ATOMIC_ASYNC_PAGE_FLIP).
#   STEAM_GAMESCOPE_HDR_SUPPORTED, STEAM_GAMESCOPE_VRR_SUPPORTED — no HDR/VRR on this DSI panel.
#   STEAM_GAMESCOPE_COLOR_MANAGED / _VIRTUAL_WHITE — belongs to the night-mode/colour work.
#   STEAM_ENABLE_VOLUME_HANDLER — volume keys are ours (novadeck-hotkeyd); don't hand them to Steam.
#   STEAM_USE_DYNAMIC_VRS — RADV-only.

# Client-side defaults SteamOS/gamescope sessions set for the Big Picture shell (harmless, standard).
export SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS=0      # keep the shell up when it loses focus
export vk_xwayland_wait_ready=false            # don't block on buffers idling before present to gamescope

# -steamdeck/-steamos3/-steampal: Deck handheld behaviour. -gamepadui: Big Picture as the shell.
#
# -noverifyfiles: skip the client's startup file-verification pass. We bake a hand-assembled offline
#   shell (pre-seeded into /home by make-sdcard.sh) that won't checksum-match Valve's manifests, and there's no network
#   at first boot (Steam owns OOBE Wi-Fi) — so verification can only waste time re-hashing the baked
#   tree or stall trying to re-fetch. This leaves the SELF-UPDATE path intact.
# -noshaders: disable Steam's shader pre-caching (background shader download + compile). Orthogonal to
#   the update path — pure CPU/battery saver on the handheld; safe to keep.
#
# DO NOT add -nobootstrapupdate / -skipinitialbootstrap / -norepairfiles here. Those
# implement a PINNED-client model: the client downloads an update but the bootstrap is
# forbidden from applying it, so the running client never advances — even across reboots (HW-observed
# 2026-07-03: update downloaded, SteamUI relaunched, logo/version unchanged). We want the Deck-faithful
# self-updating client, so those three were removed while -noshaders (unrelated) stays.
# Word-splitting on the extra-args is intentional (sh).
: "${NOVADECK_STEAM_ARGS:=-gamepadui -steamos3 -steampal -steamdeck -noverifyfiles -noshaders}"

# Optional CEF remote-debugging (OFF on release). Steam's Big Picture UI is CEF; touching this
# sentinel makes the client open a DevTools port so the SteamUI (incl. the OOBE web views) can be
# inspected from a browser. Gated on the NOVADECK_DEBUG build marker (/usr/lib/novadeck/debug, baked
# only when the image is built with NOVADECK_DEBUG=1) so release launches never expose the port.
# Touched unconditionally here (only reached under the NOVADECK_DEBUG marker).
if [ -e /usr/lib/novadeck/debug ]; then
  : >"${STEAM}/.cef-enable-remote-debugging" 2>/dev/null \
    && echo "[novadeck-steam] NOVADECK_DEBUG: CEF remote debugging enabled (${STEAM}/.cef-enable-remote-debugging)" >&2
fi

# Run from the client dir. Steam's bootstrapper resolves some helper paths relative to cwd, so launch
# with steamrtarm64/ as the working directory.
cd "${STEAM}/steamrtarm64"

# Steam's bootstrapper exits to relaunch itself whenever the client requests a restart — most
# notably right after the first-launch self-update ("Update complete, launching... / Shutdown"),
# and on every in-UI "Restart Steam". It signals this with exit code 42. gamescope hosts THIS
# script as its `--` child, so a bare `exec` would let the process die on that first restart and
# gamescope would tear the whole session down mid-update instead of entering Big Picture. Loop and
# relaunch on 42 (mirrors SteamOS's steam-jupiter wrapper); any
# other exit code is a genuine shutdown, so propagate it and let the session end as intended.
#
# Past the 42 restart the client previously failed to render the Big Picture UI with
#   dlmopen steamui.so failed: libgtk-x11-2.0.so.0: cannot open shared object file
# (gtk2) and then libvpx.so.6 (media stack). gtk2 is now resolved from the host /usr/lib (overlay),
# and the media libs from steamrtarm64 via LD_LIBRARY_PATH above — no pressure-vessel needed.
status=42
while [ "$status" -eq 42 ]; do
  set +e
  "$CLIENT" $NOVADECK_STEAM_ARGS "$@"
  status=$?
  set -e
done
exit "$status"
