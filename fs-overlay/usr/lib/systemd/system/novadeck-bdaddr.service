[Unit]
Description=novadeck stable Bluetooth address (configures the controller mgmt cannot see)
# Our DTS bluetooth node has no local-bd-address, so the controller comes up HCI_UNCONFIGURED and is
# absent from the normal mgmt index list — no BT audio, no controllers, no BLE, and no error anywhere
# to say why. This hands it a per-unit address so it registers for real. See gen-bdaddr.sh.
#
# Before bluetooth.service is the intent, not a hard requirement: bluetoothd picks up an index-added
# event whenever it arrives (HW-observed — the controller was configured under a running bluetoothd
# and appeared immediately). After local-fs.target so /var/lib (the write-once store) is mounted.
# Waits for the controller the QCA setup creates, so it is NOT DefaultDependencies=no like macgen —
# it can afford to run in the normal ordering.
After=local-fs.target
Before=bluetooth.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/novadeck/gen-bdaddr.sh
# The script bounds every wait AND every btmgmt call itself, so this is only a backstop. It has to sit
# above the script's own worst case or it would fire FIRST and kill a run that was still making
# progress — which is exactly what happened at 60s on the first HW boot: 15s for the controller, then
# up to 15 address attempts each capped at 10s, then 10s for it to re-register.
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
