[Unit]
Description=novadeck SteamOS Manager compatibility service (SteamUI privileged backend)
After=novadeck-powerd.service
Requires=novadeck-powerd.service

[Service]
Type=dbus
BusName=com.steampowered.SteamOSManager1
ExecStart=/usr/bin/novadeck-steamos-manager --system
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
