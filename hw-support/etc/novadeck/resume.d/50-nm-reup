#!/bin/sh
# Release Wi-Fi resume nudge, run by novadeck-suspend after a thaw (un-frozen, post-resume).
#
# RELEASE networking is NetworkManager (Steam wizard-configured). The suspend path rfkill-blocks the
# radio (power-ops.sh power_enter) and freezes userland; on thaw power_leave unblocks it again. NM
# normally re-enables Wi-Fi by itself on an rfkill-unblock event — this nudge is defensive in case it
# does not. TODO(HW): confirm whether NM recovers unaided and drop this hook if the nudge is moot.
#
# Inert unless NM is the ACTIVE network manager, so it stays a no-op on the TEST card, where
# systemd-networkd + wpa_supplicant own wlan0 (see the TEST-only 50-wlan-reup hook, which still
# does the real re-association there). '50-nm-reup' sorts before '50-wlan-reup', so on a test build
# this exits 0 first and the wpa_supplicant re-up still runs.
command -v nmcli >/dev/null 2>&1 || exit 0
systemctl is-active --quiet NetworkManager.service || exit 0
nmcli radio wifi on >/dev/null 2>&1 || true
