#!/bin/sh
# novadeck-rest — userspace "rest mode" (fake suspend) for Qualcomm handhelds (SteamOS layer C).
#
# Real s2idle suspend/resume on these SoCs is immature and debugging it is out of our scope. Instead
# this owns a reversible low-power state ENTIRELY in userspace, restoring exactly what it changed:
#   enter   blank the panel via gamescope's own KMS modeset (gamescopectl drm_sleep_*_screen),
#           offline every CPU but the boot CPU, soft-block all radios, switch cpufreq -> powersave.
#   leave   restore each from the state captured at enter, in reverse order.
#   toggle  enter if resting, else leave (single-button friendly — for the future power-key trigger).
#   status  print "resting" or "awake".
#
# Phase-2 scope is the MECHANISM only: validate by hand on HW (`novadeck-rest enter` / `leave` over
# SSH), exactly how the gamescope session was de-risked. The trigger that fires it (a power-button
# watcher / Deck-UI request) lands as a follow-up. See devices/<soc>/bringup-phase2.md step 3.
#
# NOTE on errors: this is a sequence of independent, best-effort hardware pokes. We deliberately do
# NOT `set -e` — a single failed sysfs write (EBUSY on a CPU, a missing knob) must not abort the
# rest of enter, and must NEVER abort leave (resume has to run to completion). Each write is guarded
# and records into state only on success, so leave restores precisely what enter actually changed.
set -u

CONF=/etc/novadeck/rest.conf
[ -r "$CONF" ] && . "$CONF"
: "${NOVADECK_REST_GOVERNOR:=powersave}"
: "${NOVADECK_REST_SCREEN:=internal}"   # gamescope target: drm_sleep_<internal|external>_screen
: "${NOVADECK_REST_SKIP:=}"             # space-separated ops to skip: panel cpu rfkill governor
: "${XDG_RUNTIME_DIR:=/run/user/0}"     # where gamescope's wayland socket lives (session runs as root)
export XDG_RUNTIME_DIR

STATE_DIR=/run/novadeck/rest.d

log()  { echo "novadeck-rest: $*"; }
warn() { echo "novadeck-rest: $*" >&2; }
skip() { case " $NOVADECK_REST_SKIP " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

# --- panel: drive gamescope's DPMS convar; gamescope holds DRM-master so it does the actual KMS
# modeset (detaches the connector from its CRTC -> DSI link blanks). Best-effort: with no session up
# there is nothing to rest the display on, so we warn and let the power ops still run.
gs_sleep() {
  command -v gamescopectl >/dev/null 2>&1 || { warn "gamescopectl not found; panel unchanged"; return 0; }
  gamescopectl "drm_sleep_${NOVADECK_REST_SCREEN}_screen" "$1" 2>/dev/null \
    || warn "gamescopectl could not reach gamescope (no session?); panel unchanged"
}

# --- cpus: offline every CPU that has a writable `online` toggle (the boot CPU has none and stays
# up); never touch cpu0. Record what we offlined so leave brings back exactly those.
cpu_enter() {
  : > "$STATE_DIR/cpus"
  for f in /sys/devices/system/cpu/cpu[0-9]*/online; do
    [ -w "$f" ] || continue
    n=${f#/sys/devices/system/cpu/cpu}; n=${n%/online}
    [ "$n" = 0 ] && continue
    [ "$(cat "$f" 2>/dev/null)" = 1 ] || continue
    echo 0 > "$f" 2>/dev/null && echo "$n" >> "$STATE_DIR/cpus"
  done
}
cpu_leave() {
  [ -r "$STATE_DIR/cpus" ] || return 0
  while read -r n; do
    f=/sys/devices/system/cpu/cpu$n/online
    [ -w "$f" ] && echo 1 > "$f" 2>/dev/null
  done < "$STATE_DIR/cpus"
}

# --- radios: soft-block via sysfs (no rfkill binary dependency). Record only those we actually
# blocked (skip already-blocked ones) so leave restores the prior radio state.
rf_enter() {
  : > "$STATE_DIR/rfkill"
  for d in /sys/class/rfkill/rfkill*; do
    [ -w "$d/soft" ] || continue
    [ "$(cat "$d/soft" 2>/dev/null)" = 0 ] || continue
    echo 1 > "$d/soft" 2>/dev/null && basename "$d" >> "$STATE_DIR/rfkill"
  done
}
rf_leave() {
  [ -r "$STATE_DIR/rfkill" ] || return 0
  while read -r r; do
    f=/sys/class/rfkill/$r/soft
    [ -w "$f" ] && echo 0 > "$f" 2>/dev/null
  done < "$STATE_DIR/rfkill"
}

# --- governor: switch each cpufreq policy to powersave, recording the previous governor per policy.
# Only touch a policy that actually advertises the target governor.
gov_enter() {
  : > "$STATE_DIR/governors"
  for g in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor; do
    [ -w "$g" ] || continue
    avail=$(cat "${g%scaling_governor}scaling_available_governors" 2>/dev/null || echo)
    case " $avail " in *" $NOVADECK_REST_GOVERNOR "*) ;; *) continue ;; esac
    cur=$(cat "$g" 2>/dev/null) || continue
    [ "$cur" = "$NOVADECK_REST_GOVERNOR" ] && continue
    p=${g#/sys/devices/system/cpu/cpufreq/}; p=${p%/scaling_governor}
    echo "$NOVADECK_REST_GOVERNOR" > "$g" 2>/dev/null && echo "$p $cur" >> "$STATE_DIR/governors"
  done
}
gov_leave() {
  [ -r "$STATE_DIR/governors" ] || return 0
  while read -r p cur; do
    f=/sys/devices/system/cpu/cpufreq/$p/scaling_governor
    [ -w "$f" ] && echo "$cur" > "$f" 2>/dev/null
  done < "$STATE_DIR/governors"
}

# Enter: blank first (immediate visible feedback) then lower power. Leave reverses the order, so the
# panel comes back only once CPUs/radios/governor are restored.
do_enter() {
  [ -e "$STATE_DIR/active" ] && { log "already resting"; return 0; }
  mkdir -p "$STATE_DIR"
  skip panel    || gs_sleep 1
  skip governor || gov_enter
  skip cpu      || cpu_enter
  skip rfkill   || rf_enter
  : > "$STATE_DIR/active"
  log "resting (panel off, cpus offlined, radios blocked, governor=$NOVADECK_REST_GOVERNOR)"
}
do_leave() {
  [ -e "$STATE_DIR/active" ] || { log "not resting"; return 0; }
  rm -f "$STATE_DIR/active"
  skip rfkill   || rf_leave
  skip cpu      || cpu_leave
  skip governor || gov_leave
  skip panel    || gs_sleep 0
  rm -f "$STATE_DIR/cpus" "$STATE_DIR/rfkill" "$STATE_DIR/governors"
  log "awake"
}

case "${1:-}" in
  enter)  do_enter ;;
  leave)  do_leave ;;
  toggle) if [ -e "$STATE_DIR/active" ]; then do_leave; else do_enter; fi ;;
  status) if [ -e "$STATE_DIR/active" ]; then echo resting; else echo awake; fi ;;
  *) echo "usage: novadeck-rest {enter|leave|toggle|status}" >&2; exit 2 ;;
esac
