#!/bin/sh
# novadeck-suspend — userspace suspend/resume engine (SteamOS layer C). The real "suspend": freeze
# all of userland with the cgroup v2 freezer so the running game actually STOPS, instead of the
# immature kernel s2idle path (which is out of scope on these SoCs — see the suspend-freeze-wake
# design notes / devices/<soc>/bringup-phase2.md step 3).
#
# MUST run from an UN-FROZEN context — the novadeck-waked agent's slice (novadeck-wake.slice), which
# is a sibling of system.slice and therefore NOT frozen. Run from anywhere in system.slice (e.g. an
# SSH shell) and it would freeze itself mid-suspend. The wake agent (power key) is the resume path.
#
# Ordering is load-bearing:
#   suspend: blank panel (gamescope must still be alive) -> freeze userland
#   resume:  thaw userland (gamescope alive again) -> unblank panel
# gamescope is inside the frozen set; it holds the blank KMS modeset statically while frozen, and the
# wake agent reads the power key from its own evdev fd (the key is not EVIOCGRAB-exclusive), so a
# frozen gamescope neither un-blanks the panel nor blocks the wake. On top of panel+freeze it also
# lowers power via the shared power-ops library (cpu offline / rfkill / cpufreq+devfreq powersave) —
# the same primitives novadeck-rest uses — applied after the freeze and restored before the thaw.
set -u

CONF=/etc/novadeck/rest.conf
[ -r "$CONF" ] && . "$CONF"
: "${NOVADECK_REST_SCREEN:=internal}"
: "${NOVADECK_SUSPEND_FREEZE_CGROUPS:=/sys/fs/cgroup/system.slice /sys/fs/cgroup/user.slice}"
: "${NOVADECK_SUSPEND_AUTOTHAW:=0}"     # seconds; >0 arms a safety auto-thaw (testing). 0 = off.
: "${NOVADECK_SUSPEND_SKIP:=}"          # power ops to skip: cpu rfkill governor gpugov (e.g. "rfkill" to keep SSH up)
: "${XDG_RUNTIME_DIR:=/run/user/0}"
export XDG_RUNTIME_DIR

STATE=/run/novadeck/suspended
LOG=/var/log/novadeck-suspend.log
# Log to a FILE, never the journal, on the suspend/resume path: journald lives in the frozen set, so
# writing to it could block the (un-frozen) engine on a frozen reader. /var is plain disk I/O.
log() { echo "$(date '+%F %T') novadeck-suspend: $*" >> "$LOG" 2>/dev/null; }

# Resolve the LIVE gamescope control socket instead of a blind gamescope-0 default — see the helper
# header for the DPMS bug (stale socket -> compositor on gamescope-1 -> panel never blanks). We only
# ever call panel() while gamescope is un-frozen (blank BEFORE freeze, unblank AFTER thaw), so its
# /proc/<pid>/environ is readable. Fallback no-op keeps suspend working if the overlay lib is absent.
GS_LIB=/usr/lib/novadeck/gamescope-display.sh
if [ -r "$GS_LIB" ]; then . "$GS_LIB"; else gs_resolve_display() { :; }; fi

# Reversible power-lowering primitives (cpu offline / rfkill / cpufreq+devfreq governors), shared
# verbatim with novadeck-rest so a real suspend lowers power the same way rest mode does — not just
# stops the game. Applied AFTER the freeze and restored BEFORE the thaw (see do_suspend/do_resume).
# State records share novadeck-rest's dir (the two states are mutually exclusive). POWER_SKIP lets
# bring-up keep, e.g., the Wi-Fi link up over SSH with NOVADECK_SUSPEND_SKIP="rfkill".
POWER_STATE_DIR=/run/novadeck/rest.d
POWER_SKIP=$NOVADECK_SUSPEND_SKIP
POW_LIB=/usr/lib/novadeck/power-ops.sh
if [ -r "$POW_LIB" ]; then . "$POW_LIB"; else power_enter() { :; }; power_leave() { :; }; fi

panel() {  # $1 = 1 (blank) | 0 (unblank) — via gamescope's own KMS modeset
  command -v gamescopectl >/dev/null 2>&1 || return 0
  gs_resolve_display || log "no live gamescope socket; trying ${GAMESCOPE_WAYLAND_DISPLAY:-gamescope-0}"
  gamescopectl "drm_sleep_${NOVADECK_REST_SCREEN}_screen" "$1" 2>/dev/null \
    || log "gamescopectl unreachable; panel unchanged"
}

freeze() {  # $1 = 1 (freeze) | 0 (thaw) — direct sysfs write, no dbus/systemctl dependency
  for cg in $NOVADECK_SUSPEND_FREEZE_CGROUPS; do
    [ -w "$cg/cgroup.freeze" ] && echo "$1" > "$cg/cgroup.freeze" 2>/dev/null
  done
}

# Wait for the internal panel connector to actually reach the requested KMS state before we proceed.
# gamescope applies the drm_sleep convar on its OWN main loop (~300ms after gamescopectl returns, HW-
# measured), so on suspend we must NOT freeze gamescope until the blank has truly landed — freezing it
# mid-apply traps it before the modeset and the panel stays lit (observed on HW 2026-06-24). Poll the
# connector's sysfs `enabled` attr (plain attribute read — not debugfs, no display hitch).
: "${NOVADECK_PANEL_WAIT_DS:=30}"   # max wait, deciseconds (3s); generous over the ~300ms apply
PANEL_GLOB="/sys/class/drm/card*-DSI-*"
wait_panel() {  # $1 = enabled|disabled
  _i=0
  while [ "$_i" -lt "$NOVADECK_PANEL_WAIT_DS" ]; do
    _all=1; _seen=0
    for _c in $PANEL_GLOB; do
      [ -r "$_c/enabled" ] || continue
      [ "$(cat "$_c/status" 2>/dev/null)" = connected ] || continue
      _seen=1
      [ "$(cat "$_c/enabled" 2>/dev/null)" = "$1" ] || _all=0
    done
    [ "$_seen" = 1 ] && [ "$_all" = 1 ] && return 0
    sleep 0.1; _i=$((_i + 1))
  done
  return 1
}

do_suspend() {
  [ -e "$STATE" ] && { log "already suspended"; return 0; }
  mkdir -p "$(dirname "$STATE")"
  # Arm the safety auto-thaw BEFORE freezing, while dbus/systemd-run still work. The timer lives in
  # the un-frozen wake slice and fires novadeck-suspend resume if the wake key never comes.
  if [ "$NOVADECK_SUSPEND_AUTOTHAW" -gt 0 ] 2>/dev/null; then
    systemctl reset-failed novadeck-autothaw.timer novadeck-autothaw.service 2>/dev/null || true
    systemd-run --slice=novadeck-wake.slice --on-active="${NOVADECK_SUSPEND_AUTOTHAW}s" \
      --unit=novadeck-autothaw --description="novadeck suspend safety auto-thaw" \
      /usr/bin/novadeck-suspend resume >/dev/null 2>&1 \
      && log "safety auto-thaw armed (${NOVADECK_SUSPEND_AUTOTHAW}s)"
  fi
  log "suspending: blank panel"
  panel 1
  # CONFIRM the blank landed before freezing gamescope (it applies the modeset async — see wait_panel).
  if wait_panel disabled; then log "panel blank confirmed"; else log "panel blank NOT confirmed in ${NOVADECK_PANEL_WAIT_DS}ds; freezing anyway"; fi
  log "freezing userland: $NOVADECK_SUSPEND_FREEZE_CGROUPS"
  freeze 1
  # Lower power AFTER the freeze (no frozen workload left to schedule): offline non-boot CPUs, block
  # radios, drop cpufreq + GPU devfreq governors to powersave. cpu0 stays up so the un-frozen wake
  # agent keeps running. Each op records prior state for do_resume; honours NOVADECK_SUSPEND_SKIP.
  log "lowering power (skip='${NOVADECK_SUSPEND_SKIP}')"
  power_enter
  : > "$STATE"
  log "suspended"
}

do_resume() {
  [ -e "$STATE" ] || { log "not suspended"; return 0; }
  rm -f "$STATE"
  systemctl stop novadeck-autothaw.timer 2>/dev/null || true   # cancel pending safety (PID1 socket)
  # Restore power BEFORE the thaw so the workload wakes onto its full CPU/governor budget: bring the
  # offlined CPUs back, unblock radios, restore prior cpufreq + GPU devfreq governors (reverse of
  # power_enter; restores exactly what was changed). Then thaw.
  log "restoring power"
  power_leave
  log "resuming: thaw userland"
  freeze 0
  log "unblank panel"
  panel 0
  if wait_panel enabled; then log "panel restore confirmed"; else log "panel restore NOT confirmed in ${NOVADECK_PANEL_WAIT_DS}ds"; fi
  # post-resume hooks (run un-frozen, after thaw). Freezing pauses wpa_supplicant/networkd and the
  # link may not re-associate on its own (same as after an rfkill cycle) — the test-card Wi-Fi re-up
  # ships as a hook here. Keeps novadeck-suspend generic; networking specifics stay out of it.
  for h in /etc/novadeck/resume.d/*; do
    [ -x "$h" ] || continue
    log "resume hook: $h"
    "$h" >> "$LOG" 2>&1 || log "resume hook failed: $h"
  done
  log "resumed"
}

case "${1:-}" in
  suspend) do_suspend ;;
  resume)  do_resume ;;
  toggle)  if [ -e "$STATE" ]; then do_resume; else do_suspend; fi ;;
  status)  if [ -e "$STATE" ]; then echo suspended; else echo awake; fi ;;
  *) echo "usage: novadeck-suspend {suspend|resume|toggle|status}" >&2; exit 2 ;;
esac
