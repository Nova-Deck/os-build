# novadeck uinput access — let Steam Input create its virtual gamepad.
#
# When a game runs under Proton (the baked arm64 compat tool), Steam Input opens
# /dev/uinput to inject a virtual controller for the game. On the RO root that node
# defaults to root:root 0600, so Steam fails with "Couldn't initialize virtual
# gamepad: Couldn't open /dev/uinput for writing" — the game renders but takes no
# input (the physical pad still drives the gamescope/Steam UI, which is why the UI
# works while the game does not).
#
# Grant group `input` (the deck user is already a member) read+write on the node.
# static_node= applies the perms to the statically-created node BEFORE anything
# opens it, so the first launch after boot already has access (a plain rule only
# fires on a uevent, which uinput — a misc device — may not emit in time).
SUBSYSTEM=="misc", KERNEL=="uinput", GROUP="input", MODE="0660", OPTIONS+="static_node=uinput"
