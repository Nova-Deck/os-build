# novadeck RAUC update manifest template — Phase 4.
# images/genbundle.sh fills @PLACEHOLDERS@; `rauc bundle` computes the rootfs hash/size.
#
# The three fields below are the SAME three the payload carries in its own /etc/novadeck-release —
# genbundle.sh fills them from the sidecar the assembler wrote beside the image, not from its own
# environment, so a bundle cannot claim an identity its contents do not. That equality is what the
# OTA client's "is an update available?" comparison rests on.
[update]
compatible=novadeck
version=@VERSION@

# `version` alone cannot identify a dev build: NOVADECK_VERSION is empty off a developer's box and
# renders `dev`, which every such image shares. genbundle.sh's identity rule falls back to `build`
# for exactly that case, so both have to travel with the bundle. `[meta.*]` is RAUC's forward-
# compatible free-form metadata: it is not interpreted, and it reaches `rauc info`, InspectBundle and
# the install handlers as RAUC_META_NOVADECK_* — which is where a post-install hook would read them
# if it ever needs to record what a slot was updated TO (see issue #34, the trial-stamp fix sketch).
#
# `mode` is dev|release, copied from the payload's own /etc/novadeck-release. A DEV image carries
# Wi-Fi credentials and an authorized_keys, and signing one with the real release key makes it
# byte-indistinguishable from a shippable bundle to any signature check — so the provenance has to
# travel WITH the bundle for ota/publish-bundle.sh to be able to refuse it. Dev bundles are still
# built and still install; they are just not publishable.
[meta.novadeck]
build=@BUILD@
git=@GIT@
mode=@MODE@

[bundle]
format=verity

# A/B: RAUC installs this into the inactive 'rootfs' slot group (rootfs-a/-b),
# then the bootloader marks it primary and rolls back if first boot fails.
[image.rootfs]
filename=rootfs.img
# Ship a SHA256 index of every 4KiB block alongside the image (~0.8% of it, ~30M here). At install
# time rauc looks each block up in BOTH slots and fetches only the ones it cannot find locally, so
# an OS-only update moves the delta instead of the whole slot. Measured 2026-08-04 on two
# independent pairs of real bundles: 96.1% of non-zero blocks are reused and ~125M crosses the wire
# instead of 3.90G (DONE.md carries the table and the method).
#
# Matching is CONTENT-addressed, not offset-based, and every local hit is re-hashed against this
# index before use -- which is why post-install.sh's `btrfstune -U` is harmless here. It diverges
# the target's btrfs metadata from the image that was written, so those blocks simply miss and get
# re-fetched; it costs bandwidth proportional to metadata, never correctness.
#
# THIS IS AN OPTIMISATION, NOT A FORMAT CHANGE. The bundle still carries the full rootfs.img, and
# rauc's adaptive path is best-effort with an unconditional fall-through to a raw copy on EVERY
# failure -- no data-directory, unsupported method, or any error mid-way
# (_reference/rauc/src/update_handler.c:986-1035). So `rauc install /path/bundle.raucb` from a
# workstation still works exactly as before and still gains nothing, which is the point: the
# pre-publish hardware install stays the same test it always was.
#
# It needs `data-directory` in fs-overlay/etc/rauc/system.conf. Without it this line is INERT and
# says so only at g_message level -- see the long comment there.
adaptive=block-hash-index
