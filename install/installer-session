#!/bin/sh
# novadeck internal install — the installer's SESSION: gamescope on the panel with install/ui as
# its only client. Phase 5 of .claude/plans/internal-install.plan.md.
#
#   installer-session          (started by novadeck-installer.service)
#
# THIS IS NOT novadeck-session. That one is the main image's Steam shell: it runs inside SDDM's
# logind session as the `deck` user, and it uses gamescope's --steam/-R model where the client is
# gamescope's SIBLING so SteamUI can drive the limiter, brightness and the colour pipeline over the
# stats channel. None of that applies here. There is no Steam, no user, no logind session and
# nothing to hand a control channel to, so this is the plain shape:
#
#     seatd-launch -- gamescope --backend drm -W .. -H .. -r .. --prefer-output .. -- install/ui
#
# WHICH IS THE SHAPE BRING-UP ALREADY VALIDATED ON HARDWARE. docs/bringup-phase2.md gate 1b:
# gamescope AS ROOT via seatd-launch, no logind session and no display manager at all, opening
# /dev/dri/card0 with the panel at its native mode and scanning out on the first modeset commit;
# gate 1c is a Vulkan client rendering upright under it. The installer's situation is that one,
# not the main image's -- which is why the installer needs no SDDM: SDDM is a login manager, its
# greeter is never even started here, and what it contributes to the main image (an ACTIVE seat0
# logind session so stock polkit's allow_active authorizes Wi-Fi) is meaningless for a tool that
# runs as root.
#
# libseat has NO `builtin` backend in the libseat we ship -- that is precisely why seatd-launch is
# here rather than LIBSEAT_BACKEND=builtin. Do not spend a hardware slot rediscovering that.
#
# NO --use-rotation-shader. Our patched gamescope carries upstream PR #2228 composite rotation and
# auto-engages it off the DRM connector's panel orientation, so the flag the plan mentions is from
# the ROCKNIX-patch era and no longer exists. The logical canvas stays landscape; -W/-H below are
# the panel's portrait native mode swapped, exactly as novadeck-session derives them.
#
# NO PLYMOUTH anywhere near this: plymouthd holds DRM master and starves gamescope of it. The
# installer boots to a black panel for a few seconds instead, deliberately.
set -eu

PROG=${0##*/}
log() { printf '[%s] %s\n' "$PROG" "$*" >&2; }
die() { log "ERROR: $*"; exit 1; }

SELFDIR=$(cd "$(dirname "$0")" && pwd)
# Every one of these is a test seam as well as an override point; install/test-ui.sh drives this
# file with all of them redirected into a sandbox, exactly as test-update.sh drives novadeck-update.
DEVICE_ENV=${NOVADECK_DEVICE_ENV:-/usr/lib/novadeck/device-env}
GAMESCOPE=${NOVADECK_GAMESCOPE:-gamescope}
SEATD_LAUNCH=${NOVADECK_SEATD_LAUNCH:-seatd-launch}
SEATD_SOCKET=${NOVADECK_SEATD_SOCK:-/run/seatd.sock}
SEATD_PGREP=${NOVADECK_SEATD_PGREP:-pgrep}
UI=${NOVADECK_UI:-$SELFDIR/ui}
DRYRUN=${NOVADECK_INSTALLER_DRYRUN:-0}

[ -x "$UI" ] || die "no installer UI at $UI"

# --- the panel, from the device registry ---------------------------------------------------------
# device-env is the runtime source of truth for per-board facts (it resolves the devicetree model to
# a profile). A board it does not recognise yields nothing and we fall back to generic landscape --
# an installer that refuses to draw because a conf is missing is worse than one drawing 1920x1080.
if [ -x "$DEVICE_ENV" ]; then
    eval "$("$DEVICE_ENV" 2>/dev/null || true)"
else
    log "no device-env at $DEVICE_ENV -- falling back to a generic landscape output"
fi

if [ -n "${NOVADECK_PANEL_NATIVE_WIDTH:-}" ] && [ -n "${NOVADECK_PANEL_NATIVE_HEIGHT:-}" ]; then
    # Swap portrait native -> landscape logical. The composite-rotation patch keeps gamescope's
    # logical output landscape and rotates only the final scanout store.
    GS_W=$NOVADECK_PANEL_NATIVE_HEIGHT
    GS_H=$NOVADECK_PANEL_NATIVE_WIDTH
else
    GS_W=1920
    GS_H=1080
fi
_rr=${NOVADECK_PANEL_REFRESH_RATES:-}
GS_R=${_rr%%,*}
[ -n "$GS_R" ] || GS_R=60

set -- --backend drm -W "$GS_W" -H "$GS_H" -r "$GS_R"
if [ -n "${NOVADECK_PRIMARY_CONNECTOR:-}" ]; then
    set -- "$@" --prefer-output "$NOVADECK_PRIMARY_CONNECTOR"
fi

# --- the seat -------------------------------------------------------------------------------------
# seatd-launch LEAKS ITS SOCKET on an unclean exit, and the next start then dies with "Socket file
# found ... refusing to start". docs/bringup-phase2.md paid for that once on the main image; an
# installer is a tool people re-run after a crash, so it would bite here every time. Clear a stale
# socket -- but ONLY when no seatd is actually listening on it, because removing a live one would
# break a running session.
if [ -e "$SEATD_SOCKET" ] && ! $SEATD_PGREP -x seatd >/dev/null 2>&1; then
    log "clearing a stale $SEATD_SOCKET left by an earlier run"
    rm -f "$SEATD_SOCKET"
fi

if [ "$DRYRUN" = 1 ]; then
    # The WHOLE command, seat launcher included -- a dry run that printed only the gamescope half
    # would let the seat path change without the suite noticing, and the seat path is the part that
    # has to work with no logind session.
    printf '%s -- %s %s -- %s\n' "$SEATD_LAUNCH" "$GAMESCOPE" "$*" "$UI"
    exit 0
fi
log "starting: $SEATD_LAUNCH -- $GAMESCOPE $* -- $UI"

# The UI is gamescope's OWN CHILD (`--`), not a sibling: when it exits, gamescope exits, and the
# unit's ExecStopPost gets to collect the log. That is also the model bring-up validated.
exec "$SEATD_LAUNCH" -- "$GAMESCOPE" "$@" -- "$UI"
