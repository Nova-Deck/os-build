#!/usr/bin/env bash
# novadeck internal install — §4b's NETWORK DIAGNOSIS. Phase 4b/5 of
# .claude/plans/internal-install.plan.md.
#
#   netcfg diagnose      read-only: which of §4b's states is this machine in?
#   netcfg join          attempt to join the network wifi.conf names, then diagnose
#
# IT EMITS key=value AND NO PROSE, exactly as the consent gate's facts file does, and for the same
# reason: the words belong to whatever is drawing the screen, the facts belong here. install/uiflow
# turns STATE= into a sentence and a fix; a terminal caller can read the same line.
#
# WHY EACH STATE IS SEPARATE, and why "network failed" is not acceptable. This is a network-only
# installer with NO on-device credential entry (§4b, 2026-08-05): no keyboard is guaranteed, no
# touchscreen is guaranteed, so the SSID and PSK arrive as `novadeck/wifi.conf` on the installer's
# own ESP, written from the user's PC before booting. A wrong file therefore costs a power-off,
# pulling the card, editing it on another computer and rebooting. Every one of the states below has
# a DIFFERENT fix, and a user who is told only "network failed" has to guess which -- at that
# price per guess. The table in §4b is the acceptance criterion for this file.
#
# THE PSK IS NEVER PRINTED, not even in a debug line. It is plaintext on a FAT partition the user
# controls, it never reaches the installed system, and it must not reach the install log either.
set -uo pipefail

PROG=${0##*/}
log() { printf '[%s] %s\n' "$PROG" "$*" >&2; }

# Test seams, in the spirit of the rest of install/: install/test-netcfg.sh executes THIS file with
# every tool stubbed and every path redirected. What runs under test is the artifact that ships.
WIFI_CONF=${NOVADECK_WIFI_CONF:-/esp/novadeck/wifi.conf}

# THE OTA URL IS RESOLVED THE WAY novadeck-update RESOLVES IT: the environment, then OTA_URL in
# /etc/novadeck/ota.conf, then the same built-in default. Reachability of THAT host is what
# `no-host` means, so a URL of our own invention here would report a healthy network as broken --
# which is exactly the misdiagnosis this file exists to prevent. It was, briefly: this default read
# `ota.novadeck.org`, a host that does not exist.
#
# The literal is written twice, here and in fs-overlay/usr/bin/novadeck-update, because one is
# shell and the other Python. install/test-ui.sh asserts the two agree; that assertion is the only
# thing that keeps them the same URL.
OTA_CONFIG=${NOVADECK_OTA_CONFIG:-/etc/novadeck/ota.conf}
OTA_DEFAULT_URL=https://updates.novadeck.cloud-ip.cc
if [ -z "${NOVADECK_OTA_URL:-}" ] && [ -r "$OTA_CONFIG" ]; then
  NOVADECK_OTA_URL=$(sed -n 's/^[[:space:]]*OTA_URL=//p' "$OTA_CONFIG" | tail -1 | tr -d '"'"'"' \r')
fi
OTA_URL=${NOVADECK_OTA_URL:-$OTA_DEFAULT_URL}
NMCLI=${NMCLI:-nmcli}
CURL=${CURL:-curl}
IP=${IP:-ip}
CONNECT_TIMEOUT=${NOVADECK_NET_TIMEOUT:-20}

emit() { printf '%s=%s\n' "$1" "$2"; }

# --- the individual questions ---------------------------------------------------------------------
have_lease() {
  # Any global-scope v4 address on any interface. Deliberately not "is wlan0 up": a USB-C Ethernet
  # adapter is the zero-config path (§4b) and NetworkManager brings it up with no file at all, so
  # the wired case must satisfy this without ever looking at wifi.conf.
  [ -n "$("$IP" -4 addr show scope global 2>/dev/null | grep -c 'inet ' | tr -d ' \n')" ] \
    && "$IP" -4 addr show scope global 2>/dev/null | grep -q 'inet '
}

# THE HOST ANSWERING IS THE QUESTION -- NOT WHAT IT ANSWERS. No `-f`, deliberately: with it, curl
# turns any 4xx into a failure, and this reported `no-host` for a server that had completed a TLS
# handshake and replied 404. MEASURED on a Pocket S2, 2026-08-22, on a network the probe was
# running over. The OTA root legitimately 404s (it serves `<channel>/latest.json`, not an index),
# and so, at that moment, did the dev channel's manifest -- a published release is not a promise
# that any given channel has one.
#
# What `no-host` must mean is §4b's row: "upstream or DNS, not ours". That is exactly curl's EXIT
# code -- 6 cannot resolve, 7 cannot connect, 28 timed out, 35 TLS -- and never its HTTP status. A
# server that says 404 is a server the installer can reach.
CURL_RC=0
host_reachable() {
  "$CURL" -sS --max-time "$CONNECT_TIMEOUT" -o /dev/null "$OTA_URL/" >/dev/null 2>&1
  CURL_RC=$?
  [ "$CURL_RC" = 0 ]
}

# THE CLOCK IS A SEPARATE ROW, and on these boards it is the one that actually happens. There is no
# /dev/rtc -- the PMIC RTC probe defers forever (issue #38) -- so until systemd-timesyncd has synced,
# the clock sits at the epoch and OpenSSL rejects every certificate as not-yet-valid. HW-FOUND
# 2026-08-24: that surfaced as "Connected, but the update server is unreachable", which sent the
# operator looking at their network and their router for a fault in neither. curl exit 60 with an
# unsynchronised clock is a WAITING state, not a reachability failure: it clears itself, and the
# only correct advice is to wait a moment and check again.
# Is the radio mid-join? nmcli reports a device state like "connecting (getting IP configuration)",
# so the prefix is what is matched -- the parenthetical names the phase and there are several.
wifi_busy() {
  "$NMCLI" -t -f TYPE,STATE device 2>/dev/null \
    | awk -F: '$1 == "wifi" && $2 ~ /^connecting/ { found = 1 } END { exit !found }'
}

# Does NetworkManager hold a wifi profile of its own? A TEST medium bakes one in
# (/usr/lib/NetworkManager/system-connections) and carries no wifi.conf, so "no wifi.conf" says
# nothing there about whether a network is configured.
has_wifi_profile() {
  "$NMCLI" -t -f TYPE connection show 2>/dev/null | grep -qx '802-11-wireless'
}

# The network being joined, for the screen. Empty is fine -- the row reads without it.
active_ssid() {
  "$NMCLI" -t -f NAME,TYPE connection show --active 2>/dev/null \
    | awk -F: '$2 == "802-11-wireless" { print $1; exit }'
}

clock_unsynced() {
  [ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" = "no" ]
}

curl_reason() {
  case "$CURL_RC" in
    6)  printf 'the name %s could not be resolved (DNS)' "${OTA_URL#https://}" ;;
    7)  printf 'nothing accepted a connection' ;;
    28) printf 'it did not answer within %ss' "$CONNECT_TIMEOUT" ;;
    35|60)
        if clock_unsynced; then
          printf 'this device has no clock battery, and the time is not set yet (%s), so every certificate looks not-yet-valid. It fixes itself within a minute of joining a network' \
                 "$(date -u '+%Y-%m-%d' 2>/dev/null)"
        else
          printf 'the secure connection could not be established'
        fi ;;
    *)  printf 'curl gave up with code %s' "$CURL_RC" ;;
  esac
}

# --- wifi.conf ------------------------------------------------------------------------------------
# Parsed strictly, and the LINE NUMBER of the first offending line is reported: "present but
# unparseable" with no location is the same unhelpful answer as "network failed", one level down.
SSID=""; PSK=""; BAD_LINE=""
parse_conf() {
  local n=0 line key val
  SSID=""; PSK=""; BAD_LINE=""
  # STRIP THE CARRIAGE RETURN FIRST. This file is meant to be written on another computer, and
  # since the medium's boot partition is typed 0700 so Windows and macOS will show it, "another
  # computer" is very often Windows and the editor is very often Notepad -- which saves CRLF. A
  # trailing \r rides into the value, so the PSK becomes "secret<CR>", the access point rejects it,
  # and the screen reports a wrong password with complete confidence. The user then checks a
  # password that was correct all along. Costed nothing to prevent and would have been miserable
  # to diagnose from a photograph of a panel.
  local cr; cr=$(printf '\r')
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    line=${line%"$cr"}
    case "$line" in ''|'#'*) continue ;; esac
    case "$line" in
      *=*) key=${line%%=*}; val=${line#*=} ;;
      *)   BAD_LINE=$n; return 1 ;;
    esac
    # Trim surrounding quotes the way a user who copied dev.env would have written them.
    val=${val#[\"\']}; val=${val%[\"\']}
    case "$(printf '%s' "$key" | tr -d '[:space:]')" in
      SSID|NOVADECK_WIFI_SSID) SSID=$val ;;
      PSK|PASSWORD|NOVADECK_WIFI_PSK) PSK=$val ;;
      *) BAD_LINE=$n; return 1 ;;
    esac
  done <"$WIFI_CONF"
  [ -n "$SSID" ] || { BAD_LINE=0; return 1; }   # 0 = the file parsed but names no SSID
  return 0
}

# --- the diagnosis ----------------------------------------------------------------------------------
# ORDER IS THE DESIGN. Connectivity is checked BEFORE wifi.conf is even looked for, so a device on
# USB-C Ethernet never sees a word about a file it does not need; and the SSID is checked against
# the scan before a join is attempted, so "typo" and "wrong PSK" stay distinguishable.
diagnose() {  # <joined?>
  local joined="${1:-0}"

  if have_lease; then
    if host_reachable; then
      emit STATE online
      emit DETAIL "the installer can reach $OTA_URL"
      return 0
    fi
    # THE CLOCK IS ITS OWN STATE, because it has its own fix and the fix is "wait". §4b's table is
    # seven states because each one sends the operator somewhere different; reporting this as
    # `no-host` sent them to look at their router for a fault in neither the router nor the server
    # (HW, 2026-08-24). It is also the only row here that clears ITSELF, so the advice is not to
    # change anything.
    if [ "$CURL_RC" = 60 ] || [ "$CURL_RC" = 35 ]; then
      if clock_unsynced; then
        emit STATE no-clock
        emit URL "$OTA_URL"
        emit DETAIL "the clock reads $(date -u '+%Y-%m-%d %H:%M' 2>/dev/null) UTC and has not been set from the network yet"
        return 0
      fi
    fi
    emit STATE no-host
    emit URL "$OTA_URL"
    emit DETAIL "an address is held, but $(curl_reason)"
    return 0
  fi

  # A NETWORK THAT HAS NOT FINISHED JOINING IS NOT A MISSING CONFIGURATION, and the order of the
  # checks used to say otherwise: have_lease fails for the whole association window, so anything
  # without a lease fell through to `no-conf` -- "No Wi-Fi settings on this card" -- and told the
  # operator to go and write a file on another computer while the radio was mid-handshake.
  #
  # THE ABSENCE OF wifi.conf IS NOT THE ABSENCE OF CONFIGURATION. A TEST medium carries its network
  # baked in as an NM profile and has no wifi.conf at all, so that path is not a corner case there,
  # it is every cold boot. A RELEASE medium has neither, and `no-conf` is then exactly right --
  # which is why this needs trying on a release image before it is believed: the dev build cannot
  # reach the state it is meant to protect.
  #
  # Self-clearing, like no-clock: the only correct advice is to wait.
  if wifi_busy; then
    emit STATE associating
    emit SSID "$(active_ssid)"
    emit DETAIL "the radio is joining a network and no address has been handed out yet"
    return 0
  fi

  if [ ! -r "$WIFI_CONF" ] && has_wifi_profile; then
    # Configured, not busy, no lease: NM has a profile and is not currently working on it. Say that
    # rather than claiming there is no configuration -- the file the `no-conf` advice talks about is
    # not where this network came from.
    emit STATE associating
    emit SSID "$(active_ssid)"
    emit DETAIL "a network is configured on this medium, and no address has been handed out yet"
    return 0
  fi

  if [ ! -r "$WIFI_CONF" ]; then
    emit STATE no-conf
    emit PATH_ "$WIFI_CONF"
    return 0
  fi
  if ! parse_conf; then
    emit STATE unparsable
    emit PATH_ "$WIFI_CONF"
    emit LINE "$BAD_LINE"
    return 0
  fi
  emit SSID "$SSID"

  if [ "$joined" = 0 ]; then
    # Nothing has been attempted yet: this is the confirm-before-connecting state §4b asks for.
    # Its job is the STALE FILE -- a card round-tripped through an earlier install, or edited for
    # another network, names an SSID the user recognises as wrong BEFORE a failed attempt.
    emit STATE need-join
    return 0
  fi

  if ! "$NMCLI" -t -f SSID device wifi list --rescan yes 2>/dev/null | grep -qxF "$SSID"; then
    emit STATE not-found
    return 0
  fi
  emit STATE no-lease
  emit DETAIL "associated with the network, but no address was offered"
}

join() {
  if ! [ -r "$WIFI_CONF" ] || ! parse_conf; then
    diagnose 0
    return 0
  fi
  emit SSID "$SSID"
  # The one place the PSK is used, and it is passed as an argument to nmcli and nowhere else. Its
  # value is never logged, never emitted and never written.
  if "$NMCLI" device wifi connect "$SSID" password "$PSK" >/dev/null 2>"$TMP_ERR"; then
    diagnose 1
    return 0
  fi
  # nmcli says which of the two failures this is, and they have different fixes: a wrong PSK is
  # retyped, an absent SSID is a typo or an AP out of range.
  if grep -qiE 'secrets were required|password|encryption key' "$TMP_ERR" 2>/dev/null; then
    emit STATE auth-failed
    emit DETAIL "the network rejected the key in $WIFI_CONF"
    return 0
  fi
  if ! "$NMCLI" -t -f SSID device wifi list --rescan yes 2>/dev/null | grep -qxF "$SSID"; then
    emit STATE not-found
    return 0
  fi
  diagnose 1
}

TMP_ERR="$(mktemp)"; trap 'rm -f "$TMP_ERR"' EXIT

case "${1:-diagnose}" in
  diagnose) diagnose 0 ;;
  join)     join ;;
  *) log "usage: $PROG [diagnose|join]"; exit 2 ;;
esac
