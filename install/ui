class NullView:
    """Draws nothing and records the last description, so a test can assert what would be drawn."""

    def __init__(self):
        self.last = None

    def draw(self, desc):
        self.last = desc

    def close(self):
        pass


class PygameView:
    """
    The SDL2 client. Everything it knows about a screen arrives as the dict from describe().

    The font is pygame's own bundled face by default: a UI that dies because fontconfig came up
    empty is a black panel on a device with no serial console, and the installer is the one tool
    that has to work when everything else is broken.
    """

    BG = (16, 18, 22)
    FG = (232, 234, 238)
    DIM = (150, 155, 165)
    WARN = (240, 180, 90)
    DOT = (90, 96, 108)
    DOT_ON = (240, 240, 245)

    def __init__(self):
        import pygame                                            # lazy: see this file's header

        self.pygame = pygame
        pygame.init()
        pygame.display.set_caption("NovaDeck installer")
        self.surface = pygame.display.set_mode((0, 0), pygame.FULLSCREEN)
        self.w, self.h = self.surface.get_size()
        base = max(14, int(self.h / 34))
        self.f_title = pygame.font.Font(None, int(base * 1.9))
        self.f_head = pygame.font.Font(None, int(base * 1.25))
        self.f_body = pygame.font.Font(None, base)

    def draw(self, desc):
        pg = self.pygame
        self.surface.fill(self.BG)
        m = int(self.w * 0.06)
        y = m
        y = self._text(desc.get("title", ""), self.f_title, self.FG, m, y) + int(self.h * 0.02)
        for head, body in desc.get("blocks", []):
            if head:
                y = self._text(head, self.f_head, self.WARN, m, y)
            y = self._wrap(body, self.f_body, self.DIM, m, y, self.w - 2 * m)
            y += int(self.h * 0.012)
        diamonds = desc.get("diamonds", [])
        if diamonds:
            y = self._text(desc.get("prompt", ""), self.f_head, self.FG, m, y + int(self.h * 0.01))
            y = self._diamonds(diamonds, m, y + int(self.h * 0.015))
            y = self._text(desc.get("note", ""), self.f_body, self.DIM, m, y + int(self.h * 0.01))
        if desc.get("abort"):
            self._text(desc["abort"], self.f_body, self.DIM, m, self.h - m)
        pg.display.flip()

    def _text(self, s, font, colour, x, y):
        if not s:
            return y
        surf = font.render(s, True, colour)
        self.surface.blit(surf, (x, y))
        return y + surf.get_height()

    def _wrap(self, s, font, colour, x, y, width):
        words, line = s.split(), ""
        for w in words:
            trial = (line + " " + w).strip()
            if font.size(trial)[0] > width and line:
                y = self._text(line, font, colour, x, y)
                line = w
            else:
                line = trial
        return self._text(line, font, colour, x, y)

    def _diamonds(self, diamonds, x, y):
        """One diamond of four dots per press, the target filled, its position named underneath."""
        pg = self.pygame
        r = max(6, int(self.h / 90))          # dot radius
        span = r * 5                          # centre-to-centre of opposite dots
        cell = span * 2 + r * 6
        for i, d in enumerate(diamonds):
            cx = x + int(cell * (i + 0.5))
            cy = y + span
            for pos, (dx, dy) in (
                ("N", (0, -span)), ("E", (span, 0)), ("S", (0, span)), ("W", (-span, 0))
            ):
                filled = pos == d["pos"]
                colour = self.DOT_ON if filled else self.DOT
                pg.draw.circle(self.surface, colour, (cx + dx, cy + dy), r, 0 if filled else 2)
            label = self.f_body.render(d["name"], True, self.FG if not d["done"] else self.DIM)
            self.surface.blit(label, (cx - label.get_width() // 2, cy + span + r * 2))
        return y + span * 2 + r * 4 + self.f_body.get_height()

    def close(self):
        self.pygame.quit()


# =================================================================================================
# the loop
# =================================================================================================
def build_io():
    """The view and the input source come as a pair: scripted events mean no window at all."""
    if EVENTS_FILE:
        return NullView(), ScriptedInput(EVENTS_FILE)
    view = PygameView()
    return view, PadInput(view.pygame)


def run(server, view, source, deadline=0):
    """
    Returns when the scripted source runs out (tests) or the window goes away.

    `deadline` is a wall-clock bound in seconds, for the headless runs only: a UI that is waiting
    for a request that never comes must fail the suite rather than hang it. 0 means no bound.
    """
    screen = IdleScreen()
    started = time.monotonic()
    while True:
        req = server.poll()
        if req is not None:
            try:
                facts = read_facts(req["facts"])
                screen = ConsentScreen(facts, req["sequence"])
                screen.describe()        # raises on a screen this renderer does not know
                # Logged deliberately, and it is safe to log: the sequence is not a secret, it is
                # on the panel. What it proves in the journal is WHICH screen was shown and what
                # was asked for, next to the spine's own record of what came back.
                log("consent requested for %s (%s), sequence %s"
                    % (facts.get("DISK", "?"), facts.get("SCREEN", "?"), req["sequence"]))
            except (KeyError, OSError, ValueError) as e:
                log("refusing a consent request: %s" % e)
                server.answer({"error": str(e)})
                screen = IdleScreen()

        view.draw(screen.describe())

        for token in source.poll(screen):
            if token == TOKEN_QUIT and server.pending is None:
                # The window went away with nothing pending. During a consent request QUIT is an
                # abort instead, which the screen turns into one -- an answer, not a silent exit.
                return 0
            screen.handle(token)
            result = getattr(screen, "result", None)
            if result is not None:
                if result[0] == "abort":
                    server.answer({"abort": True})
                else:
                    server.answer({"answer": result[1]})
                screen = IdleScreen()
                break

        if isinstance(source, ScriptedInput) and source.i >= len(source.tokens) \
                and server.pending is None and screen.name == "idle":
            return 0
        if deadline and time.monotonic() - started > deadline:
            log("gave up waiting after %ds" % deadline)
            return 1
        time.sleep(1 / 60)


def main(argv):
    global SOCK_PATH
    args = list(argv)
    while args:
        a = args.pop(0)
        if a == "--socket" and args:
            SOCK_PATH = args.pop(0)
        else:
            log("unknown argument %s" % a)
            return 2

    server = ConfirmServer(SOCK_PATH)
    view, source = build_io()
    try:
        return run(server, view, source, deadline=float(os.environ.get("NOVADECK_UI_DEADLINE", "0")))
    finally:
        source.close()
        view.close()
        server.close()


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
