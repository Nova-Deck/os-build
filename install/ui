# the loop
# =================================================================================================
# The command behind the one button that says "Power off". §5 chose power-off over reboot until
# Phase 0 item 4 answers the ABL scan order, so this is the decided action, not a placeholder.
POWEROFF = os.environ.get("NOVADECK_UI_POWEROFF", "systemctl poweroff")


def power_off(source):
    """
    Halt the machine, unless this is a scripted run.

    TWO LAYERS, because the failure mode is halting a developer's workstation mid-suite. The
    command is a seam so a test can assert WHICH command was issued -- and a scripted source means
    a test by construction, so this refuses outright there rather than trusting every future case
    to remember to set the seam. A screen that says "Power off" and merely exits is worse than
    either: the UI dies, gamescope dies with it, and the device sits at a black panel having
    promised something else.
    """
    if isinstance(source, ScriptedInput):
        log("scripted run: NOT powering off (would have run: %s)" % POWEROFF)
        return
    log("powering off: %s" % POWEROFF)
    os.system(POWEROFF)                                        # noqa: S605 - a fixed command


def build_io():
    """
    The view and the input source come as a pair: scripted events mean no window at all.

    install/uiview.py is loaded HERE and nowhere else — it is the only file that imports pygame, and
    reaching it requires having decided to open a display. Everything above this line runs on a
    build host with no SDL.
    """
    if EVENTS_FILE:
        return NullView(), ScriptedInput(EVENTS_FILE)
    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
    import uiview

    view = uiview.PygameView()
    return view, PadInput(view.pygame)


def run(server, view, source, base, deadline=0):
    """
    Returns when the scripted source runs out (tests) or the window goes away.

    `deadline` is a wall-clock bound in seconds, for the headless runs only: a UI that is waiting
    for a request that never comes must fail the suite rather than hang it. 0 means no bound.
    """
    # A STACK, not a variable. The consent request arrives while the progress screen is up and has
    # to hand the screen back when it is answered -- the install is still running underneath it.
    stack = [base]
    spine = None
    started = time.monotonic()
    # §4d's input check, throttled: it reads the kernel's device list, which is cheap but not free
    # at frame rate, and the answer only changes when somebody plugs something in.
    no_input = NoInputScreen()
    have_input, input_checked = source.present(), time.monotonic()
    if not have_input:
        log("no controller and no keyboard -- consent cannot be taken on this machine (§4d)")
    # THE NETWORK SCREEN RE-DIAGNOSES ITSELF, whatever it currently says. A person should never have
    # to press a button to find out that a condition already fixed itself.
    #
    # This began as an allowlist -- no-clock, associating, no-lease -- on the reasoning that every
    # OTHER row names something a human has to go and change, so re-running those would flicker
    # between guesses. THAT REASONING WAS WRONG, and hardware said so within the hour (2026-08-24):
    # the operator hit "Connected, but the update server is unreachable" and stayed on it, while the
    # device behind it had long since gone STATE=online -- the clock had synced and DNS had come up.
    # `no-host` at boot is usually DNS not being ready yet, which is exactly the self-clearing shape
    # the allowlist was built to catch, and I had excluded it by name.
    #
    # The allowlist was the wrong question. Re-probing is ALWAYS safe -- net_diagnose() defaults to
    # `diagnose`, which is read-only and never joins anything -- and the screen only changes when
    # the STATE actually changes, so a stable fault stays stable and readable. What varies is not
    # whether to look, it is what to do with the answer: `online` leaves the screen, anything else
    # redraws it. No guessing, and no state can be forgotten by omission from a list again.
    NET_RECHECK_S = 5
    net_checked = time.monotonic()
    while True:
        if time.monotonic() - input_checked > 2:
            was, have_input = have_input, source.present()
            input_checked = time.monotonic()
            if was != have_input:
                log("input devices: %s" % ("present again" if have_input else "gone"))

        top = stack[-1]
        if (getattr(top, "name", "") == "network"
                and time.monotonic() - net_checked > NET_RECHECK_S):
            net_checked = time.monotonic()
            fresh = net_diagnose()
            if fresh.get("STATE") != top.facts.get("STATE"):
                log("network: %s (was %s, re-checked on its own)"
                    % (fresh.get("STATE"), top.facts.get("STATE")))
                if fresh.get("STATE") == "online":
                    # ONLINE IS NOT A SCREEN, it is the reason to leave this one. Replacing the
                    # network screen with a network screen that says "online" would leave a person
                    # looking at a success message with a Continue button, having already waited --
                    # so take the same step pressing Continue takes. Nothing is written by it: the
                    # pre-flight screen is the last read-only stop before consent.
                    facts, why = gather_preflight()
                    stack[-1] = PreflightScreen(facts) if facts else IdleScreen(why)
                else:
                    stack[-1] = NetworkScreen(fresh)

        screen = no_input if not have_input else stack[-1]

        # The install, if one is running. Read before drawing so a frame shows the newest step.
        if spine is not None:
            progress = next((s for s in stack if s.name == "progress"), None)
            for line in spine.poll():
                log("spine: %s" % line)
                if progress is not None:
                    progress.feed(line)
            rc = spine.returncode()
            if rc is not None and not spine.buf:
                if progress is not None:
                    progress.finish(rc)
                log("the spine exited %d" % rc)
                spine = None

        req = server.poll()
        if req is not None and not have_input:
            # THE REFUSAL THAT MAKES THE SCREEN MORE THAN A MESSAGE. Drawing a consent screen on a
            # machine with nothing to press it with would leave the spine blocked on an answer that
            # can never come; answering with an error makes the shim exit non-zero, which the spine
            # reads as an abort and stops on. It fails closed, and it fails at once.
            log("refusing a consent request: there is no input device to take consent on (§4d)")
            server.answer({"error": "no controller or keyboard is attached"})
            req = None
        if req is not None:
            try:
                facts = read_facts(req["facts"])
                consent = ConsentScreen(facts, req["sequence"])
                consent.describe()       # raises on a screen this renderer does not know
                stack.append(consent)
                screen = consent
                # Logged deliberately, and it is safe to log: the sequence is not a secret, it is
                # on the panel. What it proves in the journal is WHICH screen was shown and what
                # was asked for, next to the spine's own record of what came back.
                log("consent requested for %s (%s), sequence %s"
                    % (facts.get("DISK", "?"), facts.get("SCREEN", "?"), req["sequence"]))
            except (KeyError, OSError, ValueError) as e:
                log("refusing a consent request: %s" % e)
                server.answer({"error": str(e)})

        view.draw(screen.describe())

        for token in source.poll(screen):
            if token == TOKEN_QUIT and server.pending is None and screen.name != "consent":
                # The window went away with nothing pending. During a consent request QUIT is an
                # abort instead, which the screen turns into one -- an answer, not a silent exit.
                return 0
            screen.handle(token)
            result = getattr(screen, "result", None)
            if result is None:
                continue
            if screen.name == "consent":
                server.answer({"abort": True} if result[0] == "abort" else {"answer": result[1]})
                stack.pop()                          # back to whatever asked -- usually progress
            elif result[0] in ("join", "retry"):
                # The only two buttons the network screen has. `join` is the one that touches
                # NetworkManager; both end in a fresh diagnosis, because the state after an attempt
                # is the only thing worth showing.
                log("network: %s" % result[0])
                stack[-1] = NetworkScreen(net_diagnose("join" if result[0] == "join" else
                                                       "diagnose"))
            elif result[0] == "continue":
                # The network is up, so the pre-flight facts can finally be gathered -- they need
                # nothing from the network themselves, but there is no point drawing a disk the
                # installer cannot then fetch a bundle for.
                facts, why = gather_preflight()
                stack[-1] = PreflightScreen(facts) if facts else IdleScreen(why)
            elif result[0] == "start":
                spine = SpineRun(result[1], server.path)
                stack.append(ProgressScreen(spine))
            elif result[0] == "poweroff":
                power_off(source)
                return 0
            elif result[0] == "quit":
                return 0
            break

        # A scripted run is over when its tokens are spent and nothing is still owed an answer.
        # Deliberately NOT keyed on which screen is up: a screen this condition forgot to name is a
        # suite that hangs until the deadline, which is how adding the network screen announced
        # itself.
        if isinstance(source, ScriptedInput) and source.i >= len(source.tokens) \
                and server.pending is None and spine is None:
            return 0
        if deadline and time.monotonic() - started > deadline:
            log("gave up waiting after %ds" % deadline)
            return 1
        time.sleep(1 / 60)


def main(argv):
    global SOCK_PATH
    args = list(argv)
    while args:
        a = args.pop(0)
        if a == "--socket" and args:
            SOCK_PATH = args.pop(0)
        else:
            log("unknown argument %s" % a)
            return 2

    server = ConfirmServer(SOCK_PATH)
    view, source = build_io()
    # NO TARGET IS NOT AN ERROR. The UI is also started on a machine where the spine is being driven
    # over SSH (that is how Phase 4 was hardware-gated), and there its whole job is to render consent
    # when the shim asks. It says so in the journal and waits.
    # NO TARGET, NO OPINION ABOUT THE NETWORK. Both checks are read-only, and the order between
    # them is a UX decision rather than a technical one: a machine with nothing to install onto is
    # one where this UI is only a consent renderer (that is how Phase 4 is hardware-gated, with the
    # spine driven over SSH), and greeting that operator with a Wi-Fi error would be answering a
    # question nobody asked.
    #
    # WHEN THERE IS A TARGET, THE NETWORK IS THE FIRST THING SHOWN, because §4b's failures are the
    # ones a user cannot fix in place: a wrong wifi.conf costs a power-off, a pulled card, an edit
    # on another computer and a reboot. Finding that out after the pre-flight screen has raised
    # expectations is worse than finding it out at second zero. A machine already online (USB-C
    # Ethernet, §4b's zero-config path) never sees the screen at all.
    facts, why = gather_preflight()
    if facts is None:
        base = IdleScreen(why)
    else:
        net = net_diagnose()
        log("network: %s" % net.get("STATE", "?"))
        base = PreflightScreen(facts) if net.get("STATE") == "online" else NetworkScreen(net)
    try:
        return run(server, view, source, base,
                   deadline=float(os.environ.get("NOVADECK_UI_DEADLINE", "0")))
    finally:
        source.close()
        view.close()
        server.close()


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
