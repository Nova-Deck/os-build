# novadeck kernel config fragment — SM8650 (Snapdragon 8 Gen 3)
#
# Merge onto an arm64 base (e.g. mainline `defconfig`) with:
#   scripts/kconfig/merge_config.sh -m arch/arm64/configs/defconfig kernel/config/sm8650.config
#
# STATUS: validated against linux 7.0.11 (see kernel/SOURCE.pin) on 2026-06-17.
# All symbols below exist in that tree EXCEPT where explicitly noted as a gap.

# --- Page size: 4K REQUIRED for FEX-Emu / x86 game compat (Phase 3) ---
CONFIG_ARM64_4K_PAGES=y
# CONFIG_ARM64_16K_PAGES is not set
# CONFIG_ARM64_64K_PAGES is not set

# --- Platform core ---
CONFIG_ARCH_QCOM=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_SOCINFO=y
CONFIG_MAILBOX=y
CONFIG_QCOM_APCS_IPC=y
CONFIG_QCOM_IPCC=y

# --- Clocks / interconnect / pinctrl (SM8650) ---
CONFIG_COMMON_CLK_QCOM=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_SM_GCC_8650=y
# SM8650 reuses the SM8550 display clock controller — there is no separate _8650 dispcc
# upstream (symbols jump 8550 -> 8750 in 7.0.11).
CONFIG_SM_DISPCC_8550=y
CONFIG_SM_GPUCC_8650=y
CONFIG_SM_TCSRCC_8650=y
CONFIG_PINCTRL_SM8650=y
CONFIG_PINCTRL_SM8650_LPASS_LPI=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SM8650=y

# --- Serial console (Qualcomm GENI) — bring-up step 1 (UART) ---
CONFIG_QCOM_GENI_SE=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y

# --- Storage (UFS) — bring-up step 2 ---
CONFIG_SCSI=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y

# --- USB — bring-up step 3 ---
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_PHY_SNPS_EUSB2=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y
CONFIG_TYPEC=y
CONFIG_TYPEC_QCOM_PMIC=y

# --- Display + GPU (MSM DRM kernel; Turnip Vulkan in userspace) — steps 4 & 6 ---
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_GPU_STATE=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_PHY_QCOM_QMP_COMBO=y

# --- Handheld panels / backlight / panel-power (from kernel/patches/0060-0063) ---
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_SY7758=y              # 0060: Silergy SY7758 backlight
CONFIG_REGULATOR_SGM3804=y             # 0061: SGM3804 panel-power regulator
CONFIG_DRM_PANEL_AYANEO_WT0600_2K=y    # 0062: AYANEO WT0600 2K panel
CONFIG_DRM_PANEL_AR14=y                # 0063: AR14 144Hz panel (KONKR ayaneo,ar14-144hz)

# --- Input — bring-up step 5 ---
CONFIG_INPUT_EVDEV=y

# --- Remoteproc / DSPs (adsp, cdsp) — needed for audio (step 7) + GPU zap ---
CONFIG_REMOTEPROC=y
CONFIG_QCOM_Q6V5_COMMON=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_SYSMON=y
CONFIG_RPMSG=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y

# --- Power / regulators / SPMI PMIC ---
CONFIG_SPMI=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_QCOM_RPMH=y

# --- Thermal — bring-up step 8 ---
CONFIG_THERMAL=y
CONFIG_QCOM_TSENS=y
CONFIG_CPU_THERMAL=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y

# --- Filesystems for immutable A/B (Phase 4) ---
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_OVERLAY_FS=y
CONFIG_EROFS_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
