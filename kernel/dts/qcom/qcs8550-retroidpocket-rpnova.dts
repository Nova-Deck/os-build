/dts-v1/;

#include "qcs8550-retroidpocket-rp6.dts"

/ {
	model = "Retroid Pocket Nova";
	compatible = "retroidpocket,rpnova", "qcom,qcs8550", "qcom,sm8550";
};

/*
 * 4.5" 1280x960 (4:3) panel on an Ilitek IL97680A, wired NATIVE LANDSCAPE — unlike
 * the RP6's portrait VTDR6130, so the inherited rotation = <270> must go or the
 * compositor would rotate an already-landscape scanout.
 */
&mdss_dsi0 {
	panel@0 {
		compatible = "il97680a,rpnova";
		/delete-property/ rotation;
	};
};

/* Landscape digitizer: same axis order as the panel, so no Y inversion either. */
&i2c_hub_3 {
	touchscreen@38 {
		touchscreen-size-x = <1280>;
		touchscreen-size-y = <960>;
		/delete-property/ touchscreen-inverted-y;
	};
};

/*
 * The Nova's left stick reports both axes mirrored relative to the RP6 it inherits
 * from, so flip X and Y back in the driver. The right stick is already correct —
 * do NOT add invert-rx/invert-ry.
 *
 * Both analog triggers idle a little above zero, which reads as permanently
 * half-pulled; a deadzone of 100 (axis-range is 1024) swallows the rest offset
 * without eating usable travel.
 */
&gamepad {
	invert-x;
	invert-y;
	trigger-left-deadzone = <100>;
	trigger-right-deadzone = <100>;
};
