/dts-v1/;

#include "qcs8550-retroidpocket-rp6.dts"

/ {
	model = "Retroid Pocket Nova";
	compatible = "retroidpocket,rpnova", "qcom,qcs8550", "qcom,sm8550";
};

/* The panel sets its own brightness over DCS; the RP6's PWM backlight is not wired. */
&backlight {
	status = "disabled";
};

/* The panel's 2.8V rail is enabled from GPIO 143 here, not the RP6's 142. */
&vdd_disp_2v8 {
	gpio = <&tlmm 143 GPIO_ACTIVE_HIGH>;
};

/*
 * 4.5" 1280x960 (4:3) command-mode panel on an Ilitek IL97680A, wired NATIVE
 * LANDSCAPE — unlike the RP6's portrait VTDR6130, so the inherited rotation = <270>
 * must go or the compositor would rotate an already-landscape scanout.
 */
&mdss_dsi0 {
	panel@0 {
		compatible = "retroidpocket,rpnova-panel";
		/delete-property/ backlight;
		/delete-property/ avdd-supply;

		vdd-supply = <&vreg_l11b_1p2>;
		vddio-supply = <&vreg_l12b_1p8>;
		vci-supply = <&vreg_l13b_3p0>;
		vdd18-supply = <&vdd_disp_1v8>;
		vdd28-supply = <&vdd_disp_2v8>;

		rotation = <0>;
	};
};

/* Landscape digitizer: same axis order as the panel, so no Y inversion either. */
&i2c_hub_3 {
	touchscreen@38 {
		touchscreen-size-x = <1280>;
		touchscreen-size-y = <960>;
		/delete-property/ touchscreen-inverted-y;
	};
};

/*
 * The Nova's left stick reports both axes mirrored relative to the RP6 it inherits
 * from, so flip X and Y back in the driver. The right stick is already correct —
 * do NOT add invert-rx/invert-ry.
 *
 * Both analog triggers idle a little above zero, which reads as permanently
 * half-pulled; a deadzone of 100 (axis-range is 1024) swallows the rest offset
 * without eating usable travel.
 */
&gamepad {
	invert-x;
	invert-y;
	trigger-left-deadzone = <100>;
	trigger-right-deadzone = <100>;
};
