# novadeck kernel config fragment — SM8650 (Snapdragon 8 Gen 3)
#
# Merge onto an arm64 base (e.g. mainline `defconfig`) with:
#   scripts/kconfig/merge_config.sh -m arch/arm64/configs/defconfig kernel/config/sm8650.config
#
# STATUS: validated against linux 7.0.11 (see kernel/SOURCE.pin) on 2026-06-17;
# source bumped to 7.1.3 on 2026-07-12, then 7.1.5 on 2026-07-25 (rebuilt + HW-validated),
# then 7.1.6 on 2026-08-03 (all 356 symbols re-checked against the patched tree, no corrections).
# All symbols below exist in that tree EXCEPT where explicitly noted as a gap.

# --- Page size: 4K REQUIRED for FEX-Emu / x86 game compat (Phase 3) ---
CONFIG_ARM64_4K_PAGES=y
# CONFIG_ARM64_16K_PAGES is not set
# CONFIG_ARM64_64K_PAGES is not set

# ============== Gaming performance (scheduler / memory / sync) ==============
CONFIG_UCLAMP_TASK=y                         # per-game cpu.uclamp.min floor (no consumer yet)
CONFIG_UCLAMP_TASK_GROUP=y

# --- sched_ext: BPF-programmable scheduler class (userspace schedulers: packages/scx-scheds) ---
# Dependency chain, verified against the pinned tree — every link must hold or the whole block is
# silently dropped by merge_config (it warns, it does NOT fail the build):
#   kernel/Kconfig.preempt:171  SCHED_CLASS_EXT depends on BPF_SYSCALL && BPF_JIT && DEBUG_INFO_BTF
#   lib/Kconfig.debug:398       DEBUG_INFO_BTF  depends on !DEBUG_INFO_REDUCED && PAHOLE_VERSION >= 122
# The arm64 defconfig sets DEBUG_INFO_REDUCED=y, so clearing it here is LOAD-BEARING, not tidying.
# PAHOLE_VERSION comes from `dwarves` in build/Dockerfile; without it the symbol resolves to 0.
# Cost: the pahole BTF pass slows the kernel build and grows Image. Verify after a config merge
# with `grep -E 'SCHED_CLASS_EXT|DEBUG_INFO_BTF' work/kernel/linux-*/.config` — both must be =y.
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_SCHED_CLASS_EXT=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y                   # no BPF interpreter; JIT or fail (upstream scx guidance)
CONFIG_BPF_JIT_DEFAULT_ON=y
CONFIG_PERF_EVENTS=y
# scx_lavd traces futex calls to grant the lock holder an extra slice (avoiding lock-holder
# preemption). Upstream's kernel.config: lavd tries ftrace first and falls back to a tracepoint,
# so this is a latency optimisation, not a hard dep — but it is the reason we ship lavd. FTRACE
# is off in the arm64 defconfig, so it has to be asked for explicitly. FTRACE is the menu gate
# (kernel/trace/Kconfig:211 `if FTRACE`) and defconfig's `# CONFIG_FTRACE is not set` beats its
# `default y if DEBUG_KERNEL`, so without the gate the two below are silently dropped.
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
# lavd's fallback when the fexit attach fails: SEC("?tracepoint/syscalls/sys_enter_futex") in
# scheds/rust/scx_lavd/src/bpf/lock.bpf.c. Those are SYSCALL tracepoints, gated by FTRACE_SYSCALLS
# — without it there is no second chance and futex boosting just goes quiet.
CONFIG_FTRACE_SYSCALLS=y
CONFIG_NTSYNC=y                              # Proton NT sync; off in arm64 defconfig
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y                     # bare LRU_GEN only builds MGLRU, this enables it
CONFIG_LRU_GEN_WALKS_MMU=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y        # not defconfig's ALWAYS, which bloats FEX RAM

# --- zram: compressed swap in RAM (fs-overlay/usr/lib/systemd/zram-generator.conf) ---
# The device shipped with NO swap device: CONFIG_SWAP was on (defconfig) but nothing provided a
# device, so the kernel's only response to an anonymous-memory spike was to OOM. That is a poor
# trade on a target that spans 8 GB SKUs and runs x86 titles under FEX/Proton. No disk is involved
# — the root is read-only and the only bulk storage is an SD card, where a swap FILE would be both
# slow and a wear problem.
#
# It also makes an already-shipped knob real: 60-novadeck-gaming.conf sets vm.swappiness=180, which
# does nothing without a swap device.
#
# =y not =m, deliberately: the generator brings zram0 up inside early boot (swap.target), and our
# initramfs is hand-rolled with no module loading of its own, so a module here is one more ordering
# dependency for no benefit. zsmalloc is zram's allocator (it selects it, but state it so a config
# diff shows what is being pulled in). Only the zstd backend is built — the generator config asks
# for zstd and nothing asks for lzo/lz4, so the others are dead weight in the Image.
#
# ZRAM_BACKEND_ZSTD *and* ZRAM_DEF_COMP_ZSTD are both needed and they are not the same thing: the
# backend compiles the algorithm in, the DEF_COMP picks what an un-configured device uses. Without
# the backend, ZRAM_BACKEND_FORCE_LZO turns itself on (drivers/block/zram/Kconfig: def_bool when no
# other backend is selected) and the generator's `compression-algorithm = zstd` fails at runtime.
# build.sh asserts CONFIG_ZRAM=y survived olddefconfig; the failure is otherwise silent — no zram0,
# no swap, no error in the log.
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y

# --- CPU frequency governors ---
# novadeck-powerd's power profiles ask for `cpu_governor=schedutil` (eco + balanced, see
# fs-overlay/usr/share/novadeck/power-profiles.conf). schedutil is the right choice for a
# per-cluster mobile SoC: it drives frequency from the scheduler's own utilisation signal instead
# of sampling load like ondemand. It must be asked for EXPLICITLY here: the parity block below
# sets CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y, and nothing in the base config brings
# GOV_SCHEDUTIL along on its own (only DEFAULT_GOV_SCHEDUTIL would `select` it).
# Measured on 192.168.1.211 (7.1.5) before this line existed: scaling_available_governors was
# `ondemand userspace powersave performance` — no schedutil — so write_governor()
# (fs-overlay/usr/bin/novadeck-powerd) hit its documented preferred -> schedutil -> ondemand
# fallback and eco + balanced both silently landed on ondemand, making them identical at the
# governor level. Verify after a config merge:
#   grep CPU_FREQ_GOV_SCHEDUTIL work/kernel/linux-*/.config
# and on the device: cat /sys/devices/system/cpu/cpufreq/policy0/scaling_available_governors
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y

CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# --- Platform core ---
CONFIG_ARCH_QCOM=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_SOCINFO=y
CONFIG_MAILBOX=y
CONFIG_QCOM_APCS_IPC=y
CONFIG_QCOM_IPCC=y
CONFIG_PINCTRL_MSM=y

# --- Clocks / interconnect / pinctrl (SM8650) ---
CONFIG_COMMON_CLK_QCOM=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_QCOM_CLK_SMD_RPM=y
CONFIG_SM_GCC_8650=y
# SM8650 reuses the SM8550 display clock controller — there is no separate _8650 dispcc
# upstream (symbols jump 8550 -> 8750 in 7.0.11).
CONFIG_SM_DISPCC_8550=y
CONFIG_SM_GPUCC_8650=y
CONFIG_SM_TCSRCC_8650=y
CONFIG_PINCTRL_SM8650=y
CONFIG_PINCTRL_LPASS_LPI=m
CONFIG_PINCTRL_SM8650_LPASS_LPI=m
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SM8650=y

# --- Clocks / interconnect / pinctrl (SM8550, Snapdragon 8 Gen 2 — Odin2 / Pocket ACE
# family, Adreno 740). Unified tree also carries these SoCs; they reuse the DISPCC_8550
# + VIDEOCC_8550 controllers already enabled above (SM8650 borrows the 8550 dispcc, so
# the symbol was present before SM8550 boards existed). LPASS_LPI pinctrl is =m to match
# the SM8650 LPASS block (loaded from rootfs, not needed at early boot). ---
CONFIG_SM_GCC_8550=y
CONFIG_SM_GPUCC_8550=y
CONFIG_SM_TCSRCC_8550=y
CONFIG_SM_CAMCC_8550=y
CONFIG_PINCTRL_SM8550=y
CONFIG_PINCTRL_SM8550_LPASS_LPI=m
CONFIG_INTERCONNECT_QCOM_SM8550=y

# --- Serial console (Qualcomm GENI) — bring-up step 1 (UART) ---
CONFIG_QCOM_GENI_SE=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y

# --- Storage (UFS) — bring-up step 2 ---
CONFIG_SCSI=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y

# --- USB — bring-up step 3 ---
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_PHY_SNPS_EUSB2=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y
CONFIG_TYPEC=y
CONFIG_TYPEC_QCOM_PMIC=y

# --- PCIe power control ---
# The Renesas μPD720201 PCIe USB3.0 host controller (gamepad hub) is powered via the
# generic PCI power-sequencing driver, which drives the avdd33/vdd10/vdd33 fixed
# regulators declared on its DT node (kernel/dts/qcom/sm8650-ayaneo-common.dtsi,
# &pcie1_port0). Built-in (=y) — no initramfs, so it must be present before the bus
# enumerates. Replaces the older _SLOT power-control path.
CONFIG_PCI_PWRCTRL_GENERIC=y

# --- Display + GPU (MSM DRM kernel; Turnip Vulkan in userspace) — steps 4 & 6 ---
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_GPU_STATE=y
CONFIG_DRM_MSM_KMS=y
CONFIG_DRM_MSM_KMS_FBDEV=y
CONFIG_DRM_MSM_MDSS=y
CONFIG_DRM_MSM_MDP4=y
CONFIG_DRM_MSM_MDP5=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DP=y
CONFIG_DRM_MSM_DSI=y
# SM8650 DSI PHY is the 4nm variant, handled by the 7nm PHY driver
# (dsi_phy_4nm_8650_cfgs lives in dsi_phy_7nm.c). Other variants are dead weight.
# CONFIG_DRM_MSM_DSI_28NM_PHY is not set
# CONFIG_DRM_MSM_DSI_20NM_PHY is not set
# CONFIG_DRM_MSM_DSI_28NM_8960_PHY is not set
# CONFIG_DRM_MSM_DSI_14NM_PHY is not set
# CONFIG_DRM_MSM_DSI_10NM_PHY is not set
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_DRM_MSM_HDMI=y
CONFIG_DRM_MSM_HDMI_HDCP=y
CONFIG_PHY_QCOM_QMP_COMBO=y
# DRM_MSM 'depends on FOO || FOO=n' for these optional blocks, so a =m FOO caps
# DRM_MSM (and the KMS/DISPLAY helpers it selects) at =m — which makes a built-in
# (=y) panel fail to link. LLCC + AOSS_QMP are real SM8650 blocks -> force =y. OCMEM
# is an older-SoC on-chip-memory block absent on SM8650 -> disable it (=n also
# satisfies the dependency) instead of building a useless =m driver that caps DRM_MSM.
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_AOSS_QMP=y
# CONFIG_QCOM_OCMEM is not set
# (The KMS/DISPLAY/DSC helper libs the =y panels link against are pulled in by the
# panel drivers' own `select`s — see kernel/patches/0067 — not forced here.)
# Framebuffer console on the panel: with no UART hooked up, the screen is the only
# boot/debug console, so paint the kernel log on it (fbcon over DRM fbdev emulation)
# from early in boot rather than relying on userspace.
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# --- Handheld panels / backlight / panel-power (from kernel/patches/0060-0068) ---
# (CONFIG_REGULATOR core lives in the Power / regulators section below.)
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_SY7758=y              # 0062: Silergy SY7758 backlight (I2C)
CONFIG_BACKLIGHT_ODIN2MINI=y           # 0060: AYN Odin2 Mini backlight (I2C)
CONFIG_REGULATOR_SGM3804=y             # 0065: SGM3804 panel-power regulator (I2C)
# The SY7758 backlight + SGM3804 panel-power regulator sit on a GENI I2C bus, so the
# I2C host controller MUST be built-in too — defconfig ships it =m, which leaves no
# I2C bus at boot, the regulator/backlight never probe, and the panel stays black.
CONFIG_I2C_QUP=y
CONFIG_I2C_QCOM_GENI=y
# Panels are =y, not =m: with the screen as the only console the display must come up
# from the kernel itself (a =m panel can't bind until the rootfs mounts + modprobe
# runs). DRM_MSM=y already select's the KMS/DISPLAY/MIPI-DSI helpers =y, so =y is fine.
CONFIG_DRM_PANEL_AYANEO_WT0600_2K=y    # 0066: AYANEO WT0600 2K panel
CONFIG_DRM_PANEL_AR14=y                # 0067: AR14 144Hz panel
# SM8550 handheld panels (=y for the same no-initramfs reason as above). Board map:
# AR06=Pocket ACE, AR02=Pocket DMG, AR11=Pocket DS, WT0600_1K=Pocket S 1K, TD4328=Odin2,
# XM91080G=Odin2 Mini, VTDR6130_COG=Retroid Pocket 6, ILITEK_IL97680A=Retroid Pocket
# Nova; ICNA35XX(icna3512/icna3520) covers
# Pocket DS/EVO + Odin2 Portal + Thor. Pocket S 2K (ayaneo,wt0600-2k) reuses the existing
# DRM_PANEL_AYANEO_WT0600_2K=y enabled above, so it needs no symbol here.
# Drivers from kernel/patches/0051,0052,0054,0056-0059,0068,0104,0105.
CONFIG_DRM_PANEL_AR06_4INCH=y          # 0051: Pocket ACE
CONFIG_DRM_PANEL_AR02_3INCH=y          # 0052: Pocket DMG
CONFIG_DRM_PANEL_AR11_5INCH=y          # 0054: Pocket DS
CONFIG_DRM_PANEL_SYNAPTICS_TD4328=y    # 0056: Synaptics TD4328
CONFIG_DRM_PANEL_BOE_XM91080G=y        # 0057: Xm-Plus XM91080G
CONFIG_DRM_PANEL_CHIPONE_ICNA35XX=y    # 0058: ChipOne ICNA35XX
CONFIG_DRM_PANEL_DDIC_CH13726A=y       # 0059: DDIC CH13726A
CONFIG_DRM_PANEL_AYANEO_WT0600_1K=y    # 0068: AYANEO WT0600 1K
CONFIG_DRM_PANEL_VISIONOX_VTDR6130_COG=y # 0104: Retroid Pocket 6
CONFIG_DRM_PANEL_ILITEK_IL97680A=y     # 0105: Retroid Pocket Nova

# --- Input — bring-up step 5 ---
CONFIG_INPUT_EVDEV=y
# ChipOne ICNL9922C TDDI touchscreen (KONKR Pocket FIT) — in-tree via
# kernel/patches/0069. Sits on I2C4 @ 0x48 (see the board .dts touch node).
#
# =m, NOT =y. This is a TDDI part: the controller has no rail of its own, it is
# powered by the PANEL rails (the .dts touch node declares no supply for exactly
# that reason). Built-in, its probe runs from the initcall at ~0.97s — the msm
# DRM panel driver does not bind until ~19.8s, so the controller is unpowered,
# every I2C write returns -110, and the driver's three 5.1s retries burn ~18.6s
# of boot before failing the probe -19. That is BOTH the dead touchscreen and
# the bulk of the 20.9s "kernel" phase: nothing after it in initcall order
# (PCIe, UFS, DRM) probes until it gives up.
#
# ROCKNIX ships this driver as an out-of-tree .ko (packages/linux-drivers/
# chipone_tddi, PKG_IS_KERNEL_PKG) and touch works there on identical DTS —
# udev autoloads it via MODULE_DEVICE_TABLE(of) once userspace is up and the
# panel is powered. =m buys us that same ordering.
#
# This is ROCKNIX parity, not a root fix: the driver still has no power or
# ordering dependency, so it is timing that saves it, not a guarantee. The real
# fix is to make the probe defer (declare the panel supply / return
# -EPROBE_DEFER on the -110) instead of dying permanently on first failure.
CONFIG_TOUCHSCREEN_CHIPONE_TDDI=m
# Synaptics DSX touchscreen (AYANEO Pocket ACE, syna,dsx over I2C) — out-of-tree driver
# added by kernel/patches/0063+0064-input-touchscreen-add-synaptics-dsx-*. =y: touch must come
# up from the kernel (no initramfs/modprobe). Other SM8550 touch controllers reuse in-tree
# drivers already =y: RMI4_I2C (Odin2 syna,rmi4-i2c), EDT_FT5X06 (focaltech,ft5426 —
# Pocket EVO / RP6), GOODIX (gt911), HYNITRON_CSTXXX (Odin2 Mini cst340).
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX=y

# --- GPIO expander + fan (SM8550 handhelds) ---
# AYANEO Pocket DS drives its panel enable/reset lines through a TI TCA6408 I2C GPIO
# expander (gpio-pca953x driver owns ti,tca6408 — ROCKNIX enables the same symbol); the
# AYN and AYANEO Pocket boards cool with a pwm-fan. Both =y so they bind at early boot
# without an initramfs (the expander gates panel power, so it must be up before DRM).
CONFIG_GPIO_PCA953X=y
CONFIG_SENSORS_PWM_FAN=y

# --- Non-essential SM8550 peripherals (=m) ---
# These don't gate boot or display, so build them as modules and let udev/modprobe load
# them once the rootfs is mounted (novadeck already ships =m drivers, e.g. the DSPs).
# ROCKNIX builds them =y; we deliberately demote to =m. Drivers from kernel/patches/
# 0031,0033,0034,1000 (+1002/1003 fixes; the audio patches 0036/0047/0200 only extend the
# already-=y aw88166/wcd938x/sc8280xp code, so they need no new symbol).
CONFIG_SERIAL_DEV_BUS=y                 # serdev bus RSInput sits on (framework, =y)
CONFIG_JOYSTICK_RSINPUT=m               # 0031: AYN/Retroid UART gamepad (+1003 force-feedback)
CONFIG_LEDS_HTR3212=m                   # 0033: HEROIC HTR3212 I2C LED controller
CONFIG_PWM_SN3112=m                     # 0034: SI-EN SN3112 I2C PWM RGB LED
CONFIG_INPUT_QCOM_HV_HAPTICS=m          # 1000: QTI HV haptics (+1002 sine/fixes)

# --- Remoteproc / DSPs (adsp, cdsp) — needed for audio (step 7) + GPU zap ---
# REMOTEPROC/RPMSG are bool framework symbols (stay =y); the DSP drivers are built
# as loadable modules (=m) so they load from the rootfs after mount, not embedded.
CONFIG_REMOTEPROC=y
CONFIG_QCOM_Q6V5_COMMON=m
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_SYSMON=m
CONFIG_RPMSG=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y

# --- Power / regulators / SPMI PMIC ---
CONFIG_SPMI=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_QCOM_RPMH=y

# --- Thermal — bring-up step 8 ---
CONFIG_THERMAL=y
CONFIG_QCOM_TSENS=y
CONFIG_CPU_THERMAL=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y

# --- Filesystems for immutable A/B (Phase 4) ---
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_OVERLAY_FS=y
CONFIG_EROFS_FS=y
# EROFS_FS alone mounts only UNCOMPRESSED images. The FEX x86 guest rootfs is compressed (LZ4 --
# its superblock sets no COMPR_CFGS bit, so LZ4 is the only algorithm in play), and it is mounted
# read-only to serve as the Steam graphics provider at /usr/share/guestos/fex-mesa. Without ZIP the
# mount fails outright. It happens to be =y by defconfig default today; state it, because the
# default is not a guarantee and the failure is a quiet one (both fstab entries carry nofail).
CONFIG_EROFS_FS_ZIP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y

# --- dm-verity, for RAUC's `format=verity` bundles (Phase 4b) ---
# images/rauc/manifest.raucm.in declares format=verity: `rauc install` loop-mounts the bundle
# behind a dm-verity mapping and refuses to read a byte that does not hash to the manifest's
# root hash. Built IN, not =m: rauc runs from the sealed read-only root, and a module on the
# update path is one more thing that can be missing at the exact moment an update is applied.
# arm64 defconfig ships BLK_DEV_DM=m and no DM_VERITY at all, so all four lines are ours.
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_BUFIO=y
CONFIG_DM_VERITY=y

# --- The ESP is on the boot path now, so declare what reads it (Phase 4b) ---
# images/initramfs/init mounts PARTLABEL=NOVADECK-ESP (vfat) to read the A/B slot state before
# it picks a root. VFAT_FS, its two NLS tables and BLK_DEV_LOOP (rauc loop-mounts the bundle)
# are all set today ONLY by inheritance from arm64 defconfig -- i.e. nothing in this repo asks
# for them. A defconfig bump could drop any of them and the sole symptom would be that every
# boot silently takes the cmdline fallback path instead of reading its slot state. Declare them.
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_BLK_DEV_LOOP=y

# --- Wireless stack: MODULES on purpose (do NOT let the parity block below reclaim these) ---
# cfg80211 must not be built in. Built-in, it runs at kernel init and fires its request_firmware
# for regulatory.db long before any rootfs exists, so the load always fails:
#   faux_driver regulatory: Direct firmware load for regulatory.db failed with error -2
#   cfg80211: failed to load regulatory.db
# even though /usr/lib/firmware/regulatory.db IS shipped. As a module it loads via udev after the
# root is mounted and the db resolves normally. mac80211 follows it (it depends on cfg80211, so it
# cannot stay built-in once cfg80211 is =m), and ath12k -- the actual WCN7850 driver -- is already
# =m and loads fine from the real root. Nothing here is needed at early boot: root is on SD/mmc.
# The parity block below is auto-generated from a BASE_CONFIG diff and swept these in as a
# side effect; they are NOT early-boot platform drivers, so keep them out of it on regeneration.
CONFIG_CFG80211=m
CONFIG_MAC80211=m

# === Built-in platform-driver parity (auto-generated 2026-06-19, BASE_CONFIG diff) ===
# novadeck has NO initramfs, so any =m platform driver never loads at early boot.
# defconfig builds these as modules (or omits them); the BASE_CONFIG builds them in. Without
# this block the kernel dies before fan/LED control (e.g. LEDS_QCOM_LPG, QCOM_PMIC_GLINK,
# QCOM_PD_MAPPER, QCOM_GPI_DMA, PHY_QCOM_QMP_*). Forces these into the built-in set.
CONFIG_BACKLIGHT_PWM=y
CONFIG_BACKLIGHT_QCOM_WLED=y
CONFIG_BINFMT_MISC=y
CONFIG_BOOT_PRINTK_DELAY=y
CONFIG_BT_LE=y
CONFIG_BT_LE_L2CAP_ECRED=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CRYPTO_AES_ARM64_BS=y
CONFIG_CRYPTO_BLAKE2B=y
CONFIG_CRYPTO_CRC32=y
CONFIG_CRYPTO_CRC32C=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_DEV_QCE=y
CONFIG_CRYPTO_DEV_QCOM_RNG=y
CONFIG_CRYPTO_ECC=y
CONFIG_CRYPTO_ECDH=y
CONFIG_CRYPTO_LIB_MD5=y
CONFIG_CRYPTO_MD4=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_NULL=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_RNG=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_XXHASH=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_FQ_CODEL=y
CONFIG_DEVFREQ_GOV_PERFORMANCE=y
CONFIG_DEVFREQ_GOV_POWERSAVE=y
CONFIG_DRM_DISPLAY_CONNECTOR=y
CONFIG_DRM_DISPLAY_DP_AUX_CHARDEV=y
CONFIG_DRM_LOAD_EDID_FIRMWARE=y
CONFIG_DRM_LONTIUM_LT8912B=y
CONFIG_DRM_PANEL_EDP=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_EFI_ZBOOT=y
CONFIG_EXFAT_FS=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_IOSTAT=y
CONFIG_F2FS_STAT_FS=y
# Unicode/NLS tables for casefold (+F) dirs — case-insensitive lookups so Proton/
# Windows games resolve mixed-case paths on the ext4 Steam library without a shim.
CONFIG_UNICODE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_FUSE_FS=y
CONFIG_FW_LOADER_DEBUG=y
CONFIG_HID_BATTERY_STRENGTH=y
CONFIG_HID_LOGITECH=y
CONFIG_HID_NINTENDO=y
CONFIG_HID_PLAYSTATION=y
CONFIG_HIDRAW=y
CONFIG_HID_SONY=y
