From: sunshineinabox <aqemail@gmail.com>
Date: Mon, 16 Nov 2026 20:30:00 +0000
Subject: [PATCH] soc: qcom: memlat: create the counters when a CPU comes online

The voter created its perf events once, in probe, and its hotplug
callbacks only stopped and restarted the sampling timer. Perf removes a
CPU's events from the CPU's context when the CPU goes offline and does
not put them back, so once a CPU had been offline its counters stood
still and it never voted again. The fake suspend on SM8650 and SM8750
takes CPUs 1-7 offline, so after the first sleep only CPU 0 voted.

Seen on the KONKR Pocket FIT Elite (2026-11-16): a memory load on CPU 7
raised the votes to 16896000 kBps before CPU 7 was cycled and to none
after, while CPU 0 and CPU 6 kept voting.

Create the events in the online callback and retire them in the offline
one, as the vendor's pmu_lib does. The release itself runs from a work,
outside the hotplug path, as the perf hardlockup detector does it. A CPU
whose events cannot be created casts no vote and still comes up; at
probe, and when the sysfs switch turns the voter on, it fails the start.
---
 drivers/soc/qcom/memlat.c | 136 +++++++++++++++++++++++++++++++-------
 1 file changed, 111 insertions(+), 25 deletions(-)

diff --git a/drivers/soc/qcom/memlat.c b/drivers/soc/qcom/memlat.c
--- a/drivers/soc/qcom/memlat.c
+++ b/drivers/soc/qcom/memlat.c
@@ -80,6 +80,11 @@
 	ktime_t ts;
 	ktime_t prev_ts;
 	u32 mhz;
+	/* The events of the last offline, until reap releases them */
+	struct perf_event **dead;
+	struct work_struct reap;
+	/* Why this CPU has no counters, or 0 */
+	int err;
 };
 
 struct memlat {
@@ -202,7 +207,68 @@
 
 		bus->cur_khz = khz;
 		icc_set_bw(bus->path, 0, kBps_to_icc(khz * bus->width));
+	}
+}
+
+/*
+ * Perf drops a CPU's events when the CPU goes offline and does not bring
+ * them back, so the counters live from online to offline, not from probe.
+ * Releasing an event takes perf's context mutex: that is left to a work,
+ * outside the hotplug callbacks, as the perf hardlockup detector does.
+ */
+static void memlat_reap(struct work_struct *work)
+{
+	struct memlat_cpu *c = container_of(work, struct memlat_cpu, reap);
+	struct perf_event *ev;
+	u32 i;
+
+	for (i = 0; i < c->ml->num_evs; i++) {
+		ev = xchg(&c->dead[i], NULL);
+		if (ev)
+			perf_event_release_kernel(ev);
+	}
+}
+
+static void memlat_retire_events(struct memlat_cpu *c)
+{
+	struct perf_event *ev;
+	u32 i;
+
+	for (i = 0; i < c->ml->num_evs; i++) {
+		ev = xchg(&c->dead[i], c->ev[i]);
+		c->ev[i] = NULL;
+		/* Only when the CPU went down twice before one reap ran */
+		if (ev)
+			perf_event_release_kernel(ev);
+	}
+	queue_work(system_dfl_wq, &c->reap);
+}
+
+static int memlat_create_events(struct memlat *ml, struct memlat_cpu *c,
+				unsigned int cpu)
+{
+	struct perf_event_attr attr = {
+		.size = sizeof(attr),
+		.pinned = 1,
+	};
+	int ret;
+	u32 i;
+
+	for (i = 0; i < ml->num_evs; i++) {
+		attr.type = ml->events[i].type;
+		attr.config = ml->events[i].config;
+		c->ev[i] = perf_event_create_kernel_counter(&attr, cpu, NULL, NULL, NULL);
+		if (IS_ERR(c->ev[i])) {
+			ret = PTR_ERR(c->ev[i]);
+			c->ev[i] = NULL;
+			dev_err(ml->dev, "can't count event %u:%#llx on cpu%u: %d\n",
+				ml->events[i].type, ml->events[i].config, cpu, ret);
+			memlat_retire_events(c);
+			return ret;
+		}
 	}
+
+	return 0;
 }
 
 static int memlat_cpu_online(unsigned int cpu, struct hlist_node *node)
@@ -210,6 +276,19 @@
 	struct memlat *ml = hlist_entry_safe(node, struct memlat, node);
 	struct memlat_cpu *c = per_cpu_ptr(ml->cpus, cpu);
 
+	/* A CPU without counters casts no vote; that must not stop it coming up */
+	c->err = memlat_create_events(ml, c, cpu);
+	if (c->err)
+		return 0;
+
+	/* The new counters start from zero */
+	spin_lock_irq(&c->lock);
+	memset(c->cnt, 0, ml->num_evs * sizeof(*c->cnt));
+	memset(c->prev, 0, ml->num_evs * sizeof(*c->prev));
+	c->ts = ktime_get();
+	c->prev_ts = c->ts;
+	spin_unlock_irq(&c->lock);
+
 	timer_setup(&c->timer, memlat_sample, TIMER_DEFERRABLE | TIMER_PINNED);
 	c->timer.expires = jiffies + msecs_to_jiffies(MEMLAT_SAMPLE_MS);
 	add_timer_on(&c->timer, cpu);
@@ -220,12 +299,40 @@
 static int memlat_cpu_offline(unsigned int cpu, struct hlist_node *node)
 {
 	struct memlat *ml = hlist_entry_safe(node, struct memlat, node);
-
-	timer_shutdown_sync(&per_cpu_ptr(ml->cpus, cpu)->timer);
+	struct memlat_cpu *c = per_cpu_ptr(ml->cpus, cpu);
 
+	if (c->err)
+		return 0;
+
+	timer_shutdown_sync(&c->timer);
+	memlat_retire_events(c);
+
 	return 0;
 }
 
+/* Start sampling on every online CPU. A CPU that cannot count fails the start. */
+static int memlat_start(struct memlat *ml)
+{
+	unsigned int cpu;
+	int ret;
+
+	ret = cpuhp_state_add_instance(memlat_hp_state, &ml->node);
+	if (ret)
+		return ret;
+
+	cpus_read_lock();
+	for_each_online_cpu(cpu) {
+		ret = per_cpu_ptr(ml->cpus, cpu)->err;
+		if (ret)
+			break;
+	}
+	cpus_read_unlock();
+	if (ret)
+		cpuhp_state_remove_instance(memlat_hp_state, &ml->node);
+
+	return ret;
+}
+
 static int memlat_parse_mon(struct memlat *ml, struct device_node *np,
 			    struct memlat_mon *mon)
 {
@@ -373,7 +480,7 @@
 		return count;
 
 	if (enable) {
-		ret = cpuhp_state_add_instance(memlat_hp_state, &ml->node);
+		ret = memlat_start(ml);
 	} else {
 		cpuhp_state_remove_instance(memlat_hp_state, &ml->node);
 		cancel_work_sync(&ml->work);
@@ -399,9 +506,13 @@
 	for_each_possible_cpu(cpu) {
 		struct memlat_cpu *c = per_cpu_ptr(ml->cpus, cpu);
 
-		for (i = 0; c->ev && i < ml->num_evs; i++)
-			if (!IS_ERR_OR_NULL(c->ev[i]))
+		cancel_work_sync(&c->reap);
+		for (i = 0; c->ev && c->dead && i < ml->num_evs; i++) {
+			if (c->ev[i])
 				perf_event_release_kernel(c->ev[i]);
+			if (c->dead[i])
+				perf_event_release_kernel(c->dead[i]);
+		}
 	}
 	cancel_work_sync(&ml->work);
 	for (b = 0; b < ml->num_buses; b++) {
@@ -412,14 +523,9 @@
 
 static int memlat_probe(struct platform_device *pdev)
 {
-	struct perf_event_attr attr = {
-		.type = PERF_TYPE_RAW,
-		.size = sizeof(attr),
-		.pinned = 1,
-	};
 	struct device *dev = &pdev->dev;
 	struct memlat *ml;
-	int cpu, i, ret;
+	int cpu, ret;
 
 	ml = devm_kzalloc(dev, sizeof(*ml), GFP_KERNEL);
 	if (!ml)
@@ -432,6 +538,14 @@
 	if (!ml->cpus)
 		return -ENOMEM;
 
+	for_each_possible_cpu(cpu) {
+		struct memlat_cpu *c = per_cpu_ptr(ml->cpus, cpu);
+
+		c->ml = ml;
+		spin_lock_init(&c->lock);
+		INIT_WORK(&c->reap, memlat_reap);
+	}
+
 	ret = memlat_parse(ml);
 	if (ret)
 		goto err;
@@ -439,31 +553,18 @@
 	for_each_possible_cpu(cpu) {
 		struct memlat_cpu *c = per_cpu_ptr(ml->cpus, cpu);
 
-		c->ml = ml;
-		spin_lock_init(&c->lock);
 		c->ev = devm_kcalloc(dev, ml->num_evs, sizeof(*c->ev), GFP_KERNEL);
+		c->dead = devm_kcalloc(dev, ml->num_evs, sizeof(*c->dead), GFP_KERNEL);
 		c->cnt = devm_kcalloc(dev, ml->num_evs, sizeof(*c->cnt), GFP_KERNEL);
 		c->prev = devm_kcalloc(dev, ml->num_evs, sizeof(*c->prev), GFP_KERNEL);
 		c->ipm = devm_kcalloc(dev, ml->num_buses, sizeof(*c->ipm), GFP_KERNEL);
-		if (!c->ev || !c->cnt || !c->prev || !c->ipm) {
+		if (!c->ev || !c->dead || !c->cnt || !c->prev || !c->ipm) {
 			ret = -ENOMEM;
 			goto err;
 		}
-
-		for (i = 0; i < ml->num_evs; i++) {
-			attr.type = ml->events[i].type;
-			attr.config = ml->events[i].config;
-			c->ev[i] = perf_event_create_kernel_counter(&attr, cpu, NULL, NULL, NULL);
-			if (IS_ERR(c->ev[i])) {
-				ret = dev_err_probe(dev, PTR_ERR(c->ev[i]),
-						    "can't count event %u:%#llx on cpu%d\n",
-						    ml->events[i].type, ml->events[i].config, cpu);
-				goto err;
-			}
-		}
 	}
 
-	ret = cpuhp_state_add_instance(memlat_hp_state, &ml->node);
+	ret = memlat_start(ml);
 	if (ret)
 		goto err;
 
-- 
2.47.3

