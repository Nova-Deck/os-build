From: sunshineinabox <aqemail@gmail.com>
Date: Tue, 22 Sep 2026 09:27:40 -0700
Subject: [PATCH] drm/msm/dpu: make the detail enhancer and directional filter tunable

Expose the QSEED detail enhancer and directional filter settings as msm
module parameters so they can be tuned live instead of
recompiling. Values are clamped to their register fields.

msm is built in, so they are msm.dpu_de_* on the kernel command line and
/sys/module/msm/parameters/dpu_de_* at runtime (0644, read on the next
atomic commit that programs the scaler).

  dpu_de            master switch for the enhancer (default on)
  dpu_de_dir        direction filter on scaled planes (default on)
  dpu_de_dir_weight 0..255
  dpu_de_sharpen1/2, _clip, _limit, _thr_quiet, _thr_dieout, _thr_low,
  _thr_high, _prec_shift, _blend, _adjust_a/b/c[3]
                    the DE register block, field for field
  dpu_de_unscaled   also sharpen unscaled planes (default off). It applies
                    to any 1:1 plane on a VIG pipe outside multirect, and
                    it steers the PRIMARY plane onto a VIG pipe (out of
                    multirect) so there is a scaler to do it with; if no
                    VIG pipe is free that plane falls back to the plain
                    assignment.

DEFAULTS ARE NOT THE ORIGINAL AUTHOR'S. The patch as written changed every
enhancer value to a new "vendor" set and turned the direction filter off.
Here the defaults are 0350's working point, bit for bit, so this patch
changes no pixel until someone sets a parameter. The reason is provenance:
the downstream SDE driver has no DE defaults of its own -- it copies
whatever the Android composer hands it through the scaler_v2 property --
so the "vendor" set cannot be checked against any source in reach. It is
kept below as a ready-made profile to try:

  msm.dpu_de_dir=0 msm.dpu_de_sharpen1=12 msm.dpu_de_sharpen2=12
  msm.dpu_de_clip=4 msm.dpu_de_limit=3 msm.dpu_de_thr_quiet=0
  msm.dpu_de_thr_dieout=1023 msm.dpu_de_thr_low=40 msm.dpu_de_thr_high=512
  msm.dpu_de_prec_shift=4 msm.dpu_de_blend=15
  msm.dpu_de_adjust_a=102,0,-8 msm.dpu_de_adjust_b=0,16,32
  msm.dpu_de_adjust_c=0,0,-2

Merged by hand onto 0350: two hunks rewrite 0350's enhancer block, which
carries a comment the original's base does not. The resource-assignment
hunks applied unchanged.

NOT UPSTREAM.

ON HARDWARE 2026-09-29 (Pocket S2, QSEED 3.2 at 1.33x; Pocket Max, QSEED
3.0 at 1.5x): the parameters are live and dpu_de=0 reads as "slightly
softer" on both, with 0352's Catmull-Rom on. dmesg clean. The PR's profile
and dpu_de_unscaled were NOT exercised.

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_plane.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_plane.c
index e74cb014b..53e1ce925 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_plane.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_plane.c
@@ -430,16 +430,54 @@ static void _dpu_plane_set_qos_remap(struct drm_plane *plane,
 					       false, &forced_on);
 }
 
+static bool dpu_de = true;
+module_param(dpu_de, bool, 0644);
+static bool dpu_de_unscaled;
+module_param(dpu_de_unscaled, bool, 0644);
+static bool dpu_de_dir = true;
+module_param(dpu_de_dir, bool, 0644);
+static int dpu_de_dir_weight = 32;
+module_param(dpu_de_dir_weight, int, 0644);
+static int dpu_de_sharpen1 = 8;
+module_param(dpu_de_sharpen1, int, 0644);
+static int dpu_de_sharpen2 = 8;
+module_param(dpu_de_sharpen2, int, 0644);
+static int dpu_de_clip;
+module_param(dpu_de_clip, int, 0644);
+static int dpu_de_limit = 4;
+module_param(dpu_de_limit, int, 0644);
+static int dpu_de_thr_quiet = 8;
+module_param(dpu_de_thr_quiet, int, 0644);
+static int dpu_de_thr_dieout = 256;
+module_param(dpu_de_thr_dieout, int, 0644);
+static int dpu_de_thr_low = 8;
+module_param(dpu_de_thr_low, int, 0644);
+static int dpu_de_thr_high = 64;
+module_param(dpu_de_thr_high, int, 0644);
+static int dpu_de_prec_shift = 2;
+module_param(dpu_de_prec_shift, int, 0644);
+static int dpu_de_blend;
+module_param(dpu_de_blend, int, 0644);
+static int dpu_de_adjust_a[DPU_MAX_DE_CURVES] = { 112, 112, 112 };
+module_param_array(dpu_de_adjust_a, int, NULL, 0644);
+static int dpu_de_adjust_b[DPU_MAX_DE_CURVES];
+module_param_array(dpu_de_adjust_b, int, NULL, 0644);
+static int dpu_de_adjust_c[DPU_MAX_DE_CURVES];
+module_param_array(dpu_de_adjust_c, int, NULL, 0644);
+
 static void _dpu_plane_setup_scaler3(struct dpu_hw_sspp *pipe_hw,
 		uint32_t src_w, uint32_t src_h, uint32_t dst_w, uint32_t dst_h,
 		struct dpu_hw_scaler3_cfg *scale_cfg,
 		const struct msm_format *fmt,
 		uint32_t chroma_subsmpl_h, uint32_t chroma_subsmpl_v,
-		unsigned int rotation)
+		unsigned int rotation, bool multirect)
 {
 	uint32_t i;
 	bool inline_rotation = rotation & DRM_MODE_ROTATE_90;
 
+	bool unscaled_de = dpu_de_unscaled && !multirect;
+	bool scaled;
+
 	/*
 	 * For inline rotation cases, scaler config is post-rotation,
 	 * so swap the dimensions here. However, pixel extension will
@@ -490,8 +528,10 @@ static void _dpu_plane_setup_scaler3(struct dpu_hw_sspp *pipe_hw,
 	 * feeds its output through QSEED, so the scaler has to stay programmed
 	 * (as a pass-through) whenever we rotate.
 	 */
-	if (!(MSM_FORMAT_IS_YUV(fmt)) && (src_h == dst_h)
-		&& (src_w == dst_w) && !inline_rotation)
+	scaled = src_w != dst_w || src_h != dst_h;
+
+	if (!(MSM_FORMAT_IS_YUV(fmt)) && !scaled && !inline_rotation &&
+	    !(dpu_de && unscaled_de))
 		return;
 
 	scale_cfg->dst_width = dst_w;
@@ -506,32 +546,35 @@ static void _dpu_plane_setup_scaler3(struct dpu_hw_sspp *pipe_hw,
 	/*
 	 * The direction filter and the detail enhancer only earn their power
 	 * when QSEED is really resampling. A rotated 1:1 RGB pipe keeps the
-	 * scaler on as a pass-through (see above) and must not be sharpened.
+	 * scaler on as a pass-through (see above) and is not sharpened unless
+	 * dpu_de_unscaled asks for it.
 	 *
-	 * The curve below is the hardware's own default working point: the
+	 * The curve defaults are the hardware's own default working point: the
 	 * enhancer adds back the high-frequency detail a bilinear upscale
 	 * loses, with thr_quiet/thr_dieout holding it off flat and noisy
-	 * regions so it sharpens edges rather than grain.
+	 * regions so it sharpens edges rather than grain. Every field is a
+	 * module parameter, clamped to its register width.
 	 */
-	if (src_w != dst_w || src_h != dst_h) {
-		scale_cfg->dir_en = 1;
-		scale_cfg->dir_weight = 32;
-
+	if (scaled) {
+		scale_cfg->dir_en = dpu_de_dir;
+		scale_cfg->dir_weight = clamp(dpu_de_dir_weight, 0, 255);
+	}
+	if (dpu_de && (scaled || unscaled_de)) {
 		scale_cfg->de.enable = 1;
-		scale_cfg->de.sharpen_level1 = 8;
-		scale_cfg->de.sharpen_level2 = 8;
-		scale_cfg->de.clip = 0;
-		scale_cfg->de.limit = 4;
-		scale_cfg->de.thr_quiet = 8;
-		scale_cfg->de.thr_dieout = 256;
-		scale_cfg->de.thr_low = 8;
-		scale_cfg->de.thr_high = 64;
-		scale_cfg->de.prec_shift = 2;
-		scale_cfg->de.blend = 0;
+		scale_cfg->de.sharpen_level1 = clamp(dpu_de_sharpen1, -256, 255);
+		scale_cfg->de.sharpen_level2 = clamp(dpu_de_sharpen2, -256, 255);
+		scale_cfg->de.clip = clamp(dpu_de_clip, 0, 7);
+		scale_cfg->de.limit = clamp(dpu_de_limit, 0, 15);
+		scale_cfg->de.thr_quiet = clamp(dpu_de_thr_quiet, 0, 255);
+		scale_cfg->de.thr_dieout = clamp(dpu_de_thr_dieout, 0, 1023);
+		scale_cfg->de.thr_low = clamp(dpu_de_thr_low, 0, 1023);
+		scale_cfg->de.thr_high = clamp(dpu_de_thr_high, 0, 1023);
+		scale_cfg->de.prec_shift = clamp(dpu_de_prec_shift, 0, 7);
+		scale_cfg->de.blend = clamp(dpu_de_blend, 0, 15);
 		for (i = 0; i < DPU_MAX_DE_CURVES; i++) {
-			scale_cfg->de.adjust_a[i] = 112;
-			scale_cfg->de.adjust_b[i] = 0;
-			scale_cfg->de.adjust_c[i] = 0;
+			scale_cfg->de.adjust_a[i] = clamp(dpu_de_adjust_a[i], -512, 511);
+			scale_cfg->de.adjust_b[i] = clamp(dpu_de_adjust_b[i], -512, 511);
+			scale_cfg->de.adjust_c[i] = clamp(dpu_de_adjust_c[i], -512, 511);
 		}
 	}
 }
@@ -597,7 +640,8 @@ static void _dpu_plane_setup_scaler(struct dpu_sw_pipe *pipe,
 			dst_height,
 			&scaler3_cfg, fmt,
 			info->hsub, info->vsub,
-			pipe_cfg->rotation);
+			pipe_cfg->rotation,
+			pipe->multirect_mode != DPU_SSPP_MULTIRECT_NONE);
 
 	/* configure pixel extension based on scalar config */
 	_dpu_plane_setup_pixel_ext(&scaler3_cfg, &pixel_ext,
@@ -1344,6 +1388,7 @@ static int dpu_plane_virtual_assign_resources(struct drm_crtc *crtc,
 	struct dpu_sw_pipe *pipe;
 	struct dpu_sw_pipe_cfg *pipe_cfg;
 	const struct msm_format *fmt;
+	bool unscaled_de;
 	int i, ret;
 
 	pstate = to_dpu_plane_state(plane_state);
@@ -1374,22 +1419,39 @@ static int dpu_plane_virtual_assign_resources(struct drm_crtc *crtc,
 
 	reqs.rot90 = drm_rotation_90_or_270(plane_state->rotation);
 
+
+	unscaled_de = dpu_de && dpu_de_unscaled && !reqs.scale && !reqs.yuv &&
+		plane->type == DRM_PLANE_TYPE_PRIMARY;
+
 	for (i = 0; i < STAGES_PER_PLANE; i++) {
-		if (prev_adjacent_pstate[i] &&
+		struct dpu_rm_sspp_requirements de_reqs = reqs;
+
+		bool want_scaler = unscaled_de &&
+			!drm_rect_width(&pstate->pipe_cfg[i * PIPES_PER_STAGE + 1].src_rect);
+
+		if (prev_adjacent_pstate[i] && !want_scaler &&
 		    dpu_plane_try_multirect_shared(pstate, prev_adjacent_pstate[i], fmt,
 						   dpu_kms->catalog->caps->max_linewidth,
 						   i))
 			continue;
 
-		if (dpu_plane_get_single_pipe_in_stage(pstate, &pipe, &pipe_cfg, i))
+		if (!want_scaler &&
+		    dpu_plane_get_single_pipe_in_stage(pstate, &pipe, &pipe_cfg, i))
 			prev_adjacent_plane_state[i] = plane_state;
 
 		pipe = &pstate->pipe[i * PIPES_PER_STAGE];
 		pipe_cfg = &pstate->pipe_cfg[i * PIPES_PER_STAGE];
+		de_reqs.scale = want_scaler;
 		ret = dpu_plane_assign_resource_in_stage(pipe, pipe_cfg,
 							 plane_state,
 							 global_state,
-							 crtc, &reqs);
+							 crtc, want_scaler ? &de_reqs : &reqs);
+
+		if (ret && want_scaler)
+			ret = dpu_plane_assign_resource_in_stage(pipe, pipe_cfg,
+								 plane_state,
+								 global_state,
+								 crtc, &reqs);
 		if (ret)
 			return ret;
 	}
