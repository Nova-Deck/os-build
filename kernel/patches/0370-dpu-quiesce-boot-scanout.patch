Subject: [PATCH v2] drm/msm/dpu: stop scanout before iommu attach

The bootloader may leave a continuous splash scanning out when the
kernel starts. arm-smmu-qcom preserves the bootloader's stream mapping
as BYPASS, so the scanout is still live and can cause iommu fault.

Precedent in prior drivers:
- mdp4_kms_init clears DTV/LCDC/DSI_ENABLE and waits a frame
    before msm_kms_init_vm
- mdp5_kms_init clears INTF_TIMING_ENGINE_EN on every interface
    and waits a frame before msm_kms_init_vm

---
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.c
index ac82b69..96aaed6 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.c
@@ -601,6 +601,34 @@ static void dpu_hw_intf_program_intf_cmd_cfg(struct dpu_hw_intf *intf,
 	DPU_REG_WRITE(&intf->hw, INTF_CONFIG2, intf_cfg2);
 }
 
+/*
+ * Stop a timing engine the bootloader left running and wait for it to go
+ * idle, as mdp4/mdp5 do before attaching the iommu. Runs before the INTF
+ * hw blocks are constructed, hence raw mmio.
+ */
+void dpu_hw_intf_stop_boot_scanout(void __iomem *mmio,
+				   const struct dpu_intf_cfg *cfg,
+				   const struct dpu_mdss_version *mdss_rev)
+{
+	void __iomem *base = mmio + cfg->base;
+	u32 val;
+
+	if (!readl_relaxed(base + INTF_TIMING_ENGINE_EN))
+		return;
+
+	writel_relaxed(0, base + INTF_TIMING_ENGINE_EN);
+
+	if (mdss_rev->core_major_ver >= 5) {
+		if (readl_poll_timeout(base + INTF_STATUS, val,
+				       !(val & BIT(0)), 1000, 50000))
+			DPU_ERROR("INTF_%d: boot scanout did not stop\n",
+				  cfg->id - INTF_0);
+	} else {
+		/* no INTF_STATUS before DPU 5.0, wait out a frame */
+		msleep(20);
+	}
+}
+
 /**
  * dpu_hw_intf_init() - Initializes the INTF driver for the passed
  * interface catalog entry.
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.h b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.h
index badd263..85ae28f 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.h
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_intf.h
@@ -132,4 +132,8 @@ struct dpu_hw_intf *dpu_hw_intf_init(struct drm_device *dev,
 				     void __iomem *addr,
 				     const struct dpu_mdss_version *mdss_rev);
 
+void dpu_hw_intf_stop_boot_scanout(void __iomem *mmio,
+				   const struct dpu_intf_cfg *cfg,
+				   const struct dpu_mdss_version *mdss_rev);
+
 #endif /*_DPU_HW_INTF_H */
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
index bab5090..0fc48cd 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
@@ -31,6 +31,7 @@
 #include "dpu_crtc.h"
 #include "dpu_encoder.h"
 #include "dpu_formats.h"
+#include "dpu_hw_intf.h"
 #include "dpu_hw_vbif.h"
 #include "dpu_kms.h"
 #include "dpu_hw_dspp.h"
@@ -1247,6 +1248,21 @@ static void _dpu_kms_reg_dma_resume(struct dpu_kms *dpu_kms)
 			dpu_hw_dspp_reg_dma_resume(to_dpu_hw_dspp(dpu_kms->rm.dspp_blks[i]));
 }
 
+static void dpu_kms_stop_boot_scanout(struct dpu_kms *dpu_kms)
+{
+	int i;
+
+	for (i = 0; i < dpu_kms->catalog->intf_count; i++) {
+		const struct dpu_intf_cfg *intf = &dpu_kms->catalog->intf[i];
+
+		if (intf->type == INTF_NONE)
+			continue;
+
+		dpu_hw_intf_stop_boot_scanout(dpu_kms->mmio, intf,
+					      dpu_kms->catalog->mdss_ver);
+	}
+}
+
 static int dpu_kms_hw_init(struct msm_kms *kms)
 {
 	struct dpu_kms *dpu_kms;
@@ -1286,6 +1302,11 @@ static int dpu_kms_hw_init(struct msm_kms *kms)
 		goto err_pm_put;
 	}
 
+	/* make sure things are off before attaching iommu, otherwise
+	 * the running scanout will fault once the iommu is attached.
+	 */
+	dpu_kms_stop_boot_scanout(dpu_kms);
+
 	/*
 	 * Now we need to read the HW catalog and initialize resources such as
 	 * clocks, regulators, GDSC/MMAGIC, ioremap the register ranges etc
