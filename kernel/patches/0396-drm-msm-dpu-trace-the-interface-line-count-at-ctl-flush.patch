From: Philippe Simons <simons.philippe@gmail.com>
Subject: [PATCH] drm/msm/dpu: trace the interface line count at CTL flush

DEBUG INSTRUMENT FOR ISSUE #110, NOT A FIX. Drop it once that issue closes.

Add dpu_enc_flush_line, which reads INTF_LINE_COUNT immediately before
and after ctl->ops.trigger_flush() and logs both with the mode's vtotal.
It runs after 0395's wait, so it shows where each flush really lands.
Pairing the master's and the slave's events is how 0395's mechanism was
found (an underrun follows a kickoff whose two flushes straddle the
programmable fetch start), and it is how to check that no pair straddles
it any more.

The existing dpu_kms_commit tracepoint fires well before the flush write,
so it cannot place the flush on a scan line.

The two register reads happen only while the event is enabled.

Also add msm.dpu_flush_guard (default on). Writing 0 to
/sys/module/msm/parameters/dpu_flush_guard skips 0395's wait, so the
underrun can be compared with and without the fix on one boot, in
interleaved legs, without a second card.

NOT UPSTREAM.

---
diff -ruN a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c	2026-10-06 12:25:36.095010231 +0200
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c	2026-10-06 13:14:56.378757514 +0200
@@ -1634,6 +1634,8 @@
 	struct dpu_encoder_virt *dpu_enc = to_dpu_encoder_virt(drm_enc);
 	struct dpu_hw_ctl *ctl;
 	int pending_kickoff_cnt;
+	bool trace_line;
+	u32 line_before = 0;
 	u32 ret = UINT_MAX;
 
 	if (!phys->hw_pp) {
@@ -1661,8 +1663,21 @@
 	if (extra_flush_bits && ctl->ops.update_pending_flush)
 		ctl->ops.update_pending_flush(ctl, extra_flush_bits);
 
+	trace_line = trace_dpu_enc_flush_line_enabled() && phys->hw_intf &&
+		     phys->hw_intf->ops.get_line_count;
+	if (trace_line)
+		line_before = phys->hw_intf->ops.get_line_count(phys->hw_intf);
+
 	ctl->ops.trigger_flush(ctl);
 
+	if (trace_line) {
+		u32 line_after = phys->hw_intf->ops.get_line_count(phys->hw_intf);
+
+		trace_dpu_enc_flush_line(DRMID(drm_enc), phys->hw_intf->idx,
+					 line_before, line_after,
+					 phys->cached_mode.vtotal);
+	}
+
 	if (ctl->ops.get_pending_flush)
 		ret = ctl->ops.get_pending_flush(ctl);
 
@@ -1774,6 +1789,10 @@
 	phys_enc->enable_state = DPU_ENC_ENABLED;
 }
 
+/* issue #110 A/B switch: 0 skips 0395's wait, so the underrun can be reproduced live */
+static bool dpu_flush_guard = true;
+module_param(dpu_flush_guard, bool, 0644);
+
 /**
  * _dpu_encoder_kickoff_phys - handle physical encoder kickoff
  *	Iterate through the physical encoders and perform consolidated flush
@@ -1798,7 +1817,8 @@
 	 * Wait once, on the master, so that the flushes of every interface
 	 * land on the same side of the programmable fetch start.
 	 */
-	if (dpu_enc->cur_master && dpu_enc->cur_master->ops.wait_flush_window)
+	if (dpu_flush_guard && dpu_enc->cur_master &&
+	    dpu_enc->cur_master->ops.wait_flush_window)
 		dpu_enc->cur_master->ops.wait_flush_window(dpu_enc->cur_master);
 
 	/* don't perform flush/start operations for slave encoders */
diff -ruN a/drivers/gpu/drm/msm/disp/dpu1/dpu_trace.h b/drivers/gpu/drm/msm/disp/dpu1/dpu_trace.h
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_trace.h	2026-10-06 12:25:36.095050326 +0200
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_trace.h	2026-10-06 13:14:56.379260106 +0200
@@ -454,6 +454,29 @@
 		  __entry->extra_flush_bits, __entry->pending_flush_ret)
 );
 
+TRACE_EVENT(dpu_enc_flush_line,
+	TP_PROTO(uint32_t drm_id, enum dpu_intf intf_idx, u32 line_before,
+		 u32 line_after, u32 vtotal),
+	TP_ARGS(drm_id, intf_idx, line_before, line_after, vtotal),
+	TP_STRUCT__entry(
+		__field(	uint32_t,	drm_id		)
+		__field(	enum dpu_intf,	intf_idx	)
+		__field(	u32,		line_before	)
+		__field(	u32,		line_after	)
+		__field(	u32,		vtotal		)
+	),
+	TP_fast_assign(
+		__entry->drm_id = drm_id;
+		__entry->intf_idx = intf_idx;
+		__entry->line_before = line_before;
+		__entry->line_after = line_after;
+		__entry->vtotal = vtotal;
+	),
+	TP_printk("id=%u intf_idx=%d line_before=%u line_after=%u vtotal=%u",
+		  __entry->drm_id, __entry->intf_idx, __entry->line_before,
+		  __entry->line_after, __entry->vtotal)
+);
+
 DECLARE_EVENT_CLASS(dpu_id_event_template,
 	TP_PROTO(uint32_t drm_id, u32 event),
 	TP_ARGS(drm_id, event),
