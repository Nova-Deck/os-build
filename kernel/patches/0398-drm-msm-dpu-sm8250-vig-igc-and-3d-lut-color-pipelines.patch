-		.sblk = &dpu_vig_sblk_qseed3_3_0,
+		.sblk = &dpu_vig_sblk_qseed3_3_0_sm8250,
 		.xin_id = 4,
 		.type = SSPP_TYPE_VIG,
 		.clk_ctrl = DPU_CLK_CTRL_VIG1,
