ASoC: qcom: sc8280xp: refcount the MI2S bit clock across all MI2S BEs

Delta on 0820: the card-level "i2s_clk" enable there covers only
PRIMARY_MI2S_RX (the AYN Odin2/Thor aw88166 path). The AYN Odin 3 routes
its amps over SECONDARY and the KONKR Pocket FIT Elite over QUATERNARY
MI2S, and without BCLK the aw88261 reports "check pll lock fail, cannot
start". Widen the enable to every MI2S BE and refcount it across the
links, keeping the PRIMARY-only DAI format setup as it was.

From ROCKNIX SM8750 0060 (Teguh Sobirin), rebased onto our 0820 which
already carries the clk handle, the optional devm_clk_get and the ops
wiring.

--- a/sound/soc/qcom/sc8280xp.c
+++ b/sound/soc/qcom/sc8280xp.c
@@ -21,6 +21,7 @@
 	struct snd_soc_jack jack;
 	struct snd_soc_jack dp_jack[8];
 	struct clk *i2s_clk;
+	int mi2s_clk_count;
 	bool jack_setup;
 };
 
@@ -76,12 +77,29 @@
 	struct sc8280xp_snd_data *pdata = snd_soc_card_get_drvdata(rtd->card);
 	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
 	struct snd_soc_dai *codec_dai = snd_soc_rtd_to_codec(rtd, 0);
+	int ret;
 
 	switch (cpu_dai->id) {
-	case PRIMARY_MI2S_RX:
-		clk_prepare_enable(pdata->i2s_clk);
-		snd_soc_dai_set_fmt(cpu_dai, fmt);
-		snd_soc_dai_set_fmt(codec_dai, codec_dai_fmt);
+	case PRIMARY_MI2S_RX...QUATERNARY_MI2S_TX:
+	case QUINARY_MI2S_RX...QUINARY_MI2S_TX:
+		/*
+		 * The MI2S bit clock (DT clock "i2s_clk", a q6prm clock) is
+		 * not managed by the DSP graph: without an explicit enable
+		 * the BE streams but no BCLK ever leaves the SoC and
+		 * BCLK-slaved speaker amps cannot lock their PLL. Refcounted
+		 * across the MI2S links, which share the one card clock.
+		 */
+		if (++pdata->mi2s_clk_count == 1) {
+			ret = clk_prepare_enable(pdata->i2s_clk);
+			if (ret) {
+				pdata->mi2s_clk_count--;
+				return ret;
+			}
+		}
+		if (cpu_dai->id == PRIMARY_MI2S_RX) {
+			snd_soc_dai_set_fmt(cpu_dai, fmt);
+			snd_soc_dai_set_fmt(codec_dai, codec_dai_fmt);
+		}
 		break;
 	default:
 		break;
@@ -97,8 +115,10 @@
 	struct sc8280xp_snd_data *pdata = snd_soc_card_get_drvdata(rtd->card);
 
 	switch (cpu_dai->id) {
-	case PRIMARY_MI2S_RX:
-		clk_disable_unprepare(pdata->i2s_clk);
+	case PRIMARY_MI2S_RX...QUATERNARY_MI2S_TX:
+	case QUINARY_MI2S_RX...QUINARY_MI2S_TX:
+		if (--pdata->mi2s_clk_count == 0)
+			clk_disable_unprepare(pdata->i2s_clk);
 		break;
 	default:
 		break;
