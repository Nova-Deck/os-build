From: Armada <noreply@armada.local>
Subject: [PATCH] ASoC: qcom: sc8280xp: restart SoundWire streams across system suspend

With a PCM open across system suspend, the stream is re-prepared on
resume, but qcom_snd_sdw_prepare() skips a SoundWire stream that is still
marked prepared. The stream is never enabled again after the bus went
through s2idle, and headphone audio comes back thin and distorted until
every stream is closed.

Disable and deprepare the prepared SoundWire streams in suspend_post, as
hw_free does, and prepare and enable them again in resume_pre. That runs
before the BE ports are restored and DAPM powers the codec, as on a fresh
prepare; enabling them only at the userspace re-prepare pops. A stream
that cannot be enabled yet is left to the userspace re-prepare.

Tested with a stream open across s2idle on AYN Odin 2 Portal (WCD9385)
and Odin 3 (WCD9395) headphones and KONKR Pocket FIT (WSA884x) speakers.

The original adds the two loops to suspend_post/resume_pre callbacks that
already gate an MI2S clock; this tree has no card suspend callbacks, so
they are added here and registered in probe.
---
 sound/soc/qcom/sc8280xp.c | 70 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 70 insertions(+)

diff --git a/sound/soc/qcom/sc8280xp.c b/sound/soc/qcom/sc8280xp.c
index 6183ade67..4bebc5107 100644
--- a/sound/soc/qcom/sc8280xp.c
+++ b/sound/soc/qcom/sc8280xp.c
@@ -76,6 +76,7 @@ struct qcom_snd_soc_common {
 
 struct sc8280xp_snd_data {
 	bool stream_prepared[AFE_PORT_MAX];
+	bool sdw_suspended[AFE_PORT_MAX];
 	struct snd_soc_card *card;
 	struct snd_soc_jack jack;
 	struct snd_soc_jack dp_jack[8];
@@ -389,6 +390,73 @@ static const struct snd_soc_ops sc8280xp_be_ops = {
 	.prepare = sc8280xp_snd_prepare,
 };
 
+/*
+ * A PCM held open across system suspend is re-prepared on resume, but
+ * qcom_snd_sdw_prepare() skips a SoundWire stream still marked prepared,
+ * so the stream is never enabled again after the bus went through s2idle
+ * and headphone audio comes back thin and distorted. Tear the prepared
+ * streams down here the way hw_free does.
+ */
+static int sc8280xp_snd_suspend_post(struct snd_soc_card *card)
+{
+	struct sc8280xp_snd_data *data = snd_soc_card_get_drvdata(card);
+	struct snd_soc_pcm_runtime *rtd;
+	int dir;
+
+	for_each_card_rtds(card, rtd) {
+		struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+
+		if (!cpu_dai || cpu_dai->id >= AFE_PORT_MAX ||
+		    !data->stream_prepared[cpu_dai->id])
+			continue;
+
+		for_each_pcm_streams(dir) {
+			struct snd_pcm_substream *ss = snd_soc_dpcm_get_substream(rtd, dir);
+
+			if (!ss || !data->stream_prepared[cpu_dai->id])
+				continue;
+			qcom_snd_sdw_hw_free(ss, &data->stream_prepared[cpu_dai->id]);
+			data->sdw_suspended[cpu_dai->id] = !data->stream_prepared[cpu_dai->id];
+		}
+	}
+
+	return 0;
+}
+
+/*
+ * Enable the torn-down streams again before the ports are restored and DAPM
+ * powers the codec, as a fresh prepare would; enabling them only at the
+ * userspace re-prepare pops. A stream that cannot be enabled yet is left to
+ * that re-prepare.
+ */
+static int sc8280xp_snd_resume_pre(struct snd_soc_card *card)
+{
+	struct sc8280xp_snd_data *data = snd_soc_card_get_drvdata(card);
+	struct snd_soc_pcm_runtime *rtd;
+	int dir;
+
+	for_each_card_rtds(card, rtd) {
+		struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+
+		if (!cpu_dai || cpu_dai->id >= AFE_PORT_MAX ||
+		    !data->sdw_suspended[cpu_dai->id])
+			continue;
+
+		data->sdw_suspended[cpu_dai->id] = false;
+		for_each_pcm_streams(dir) {
+			struct snd_pcm_substream *ss = snd_soc_dpcm_get_substream(rtd, dir);
+
+			if (!ss || data->stream_prepared[cpu_dai->id])
+				continue;
+			if (qcom_snd_sdw_prepare(ss, &data->stream_prepared[cpu_dai->id]))
+				dev_warn(card->dev, "%s: SoundWire re-enable deferred to prepare\n",
+					 cpu_dai->name);
+		}
+	}
+
+	return 0;
+}
+
 static void sc8280xp_add_be_ops(struct snd_soc_card *card)
 {
 	struct snd_soc_dai_link *link;
@@ -439,6 +507,8 @@ static int sc8280xp_platform_probe(struct platform_device *pdev)
 		return ret;
 
 	card->driver_name = data->priv->driver_name;
+	card->suspend_post = sc8280xp_snd_suspend_post;
+	card->resume_pre = sc8280xp_snd_resume_pre;
 	sc8280xp_add_be_ops(card);
 	return devm_snd_soc_register_card(dev, card);
 }
