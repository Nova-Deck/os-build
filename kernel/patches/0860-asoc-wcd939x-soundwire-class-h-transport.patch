From: mrdidit <26687854+mrdidit@users.noreply.github.com>
Subject: [PATCH] ASoC: wcd939x, soundwire: qcom: Class-H transport

Declare the Class-H sink FULL so SoundWire programs its window and packing
fields, and add optional master channel masks and an SSP period.

Squashed from:
  0081b: ASoC: wcd939x: program Class-H transport fields
  0081c: soundwire: qcom: configure Class-H master transport
  0081d: dt-bindings: soundwire: qcom: describe master transport
---
diff --git a/Documentation/devicetree/bindings/soundwire/qcom,soundwire.yaml b/Documentation/devicetree/bindings/soundwire/qcom,soundwire.yaml
index 8e6973fa2..81e7437a8 100644
--- a/Documentation/devicetree/bindings/soundwire/qcom,soundwire.yaml
+++ b/Documentation/devicetree/bindings/soundwire/qcom,soundwire.yaml
@@ -82,6 +82,33 @@ properties:
     description: count of data out ports
     deprecated: true
 
+  qcom,pcm-ports-mask:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      Bitmask of physical master ports requiring the PCM/PDM32 formatter.
+      Bit N selects port N; port 0 is reserved.
+    maximum: 65534
+    multipleOf: 2
+
+  qcom,ports-master-channel-mask:
+    $ref: /schemas/types.yaml#/definitions/uint8-array
+    description:
+      Master channel-enable masks, one entry per physical data port,
+      starting with port 1. Out ports are followed by in ports. A zero
+      entry retains the connected slave's channel mask. Nonzero entries
+      configure only the master; slave channel masks remain unchanged.
+    minItems: 3
+    maxItems: 16
+
+  qcom,ssp-period:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      Number of SoundWire frames between stream synchronization points.
+      The controller register encodes this count minus one.
+    minimum: 1
+    maximum: 256
+    default: 1
+
   qcom,ports-word-length:
     $ref: /schemas/types.yaml#/definitions/uint8-array
     description:
diff --git a/drivers/soundwire/qcom.c b/drivers/soundwire/qcom.c
index 1997a4f45..5ee902ec6 100644
--- a/drivers/soundwire/qcom.c
+++ b/drivers/soundwire/qcom.c
@@ -93,6 +93,7 @@
 #define SWRM_MCP_FRAME_CTRL_BANK_ADDR(m)		(0x101C + 0x40 * (m))
 #define SWRM_MCP_FRAME_CTRL_BANK_COL_CTRL_BMSK			GENMASK(2, 0)
 #define SWRM_MCP_FRAME_CTRL_BANK_ROW_CTRL_BMSK			GENMASK(7, 3)
+#define SWRM_MCP_FRAME_CTRL_BANK_SSP_PERIOD_MASK			GENMASK(23, 16)
 #define SWRM_MCP_BUS_CTRL					0x1044
 #define SWRM_MCP_BUS_CLK_START					BIT(1)
 #define SWRM_MCP_CFG_ADDR					0x1048
@@ -121,6 +122,7 @@
 #define SWRM_V2_0_LINK_STATUS					0x5064
 
 #define SWRM_DP_PORT_CTRL_EN_CHAN_SHFT				0x18
+#define SWRM_DP_PORT_CTRL_EN_CHAN_MASK				GENMASK(31, 24)
 #define SWRM_DP_PORT_CTRL_OFFSET2_SHFT				0x10
 #define SWRM_DP_PORT_CTRL_OFFSET1_SHFT				0x08
 #define SWRM_AHB_BRIDGE_WR_DATA_0				0xc85
@@ -160,6 +162,7 @@ struct qcom_swrm_port_config {
 	u8 word_length;
 	u8 blk_group_count;
 	u8 lane_control;
+	u8 master_channel_mask;
 };
 
 /*
@@ -210,6 +213,8 @@ struct qcom_swrm_ctrl {
 	int cols_index;
 	int rows_index;
 	u32 pcm_ports_mask;
+	u32 formatter_ports;
+	u32 ssp_period;
 	unsigned long port_mask;
 	u32 intr_mask;
 	u8 rcmd_id;
@@ -885,6 +890,9 @@ static int qcom_swrm_init(struct qcom_swrm_ctrl *ctrl)
 	/* Clear Rows and Cols */
 	val = FIELD_PREP(SWRM_MCP_FRAME_CTRL_BANK_ROW_CTRL_BMSK, ctrl->rows_index);
 	val |= FIELD_PREP(SWRM_MCP_FRAME_CTRL_BANK_COL_CTRL_BMSK, ctrl->cols_index);
+	if (ctrl->ssp_period)
+		val |= FIELD_PREP(SWRM_MCP_FRAME_CTRL_BANK_SSP_PERIOD_MASK,
+				  ctrl->ssp_period - 1);
 
 	reset_control_reset(ctrl->audio_cgcr);
 
@@ -1021,11 +1029,17 @@ static int qcom_swrm_pre_bank_switch(struct sdw_bus *bus)
 	u32 reg = SWRM_MCP_FRAME_CTRL_BANK_ADDR(bus->params.next_bank);
 	struct qcom_swrm_ctrl *ctrl = to_qcom_sdw(bus);
 	u32 val;
+	int ret;
 
-	ctrl->reg_read(ctrl, reg, &val);
+	ret = ctrl->reg_read(ctrl, reg, &val);
+	if (ret)
+		return ret;
 
 	u32p_replace_bits(&val, ctrl->cols_index, SWRM_MCP_FRAME_CTRL_BANK_COL_CTRL_BMSK);
 	u32p_replace_bits(&val, ctrl->rows_index, SWRM_MCP_FRAME_CTRL_BANK_ROW_CTRL_BMSK);
+	if (ctrl->ssp_period)
+		u32p_replace_bits(&val, ctrl->ssp_period - 1,
+				  SWRM_MCP_FRAME_CTRL_BANK_SSP_PERIOD_MASK);
 
 	return ctrl->reg_write(ctrl, reg, val);
 }
@@ -1041,17 +1055,10 @@ static int qcom_swrm_port_params(struct sdw_bus *bus,
 				p_params->bps - 1);
 }
 
-/*
- * Ports carrying PCM samples (e.g. the WCD939x HIFI_PCM headphone port)
- * additionally need the controller's per-port PCM format enable
- * (SWRM_DOUT_DP_PCM_PORT_CTRL) set; PDM ports don't care. Mainline has no
- * binding for per-port stream type yet, so take the port set from an
- * optional DT mask, overridable via module parameter for kernels whose DTB
- * predates the property.
- */
+/* PCM and PDM32 ports require the unbanked formatter. */
 static uint pcm_ports_mask;
 module_param(pcm_ports_mask, uint, 0644);
-MODULE_PARM_DESC(pcm_ports_mask, "Bitmask of data ports carrying PCM (overrides qcom,pcm-ports-mask)");
+MODULE_PARM_DESC(pcm_ports_mask, "PCM/PDM32 port mask added to qcom,pcm-ports-mask");
 
 static int qcom_swrm_transport_params(struct sdw_bus *bus,
 				      struct sdw_transport_params *params,
@@ -1130,37 +1137,67 @@ static int qcom_swrm_transport_params(struct sdw_bus *bus,
 	return ret;
 }
 
+static int qcom_swrm_clear_idle_formatter(struct qcom_swrm_ctrl *ctrl,
+					  unsigned int port_num)
+{
+	u32 offset = ctrl->reg_layout[SWRM_OFFSET_DP_PORT_CTRL_BANK];
+	u32 reg, val;
+	int bank, ret;
+
+	/* The formatter is unbanked; both channel banks must be idle. */
+	for (bank = 0; bank < 2; bank++) {
+		reg = SWRM_DPn_PORT_CTRL_BANK(offset, port_num, bank);
+		ret = ctrl->reg_read(ctrl, reg, &val);
+		if (ret || (val & SWRM_DP_PORT_CTRL_EN_CHAN_MASK))
+			return ret;
+	}
+
+	ret = ctrl->reg_write(ctrl, SWRM_DOUT_DP_PCM_PORT_CTRL(port_num), 0);
+	if (!ret)
+		ctrl->formatter_ports &= ~BIT(port_num);
+
+	return ret;
+}
+
 static int qcom_swrm_port_enable(struct sdw_bus *bus,
 				 struct sdw_enable_ch *enable_ch,
 				 unsigned int bank)
 {
-	u32 reg;
 	struct qcom_swrm_ctrl *ctrl = to_qcom_sdw(bus);
-	u32 val;
 	u32 offset = ctrl->reg_layout[SWRM_OFFSET_DP_PORT_CTRL_BANK];
+	u32 port = BIT(enable_ch->port_num);
+	u32 reg, val;
+	bool formatted;
+	int ret;
 
 	reg = SWRM_DPn_PORT_CTRL_BANK(offset, enable_ch->port_num, bank);
+	ret = ctrl->reg_read(ctrl, reg, &val);
+	if (ret)
+		return ret;
 
-	ctrl->reg_read(ctrl, reg, &val);
-
-	if (enable_ch->enable)
-		val |= (enable_ch->ch_mask << SWRM_DP_PORT_CTRL_EN_CHAN_SHFT);
-	else
-		val &= ~(0xff << SWRM_DP_PORT_CTRL_EN_CHAN_SHFT);
+	formatted = (ctrl->pcm_ports_mask | READ_ONCE(pcm_ports_mask) |
+		     ctrl->formatter_ports) & port;
+	if (enable_ch->enable) {
+		if (formatted) {
+			ret = ctrl->reg_write(ctrl,
+					     SWRM_DOUT_DP_PCM_PORT_CTRL(enable_ch->port_num), 3);
+			if (ret)
+				return ret;
+			ctrl->formatter_ports |= port;
+		}
+		val |= enable_ch->ch_mask << SWRM_DP_PORT_CTRL_EN_CHAN_SHFT;
+		ret = ctrl->reg_write(ctrl, reg, val);
+		if (ret && formatted)
+			qcom_swrm_clear_idle_formatter(ctrl, enable_ch->port_num);
+		return ret;
+	}
 
-	/*
-	 * Only set, never clear: port_enable also fires for the inactive
-	 * bank's disable during bank switches and would strip the PCM format
-	 * mid-stream. The register only affects PCM-mode ports, so a sticky
-	 * 0x3 is harmless.
-	 */
-	if (((ctrl->pcm_ports_mask | pcm_ports_mask) & BIT(enable_ch->port_num)) &&
-	    enable_ch->enable)
-		ctrl->reg_write(ctrl,
-				SWRM_DOUT_DP_PCM_PORT_CTRL(enable_ch->port_num),
-				0x3);
+	val &= ~SWRM_DP_PORT_CTRL_EN_CHAN_MASK;
+	ret = ctrl->reg_write(ctrl, reg, val);
+	if (ret || !formatted)
+		return ret;
 
-	return ctrl->reg_write(ctrl, reg, val);
+	return qcom_swrm_clear_idle_formatter(ctrl, enable_ch->port_num);
 }
 
 static const struct sdw_master_port_ops qcom_swrm_port_ops = {
@@ -1316,7 +1353,9 @@ static int qcom_swrm_stream_alloc_ports(struct qcom_swrm_ctrl *ctrl,
 				}
 				set_bit(pn, port_mask);
 				pconfig[nports].num = pn;
-				pconfig[nports].ch_mask = p_rt->ch_mask;
+				pconfig[nports].ch_mask = ctrl->pconfig[pn].master_channel_mask;
+				if (!pconfig[nports].ch_mask)
+					pconfig[nports].ch_mask = p_rt->ch_mask;
 				nports++;
 			}
 		}
@@ -1460,6 +1499,7 @@ static int qcom_swrm_get_port_config(struct qcom_swrm_ctrl *ctrl)
 {
 	struct device_node *np = ctrl->dev->of_node;
 	struct qcom_swrm_port_config *pcfg;
+	bool has_master_channel_mask;
 	int i, ret, val;
 
 	ctrl->reg_read(ctrl, SWRM_COMP_PARAMS, &val);
@@ -1479,6 +1519,14 @@ static int qcom_swrm_get_port_config(struct qcom_swrm_ctrl *ctrl)
 
 	of_property_read_u32(np, "qcom,pcm-ports-mask", &ctrl->pcm_ports_mask);
 
+	if (of_property_present(np, "qcom,ssp-period")) {
+		ret = of_property_read_u32(np, "qcom,ssp-period", &ctrl->ssp_period);
+		if (ret)
+			return ret;
+		if (!ctrl->ssp_period || ctrl->ssp_period > 256)
+			return dev_err_probe(ctrl->dev, -EINVAL, "Invalid SSP period\n");
+	}
+
 	ret = of_property_read_u32(np, "qcom,dout-ports", &val);
 	if (!ret) { /* only if present */
 		if (val != ctrl->num_dout_ports) {
@@ -1491,6 +1539,14 @@ static int qcom_swrm_get_port_config(struct qcom_swrm_ctrl *ctrl)
 
 	ctrl->nports = ctrl->num_dout_ports + ctrl->num_din_ports;
 
+	has_master_channel_mask = of_property_present(np, "qcom,ports-master-channel-mask");
+	if (has_master_channel_mask) {
+		ret = of_property_count_u8_elems(np, "qcom,ports-master-channel-mask");
+		if (ret != ctrl->nports)
+			return dev_err_probe(ctrl->dev, -EINVAL,
+					     "Master channel mask count must match port count\n");
+	}
+
 	ctrl->pconfig = devm_kcalloc(ctrl->dev, ctrl->nports + 1,
 					sizeof(*ctrl->pconfig), GFP_KERNEL);
 	if (!ctrl->pconfig)
@@ -1501,6 +1557,13 @@ static int qcom_swrm_get_port_config(struct qcom_swrm_ctrl *ctrl)
 	for (i = 0; i < ctrl->nports; i++) {
 		pcfg = &ctrl->pconfig[i + 1];
 
+		if (has_master_channel_mask) {
+			ret = of_property_read_u8_index(np, "qcom,ports-master-channel-mask",
+							i, &pcfg->master_channel_mask);
+			if (ret)
+				return ret;
+		}
+
 		ret = of_property_read_u8_index(np, "qcom,ports-offset1", i, &pcfg->off1);
 		if (ret)
 			return ret;
diff --git a/sound/soc/codecs/wcd939x-sdw.c b/sound/soc/codecs/wcd939x-sdw.c
index 69b9b0811..21b54d898 100644
--- a/sound/soc/codecs/wcd939x-sdw.c
+++ b/sound/soc/codecs/wcd939x-sdw.c
@@ -61,7 +61,7 @@ static struct sdw_dpn_prop wcd939x_rx_dpn_prop[WCD939X_MAX_RX_SWR_PORTS] = {
 	},
 	{
 		.num = WCD939X_CLSH_PORT,
-		.type = SDW_DPN_SIMPLE,
+		.type = SDW_DPN_FULL,
 		.min_ch = 1,
 		.max_ch = 1,
 		.simple_ch_prep_sm = true,
