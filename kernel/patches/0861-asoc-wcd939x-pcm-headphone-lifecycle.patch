+static int wcd939x_zdet_supplies_enable(struct wcd939x_priv *wcd939x)
+{
+	int ret;
+
+	/* MBHC owns the RX bias, buck/flyback clock and Vneg during ZDET. */
+	ret = regmap_update_bits(wcd939x->regmap, WCD939X_MBHC_ZDET_VNEG_CTL,
+				 0x4e, 0x4e);
+	if (ret)
+		return ret;
+	usleep_range(100, 110);
+
+	ret = regmap_update_bits(wcd939x->regmap, WCD939X_MBHC_ZDET_VNEG_CTL,
+				 0x10, 0x10);
+	if (ret)
+		return ret;
+	usleep_range(100, 110);
+
+	/* Keep both PAs disabled before enabling VPOS. */
+	ret = regmap_update_bits(wcd939x->regmap, WCD939X_MBHC_ZDET_VNEG_CTL,
+				 0x01, 0x01);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(wcd939x->regmap, WCD939X_MBHC_ZDET_VNEG_CTL,
+				 0x20, 0x20);
+	if (ret)
+		return ret;
+	usleep_range(500, 510);
+
+	return 0;
+}
+
+static int wcd939x_zdet_supplies_disable(struct wcd939x_priv *wcd939x)
+{
+	int ret, err;
+
+	/* Attempt every release, including after an incomplete setup write. */
+	ret = regmap_write_bits(wcd939x->regmap, WCD939X_MBHC_ZDET_VNEG_CTL,
+				0x20, 0x00);
+	usleep_range(500, 510);
+
+	err = regmap_write_bits(wcd939x->regmap, WCD939X_MBHC_ZDET_VNEG_CTL,
+				0x11, 0x00);
+	if (!ret)
+		ret = err;
+	usleep_range(100, 110);
+
+	err = regmap_write_bits(wcd939x->regmap, WCD939X_MBHC_ZDET_VNEG_CTL,
+				0x06, 0x00);
+	if (!ret)
+		ret = err;
+	usleep_range(100, 110);
+
+	err = regmap_write_bits(wcd939x->regmap, WCD939X_MBHC_ZDET_VNEG_CTL,
+				0x48, 0x00);
+	if (!ret)
+		ret = err;
+
+	return ret;
+}
