+static int wcd939x_revision_init(struct snd_soc_component *component)
+{
+	struct wcd939x_priv *wcd939x = snd_soc_component_get_drvdata(component);
+	struct device *dev = component->dev;
+	unsigned int id1, status1, version;
+	int ret;
+
+	wcd939x->zdet_v2 = false;
+	ret = regmap_read(wcd939x->regmap, WCD939X_DIGITAL_CHIP_ID1, &id1);
+	if (ret)
+		return ret;
+
+	switch (id1) {
+	case CHIPID_WCD939X_VER_MAJOR_1:
+		ret = regmap_read(wcd939x->regmap, WCD939X_EAR_STATUS_REG_1,
+				  &status1);
+		if (ret)
+			return ret;
+		version = status1 & CHIPID_WCD939X_VER_MINOR_1 ?
+			WCD939X_VERSION_1_1 : WCD939X_VERSION_1_0;
+		break;
+	case CHIPID_WCD939X_VER_MAJOR_2:
+		version = WCD939X_VERSION_2_0;
+		break;
+	default:
+		dev_warn(dev, "Unknown codec revision %#x; initialization unchanged\n", id1);
+		return 0;
+	}
+
+	wcd939x->zdet_v2 = version == WCD939X_VERSION_2_0;
+	dev_dbg(dev, "wcd939x version: %s\n", version_to_str(version));
+	if (version == WCD939X_VERSION_1_0)
+		return 0;
+
+	ret = regmap_write(wcd939x->regmap, WCD939X_BIAS_VBG_FINE_ADJ, 0xa5);
+	if (ret)
+		return ret;
+
+	return regmap_update_bits(wcd939x->regmap,
+				  WCD939X_HPH_NEW_INT_PA_GAIN_CTL_R,
+				  WCD939X_PA_GAIN_CTL_R_D_RCO_CLK_EN,
+				  WCD939X_PA_GAIN_CTL_R_D_RCO_CLK_EN);
+}
