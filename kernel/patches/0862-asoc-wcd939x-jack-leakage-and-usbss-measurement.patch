From: mrdidit <26687854+mrdidit@users.noreply.github.com>
Subject: [PATCH] ASoC: wcd939x: jack leakage control and USBSS measurement

Jack leakage lifecycle, a USBSS provider for impedance measurement on an
independent jack, PCM PA settling delays, MBHC worker drain and USBSS
protection across codec reset.

Squashed from:
  0081j: ASoC: wcd939x: restore jack leakage pull-up lifecycle
  0081k: ASoC: wcd939x: separate jack leakage from optional switch routing
  0081l: ASoC: wcd939x: coordinate USBSS jack impedance measurement
  0081m: ASoC: wcd939x: preserve PCM headphone amplifier settling time
  0081n: ASoC: wcd-mbhc: drain jack work before releasing state
  0081o: dt-bindings: sound: wcd939x: describe USBSS jack measurement
  0081p: ASoC: wcd939x: coordinate codec reset with USBSS protection
  0081q: dt-bindings: sound: wcd939x: describe USBSS reset coordination
---
diff --git a/Documentation/devicetree/bindings/sound/qcom,wcd939x.yaml b/Documentation/devicetree/bindings/sound/qcom,wcd939x.yaml
index 85283f944..0dea3f56c 100644
--- a/Documentation/devicetree/bindings/sound/qcom,wcd939x.yaml
+++ b/Documentation/devicetree/bindings/sound/qcom,wcd939x.yaml
@@ -21,6 +21,15 @@ description: |
 allOf:
   - $ref: dai-common.yaml#
   - $ref: qcom,wcd93xx-common.yaml#
+  - if:
+      required:
+        - qcom,usbss-measurement
+    then:
+      properties:
+        port: false
+        mode-switch: false
+        orientation-switch: false
+        qcom,usbss: false
 
 properties:
   compatible:
@@ -48,6 +57,15 @@ properties:
   vdd-px-supply:
     description: A reference to the 1.2V PX supply
 
+  qcom,usbss-measurement:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: |
+      USBSS provider for codec reset protection, impedance measurement and
+      linearizer calibration on an independent headphone jack. Protection
+      settings must be coordinated with this provider before driving codec
+      reset. This does not enable USB-C analog audio routing and cannot be
+      combined with the codec's Type-C audio graph.
+
 required:
   - compatible
 
diff --git a/drivers/usb/typec/mux/wcd939x-usbss.c b/drivers/usb/typec/mux/wcd939x-usbss.c
index 195a8983c..ee238846c 100644
--- a/drivers/usb/typec/mux/wcd939x-usbss.c
+++ b/drivers/usb/typec/mux/wcd939x-usbss.c
@@ -9,14 +9,21 @@
 #include <linux/kernel.h>
 #include <linux/module.h>
 #include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/slab.h>
 #include <linux/regmap.h>
 #include <linux/bitfield.h>
 #include <linux/gpio/consumer.h>
 #include <linux/usb/typec_dp.h>
 #include <linux/usb/typec_mux.h>
+#include <linux/usb/wcd939x-usbss.h>
 
 #define WCD_USBSS_PMP_OUT1			0x2
 
+#define WCD_USBSS_DP_EN			0x1e
+#define WCD_USBSS_DN_EN			0x21
+#define WCD_USBSS_DP_DN_EN_P_THRESH_SEL		GENMASK(3, 1)
+
 #define WCD_USBSS_DP_DN_MISC1			0x20
 
 #define WCD_USBSS_DP_DN_MISC1_DP_PCOMP_2X_DYN_BST_ON_EN			BIT(3)
@@ -46,6 +53,9 @@
 
 #define WCD_USBSS_MG2_MISC_PCOMP_2X_DYN_BST_ON_EN			BIT(5)
 
+#define WCD_USBSS_EXT_LIN_EN			0x3d
+#define WCD_USBSS_EXT_SW_CTRL_1			0x43
+
 #define WCD_USBSS_DISP_AUXP_THRESH		0x80
 
 #define WCD_USBSS_DISP_AUXP_THRESH_DISP_AUXP_OVPON_CM			GENMASK(7, 5)
@@ -96,6 +106,8 @@
 
 #define WCD_USBSS_FUNCTION_ENABLE		0x413
 
+#define WCD_USBSS_FUNCTION_ENABLE_RDAC_CAL_SELECT		BIT(2)
+
 #define WCD_USBSS_FUNCTION_ENABLE_SOURCE_SELECT				GENMASK(1, 0)
 
 #define WCD_USBSS_FUNCTION_ENABLE_SOURCE_SELECT_MANUAL		1
@@ -123,6 +135,15 @@
 #define WCD_USBSS_RATIO_SPKR_REXT_L_MSB		0x462
 #define WCD_USBSS_RATIO_SPKR_REXT_R_LSB		0x463
 #define WCD_USBSS_RATIO_SPKR_REXT_R_MSB		0x464
+#define WCD_USBSS_AUDIO_TAP_L_LSB		0x465
+#define WCD_USBSS_AUDIO_TAP_L_MSB		0x466
+#define WCD_USBSS_AUDIO_TAP_R_LSB		0x467
+#define WCD_USBSS_AUDIO_TAP_R_MSB		0x468
+#define WCD_USBSS_GROUND_TAP_L_LSB	0x469
+#define WCD_USBSS_GROUND_TAP_L_MSB	0x46a
+#define WCD_USBSS_GROUND_TAP_R_LSB	0x46b
+#define WCD_USBSS_GROUND_TAP_R_MSB	0x46c
+
 #define WCD_USBSS_AUD_COEF_L_K0_0		0x475
 #define WCD_USBSS_AUD_COEF_L_K0_1		0x476
 #define WCD_USBSS_AUD_COEF_L_K0_2		0x477
@@ -199,6 +220,36 @@ struct wcd939x_usbss {
 	unsigned int svid;
 };
 
+static struct i2c_driver wcd939x_usbss_driver;
+
+static const unsigned int wcd939x_usbss_reset_regs[] = {
+	WCD_USBSS_DP_EN,
+	WCD_USBSS_DN_EN,
+};
+
+struct wcd939x_usbss_reset {
+	struct wcd939x_usbss *usbss;
+	unsigned int saved[ARRAY_SIZE(wcd939x_usbss_reset_regs)];
+	int error;
+	bool completed;
+};
+
+static const struct {
+	unsigned int reg;
+	unsigned int value;
+} wcd939x_usbss_measurement_regs[] = {
+	{ WCD_USBSS_EXT_LIN_EN, 0x00 },
+	{ WCD_USBSS_EXT_SW_CTRL_1, 0x00 },
+	{ WCD_USBSS_MG1_BIAS, 0x0e },
+	{ WCD_USBSS_MG2_BIAS, 0x0e },
+};
+
+struct wcd939x_usbss_measurement {
+	struct wcd939x_usbss *usbss;
+	unsigned int saved[ARRAY_SIZE(wcd939x_usbss_measurement_regs)];
+	int error;
+};
+
 static const struct regmap_range_cfg wcd939x_usbss_ranges[] = {
 	{
 		.range_min = 0,
@@ -721,6 +772,7 @@ static int wcd939x_usbss_probe(struct i2c_client *client)
 	}
 
 	i2c_set_clientdata(client, usbss);
+	dev_dbg(dev, "USBSS provider ready\n");
 
 	return 0;
 
@@ -782,6 +834,305 @@ int wcd939x_usbss_audio_config(struct device *dev, bool enable)
 }
 EXPORT_SYMBOL_GPL(wcd939x_usbss_audio_config);
 
+static void wcd939x_usbss_put_device(void *data)
+{
+	put_device(data);
+}
+
+struct wcd939x_usbss *devm_wcd939x_usbss_get(struct device *consumer,
+					     const char *property)
+{
+	struct wcd939x_usbss *usbss;
+	struct device_node *node;
+	struct i2c_client *client;
+	struct device *supplier;
+	int ret;
+
+	if (!of_property_present(consumer->of_node, property))
+		return NULL;
+
+	node = of_parse_phandle(consumer->of_node, property, 0);
+	if (!node)
+		return ERR_PTR(-EINVAL);
+
+	client = of_find_i2c_device_by_node(node);
+	of_node_put(node);
+	if (!client)
+		return ERR_PTR(-EPROBE_DEFER);
+
+	supplier = &client->dev;
+	if (!device_trylock(supplier)) {
+		ret = -EPROBE_DEFER;
+		goto put_device;
+	}
+
+	if (!device_is_bound(supplier) ||
+	    supplier->links.status != DL_DEV_DRIVER_BOUND) {
+		ret = -EPROBE_DEFER;
+		goto unlock;
+	}
+
+	if (supplier->driver != &wcd939x_usbss_driver.driver) {
+		ret = -ENODEV;
+		goto unlock;
+	}
+
+	if (!device_link_add(consumer, supplier, DL_FLAG_AUTOREMOVE_CONSUMER)) {
+		ret = -EINVAL;
+		goto unlock;
+	}
+
+	usbss = i2c_get_clientdata(client);
+	device_unlock(supplier);
+
+	ret = devm_add_action_or_reset(consumer, wcd939x_usbss_put_device, supplier);
+	if (ret)
+		return ERR_PTR(ret);
+
+	return usbss;
+
+unlock:
+	device_unlock(supplier);
+put_device:
+	put_device(supplier);
+	return ERR_PTR(ret);
+}
+EXPORT_SYMBOL_GPL(devm_wcd939x_usbss_get);
+
+static int wcd939x_usbss_reset_restore(struct wcd939x_usbss_reset *reset)
+{
+	struct wcd939x_usbss *usbss = reset->usbss;
+	int error = 0, ret;
+	unsigned int i;
+
+	lockdep_assert_held(&usbss->lock);
+	for (i = 0; i < ARRAY_SIZE(wcd939x_usbss_reset_regs); i++) {
+		ret = regmap_update_bits(usbss->regmap, wcd939x_usbss_reset_regs[i],
+					 WCD_USBSS_DP_DN_EN_P_THRESH_SEL, reset->saved[i]);
+		if (ret) {
+			dev_err(&usbss->client->dev, "Reset protection restore %#x failed: %d\n",
+				wcd939x_usbss_reset_regs[i], ret);
+			if (!error)
+				error = ret;
+		}
+	}
+
+	return error;
+}
+
+struct wcd939x_usbss_reset *wcd939x_usbss_reset_begin(struct wcd939x_usbss *usbss)
+{
+	struct wcd939x_usbss_reset *reset;
+	unsigned int i;
+	int ret;
+
+	reset = kzalloc_obj(*reset);
+	if (!reset)
+		return ERR_PTR(-ENOMEM);
+
+	reset->usbss = usbss;
+	mutex_lock(&usbss->lock);
+	for (i = 0; i < ARRAY_SIZE(wcd939x_usbss_reset_regs); i++) {
+		ret = regmap_read(usbss->regmap, wcd939x_usbss_reset_regs[i],
+				  &reset->saved[i]);
+		if (ret)
+			goto unlock;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(wcd939x_usbss_reset_regs); i++) {
+		ret = regmap_update_bits(usbss->regmap, wcd939x_usbss_reset_regs[i],
+					 WCD_USBSS_DP_DN_EN_P_THRESH_SEL,
+					 FIELD_PREP(WCD_USBSS_DP_DN_EN_P_THRESH_SEL, 4));
+		if (ret) {
+			/* A failed transfer may still have changed either field. */
+			wcd939x_usbss_reset_restore(reset);
+			goto unlock;
+		}
+	}
+
+	dev_dbg(&usbss->client->dev,
+		"Reset protection prepared: DP/DN mask=0x0e value=0x08\n");
+	return reset;
+
+unlock:
+	mutex_unlock(&usbss->lock);
+	kfree(reset);
+	return ERR_PTR(ret);
+}
+EXPORT_SYMBOL_GPL(wcd939x_usbss_reset_begin);
+
+int wcd939x_usbss_reset_complete(struct wcd939x_usbss_reset *reset)
+{
+	struct wcd939x_usbss *usbss = reset->usbss;
+	unsigned int i;
+	int ret;
+
+	lockdep_assert_held(&usbss->lock);
+	for (i = 0; i < ARRAY_SIZE(wcd939x_usbss_reset_regs); i++) {
+		ret = regmap_update_bits(usbss->regmap, wcd939x_usbss_reset_regs[i],
+					 WCD_USBSS_DP_DN_EN_P_THRESH_SEL,
+					 FIELD_PREP(WCD_USBSS_DP_DN_EN_P_THRESH_SEL, 6));
+		if (ret) {
+			reset->error = ret;
+			return ret;
+		}
+	}
+	reset->completed = true;
+	dev_dbg(&usbss->client->dev,
+		"Reset protection completed: DP/DN mask=0x0e value=0x0c\n");
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(wcd939x_usbss_reset_complete);
+
+int wcd939x_usbss_reset_end(struct wcd939x_usbss_reset *reset)
+{
+	struct wcd939x_usbss *usbss = reset->usbss;
+	int error = reset->error;
+	int ret;
+
+	lockdep_assert_held(&usbss->lock);
+	if (!reset->completed) {
+		ret = wcd939x_usbss_reset_restore(reset);
+		if (!error)
+			error = ret;
+	}
+	mutex_unlock(&usbss->lock);
+	kfree(reset);
+
+	return error;
+}
+EXPORT_SYMBOL_GPL(wcd939x_usbss_reset_end);
+
+int wcd939x_usbss_init_measurement(struct wcd939x_usbss *usbss)
+{
+	int ret;
+
+	mutex_lock(&usbss->lock);
+	ret = regmap_update_bits(usbss->regmap, WCD_USBSS_FUNCTION_ENABLE,
+				 WCD_USBSS_FUNCTION_ENABLE_RDAC_CAL_SELECT,
+				 WCD_USBSS_FUNCTION_ENABLE_RDAC_CAL_SELECT);
+	if (!ret)
+		dev_dbg(&usbss->client->dev, "USBSS RDAC calibration selection initialized\n");
+	mutex_unlock(&usbss->lock);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(wcd939x_usbss_init_measurement);
+
+static int wcd939x_usbss_measurement_restore(struct wcd939x_usbss_measurement *measurement)
+{
+	struct wcd939x_usbss *usbss = measurement->usbss;
+	int error = 0, ret;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(wcd939x_usbss_measurement_regs); i++) {
+		ret = regmap_write(usbss->regmap, wcd939x_usbss_measurement_regs[i].reg,
+				   measurement->saved[i]);
+		if (ret) {
+			dev_err(&usbss->client->dev, "Measurement restore %#x failed: %d\n",
+				wcd939x_usbss_measurement_regs[i].reg, ret);
+			if (!error)
+				error = ret;
+		}
+	}
+
+	return error;
+}
+
+struct wcd939x_usbss_measurement *
+wcd939x_usbss_measurement_begin(struct wcd939x_usbss *usbss)
+{
+	struct wcd939x_usbss_measurement *measurement;
+	unsigned int i;
+	int ret;
+
+	measurement = kzalloc_obj(*measurement);
+	if (!measurement)
+		return ERR_PTR(-ENOMEM);
+
+	measurement->usbss = usbss;
+	mutex_lock(&usbss->lock);
+
+	for (i = 0; i < ARRAY_SIZE(wcd939x_usbss_measurement_regs); i++) {
+		ret = regmap_read(usbss->regmap, wcd939x_usbss_measurement_regs[i].reg,
+				  &measurement->saved[i]);
+		if (ret)
+			goto unlock;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(wcd939x_usbss_measurement_regs); i++) {
+		ret = regmap_write(usbss->regmap, wcd939x_usbss_measurement_regs[i].reg,
+				   wcd939x_usbss_measurement_regs[i].value);
+		if (ret) {
+			/* A failed transfer may still have changed the register. */
+			wcd939x_usbss_measurement_restore(measurement);
+			goto unlock;
+		}
+	}
+
+	return measurement;
+
+unlock:
+	mutex_unlock(&usbss->lock);
+	kfree(measurement);
+	return ERR_PTR(ret);
+}
+EXPORT_SYMBOL_GPL(wcd939x_usbss_measurement_begin);
+
+int wcd939x_usbss_measurement_set_taps(struct wcd939x_usbss_measurement *measurement)
+{
+	static const struct {
+		unsigned int reg;
+		unsigned int mask;
+		unsigned int value;
+	} taps[] = {
+		{ WCD_USBSS_AUDIO_TAP_L_LSB, 0xff, 0xe8 },
+		{ WCD_USBSS_AUDIO_TAP_L_MSB, 0x03, 0x00 },
+		{ WCD_USBSS_AUDIO_TAP_R_LSB, 0xff, 0xe8 },
+		{ WCD_USBSS_AUDIO_TAP_R_MSB, 0x03, 0x00 },
+		{ WCD_USBSS_GROUND_TAP_L_LSB, 0xff, 0xe8 },
+		{ WCD_USBSS_GROUND_TAP_L_MSB, 0x03, 0x00 },
+		{ WCD_USBSS_GROUND_TAP_R_LSB, 0xff, 0xe8 },
+		{ WCD_USBSS_GROUND_TAP_R_MSB, 0x03, 0x00 },
+	};
+	struct wcd939x_usbss *usbss = measurement->usbss;
+	unsigned int i;
+	int ret;
+
+	lockdep_assert_held(&usbss->lock);
+	for (i = 0; i < ARRAY_SIZE(taps); i++) {
+		ret = regmap_update_bits(usbss->regmap, taps[i].reg,
+					 taps[i].mask, taps[i].value);
+		if (ret) {
+			dev_err(&usbss->client->dev, "Measurement tap %#x failed: %d\n",
+				taps[i].reg, ret);
+			if (!measurement->error)
+				measurement->error = ret;
+		}
+	}
+
+	return measurement->error;
+}
+EXPORT_SYMBOL_GPL(wcd939x_usbss_measurement_set_taps);
+
+int wcd939x_usbss_measurement_end(struct wcd939x_usbss_measurement *measurement)
+{
+	struct wcd939x_usbss *usbss = measurement->usbss;
+	int error = measurement->error;
+	int ret;
+
+	lockdep_assert_held(&usbss->lock);
+	ret = wcd939x_usbss_measurement_restore(measurement);
+	if (!error)
+		error = ret;
+	mutex_unlock(&usbss->lock);
+	kfree(measurement);
+
+	return error;
+}
+EXPORT_SYMBOL_GPL(wcd939x_usbss_measurement_end);
+
 static const struct i2c_device_id wcd939x_usbss_table[] = {
 	{ .name = "wcd9390-usbss" },
 	{ }
diff --git a/include/linux/usb/wcd939x-usbss.h b/include/linux/usb/wcd939x-usbss.h
new file mode 100644
index 000000000..d7fd22fe3
--- /dev/null
+++ b/include/linux/usb/wcd939x-usbss.h
@@ -0,0 +1,81 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __LINUX_USB_WCD939X_USBSS_H
+#define __LINUX_USB_WCD939X_USBSS_H
+
+#include <linux/err.h>
+#include <linux/kconfig.h>
+#include <linux/property.h>
+
+struct device;
+struct wcd939x_usbss;
+struct wcd939x_usbss_reset;
+struct wcd939x_usbss_measurement;
+
+/* Probe-only lookup; a configured provider must remain bound to the consumer. */
+#if IS_REACHABLE(CONFIG_TYPEC_MUX_WCD939X_USBSS)
+int wcd939x_usbss_audio_config(struct device *dev, bool enable);
+struct wcd939x_usbss *devm_wcd939x_usbss_get(struct device *consumer,
+					     const char *property);
+int wcd939x_usbss_init_measurement(struct wcd939x_usbss *usbss);
+/* Begin/end retain the mode mutex and must execute in the same task. */
+struct wcd939x_usbss_reset *wcd939x_usbss_reset_begin(struct wcd939x_usbss *usbss);
+/* Complete after reset release settles, retaining the token and mode mutex. */
+int wcd939x_usbss_reset_complete(struct wcd939x_usbss_reset *reset);
+/* On failure, reassert codec reset before end restores both saved fields. */
+int wcd939x_usbss_reset_end(struct wcd939x_usbss_reset *reset);
+struct wcd939x_usbss_measurement *
+wcd939x_usbss_measurement_begin(struct wcd939x_usbss *usbss);
+int wcd939x_usbss_measurement_set_taps(struct wcd939x_usbss_measurement *measurement);
+int wcd939x_usbss_measurement_end(struct wcd939x_usbss_measurement *measurement);
+#else
+static inline int wcd939x_usbss_audio_config(struct device *dev, bool enable)
+{
+	return -ENODEV;
+}
+
+static inline struct wcd939x_usbss *
+devm_wcd939x_usbss_get(struct device *consumer, const char *property)
+{
+	return device_property_present(consumer, property) ? ERR_PTR(-ENODEV) : NULL;
+}
+
+static inline int wcd939x_usbss_init_measurement(struct wcd939x_usbss *usbss)
+{
+	return -ENODEV;
+}
+
+static inline struct wcd939x_usbss_reset *
+wcd939x_usbss_reset_begin(struct wcd939x_usbss *usbss)
+{
+	return ERR_PTR(-ENODEV);
+}
+
+static inline int wcd939x_usbss_reset_complete(struct wcd939x_usbss_reset *reset)
+{
+	return -ENODEV;
+}
+
+static inline int wcd939x_usbss_reset_end(struct wcd939x_usbss_reset *reset)
+{
+	return -ENODEV;
+}
+
+static inline struct wcd939x_usbss_measurement *
+wcd939x_usbss_measurement_begin(struct wcd939x_usbss *usbss)
+{
+	return ERR_PTR(-ENODEV);
+}
+
+static inline int
+wcd939x_usbss_measurement_set_taps(struct wcd939x_usbss_measurement *measurement)
+{
+	return -ENODEV;
+}
+
+static inline int
+wcd939x_usbss_measurement_end(struct wcd939x_usbss_measurement *measurement)
+{
+	return -ENODEV;
+}
+#endif
+#endif
diff --git a/sound/soc/codecs/wcd-mbhc-v2.c b/sound/soc/codecs/wcd-mbhc-v2.c
index 0a2447d2a..5fd5d83f4 100644
--- a/sound/soc/codecs/wcd-mbhc-v2.c
+++ b/sound/soc/codecs/wcd-mbhc-v2.c
@@ -359,6 +359,9 @@ static void wcd_mbhc_report_plug_insertion(struct wcd_mbhc *mbhc,
 
 
 	is_pa_on = wcd_mbhc_read_field(mbhc, WCD_MBHC_HPH_PA_EN);
+	dev_dbg(mbhc->component->dev,
+		"Jack insertion: type=%#x pa_on=%d impedance_detect=%d linein_th=%u\n",
+		jack_type, is_pa_on, mbhc->impedance_detect, mbhc->cfg->linein_th);
 
 	if (!is_pa_on) {
 		wcd_mbhc_compute_impedance(mbhc);
@@ -515,7 +518,8 @@ static void mbhc_plug_detect_fn(struct work_struct *work)
 	struct wcd_mbhc *mbhc = container_of(work, struct wcd_mbhc, mbhc_plug_detect_work);
 	struct snd_soc_component *component = mbhc->component;
 	enum snd_jack_types jack_type;
-	bool detection_type;
+	bool detection_type, restore_leakage = false;
+	int ret;
 
 	mutex_lock(&mbhc->lock);
 
@@ -535,25 +539,21 @@ static void mbhc_plug_detect_fn(struct work_struct *work)
 	if (detection_type) {
 		if (mbhc->current_plug != MBHC_PLUG_TYPE_NONE)
 			goto exit;
-		/*
-		 * Route the external analog switch (if any) into audio mode so
-		 * an integrated jack presents a real HPHL/HPHR load to plug
