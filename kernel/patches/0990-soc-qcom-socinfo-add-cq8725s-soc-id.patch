soc: qcom: add the CQ8725S SoC-ID (dt-bindings + socinfo)

Squash of ROCKNIX SM8750 0026 (dt-bindings/arm/qcom,ids.h) and 0027
(drivers/soc/qcom/socinfo.c): the CQ8725S is the gaming SKU of the SM8750
("sun"), carried by the AYN Odin 3. One series, one file, per the stack
convention.

diff --git a/include/dt-bindings/arm/qcom,ids.h b/include/dt-bindings/arm/qcom,ids.h
index 1af73c0ad..347f89f79 100644
--- a/include/dt-bindings/arm/qcom,ids.h
+++ b/include/dt-bindings/arm/qcom,ids.h
@@ -295,6 +295,7 @@
 #define QCOM_ID_IPQ5404			671
 #define QCOM_ID_QCS9100			667
 #define QCOM_ID_QCS8300			674
+#define QCOM_ID_CQ8725S			706
 #define QCOM_ID_QCS8275			675
 #define QCOM_ID_QCS9075			676
 #define QCOM_ID_QCS615			680
diff --git a/drivers/soc/qcom/socinfo.c b/drivers/soc/qcom/socinfo.c
index af418adad..3e26a9712 100644
--- a/drivers/soc/qcom/socinfo.c
+++ b/drivers/soc/qcom/socinfo.c
@@ -535,6 +535,7 @@ static const struct soc_id soc_id[] = {
 	{ qcom_board_id(SM8850) },
 	{ qcom_board_id(IPQ5404) },
 	{ qcom_board_id(QCS9100) },
+	{ qcom_board_id(CQ8725S) },
 	{ qcom_board_id(QCS8300) },
 	{ qcom_board_id(QCS8275) },
 	{ qcom_board_id(QCS9075) },
