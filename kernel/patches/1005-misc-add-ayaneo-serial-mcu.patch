diff -Naur a/drivers/misc/ayaneo-serial-mcu.c b/drivers/misc/ayaneo-serial-mcu.c
--- a/drivers/misc/ayaneo-serial-mcu.c	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/misc/ayaneo-serial-mcu.c	2026-09-01 17:55:02.637436988 +0200
@@ -0,0 +1,522 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * AYANEO handheld controller MCU, serial side.
+ *
+ * The controller on these handhelds is an MCU with two USB personalities. Left alone it
+ * enumerates as a direct-input pad, `4001:0428` "AYANEO Controller", which reports buttons and
+ * axes but advertises NO EV_FF -- so nothing can rumble, on a device whose emulated pad promises
+ * rumble to games. A command on the MCU's own UART switches it to an Xbox 360 personality,
+ * `045e:028e`, which xpad drives and which does have force feedback.
+ *
+ * A second command picks which face-button layout that personality reports, and it matters
+ * because these boards do not all print the same letters on the same buttons. See
+ * AYANEO_MCU_LAYOUT_* below.
+ *
+ * That UART is a dedicated port with nothing else on it, so the switch belongs to a driver that
+ * OWNS the port rather than to a boot script racing whoever opens the tty first. Binding a serdev
+ * driver to it takes the port out of /dev entirely and no tty is registered.
+ *
+ * THE MCU IS NOT READY WHEN THIS DRIVER PROBES, and that is the whole reason for the retry below.
+ * Measured on a Pocket ACE: probe runs at 1.26s, the MCU's USB side does not appear until ~4.9s,
+ * and commands sent at probe are simply not heard -- the pad stays in direct input. Sending the
+ * same commands later, with the MCU up, switches it immediately. So the driver cannot send once
+ * and assume; it has to wait for the MCU to be listening.
+ *
+ * WHAT IT WAITS FOR IS THE MCU'S OWN ANSWER. The MCU talks back, so a reply is evidence that
+ * something is there to hear us -- which a timer is not. Each attempt sends the commands and then
+ * waits briefly for any byte; silence means try again, up to a bounded number of attempts. The
+ * commands are idempotent, so a resend costs nothing but the bytes.
+ */
+
+#include <linux/completion.h>
+#include <linux/delay.h>
+#include <linux/hex.h>
+#include <linux/minmax.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/notifier.h>
+#include <linux/property.h>
+#include <linux/serdev.h>
+#include <linux/spinlock.h>
+#include <linux/string.h>
+#include <linux/suspend.h>
+#include <linux/workqueue.h>
+
+#define AYANEO_MCU_BAUD_RATE		115200
+#define AYANEO_MCU_TX_TIMEOUT_MS	100
+#define AYANEO_MCU_DRAIN_TIMEOUT_MS	100
+
+/*
+ * The MCU wants its frames spaced, and this is not a handshake -- there is no reply to wait on,
+ * so the gap is the only thing sequencing them. Every known-good sequence for this MCU uses
+ * 100ms; shortening it has not been tested.
+ */
+#define AYANEO_MCU_FRAME_GAP_MS		100
+
+/*
+ * How long to listen for the MCU's answer before deciding it was not there, how long to wait
+ * before asking again, and how many times to ask. 15 attempts a second apart covers the ~5s the
+ * MCU took to come up on the slowest board seen, with room to spare, and then stops: a board that
+ * has said nothing for fifteen seconds is not going to.
+ */
+#define AYANEO_MCU_REPLY_TIMEOUT_MS	250
+#define AYANEO_MCU_RETRY_MS		1000
+#define AYANEO_MCU_MAX_ATTEMPTS		15
+
+/* Enough of the answer to identify it in the log; the driver does not parse it. */
+#define AYANEO_MCU_RX_LEN		32
+
+/*
+ * A command is EIGHT payload bytes, sent twice in two different encodings, and the MCU needs
+ * both:
+ *
+ *   1. a binary frame  0xe7 <payload[8]> <checksum> 0xed
+ *   2. the same payload spelled out as 16 uppercase hex ASCII characters
+ *
+ * The checksum is the low byte of the payload sum. That is not a guess -- it reproduces the
+ * checksum byte of all three known-good commands below (0x5b, 0x33, 0x43), which is why this
+ * computes it instead of carrying opaque constants.
+ */
+#define AYANEO_MCU_PAYLOAD_LEN		8
+#define AYANEO_MCU_BINARY_LEN		(AYANEO_MCU_PAYLOAD_LEN + 3)
+#define AYANEO_MCU_ASCII_LEN		(AYANEO_MCU_PAYLOAD_LEN * 2)
+#define AYANEO_MCU_FRAME_START		0xe7
+#define AYANEO_MCU_FRAME_END		0xed
+
+/* Switch the MCU to its Xbox 360 personality (045e:028e). */
+static const u8 ayaneo_mcu_cmd_xbox360[AYANEO_MCU_PAYLOAD_LEN] = {
+	0x55, 0x05, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00,
+};
+
+/*
+ * Swap the face buttons the Xbox 360 personality reports: A<->B and X<->Y.
+ *
+ * These handhelds do not agree on what is printed where. On a Pocket ACE or DMG the BOTTOM button
+ * is printed `B` and the right one `A`, the Nintendo arrangement; on an EVO, DS, Pocket S or
+ * Pocket S2 the bottom button is `A`, the Xbox arrangement. The MCU reports by LABEL, so on the
+ * first group every face button lands one position from where it should be until this is sent.
+ *
+ * ONLY THE BOARDS THAT NEED THE SWAP SEND ANYTHING. The same command with 0x1f in place of 0x0f
+ * selects the unswapped layout, and the reference this was ported from sends it to the
+ * Xbox-labelled boards -- but those boards report correctly here having never been sent any
+ * layout command at all, so 0x1f is what the MCU already does and saying it again is noise. It is
+ * recorded here rather than implemented, so that a board which ever does come up swapped has a
+ * documented lever instead of a rediscovery.
+ */
+static const u8 ayaneo_mcu_cmd_swap_faces[AYANEO_MCU_PAYLOAD_LEN] = {
+	0x00, 0x00, 0x22, 0x02, 0x00, 0x00, 0x00, 0x0f,
+};
+
+struct ayaneo_mcu {
+	struct serdev_device *serdev;
+	struct notifier_block pm_nb;
+	struct delayed_work config_work;
+	struct completion reply;
+	spinlock_t rx_lock;		/* guards rx and rx_len */
+	u8 rx[AYANEO_MCU_RX_LEN];
+	size_t rx_len;
+	unsigned int attempt;
+	bool xbox360_mode;
+	bool swap_faces;
+};
+
+/*
+ * Keep the first bytes of whatever the MCU says and wake the attempt that is waiting. The content
+ * is not interpreted -- only the fact that it arrived is load-bearing -- but it is logged, because
+ * the next person to extend this protocol will want to know what an answer looks like.
+ */
+static size_t ayaneo_mcu_receive_buf(struct serdev_device *serdev, const u8 *data, size_t count)
+{
+	struct ayaneo_mcu *mcu = serdev_device_get_drvdata(serdev);
+	unsigned long flags;
+	size_t room;
+
+	spin_lock_irqsave(&mcu->rx_lock, flags);
+	room = sizeof(mcu->rx) - mcu->rx_len;
+	if (room) {
+		size_t n = min(count, room);
+
+		memcpy(mcu->rx + mcu->rx_len, data, n);
+		mcu->rx_len += n;
+	}
+	spin_unlock_irqrestore(&mcu->rx_lock, flags);
+
+	complete(&mcu->reply);
+	return count;
+}
+
+static const struct serdev_device_ops ayaneo_mcu_serdev_ops = {
+	.receive_buf = ayaneo_mcu_receive_buf,
+	.write_wakeup = serdev_device_write_wakeup,
+};
+
+static int ayaneo_mcu_write_full(struct ayaneo_mcu *mcu, const u8 *data, size_t len)
+{
+	ssize_t ret;
+
+	ret = serdev_device_write(mcu->serdev, data, len,
+				  msecs_to_jiffies(AYANEO_MCU_TX_TIMEOUT_MS));
+	if (ret < 0)
+		return ret;
+	if (ret != len)
+		return -ETIMEDOUT;
+
+	serdev_device_wait_until_sent(mcu->serdev,
+				      msecs_to_jiffies(AYANEO_MCU_DRAIN_TIMEOUT_MS));
+	return 0;
+}
+
+/* Send one command: the binary frame, then the same payload as hex ASCII. */
+static int ayaneo_mcu_send_command(struct ayaneo_mcu *mcu, const u8 *payload)
+{
+	u8 binary[AYANEO_MCU_BINARY_LEN];
+	char ascii[AYANEO_MCU_ASCII_LEN];
+	u8 checksum = 0;
+	unsigned int i;
+	int ret;
+
+	binary[0] = AYANEO_MCU_FRAME_START;
+	for (i = 0; i < AYANEO_MCU_PAYLOAD_LEN; i++) {
+		binary[1 + i] = payload[i];
+		checksum += payload[i];
+		hex_byte_pack_upper(&ascii[i * 2], payload[i]);
+	}
+	binary[AYANEO_MCU_PAYLOAD_LEN + 1] = checksum;
+	binary[AYANEO_MCU_PAYLOAD_LEN + 2] = AYANEO_MCU_FRAME_END;
+
+	dev_dbg(&mcu->serdev->dev, "TX binary %*ph / ascii %*ph\n",
+		(int)sizeof(binary), binary, (int)sizeof(ascii), ascii);
+
+	ret = ayaneo_mcu_write_full(mcu, binary, sizeof(binary));
+	if (ret)
+		return ret;
+	msleep(AYANEO_MCU_FRAME_GAP_MS);
+
+	ret = ayaneo_mcu_write_full(mcu, (const u8 *)ascii, sizeof(ascii));
+	if (ret)
+		return ret;
+	msleep(AYANEO_MCU_FRAME_GAP_MS);
+
+	return 0;
+}
+
+/*
+ * DEBUG SURFACE -- NOT PART OF THE FEATURE, and it must not survive into a shipping image.
+ *
+ * The MCU's command set is not documented anywhere we can reach. It is known by three frames
+ * copied out of a shell script, one of which does not visibly do what its comment says. Every
+ * hypothesis about why costs a full image build to test, which is how a protocol question turns
+ * into a week. These two attributes make an experiment cost a round trip instead:
+ *
+ *   command   eight payload bytes as hex; the driver builds the binary+ASCII pair as it does for
+ *             its own commands, so this exercises the SAME path the feature uses
+ *   raw       arbitrary bytes as hex, written verbatim with no framing, so a byte sequence can be
+ *             replayed exactly and the driver's frame construction taken out of the question
+ *
+ * Both log what they sent and whatever came back, and neither touches the retry state machine.
+ */
+static ssize_t ayaneo_mcu_parse_hex(const char *buf, size_t len, u8 *out, size_t out_max)
+{
+	size_t n = 0;
+	int hi, lo;
+
+	while (len && n < out_max) {
+		while (len && (*buf == ' ' || *buf == ',' || *buf == '\n' || *buf == '\t')) {
+			buf++;
+			len--;
+		}
+		if (!len)
+			break;
+		if (len < 2)
+			return -EINVAL;
+		hi = hex_to_bin(buf[0]);
+		lo = hex_to_bin(buf[1]);
+		if (hi < 0 || lo < 0)
+			return -EINVAL;
+		out[n++] = (hi << 4) | lo;
+		buf += 2;
+		len -= 2;
+	}
+
+	return n;
+}
+
+static void ayaneo_mcu_report_reply(struct ayaneo_mcu *mcu, const char *what)
+{
+	struct device *dev = &mcu->serdev->dev;
+	u8 rx[AYANEO_MCU_RX_LEN];
+	unsigned long flags;
+	size_t rx_len;
+
+	if (!wait_for_completion_timeout(&mcu->reply,
+					 msecs_to_jiffies(AYANEO_MCU_REPLY_TIMEOUT_MS))) {
+		dev_info(dev, "%s: no answer\n", what);
+		return;
+	}
+
+	spin_lock_irqsave(&mcu->rx_lock, flags);
+	rx_len = min(mcu->rx_len, sizeof(rx));
+	memcpy(rx, mcu->rx, rx_len);
+	spin_unlock_irqrestore(&mcu->rx_lock, flags);
+
+	dev_info(dev, "%s: answered %*ph\n", what, (int)rx_len, rx);
+}
+
+static void ayaneo_mcu_arm_reply(struct ayaneo_mcu *mcu)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&mcu->rx_lock, flags);
+	mcu->rx_len = 0;
+	spin_unlock_irqrestore(&mcu->rx_lock, flags);
+	reinit_completion(&mcu->reply);
+}
+
+static ssize_t command_store(struct device *dev, struct device_attribute *attr,
+			     const char *buf, size_t count)
+{
+	struct ayaneo_mcu *mcu = dev_get_drvdata(dev);
+	u8 payload[AYANEO_MCU_PAYLOAD_LEN];
+	ssize_t n;
+	int ret;
+
+	n = ayaneo_mcu_parse_hex(buf, count, payload, sizeof(payload));
+	if (n < 0)
+		return n;
+	if (n != AYANEO_MCU_PAYLOAD_LEN)
+		return -EINVAL;
+
+	ayaneo_mcu_arm_reply(mcu);
+	ret = ayaneo_mcu_send_command(mcu, payload);
+	if (ret)
+		return ret;
+	ayaneo_mcu_report_reply(mcu, "command");
+
+	return count;
+}
+static DEVICE_ATTR_WO(command);
+
+static ssize_t raw_store(struct device *dev, struct device_attribute *attr,
+			 const char *buf, size_t count)
+{
+	struct ayaneo_mcu *mcu = dev_get_drvdata(dev);
+	u8 bytes[64];
+	ssize_t n;
+	int ret;
+
+	n = ayaneo_mcu_parse_hex(buf, count, bytes, sizeof(bytes));
+	if (n <= 0)
+		return n ? n : -EINVAL;
+
+	dev_info(dev, "raw: sending %*ph\n", (int)n, bytes);
+	ayaneo_mcu_arm_reply(mcu);
+	ret = ayaneo_mcu_write_full(mcu, bytes, n);
+	if (ret)
+		return ret;
+	ayaneo_mcu_report_reply(mcu, "raw");
+
+	return count;
+}
+static DEVICE_ATTR_WO(raw);
+
+static struct attribute *ayaneo_mcu_attrs[] = {
+	&dev_attr_command.attr,
+	&dev_attr_raw.attr,
+	NULL,
+};
+static const struct attribute_group ayaneo_mcu_group = {
+	.attrs = ayaneo_mcu_attrs,
+};
+
+static int ayaneo_mcu_configure(struct ayaneo_mcu *mcu)
+{
+	int ret;
+
+	ret = ayaneo_mcu_send_command(mcu, ayaneo_mcu_cmd_xbox360);
+	if (ret)
+		return ret;
+
+	if (!mcu->swap_faces)
+		return 0;
+
+	return ayaneo_mcu_send_command(mcu, ayaneo_mcu_cmd_swap_faces);
+}
+
+/*
+ * One attempt: say it, then listen. Silence means the MCU is not up yet, so come back and say it
+ * again; an answer means it heard us and this is finished.
+ *
+ * Everything happens here rather than in probe because an attempt sleeps -- 400ms of frame gaps
+ * plus the listen window -- and because there may be fifteen of them.
+ */
+static void ayaneo_mcu_config_work(struct work_struct *work)
+{
+	struct ayaneo_mcu *mcu = container_of(to_delayed_work(work), struct ayaneo_mcu, config_work);
+	struct device *dev = &mcu->serdev->dev;
+	u8 rx[AYANEO_MCU_RX_LEN];
+	unsigned long flags;
+	size_t rx_len;
+	int ret;
+
+	mcu->attempt++;
+
+	spin_lock_irqsave(&mcu->rx_lock, flags);
+	mcu->rx_len = 0;
+	spin_unlock_irqrestore(&mcu->rx_lock, flags);
+	reinit_completion(&mcu->reply);
+
+	ret = ayaneo_mcu_configure(mcu);
+	if (ret) {
+		dev_warn(dev, "attempt %u: could not send to the MCU: %d\n", mcu->attempt, ret);
+		return;
+	}
+
+	if (!wait_for_completion_timeout(&mcu->reply,
+					 msecs_to_jiffies(AYANEO_MCU_REPLY_TIMEOUT_MS))) {
+		if (mcu->attempt < AYANEO_MCU_MAX_ATTEMPTS) {
+			dev_dbg(dev, "attempt %u: no answer, asking again\n", mcu->attempt);
+			schedule_delayed_work(&mcu->config_work,
+					      msecs_to_jiffies(AYANEO_MCU_RETRY_MS));
+			return;
+		}
+		dev_warn(dev,
+			 "MCU never answered in %u attempts -- the controller is left as it came up\n",
+			 mcu->attempt);
+		return;
+	}
+
+	spin_lock_irqsave(&mcu->rx_lock, flags);
+	rx_len = min(mcu->rx_len, sizeof(rx));
+	memcpy(rx, mcu->rx, rx_len);
+	spin_unlock_irqrestore(&mcu->rx_lock, flags);
+
+	dev_info(dev, "MCU configured on attempt %u (Xbox 360 mode%s); it answered %*ph\n",
+		 mcu->attempt, mcu->swap_faces ? ", face buttons swapped" : "",
+		 (int)rx_len, rx);
+}
+
+/*
+ * Start over on resume.
+ *
+ * A board that never reaches a real system suspend never runs this, which is the case today --
+ * these handhelds suspend by freezing userspace, where the MCU keeps its state because it was
+ * never powered down. It exists for the boards that do, where losing the mode would silently
+ * return the pad to direct input and take rumble with it.
+ */
+static void ayaneo_mcu_restart(struct ayaneo_mcu *mcu)
+{
+	mcu->attempt = 0;
+	mod_delayed_work(system_wq, &mcu->config_work, 0);
+}
+
+static int ayaneo_mcu_pm_notify(struct notifier_block *nb, unsigned long action, void *data)
+{
+	struct ayaneo_mcu *mcu = container_of(nb, struct ayaneo_mcu, pm_nb);
+
+	switch (action) {
+	case PM_POST_SUSPEND:
+	case PM_POST_HIBERNATION:
+	case PM_POST_RESTORE:
+		ayaneo_mcu_restart(mcu);
+		break;
+	default:
+		break;
+	}
+
+	return NOTIFY_DONE;
+}
+
+static void ayaneo_mcu_unregister_pm_notifier(void *data)
+{
+	struct ayaneo_mcu *mcu = data;
+
+	unregister_pm_notifier(&mcu->pm_nb);
+	cancel_delayed_work_sync(&mcu->config_work);
+}
+
+static int ayaneo_mcu_probe(struct serdev_device *serdev)
+{
+	struct device *dev = &serdev->dev;
+	struct ayaneo_mcu *mcu;
+	unsigned int baud;
+	int ret;
+
+	mcu = devm_kzalloc(dev, sizeof(*mcu), GFP_KERNEL);
+	if (!mcu)
+		return -ENOMEM;
+
+	mcu->serdev = serdev;
+	mcu->xbox360_mode = device_property_read_bool(dev, "ayaneo,xbox360-mode");
+	mcu->swap_faces = device_property_read_bool(dev, "ayaneo,swap-face-buttons");
+	INIT_DELAYED_WORK(&mcu->config_work, ayaneo_mcu_config_work);
+	init_completion(&mcu->reply);
+	spin_lock_init(&mcu->rx_lock);
+	serdev_device_set_drvdata(serdev, mcu);
+	serdev_device_set_client_ops(serdev, &ayaneo_mcu_serdev_ops);
+
+	ret = devm_serdev_device_open(dev, serdev);
+	if (ret)
+		return dev_err_probe(dev, ret, "could not open the controller UART\n");
+
+	baud = serdev_device_set_baudrate(serdev, AYANEO_MCU_BAUD_RATE);
+	if (baud != AYANEO_MCU_BAUD_RATE)
+		return dev_err_probe(dev, -EINVAL,
+				     "could not set 115200 baud (got %u)\n", baud);
+
+	serdev_device_set_flow_control(serdev, false);
+	ret = serdev_device_set_parity(serdev, SERDEV_PARITY_NONE);
+	if (ret)
+		return dev_err_probe(dev, ret, "could not set 8N1 framing\n");
+
+	/*
+	 * Without the property this driver still binds and still owns the port, it just sends
+	 * nothing. That is the point of claiming it either way: a board whose MCU should stay in
+	 * direct-input mode says so by omitting the property, not by leaving the UART unowned.
+	 *
+	 * The face-button swap goes with the mode switch and only with it -- it configures the
+	 * Xbox personality, so it has nothing to say to an MCU that is not in it.
+	 *
+	 * Probe does not send anything itself: the MCU is not up yet at this point on any board
+	 * measured, so the first attempt is scheduled like every retry after it.
+	 */
+	mcu->pm_nb.notifier_call = ayaneo_mcu_pm_notify;
+	ret = register_pm_notifier(&mcu->pm_nb);
+	if (ret)
+		return dev_err_probe(dev, ret, "could not register the PM notifier\n");
+
+	ret = devm_add_action_or_reset(dev, ayaneo_mcu_unregister_pm_notifier, mcu);
+	if (ret)
+		return ret;
+
+	/* Debug surface; see the block comment above command_store. Remove before shipping. */
+	ret = devm_device_add_group(dev, &ayaneo_mcu_group);
+	if (ret)
+		return dev_err_probe(dev, ret, "could not create the debug attributes\n");
+
+	if (mcu->xbox360_mode) {
+		dev_info(dev, "AYANEO serial MCU registered, waiting for the MCU to answer\n");
+		ayaneo_mcu_restart(mcu);
+	} else {
+		dev_info(dev, "AYANEO serial MCU registered (left in direct-input mode)\n");
+	}
+
+	return 0;
+}
+
+static const struct of_device_id ayaneo_mcu_of_match[] = {
+	{ .compatible = "ayaneo,serial-mcu" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ayaneo_mcu_of_match);
+
+static struct serdev_device_driver ayaneo_mcu_driver = {
+	.probe = ayaneo_mcu_probe,
+	.driver = {
+		.name = "ayaneo-serial-mcu",
+		.of_match_table = ayaneo_mcu_of_match,
+	},
+};
+module_serdev_device_driver(ayaneo_mcu_driver);
+
+MODULE_DESCRIPTION("AYANEO handheld controller MCU serial interface");
+MODULE_LICENSE("GPL");
