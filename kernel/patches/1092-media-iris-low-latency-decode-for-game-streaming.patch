From: virtudude <virtudude@protonmail.com>
Subject: [PATCH] media: iris: low latency decode for game streaming

Game streaming clients (Steam Remote Play, Moonlight) decode each frame
as it arrives. Iris sizes decode for playback, which decodes ahead of
display: stage 2 and the lowest clock that sustains the stream, so each
frame comes back later than it could. Six changes, carried as one:

1. Count CABAC and per-macroblock cost in the decoder VSP clock. The
   estimate assumed the CAVLC rate (half a cycle per bit) for every
   codec; H.264 and HEVC are normally CABAC, costed downstream at 1.35
   cycles per bit plus 25 per macroblock. The low estimate kept high
   bitrate sessions at the lowest OPP, where decode fell behind.
2. Add V4L2_CID_MPEG_VIDEO_DEC_DISPLAY_DELAY_ENABLE and _DISPLAY_DELAY
   to the gen2 decoder. As in venus, an enabled delay of 0 selects
   decode order output; the property is only sent once a client sets it.
3. Decode in stage 1 when decode order is requested.
4. Vote the top OPP for decode order sessions. The top OPP vote plus
   another session's vote does not fit in a u32, so iris_vpu_power_on()
   restores the vote as an unsigned long.
5. Rescale decoder power only when a bitstream buffer is queued. A
   capture QBUF with no bitstream pending set max_input_data_size to 0,
   so in a live stream the DDR vote flapped between the floor and the
   session's vote every frame.
6. Treat decoder sessions up to the macroblock count of 4096x2160 as
   low latency by default: stage 1 and the top OPP. Decode order stays
   opt-in, since it would return B-frame streams out of display order.
   qcom_iris.low_latency=0 restores the computed clock and stage 2.

Note for a new gen2 platform: (1) reads mb_cycles_vsp from the platform
caps; a header without it drops the per-macroblock term.
---
diff --git a/drivers/media/platform/qcom/iris/iris_ctrls.c b/drivers/media/platform/qcom/iris/iris_ctrls.c
index 232be0c..abe8e03 100644
--- a/drivers/media/platform/qcom/iris/iris_ctrls.c
+++ b/drivers/media/platform/qcom/iris/iris_ctrls.c
@@ -14,6 +14,11 @@
 #define CABAC_MAX_BITRATE 160000000
 #define CAVLC_MAX_BITRATE 220000000
 
+static bool iris_low_latency = true;
+module_param_named(low_latency, iris_low_latency, bool, 0444);
+MODULE_PARM_DESC(low_latency,
+		 "decode up to the macroblock count of 4096x2160 in stage 1 at the top clock (default: on)");
+
 static inline bool iris_valid_cap_id(enum platform_inst_fw_cap_type cap_id)
 {
 	return cap_id >= 1 && cap_id < INST_FW_CAP_MAX;
@@ -102,6 +107,10 @@ static enum platform_inst_fw_cap_type iris_get_cap_id(u32 id)
 		return PROFILE_AV1;
 	case V4L2_CID_MPEG_VIDEO_AV1_LEVEL:
 		return LEVEL_AV1;
+	case V4L2_CID_MPEG_VIDEO_DEC_DISPLAY_DELAY_ENABLE:
+		return DISPLAY_DELAY_ENABLE;
+	case V4L2_CID_MPEG_VIDEO_DEC_DISPLAY_DELAY:
+		return DISPLAY_DELAY;
 	case V4L2_CID_ROTATE:
 		return ROTATION;
 	case V4L2_CID_HFLIP:
@@ -247,6 +256,10 @@ static u32 iris_get_v4l2_id(enum platform_inst_fw_cap_type cap_id)
 		return V4L2_CID_MPEG_VIDEO_AV1_PROFILE;
 	case LEVEL_AV1:
 		return V4L2_CID_MPEG_VIDEO_AV1_LEVEL;
+	case DISPLAY_DELAY_ENABLE:
+		return V4L2_CID_MPEG_VIDEO_DEC_DISPLAY_DELAY_ENABLE;
+	case DISPLAY_DELAY:
+		return V4L2_CID_MPEG_VIDEO_DEC_DISPLAY_DELAY;
 	case ROTATION:
 		return V4L2_CID_ROTATE;
 	case HFLIP:
@@ -511,6 +524,42 @@ int iris_set_u32(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id)
 					     &hfi_value, sizeof(u32));
 }
 
+static bool iris_dec_decode_order(struct iris_inst *inst)
+{
+	return inst->domain == DECODER &&
+		inst->fw_caps[DISPLAY_DELAY_ENABLE].value &&
+		!inst->fw_caps[DISPLAY_DELAY].value;
+}
+
+bool iris_dec_low_latency(struct iris_inst *inst)
+{
+	struct v4l2_pix_format_mplane *f = &inst->fmt_src->fmt.pix_mp;
+
+	if (inst->domain != DECODER)
+		return false;
+
+	/* larger frames keep stage 2 for its throughput */
+	return iris_dec_decode_order(inst) ||
+		(iris_low_latency &&
+		 NUM_MBS_PER_FRAME(f->height, f->width) <= NUM_MBS_PER_FRAME(2160, 4096));
+}
+
+int iris_set_decode_order(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id)
+{
+	const struct iris_hfi_session_ops *hfi_ops = inst->hfi_session_ops;
+	u32 hfi_id = inst->fw_caps[cap_id].hfi_id;
+	u32 hfi_value = iris_dec_decode_order(inst);
+
+	if (!(inst->fw_caps[DISPLAY_DELAY_ENABLE].flags & CAP_FLAG_CLIENT_SET))
+		return 0;
+
+	return hfi_ops->session_set_property(inst, hfi_id,
+					     HFI_HOST_FLAGS_NONE,
+					     iris_get_port_info(inst, cap_id),
+					     HFI_PAYLOAD_U32,
+					     &hfi_value, sizeof(u32));
+}
+
 int iris_set_stage(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id)
 {
 	const struct iris_hfi_session_ops *hfi_ops = inst->hfi_session_ops;
@@ -521,7 +570,8 @@ int iris_set_stage(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id
 	u32 work_mode = STAGE_2;
 
 	if (inst->domain == DECODER) {
-		if (iris_res_is_less_than(width, height, 1280, 720))
+		if (iris_res_is_less_than(width, height, 1280, 720) ||
+		    iris_dec_low_latency(inst))
 			work_mode = STAGE_1;
 	}
 
diff --git a/drivers/media/platform/qcom/iris/iris_ctrls.h b/drivers/media/platform/qcom/iris/iris_ctrls.h
index 5180d53..ab89bea 100644
--- a/drivers/media/platform/qcom/iris/iris_ctrls.h
+++ b/drivers/media/platform/qcom/iris/iris_ctrls.h
@@ -15,6 +15,8 @@ int iris_ctrls_init(struct iris_inst *inst);
 void iris_session_init_caps(struct iris_core *core);
 int iris_set_u32_enum(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id);
 int iris_set_stage(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id);
+bool iris_dec_low_latency(struct iris_inst *inst);
+int iris_set_decode_order(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id);
 int iris_set_pipe(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id);
 int iris_set_u32(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id);
 int iris_set_profile(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id);
diff --git a/drivers/media/platform/qcom/iris/iris_hfi_gen2.c b/drivers/media/platform/qcom/iris/iris_hfi_gen2.c
index 3b8fbef..bb1d72d 100644
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen2.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen2.c
@@ -1102,6 +1102,23 @@ static const struct platform_inst_fw_cap inst_fw_cap_sm8550_dec[] = {
 		.flags = CAP_FLAG_INPUT_PORT,
 		.set = iris_set_u32,
 	},
+	{
+		.cap_id = DISPLAY_DELAY_ENABLE,
+		.min = 0,
+		.max = 1,
+		.step_or_mask = 1,
+		.value = 0,
+		.hfi_id = HFI_PROP_DECODE_ORDER_OUTPUT,
+		.flags = CAP_FLAG_INPUT_PORT,
+		.set = iris_set_decode_order,
+	},
+	{
+		.cap_id = DISPLAY_DELAY,
+		.min = 0,
+		.max = 16383,
+		.step_or_mask = 1,
+		.value = 0,
+	},
 };
 
 static const struct platform_inst_fw_cap inst_fw_cap_sm8550_enc[] = {
diff --git a/drivers/media/platform/qcom/iris/iris_hfi_gen2_defines.h b/drivers/media/platform/qcom/iris/iris_hfi_gen2_defines.h
index f43aea1..5a56536 100644
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen2_defines.h
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen2_defines.h
@@ -128,6 +128,7 @@ enum hfi_flip {
 
 #define HFI_PROP_FLIP				0x0300014c
 #define HFI_PROP_SIGNAL_COLOR_INFO		0x03000155
+#define HFI_PROP_DECODE_ORDER_OUTPUT		0x0300015b
 #define HFI_PROP_PICTURE_TYPE			0x03000162
 #define HFI_PROP_DEC_DEFAULT_HEADER		0x03000168
 #define HFI_PROP_DEC_START_FROM_RAP_FRAME	0x03000169
diff --git a/drivers/media/platform/qcom/iris/iris_platform_common.h b/drivers/media/platform/qcom/iris/iris_platform_common.h
index 9748095..1a8e691 100644
--- a/drivers/media/platform/qcom/iris/iris_platform_common.h
+++ b/drivers/media/platform/qcom/iris/iris_platform_common.h
@@ -126,6 +126,8 @@ enum platform_inst_fw_cap_type {
 	CODED_FRAMES,
 	BIT_DEPTH,
 	RAP_FRAME,
+	DISPLAY_DELAY_ENABLE,
+	DISPLAY_DELAY,
 	TIER,
 	HEADER_MODE,
 	PREPEND_SPSPPS_TO_IDR,
diff --git a/drivers/media/platform/qcom/iris/iris_platform_qcs8300.h b/drivers/media/platform/qcom/iris/iris_platform_qcs8300.h
index 3cfecae..1d1f2fa 100644
--- a/drivers/media/platform/qcom/iris/iris_platform_qcs8300.h
+++ b/drivers/media/platform/qcom/iris/iris_platform_qcs8300.h
@@ -12,6 +12,7 @@ static struct platform_inst_caps platform_inst_cap_qcs8300 = {
 	.min_frame_height = 96,
 	.max_frame_height = 4096,
 	.max_mbpf = (4096 * 2176) / 256,
+	.mb_cycles_vsp = 25,
 	.mb_cycles_vpp = 200,
 	.mb_cycles_fw = 326389,
 	.mb_cycles_fw_vpp = 44156,
diff --git a/drivers/media/platform/qcom/iris/iris_platform_sm8550.h b/drivers/media/platform/qcom/iris/iris_platform_sm8550.h
index 3c9dae9..e1273ae 100644
--- a/drivers/media/platform/qcom/iris/iris_platform_sm8550.h
+++ b/drivers/media/platform/qcom/iris/iris_platform_sm8550.h
@@ -20,6 +20,7 @@ static struct platform_inst_caps platform_inst_cap_sm8550 = {
 	.min_frame_height = 96,
 	.max_frame_height = 8192,
 	.max_mbpf = (8192 * 4352) / 256,
+	.mb_cycles_vsp = 25,
 	.mb_cycles_vpp = 200,
 	.mb_cycles_fw = 489583,
 	.mb_cycles_fw_vpp = 66234,
diff --git a/drivers/media/platform/qcom/iris/iris_power.c b/drivers/media/platform/qcom/iris/iris_power.c
index 91aa21d..31e8a78 100644
--- a/drivers/media/platform/qcom/iris/iris_power.c
+++ b/drivers/media/platform/qcom/iris/iris_power.c
@@ -8,6 +8,7 @@
 #include <media/v4l2-mem2mem.h>
 
 #include "iris_buffer.h"
+#include "iris_ctrls.h"
 #include "iris_instance.h"
 #include "iris_power.h"
 #include "iris_resources.h"
@@ -114,7 +115,10 @@ static int iris_scale_clocks(struct iris_inst *inst)
 	if (!inst->max_input_data_size)
 		return 0;
 
-	inst->power.min_freq = vpu_ops->calc_freq(inst, inst->max_input_data_size);
+	if (iris_dec_low_latency(inst))
+		inst->power.min_freq = U32_MAX;
+	else
+		inst->power.min_freq = vpu_ops->calc_freq(inst, inst->max_input_data_size);
 
 	return iris_set_clocks(inst);
 }
diff --git a/drivers/media/platform/qcom/iris/iris_vb2.c b/drivers/media/platform/qcom/iris/iris_vb2.c
index a2ea2d6..542a2be 100644
--- a/drivers/media/platform/qcom/iris/iris_vb2.c
+++ b/drivers/media/platform/qcom/iris/iris_vb2.c
@@ -244,6 +244,9 @@ void iris_vb2_stop_streaming(struct vb2_queue *q)
 	if (ret)
 		goto exit;
 
+	if (V4L2_TYPE_IS_OUTPUT(q->type))
+		inst->max_input_data_size = 0;
+
 exit:
 	iris_helper_buffers_done(inst, q->type, VB2_BUF_STATE_ERROR);
 	if (ret)
diff --git a/drivers/media/platform/qcom/iris/iris_vdec.c b/drivers/media/platform/qcom/iris/iris_vdec.c
index 9e228b7..0b520e5 100644
--- a/drivers/media/platform/qcom/iris/iris_vdec.c
+++ b/drivers/media/platform/qcom/iris/iris_vdec.c
@@ -459,9 +459,9 @@ int iris_vdec_qbuf(struct iris_inst *inst, struct vb2_v4l2_buffer *vbuf)
 						   MAXIMUM_FPS);
 			inst->frame_counter = 0;
 		}
-	}
 
-	iris_scale_power(inst);
+		iris_scale_power(inst);
+	}
 
 	return iris_queue_buffer(inst, buf);
 }
diff --git a/drivers/media/platform/qcom/iris/iris_vpu_common.c b/drivers/media/platform/qcom/iris/iris_vpu_common.c
index e4847c1..164ea39 100644
--- a/drivers/media/platform/qcom/iris/iris_vpu_common.c
+++ b/drivers/media/platform/qcom/iris/iris_vpu_common.c
@@ -428,6 +428,7 @@ u64 iris_vpu3x_vpu4x_calculate_frequency(struct iris_inst *inst, size_t data_siz
 	u64 fw_cycles, fw_vpp_cycles;
 	u64 vsp_cycles, vpp_cycles;
 	u32 fps = inst->frame_rate;
+	u32 vsp_mb_cycles = 0;
 
 	width = max(inp_f->fmt.pix_mp.width, inst->crop.width);
 	height = max(inp_f->fmt.pix_mp.height, inst->crop.height);
@@ -451,19 +452,28 @@ u64 iris_vpu3x_vpu4x_calculate_frequency(struct iris_inst *inst, size_t data_siz
 		vpp_cycles += div_u64(vpp_cycles * 5, 100);
 
 	vsp_cycles = fps * data_size * 8;
-	vsp_cycles = div_u64(vsp_cycles, 2);
+	/* the decoder cannot see the entropy mode, so cost H.264 as CABAC */
+	if (inst->domain == DECODER &&
+	    (inst->codec == V4L2_PIX_FMT_H264 || inst->codec == V4L2_PIX_FMT_HEVC)) {
+		vsp_cycles = div_u64(vsp_cycles * 135, 100);
+		vsp_mb_cycles = caps->mb_cycles_vsp;
+	} else {
+		vsp_cycles = div_u64(vsp_cycles, 2);
+	}
 	/* VSP FW overhead 1.05 */
 	vsp_cycles = div_u64(vsp_cycles * 21, 20);
 
 	if (inst->fw_caps[STAGE].value == STAGE_1)
 		vsp_cycles = vsp_cycles * 3;
 
+	vsp_cycles += (u64)mbs_per_second * vsp_mb_cycles;
+
 	return max3(vpp_cycles, vsp_cycles, fw_cycles);
 }
 
 int iris_vpu_power_on(struct iris_core *core)
 {
-	u32 freq;
+	unsigned long freq;
 	int ret;
 
 	ret = iris_set_icc_bw(core, INT_MAX);
@@ -478,8 +488,7 @@ int iris_vpu_power_on(struct iris_core *core)
 	if (ret)
 		goto err_power_off_ctrl;
 
-	freq = core->power.clk_freq ? core->power.clk_freq :
-				      (u32)ULONG_MAX;
+	freq = core->power.clk_freq ? core->power.clk_freq : ULONG_MAX;
 
 	iris_opp_set_rate(core->dev, freq);
 
