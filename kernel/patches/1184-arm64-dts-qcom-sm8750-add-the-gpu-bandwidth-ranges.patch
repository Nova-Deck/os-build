From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Andr=C3=A9=20Braga?= <code@andrebraga.com>
Date: Thu, 5 Nov 2026 21:44:21 +0000
Subject: [PATCH] arm64: dts: qcom: sm8750: add the GPU's bandwidth ranges

Take each GPU level's lowest and highest DDR bandwidth from the SM8750
vendor DT of the AYN Odin 3 (qcom,gpu-pwrlevels bus-min and bus-max,
through its DDR bus table).
---
 arch/arm64/boot/dts/qcom/sm8750.dtsi | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8750.dtsi b/arch/arm64/boot/dts/qcom/sm8750.dtsi
index e81facb47..6f2114c79 100644
--- a/arch/arm64/boot/dts/qcom/sm8750.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm8750.dtsi
@@ -3876,6 +3876,7 @@ opp-342000000 {
 					opp-hz = /bits/ 64 <342000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_LOW_SVS_D1>;
 					opp-peak-kBps = <5285156>;
+					qcom,opp-peak-kBps-range = <2136718 5285156>;
 					opp-supported-hw = <0x1f>;
 				};
 
@@ -3883,6 +3884,7 @@ opp-389000000 {
 					opp-hz = /bits/ 64 <389000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_LOW_SVS_D0>;
 					opp-peak-kBps = <6074218>;
+					qcom,opp-peak-kBps-range = <2136718 8171875>;
 					qcom,opp-acd-level = <0xc8285ffd>;
 					opp-supported-hw = <0x1f>;
 				};
@@ -3891,6 +3893,7 @@ opp-443000000 {
 					opp-hz = /bits/ 64 <443000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_LOW_SVS>;
 					opp-peak-kBps = <6074218>;
+					qcom,opp-peak-kBps-range = <2136718 8171875>;
 					qcom,opp-acd-level = <0xc02e5ffd>;
 					opp-supported-hw = <0x1f>;
 				};
@@ -3899,6 +3902,7 @@ opp-525000000 {
 					opp-hz = /bits/ 64 <525000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_LOW_SVS_L1>;
 					opp-peak-kBps = <6074218>;
+					qcom,opp-peak-kBps-range = <2136718 8171875>;
 					qcom,opp-acd-level = <0xc02e5ffd>;
 					opp-supported-hw = <0x1f>;
 				};
@@ -3907,6 +3911,7 @@ opp-607000000 {
 					opp-hz = /bits/ 64 <607000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_SVS>;
 					opp-peak-kBps = <8171875>;
+					qcom,opp-peak-kBps-range = <6074218 12449218>;
 					qcom,opp-acd-level = <0xa82e5ffd>;
 					opp-supported-hw = <0x1f>;
 				};
@@ -3915,6 +3920,7 @@ opp-660000000 {
 					opp-hz = /bits/ 64 <660000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_SVS_L0>;
 					opp-peak-kBps = <8171875>;
+					qcom,opp-peak-kBps-range = <6074218 12449218>;
 					qcom,opp-acd-level = <0x882c5ffd>;
 					opp-supported-hw = <0x1f>;
 				};
@@ -3923,6 +3929,7 @@ opp-734000000 {
 					opp-hz = /bits/ 64 <734000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_SVS_L1>;
 					opp-peak-kBps = <12449218>;
+					qcom,opp-peak-kBps-range = <8171875 16500000>;
 					qcom,opp-acd-level = <0xa82a5ffd>;
 					opp-supported-hw = <0x1f>;
 				};
@@ -3931,6 +3938,7 @@ opp-832000000 {
 					opp-hz = /bits/ 64 <832000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_SVS_L2>;
 					opp-peak-kBps = <16500000>;
+					qcom,opp-peak-kBps-range = <10687500 16500000>;
 					qcom,opp-acd-level = <0x882a5ffd>;
 					opp-supported-hw = <0x1f>;
 				};
@@ -3939,6 +3947,7 @@ opp-900000000-0 {
 					opp-hz = /bits/ 64 <900000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_NOM>;
 					opp-peak-kBps = <16500000>;
+					qcom,opp-peak-kBps-range = <10687500 16500000>;
 					qcom,opp-acd-level = <0x882a5ffd>;
 					opp-supported-hw = <0x0f>;
 				};
@@ -3948,6 +3957,7 @@ opp-900000000-1 {
 					opp-hz = /bits/ 64 <900000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_NOM>;
 					opp-peak-kBps = <18597656>;
+					qcom,opp-peak-kBps-range = <10687500 16500000>;
 					qcom,opp-acd-level = <0x882a5ffd>;
 					opp-supported-hw = <0x10>;
 				};
