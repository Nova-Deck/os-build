From: sunshineinabox <aqemail@gmail.com>
Date: Tue, 17 Nov 2026 06:00:00 +0000
Subject: [PATCH] arm64: dts: qcom: sm8750: give the DSI controllers an xo clock

Add bi_tcxo_div2, parent 0 of the byte and pixel RCGs, to both DSI
controllers as "xo", so the DSI host can park the two sources on it
while the PHY PLL is off. Both stock SM8750 device trees give their DSI
controllers this clock under the same name. It is a 13th clock, one more
than the upstream binding lists.
---
 arch/arm64/boot/dts/qcom/sm8750.dtsi | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8750.dtsi b/arch/arm64/boot/dts/qcom/sm8750.dtsi
--- a/arch/arm64/boot/dts/qcom/sm8750.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm8750.dtsi
@@ -3586,7 +3586,8 @@
 					 <&dispcc DISP_CC_ESYNC0_CLK>,
 					 <&dispcc DISP_CC_OSC_CLK>,
 					 <&dispcc DISP_CC_MDSS_BYTE0_CLK_SRC>,
-					 <&dispcc DISP_CC_MDSS_PCLK0_CLK_SRC>;
+					 <&dispcc DISP_CC_MDSS_PCLK0_CLK_SRC>,
+					 <&bi_tcxo_div2>;
 				clock-names = "byte",
 					      "byte_intf",
 					      "pixel",
@@ -3598,7 +3599,8 @@
 					      "esync",
 					      "osc",
 					      "byte_src",
-					      "pixel_src";
+					      "pixel_src",
+					      "xo";
 
 				operating-points-v2 = <&mdss_dsi_opp_table>;
 
@@ -3695,7 +3697,8 @@
 					 <&dispcc DISP_CC_ESYNC1_CLK>,
 					 <&dispcc DISP_CC_OSC_CLK>,
 					 <&dispcc DISP_CC_MDSS_BYTE1_CLK_SRC>,
-					 <&dispcc DISP_CC_MDSS_PCLK1_CLK_SRC>;
+					 <&dispcc DISP_CC_MDSS_PCLK1_CLK_SRC>,
+					 <&bi_tcxo_div2>;
 				clock-names = "byte",
 					      "byte_intf",
 					      "pixel",
@@ -3707,7 +3710,8 @@
 					      "esync",
 					      "osc",
 					      "byte_src",
-					      "pixel_src";
+					      "pixel_src",
+					      "xo";
 
 				operating-points-v2 = <&mdss_dsi_opp_table>;
 
