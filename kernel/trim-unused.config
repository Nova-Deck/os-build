# novadeck kernel config fragment — SUBTRACTIVE: subsystems and IP no handheld here has
#
# Merged last (build.sh's *.config glob). A gate where Kconfig has one, so everything behind it
# goes too; single drivers only where defconfig builds one that sits behind no gate (another
# vendor's PMIC, MMC or USB controller with only DT or bus ID tables). Every line was checked
# against the compatibles of every DTB build.sh ships (2026-11-08).
# Same syntax trap as trim-platforms.config: nothing may follow "is not set" on a directive line.

# --- Virtualisation: ABL starts Linux at EL1 (the hypervisor keeps EL2), so KVM cannot run, and
# no image here is a guest. The Android guest is a container, not a VM. ---
# CONFIG_VIRTUALIZATION is not set
# CONFIG_XEN is not set
# CONFIG_VFIO is not set
# CONFIG_VIRTIO_MENU is not set
# CONFIG_VIRTIO_BLK is not set
# CONFIG_VIRTIO_NET is not set
# CONFIG_VIRTIO_CONSOLE is not set

# --- ACPI: every board boots with a DTB, which arm64 uses over ACPI whenever one is passed. ---
# CONFIG_ACPI is not set

# --- Storage no handheld has: SATA/PATA, SAS and RAID adapters, raw flash. SD, eMMC, UFS and
# USB storage are not behind these. ---
# CONFIG_ATA is not set
# CONFIG_SCSI_LOWLEVEL is not set
# CONFIG_MTD is not set

# --- Network root: the root is always local, and the NFS client is a module (kernel.config). ---
# CONFIG_IP_PNP is not set

# --- TV tuners, DVB and SDR. Cameras and the video decoders are not behind these. ---
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_SDR_SUPPORT is not set

# --- Chromebook EC, TPM, OP-TEE (Qualcomm runs its own TEE), PC keyboard and mouse ---
# CONFIG_CHROME_PLATFORMS is not set
# CONFIG_TCG_TPM is not set
# CONFIG_OPTEE is not set
# CONFIG_KEYBOARD_ATKBD is not set
# CONFIG_MOUSE_PS2 is not set

# --- Other vendors' USB, MMC and serial controllers (Qualcomm's are dwc3, sdhci-msm, GENI) ---
# CONFIG_USB_DWC2 is not set
# CONFIG_USB_ISP1760 is not set
# CONFIG_USB_MUSB_HDRC is not set
# CONFIG_USB_CHIPIDEA is not set
# CONFIG_USB_EHCI_HCD is not set
# CONFIG_USB_OHCI_HCD is not set
# CONFIG_MMC_ARMMMCI is not set
# CONFIG_MMC_DW is not set
# CONFIG_MMC_MTK is not set
# CONFIG_MMC_SDHCI_OF_ARASAN is not set
# CONFIG_MMC_SDHCI_OF_DWCMSHC is not set
# CONFIG_MMC_SDHCI_CADENCE is not set
# CONFIG_MMC_SDHCI_XENON is not set
# CONFIG_MMC_SDHCI_F_SDH30 is not set
# CONFIG_MMC_SPI is not set
# CONFIG_SERIAL_8250 is not set
# CONFIG_SERIAL_AMBA_PL011 is not set
# CONFIG_SERIAL_FSL_LPUART is not set
# CONFIG_SERIAL_FSL_LINFLEXUART is not set
# CONFIG_SERIAL_XILINX_PS_UART is not set

# --- Other vendors' DMA, IOMMU (Qualcomm's SMMU is v2), PCIe hosts, SPI, I2C and GPIO ---
# CONFIG_PL330_DMA is not set
# CONFIG_FSL_EDMA is not set
# CONFIG_ARM_SMMU_V3 is not set
# CONFIG_PCIE_ALTERA is not set
# CONFIG_PCIE_KIRIN is not set
# CONFIG_PCI_HOST_GENERIC is not set
# CONFIG_SPI_CADENCE_QUADSPI is not set
# CONFIG_I2C_RK3X is not set
# CONFIG_I2C_DESIGNWARE_PLATFORM is not set
# CONFIG_GPIO_DWAPB is not set
# CONFIG_GPIO_MB86S7X is not set

# --- Other vendors' PMICs (each MFD takes its regulator and clock cells with it), regulators,
# clock generators and SCP firmware ---
# CONFIG_MFD_AXP20X_I2C is not set
# CONFIG_MFD_BD9571MWV is not set
# CONFIG_MFD_HI6421_PMIC is not set
# CONFIG_MFD_MAX77620 is not set
# CONFIG_MFD_MT6360 is not set
# CONFIG_MFD_MT6397 is not set
# CONFIG_MFD_RK8XX_I2C is not set
# CONFIG_MFD_RK8XX_SPI is not set
# CONFIG_MFD_ROHM_BD718XX is not set
# CONFIG_MFD_SEC_I2C is not set
# CONFIG_MFD_TPS65219 is not set
# CONFIG_REGULATOR_FAN53555 is not set
# CONFIG_REGULATOR_MAX8973 is not set
# CONFIG_REGULATOR_MP8859 is not set
# CONFIG_REGULATOR_PCA9450 is not set
# CONFIG_REGULATOR_PF8X00 is not set
# CONFIG_REGULATOR_PFUZE100 is not set
# CONFIG_REGULATOR_RAA215300 is not set
# CONFIG_COMMON_CLK_VC3 is not set
# CONFIG_COMMON_CLK_VC5 is not set
# CONFIG_COMMON_CLK_CS2000_CP is not set
# CONFIG_COMMON_CLK_RS9_PCIE is not set
# CONFIG_ARM_SCPI_PROTOCOL is not set
