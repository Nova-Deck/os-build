# crun — the OCI runtime podman drives for Valve's Lepton compat tool. Built here because
# mash-20260401 dropped Arch's container stack from the public tree (the Steam Frame still ships it
# from Valve's private layer). See packages/podman/PKGBUILD for the whole set.
#
# Recipe source: archlinux-deckard/archlinux/mash-20260305/sources/packages/crun-1.26-3.src.tar.gz
# (sha256 eea801900763369364d3468b2981b0fb91f9b6f42c7496936ffc9f369ac4a393), Arch's recipe.
#
# Deviations: the `krun` split and --with-libkrun are gone (libkrun left the snapshot too, and the
# Frame ships no krun); libkrun leaves makedepends. criu + yajl are overlay packages (source.pin
# needs:).
#
# Maintainer: Morten Linderud <foxboron@archlinux.org>
# Contributor: hexchian <i at hexchain dot org>

pkgname=crun
pkgver=1.26
pkgrel=3
pkgdesc="A fast and lightweight fully featured OCI runtime and C library for running containers"
url="https://github.com/containers/crun"
license=('LGPL-2.1-or-later')
arch=('x86_64' 'aarch64')
provides=('oci-runtime')
depends=('yajl' 'systemd-libs' 'libcap' 'libseccomp' 'criu')
makedepends=('libtool' 'python' 'go-md2man' 'systemd' 'git' 'yajl' 'libcap' 'libseccomp' 'criu')
source=("git+https://github.com/containers/crun.git#tag=$pkgver?signed")
validpgpkeys=('AC404C1C0BF735C63FF4D562263D6DF2E163E1EA')
sha256sums=('c42d4baf9a8f2e337b3b54f8659357fcd2697ef36f32bf6d41e8d0c91613632c')

build() {
    cd "$pkgname"
    ./autogen.sh
    ./configure \
        --prefix=/usr \
        --enable-shared \
        --enable-dynamic \
        --with-python-bindings
    make
}

package() {
    make -C "$pkgname" DESTDIR="$pkgdir" install
    # krun is a libkrun-only handler; drop its name and man page if the install still lays them down.
    rm -fv "$pkgdir/usr/bin/krun" "$pkgdir/usr/share/man/man1"/krun.1*
}
