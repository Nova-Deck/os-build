+// novadeck: focus-candidate instrumentation.
+//
+// The Steam bootstrapper's client-update dialog (an override-redirect GLX window carrying
+// STEAM_BIGPICTURE=1) is never presented on our arm64 handheld: gamescope commits ZERO atomic
+// flips for the whole install, so the panel stays black for minutes with no progress. Everything
+// observable from outside the process says the window should qualify — it is IsViewable,
+// InputOutput, opaque, fullscreen — so the exclusion has to be read from the inside.
+//
+// Off by default and costs nothing when off. Enable either way:
+//   GAMESCOPE_DEBUG_FOCUS=1 in the session env   (needed to catch it at boot, before SSH is up)
+//   gamescopectl debug_focus_candidates 1        (live, once a session is reachable)
+gamescope::ConVar<bool> cv_debug_focus_candidates{ "debug_focus_candidates",
+	env_to_bool( getenv( "GAMESCOPE_DEBUG_FOCUS" ) ),
+	"Log every window considered for focus with the reason it was rejected, the window that wins, "
+	"and its commit-queue state. GAMESCOPE_DEBUG_FOCUS=1 enables it from startup." };
+
+// Collapses identical consecutive reports. A wedged state is by definition unchanging, so without
+// this a 13-minute stall writes the same line thousands of times into the session log; with it the
+// state logs once and the repeat count is emitted when the state finally moves.
+class CFocusDebugReporter
+{
+public:
+	void Report( const std::string &sReport )
+	{
+		if ( sReport == m_sLast )
+		{
+			m_uRepeats++;
+			return;
+		}
+
+		if ( m_uRepeats )
+			focus_log.infof( "cand: (previous report repeated %u more times)", m_uRepeats );
+
+		m_uRepeats = 0;
+		m_sLast = sReport;
+		focus_log.infof( "%s", sReport.c_str() );
+	}
+private:
+	std::string m_sLast;
+	uint32_t m_uRepeats = 0;
+};
+
+// "queue=1 done=0 lastid=42 recvdone=1" — the discriminator between the two ways a window ends up
+// unpresented. pick_primary_focus_and_override() only publishes a focus window that satisfies
+// window_has_commits(), which needs at least one commit with done=true; a queue that is non-empty
+// with every entry done=0 means buffers were committed and their fences never signalled, which
+// looks identical at the panel to never having been focused at all.
+static std::string focus_debug_commits( steamcompmgr_win_t *w )
+{
+	std::string sResult = "queue=" + std::to_string( w->commit_queue.size() );
+
+	if ( !w->commit_queue.empty() )
+	{
+		sResult += " done=";
+		for ( size_t i = 0; i < w->commit_queue.size(); i++ )
+			sResult += ( i ? "," : "" ) + std::to_string( (int)w->commit_queue[ i ]->done );
+		sResult += " lastid=" + std::to_string( w->commit_queue.back()->commitID );
+	}
+
+	sResult += w->receivedDoneCommit ? " recvdone=1" : " recvdone=0";
+	return sResult;
+}
+
+// `controlledFocus` is a three-way OR, and when it is true it disables the generic
+// vecPossibleFocusWindows[0] fallback for the GLOBAL pass — so a window can pass every filter and
+// still never be focused. Knowing it is true is not enough; which term made it true says whether the
+// strategy is not what we assume or whether Steam claimed focus control. Print all three.
+static std::string focus_debug_controlled(
+	gamescope::VirtualConnectorStrategy eStrategy,
+	Window focusControlWindow,
+	const std::vector<uint32_t> &ctxFocusControlAppIDs )
+{
+	static const char *const s_pszStrategies[] = { "SingleApplication", "SteamControlled", "PerAppId", "PerWindow" };
+	const uint32_t uStrategy = (uint32_t)eStrategy;
+	const char *pszStrategy = uStrategy < gamescope::VirtualConnectorStrategies::Count
+		? s_pszStrategies[ uStrategy ] : "?";
+
+	std::string sAppIDs;
+	for ( uint32_t uAppID : ctxFocusControlAppIDs )
+		sAppIDs += ( sAppIDs.empty() ? "" : "," ) + std::to_string( uAppID );
+
+	char szBuf[ 256 ];
+	snprintf( szBuf, sizeof( szBuf ), "(strategy=%s[%u]%s ctrlwin=0x%lx%s ctrlappids=%zu[%s]%s)",
+		pszStrategy, uStrategy,
+		eStrategy != gamescope::VirtualConnectorStrategies::SingleApplication ? "<-" : "",
+		(unsigned long)focusControlWindow, focusControlWindow != None ? "<-" : "",
+		ctxFocusControlAppIDs.size(), sAppIDs.c_str(),
+		!ctxFocusControlAppIDs.empty() ? "<-" : "" );
+	return szBuf;
+}
+
+static std::string focus_debug_window( steamcompmgr_win_t *w )
+{
+	if ( !w )
+		return "(none)";
+
+	const char *pszTitle = w->title ? w->title->c_str() : "(untitled)";
+	char szBuf[ 512 ];
+
+	if ( w->type != steamcompmgr_win_type_t::XWAYLAND )
+	{
+		snprintf( szBuf, sizeof( szBuf ), "xdg 0x%x \"%s\" appID=%u %s",
+			w->id(), pszTitle, w->appID, focus_debug_commits( w ).c_str() );
+		return szBuf;
+	}
+
+	const Rect rect = w->GetGeometry();
+	snprintf( szBuf, sizeof( szBuf ),
+		"0x%x \"%s\" pid=%d appID=%u or=%d bigpicture=%d is_steam=%d useless=%d map=%d class=%d opacity=0x%x geom=%dx%d+%d+%d %s",
+		w->id(), pszTitle, (int)w->pid, w->appID,
+		(int)w->xwayland().a.override_redirect,
+		(int)w->isSteamLegacyBigPicture,
+		(int)window_is_steam( w ),
+		(int)win_is_useless( w ),
+		w->xwayland().a.map_state,
+		w->xwayland().a.c_class,
+		w->opacity,
+		rect.nWidth, rect.nHeight, rect.nX, rect.nY,
+		focus_debug_commits( w ).c_str() );
+	return szBuf;
+}
