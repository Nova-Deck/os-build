From: enjihn <150061999+enjihn@users.noreply.github.com>
Subject: [PATCH] drm: compose Gamma 2.2 HDR without hardware color management

Without DRM hardware color management, direct scanout is only safe for one
PQ layer targeting a PQ output. A Gamma 2.2 HDR panel needs the Vulkan
color pipeline to map even a single PQ layer into its native encoding.

diff --git a/src/Backends/DRMBackend.cpp b/src/Backends/DRMBackend.cpp
index 99dd452cdb0215ac006363cdc2932cc4b107ea6b..927d01426926e1fb54cd065e85e32a9bc438a28f 100644
--- a/src/Backends/DRMBackend.cpp
+++ b/src/Backends/DRMBackend.cpp
@@ -29,6 +29,7 @@
 
 #include "backend.h"
 #include "color_helpers.h"
+#include "DRMComposition.h"
 #include "Utils/Defer.h"
 #include "drm_include.h"
 #include "edid.h"
@@ -3740,8 +3741,13 @@ namespace gamescope
 			if ( g_bOutputHDREnabled )
 			{
 				bNeedsFullComposite |= g_bHDRItmEnable;
-				if ( !SupportsColorManagement() )
-					bNeedsFullComposite |= ( pFrameInfo->layers.count() > 1 || pFrameInfo->layers.get( 0 ).colorspace != GAMESCOPE_APP_TEXTURE_COLORSPACE_HDR10_PQ );
+				const bool bSupportsHardwareColorManagement = SupportsColorManagement();
+				bNeedsFullComposite |= DrmHdrOutputRequiresVulkanComposition(
+					g_bOutputHDREnabled,
+					bSupportsHardwareColorManagement,
+					pFrameInfo->outputEncodingEOTF,
+					static_cast<uint32_t>( pFrameInfo->layers.count() ),
+					pFrameInfo->layers.get( 0 ).colorspace == GAMESCOPE_APP_TEXTURE_COLORSPACE_HDR10_PQ );
 			}
 			else
 			{
diff --git a/src/Backends/DRMComposition.h b/src/Backends/DRMComposition.h
new file mode 100644
index 0000000000000000000000000000000000000000..1210f78cf06c80a8161aea45eb82adc624c0bf5f
--- /dev/null
+++ b/src/Backends/DRMComposition.h
@@ -0,0 +1,27 @@
+#pragma once
+
+#include "../color_helpers.h"
+
+#include <cstdint>
+
+namespace gamescope
+{
+    // Without DRM hardware color management, direct scanout is only safe for
+    // one PQ layer targeting a PQ output. In particular, a Gamma 2.2 HDR panel
+    // needs the Vulkan color pipeline to map even a single PQ layer into the
+    // panel's native encoding.
+    constexpr bool DrmHdrOutputRequiresVulkanComposition(
+        bool bOutputHDREnabled,
+        bool bSupportsHardwareColorManagement,
+        EOTF eOutputEncodingEOTF,
+        uint32_t uLayerCount,
+        bool bBaseLayerIsHDR10PQ )
+    {
+        if ( !bOutputHDREnabled || bSupportsHardwareColorManagement )
+            return false;
+
+        return eOutputEncodingEOTF != EOTF_PQ ||
+            uLayerCount != 1 ||
+            !bBaseLayerIsHDR10PQ;
+    }
+}
