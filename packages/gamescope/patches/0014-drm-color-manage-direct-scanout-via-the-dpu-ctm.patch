+TEST_CASE("a linear scale is exactly an encoded scale under gamma 2.2", "[drm][color]")
+{
+    const glm::vec3 vLinearScale{ 0.9f, 0.72f, 0.35f };
+    const glm::vec3 vEncodedScale = DrmEncodedScaleFromLinearScale( vLinearScale );
+
+    for ( float flEncodedIn : { 0.05f, 0.25f, 0.5f, 0.75f, 1.0f } )
+    {
+        for ( int c = 0; c < 3; c++ )
+        {
+            // What the Vulkan composite does: decode, scale, re-encode.
+            const float flComposite = EncodeG22( vLinearScale[c] * DecodeG22( flEncodedIn ) );
+            // What the DPU does: scale the encoded value, no decode at all.
+            const float flScanout = vEncodedScale[c] * flEncodedIn;
+
+            REQUIRE( std::fabs( flComposite - flScanout ) < 1e-5f );
+        }
+    }
+}
