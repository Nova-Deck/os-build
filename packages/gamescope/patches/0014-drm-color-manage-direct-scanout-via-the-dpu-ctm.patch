diff --git a/src/Backends/DRMColorPipeline.h b/src/Backends/DRMColorPipeline.h
new file mode 100644
index 0000000..8b097d6
--- /dev/null
+++ b/src/Backends/DRMColorPipeline.h
@@ -0,0 +1,80 @@
+#pragma once
+
+#include "../color_helpers.h"
+
+#include <cmath>
+#include <cstdint>
+#include <type_traits>
+
+namespace gamescope
+{
+    // Packing gamescope's colour transform into the display controller's own colour
+    // blocks, so that a directly scanned-out frame is still colour managed.
+    //
+    // WHAT THE HARDWARE OFFERS. The msm DPU exposes, per CRTC, a 3x3 matrix (the
+    // DSPP's PCC block, as the DRM CTM property) followed by a per-channel 1D curve
+    // (the GC block, as GAMMA_LUT). It exposes NO degamma block -- dpu_crtc.c calls
+    // drm_crtc_enable_color_mgmt() with a degamma size of 0 -- so the matrix
+    // multiplies values that are still in the panel's encoding.
+    //
+    // WHY A DIAGONAL IS THE EXACT CASE, and it is exact rather than approximate.
+    // gamescope's pipeline works in LINEAR light, and a general 3x3 does not commute
+    // with a non-linear encoding, so without a degamma block most of that pipeline
+    // cannot move into the DPU at all. A per-channel scale is the exception, because
+    // Gamma 2.2 is a pure power law:
+    //
+    //     ( a * e^2.2 )^(1/2.2)  ==  a^(1/2.2) * e
+    //
+    // A multiply by `a` in linear light is a multiply by a^(1/2.2) in the encoding.
+    // Nothing is approximated and no degamma is needed. calcScanoutLinearScale()
+    // decides when the transform really is such a scale; this is just the packing.
+    inline glm::vec3 DrmEncodedScaleFromLinearScale( const glm::vec3 &vLinearScale )
+    {
+        return glm::pow( glm::max( vLinearScale, glm::vec3( 0.f ) ), glm::vec3( 1.f / 2.2f ) );
+    }
+
+    // DRM's CTM is S31.32 SIGN-MAGNITUDE -- bit 63 is the sign, the rest is the
+    // magnitude -- NOT two's complement. See struct drm_color_ctm in drm_mode.h.
+    //
+    // Note for anyone extending this past a diagonal: msm THROWS THE SIGN AWAY. Its
+    // CONVERT_S3_15() masks bit 63 off and keeps the magnitude, so a negative
+    // coefficient is silently programmed positive. Every coefficient we emit is
+    // non-negative so that cannot bite us here -- but a real primaries matrix has
+    // negative terms, and would be quietly wrong on this hardware.
+    inline uint64_t DrmCtmFromFloat( float flValue )
+    {
+        const bool bNegative = std::signbit( flValue ) && flValue != 0.f;
+        const double dMagnitude = std::fabs( static_cast<double>( flValue ) );
+
+        // S31.32 holds 31 integer bits. Clamp before converting so a bad input
+        // saturates instead of wrapping into an unrelated colour.
+        constexpr double k_dMaxMagnitude = 2147483647.0;
+        const double dClamped = dMagnitude > k_dMaxMagnitude ? k_dMaxMagnitude : dMagnitude;
+
+        uint64_t uFixed = static_cast<uint64_t>( dClamped * 4294967296.0 + 0.5 );
+        uFixed &= ~( uint64_t( 1 ) << 63 );
+
+        return bNegative ? ( uFixed | ( uint64_t( 1 ) << 63 ) ) : uFixed;
+    }
+
+    // Fill a drm_color_ctm matrix (9 entries, row major) from a per-channel scale.
+    //
+    // TEMPLATED ON THE ELEMENT TYPE, and it has to be. drm_color_ctm::matrix is
+    // __u64, which on aarch64 is `unsigned long long` while uint64_t is
+    // `unsigned long` -- the same width but DISTINCT types, so a uint64_t(&)[9]
+    // parameter will not bind to it and the build fails on the device arch while
+    // compiling fine on x86_64. Take whatever 64-bit unsigned array we are handed.
+    template <typename T>
+    inline void DrmCtmFromDiagonal( const glm::vec3 &vScale, T ( &uOutMatrix )[9] )
+    {
+        static_assert( sizeof( T ) == 8, "drm_color_ctm entries are 64-bit" );
+        static_assert( std::is_unsigned_v<T>, "drm_color_ctm entries are unsigned" );
+
+        for ( int i = 0; i < 9; i++ )
+            uOutMatrix[i] = 0;
+
+        uOutMatrix[0] = DrmCtmFromFloat( vScale.r );
+        uOutMatrix[4] = DrmCtmFromFloat( vScale.g );
+        uOutMatrix[8] = DrmCtmFromFloat( vScale.b );
+    }
+}
diff --git a/src/color_helpers.cpp b/src/color_helpers.cpp
index 64430a5..6459ef2 100644
--- a/src/color_helpers.cpp
+++ b/src/color_helpers.cpp
@@ -828,6 +828,101 @@ void calcColorTransform( lut1d_t * pShaper, int nLutSize1d,
     }
 }
 
+// See the declaration in color_helpers.h. Mirrors the body of calcColorTransform()
+// above, step for step, asking of each step "is this the identity, or a per-channel
+// scale?" and giving up the moment one is neither.
+std::optional<glm::vec3> calcScanoutLinearScale(
+	const displaycolorimetry_t & source, EOTF sourceEOTF,
+	const displaycolorimetry_t & dest,  EOTF destEOTF,
+    const glm::vec2 & destVirtualWhite, EChromaticAdaptationMethod eMethod,
+    const colormapping_t & mapping, const nightmode_t & nightmode, const tonemapping_t & tonemapping,
+    const lut3d_t * pLook, float flGain )
+{
+    // Only a PURE POWER LAW lets a linear scale be re-expressed as a scale in the
+    // encoding, which is the whole trick (DRMColorPipeline.h). PQ is not one.
+    if ( sourceEOTF != EOTF_Gamma22 || destEOTF != EOTF_Gamma22 )
+        return std::nullopt;
+
+    // calcEOTFToLinear()/calcLinearToEOTF() multiply and divide by g22_luminance and
+    // CLAMP to [0,1] in between. At unity that is exactly x^2.2 and x^(1/2.2); at
+    // anything else there is a clamp in the middle that a scale cannot model.
+    if ( tonemapping.g22_luminance != 1.f )
+        return std::nullopt;
+
+    // Tonemapping and a look LUT are non-diagonal by construction.
+    if ( tonemapping.eOperator != ETonemapOperator_None )
+        return std::nullopt;
+
+    if ( pLook && !pLook->data.empty() )
+        return std::nullopt;
+
+    // NOTE the shaper needs no check. calcColorTransform() seeds the 3D LUT's edges
+    // with ApplyLut1D_Inverse_Linear( shaper ), so the pair cancels by construction
+    // -- "a matched pair", as the comment there puts it -- and only the 3D LUT body
+    // is an end-to-end transform.
+
+    // THE GAMUT MAPPING IS DELIBERATELY NOT CONSIDERED, and this is the subtle part.
+    //
+    // dest_from_source (a primaries matrix) and the saturation blend are both
+    // non-diagonal, so neither can go in the CTM. An earlier version of this refused
+    // whenever they were non-identity -- which is defensible in the abstract and was
+    // WRONG in practice: it meant refusing at gamescope's DEFAULT sdrGamutWideness of
+    // 0.5, where the SDR source colorimetry is generic-wide-gamut and the panel is
+    // not, so the matrix is never identity and EVERY frame composited. Measured on
+    // Pocket FIT: one plane committed instead of two, with night mode merely off.
+    //
+    // The reason that is the wrong trade is that direct scanout NEVER applied the
+    // gamut mapping. Before any of this existed, the scanout path wrote 0 to CTM,
+    // GAMMA_LUT and DEGAMMA_LUT and ran no Vulkan pass at all -- it was a straight
+    // passthrough of the source colorimetry. So compositing "to preserve" the gamut
+    // mapping preserves nothing that was ever there on that path; it only spends the
+    // GPU that inline rotation was taken to save.
+    //
+    // What this function therefore answers is NOT "is the composite a pure scale?"
+    // but the question the caller actually has: "given that scanout passes the
+    // source colorimetry through unchanged, as it always has, what per-channel scale
+    // does it still need?" Night mode, gain and brightness are that scale.
+    //
+    // CONSEQUENCE, and it must not be discovered by surprise later: a scanned-out
+    // frame and a composited one differ by the gamut mapping. That difference is not
+    // new -- it existed for every frame the old code scanned out -- but this does
+    // mean the difference can now appear and disappear as frames switch paths.
+    // Operator-checked on Pocket FIT with night mode off: no visible difference
+    // between the two paths.
+    //
+    // Doing it "properly" in hardware is not available: a real primaries matrix has
+    // NEGATIVE off-diagonal terms, and msm's CONVERT_S3_15() discards the sign bit,
+    // so such a matrix would be programmed as its absolute value. The DPU cannot
+    // carry this even approximately.
+    (void)mapping;
+    (void)source;
+    (void)dest;
+
+    // The virtual white point adaptation is a real matrix; we only handle its
+    // disabled case. Same condition calcColorTransform() uses to skip it.
+    if ( destVirtualWhite.x > 0.01f && destVirtualWhite.y > 0.01f )
+        return std::nullopt;
+
+    (void)eMethod;
+
+    glm::vec3 nightModeMultHSV( nightmode.hue, clamp01( nightmode.saturation * nightmode.amount ), 1.f );
+    glm::vec3 vMultLinear = glm::pow( hsv_to_rgb( nightModeMultHSV ), glm::vec3( 2.2f ) );
+    vMultLinear = vMultLinear * flGain;
+
+    // Staying within [0,1] keeps calcColorTransform()'s hue-preserving clip out of
+    // play: it only engages above g22_luminance + 1, and a scale of at most 1 on an
+    // at-most-1 source cannot reach it. So inside this range the composite really is
+    // a pure scale, with no branch we are failing to model. Amplification above 1
+    // would also only clip against panel peak, so refusing it costs nothing real.
+    for ( int i = 0; i < 3; i++ )
+    {
+        if ( !std::isfinite( vMultLinear[i] ) || vMultLinear[i] < 0.f || vMultLinear[i] > 1.f )
+            return std::nullopt;
+    }
+
+    return vMultLinear;
+}
