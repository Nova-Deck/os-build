+TEST_CASE("CTM packing is S31.32 sign-magnitude", "[drm][color]")
+{
+    REQUIRE( DrmCtmFromFloat( 0.f ) == 0ull );
+    REQUIRE( DrmCtmFromFloat( 1.f ) == ( 1ull << 32 ) );
+    REQUIRE( DrmCtmFromFloat( 0.5f ) == ( 1ull << 31 ) );
+
+    // Sign lives in bit 63 and the magnitude is NOT two's complement.
+    REQUIRE( DrmCtmFromFloat( -1.f ) == ( ( 1ull << 63 ) | ( 1ull << 32 ) ) );
+
+    uint64_t uMatrix[9];
+    DrmCtmFromDiagonal( glm::vec3( 1.f, 0.5f, 0.f ), uMatrix );
+
+    REQUIRE( uMatrix[0] == ( 1ull << 32 ) );
+    REQUIRE( uMatrix[4] == ( 1ull << 31 ) );
+    REQUIRE( uMatrix[8] == 0ull );
+
+    // Everything off the diagonal must be exactly zero: msm drops the sign bit, so
+    // a stray non-zero term there would be programmed as a positive coefficient.
+    for ( int i : { 1, 2, 3, 5, 6, 7 } )
+        REQUIRE( uMatrix[i] == 0ull );
