+namespace
+{
+    // The claim the whole design rests on: for a PURE POWER LAW encoding, scaling in
+    // linear light and scaling in the encoding are the same operation, with the
+    // exponent moved. If this ever stops holding, the DPU path is wrong and the
+    // scanout frames are quietly mis-coloured, so assert it numerically rather than
+    // trusting the algebra in the comment.
+    float EncodeG22( float flLinear ) { return std::pow( flLinear, 1.f / 2.2f ); }
+    float DecodeG22( float flEncoded ) { return std::pow( flEncoded, 2.2f ); }
+
+    nightmode_t MakeNightMode( float flAmount, float flHue, float flSaturation )
+    {
+        nightmode_t nightmode{};
+        nightmode.amount = flAmount;
+        nightmode.hue = flHue;
+        nightmode.saturation = flSaturation;
+        return nightmode;
+    }
+
+    colormapping_t MakeSmoothRemap()
+    {
+        // What buildSDRColorimetry() hands back for a non-wide-gamut panel: a real
+        // blend, which must NOT by itself stop us scanning out.
+        colormapping_t mapping{};
+        mapping.blendEnableMinSat = 0.7f;
+        mapping.blendEnableMaxSat = 1.0f;
+        mapping.blendAmountMin = 0.0f;
+        mapping.blendAmountMax = 1.0f;
+        return mapping;
+    }
+
+    std::optional<glm::vec3> ScaleFor(
+        const displaycolorimetry_t &source,
+        const displaycolorimetry_t &dest,
+        const nightmode_t &nightmode,
+        float flGain = 1.f,
+        EOTF eEOTF = EOTF_Gamma22 )
+    {
+        tonemapping_t tonemapping{};
+        tonemapping.bUseShaper = true;
+        tonemapping.g22_luminance = 1.f;
+        tonemapping.eOperator = ETonemapOperator_None;
+
+        return calcScanoutLinearScale( source, eEOTF, dest, eEOTF,
+            glm::vec2( 0.f, 0.f ), k_EChromaticAdapatationMethod_Bradford,
+            MakeSmoothRemap(), nightmode, tonemapping, nullptr, flGain );
+    }
+}
