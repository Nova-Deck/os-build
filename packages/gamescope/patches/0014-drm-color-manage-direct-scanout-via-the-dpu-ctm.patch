+// A SEPARATE capability from drm_supports_color_mgmt() above, on purpose.
+//
+// That one asks about AMD's per-PLANE properties and selects a whole pipeline --
+// output_tf, blend_tf, per-plane shaper and 3D LUT blobs. It is hard-false on msm
+// no matter what the DPU advertises, and it must STAY false: flipping it true
+// would select the AMD plane path rather than enable this one.
+//
+// This asks a much smaller question: does the CRTC have a CTM we can drive? That
+// is a strictly weaker capability -- one matrix, no per-plane anything, no
+// transfer functions -- so it gets its own name and its own branch.
+bool drm_supports_crtc_ctm(struct drm_t *drm)
+{
+	if ( g_bForceDisableColorMgmt )
+		return false;
+
+	if ( cv_drm_debug_disable_ctm )
+		return false;
+
+	if ( !drm->pCRTC )
+		return false;
+
+	return drm->pCRTC->GetProperties().CTM.has_value();
+}
+
+// Would a directly scanned-out frame carry the colour transform that compositing
+// would have applied?
+//
+// On the AMD plane path this is already answered by the machinery above, so we say
+// yes and change nothing there. Everywhere else the honest answer used to be "no,
+// and nobody checked" -- drm_prepare() does not fail when colour management is
+// wanted but unsupported, it just carries on -- which is exactly how night mode
+// came to be silently dropped the moment inline rotation made direct scanout
+// reachable. Now an unreproducible transform forces a composite instead.
+static bool drm_scanout_is_color_managed( struct drm_t *drm )
+{
+	if ( drm_supports_color_mgmt( drm ) )
+		return true;
+
+	// Something in the composite that no matrix can reproduce.
+	if ( !g_ScanoutLinearScale )
+		return false;
+
+	if ( drm_supports_crtc_ctm( drm ) )
+		return true;
+
+	// No hardware to put it in, so only a no-op transform can be scanned out.
+	return *g_ScanoutLinearScale == glm::vec3( 1.f );
+}
+
+// Refresh the CRTC CTM blob for the frame we are about to submit.
+//
+// bDirectScanout says whether this frame reaches the panel WITHOUT going through
+// vulkan_composite(). It decides everything, because the composite applies the very
+// same transform: if we put it in the CTM as well, the frame gets it TWICE -- night
+// mode would visibly double-darken the moment anything forced a composite. So the
+// invariant is simply
+//
+//     the CTM is non-identity ONLY for a frame that was not composited
+//
+// and the caller is responsible for not creating a frame that is half of each. That
+// is what the partial-composition guard in the composite decision is for: partial
+// composition scans out the base layer while compositing the overlays, and a
+// CRTC-level matrix sits after blending, so it would hit the composited half twice.
+//
+// ALWAYS produces a blob, even for the identity, and that is load-bearing rather
+// than lazy: msm only reserves DSPPs for a CRTC whose state carries a CTM or a
+// GAMMA_LUT, and it only reserves them during a MODESET. If we left the CTM null
+// while the transform happened to be the identity, the first time a user touched
+// the night mode slider we would need a modeset mid-flip to get a DSPP -- and since
+// the kernel stopped forcing allow_modeset on userspace's behalf, that commit would
+// simply be REJECTED. Keeping a CTM set for the life of the mode means the DSPPs are
+// already there and a new matrix is an ordinary property write.
+static void drm_update_crtc_ctm( struct drm_t *drm, bool bDirectScanout )
+{
+	if ( !drm_supports_crtc_ctm( drm ) )
+	{
+		drm->pending.ctm_id = nullptr;
+		return;
+	}
+
+	const glm::vec3 vLinearScale = bDirectScanout
+		? g_ScanoutLinearScale.value_or( glm::vec3( 1.f ) )
+		: glm::vec3( 1.f );
+
+	const glm::vec3 vEncodedScale = gamescope::DrmEncodedScaleFromLinearScale( vLinearScale );
+
+	struct drm_color_ctm ctm = {};
+	gamescope::DrmCtmFromDiagonal( vEncodedScale, ctm.matrix );
+
+	drm->pending.ctm_id = GetBackend()->CreateBackendBlob( ctm );
+}
+
+// Is there actually a transform for the DPU to carry? If not, partial composition
+// stays available, because an identity CTM cannot double-apply anything.
+static bool drm_scanout_ctm_is_active( struct drm_t *drm )
+{
+	if ( !drm_supports_crtc_ctm( drm ) )
+		return false;
+
+	return g_ScanoutLinearScale.has_value() && *g_ScanoutLinearScale != glm::vec3( 1.f );
+}
