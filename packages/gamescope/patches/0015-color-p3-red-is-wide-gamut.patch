diff --git a/tests/test_color_gamut.cpp b/tests/test_color_gamut.cpp
new file mode 100644
index 0000000..06540c7
--- /dev/null
+++ b/tests/test_color_gamut.cpp
@@ -0,0 +1,36 @@
+#include <catch2/catch_test_macros.hpp>
+
+#include "color_helpers.h"
+
+// Defined in color_helpers.cpp, which the test binary already links; the header
+// does not declare it because buildSDRColorimetry() is its only other caller.
+bool BIsWideGamut( const displaycolorimetry_t & nativeDisplayOutput );
+
+namespace
+{
+    displaycolorimetry_t WithRed( float flRedX, float flRedY )
+    {
+        displaycolorimetry_t colorimetry = displaycolorimetry_709;
+        colorimetry.primaries.r = { flRedX, flRedY };
+        return colorimetry;
+    }
+}
+
+TEST_CASE("A DCI-P3 red counts as wide gamut", "[color]")
+{
+    // Exactly the P3 red our internal AMOLED profile declares. It sits on the
+    // threshold, so an exclusive comparison calls the panel narrow and the SDR
+    // gamut wideness slider only clips instead of mapping 709 to the native gamut.
+    CHECK( BIsWideGamut( WithRed( 0.680f, 0.320f ) ) );
+}
+
+TEST_CASE("Narrow and wide reds fall the right side of the gamut test", "[color]")
+{
+    CHECK_FALSE( BIsWideGamut( displaycolorimetry_709 ) );
+
+    // Rec.2020 red, comfortably past the threshold in both coordinates.
+    CHECK( BIsWideGamut( WithRed( 0.708f, 0.292f ) ) );
+
+    // A red y low enough on its own is not sufficient: the x still has to be wide.
+    CHECK_FALSE( BIsWideGamut( WithRed( 0.640f, 0.300f ) ) );
+}
