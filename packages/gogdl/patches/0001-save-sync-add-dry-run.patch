             self.logger.info("No files in cloud, uploading")
@@ -183,6 +191,48 @@ class CloudStorageManager:
         sys.stdout.flush()
         self.logger.info("Done")
 
+    def report_plan(self, local_files, cloud_files, downloadable_cloud, timestamp):
+        """--dry-run: write what sync() would do as one JSON object on stdout, and change nothing.
+
+        "action" is the classification sync() acts on, including its empty-side rules (an empty
+        cloud uploads, an empty local dir downloads); --skip-* and --force-* are not applied, so
+        a caller can decide between them. "newest" is the latest update time of a side as a Unix
+        timestamp, or null when it has no files.
+        """
+        if len(local_files) > 0 and len(cloud_files) == 0:
+            action = SyncAction.UPLOAD
+            updated_local, updated_cloud = local_files, []
+            not_locally, not_remotely = [], []
+        elif len(local_files) == 0 and len(cloud_files) > 0:
+            action = SyncAction.DOWNLOAD
+            updated_local, updated_cloud = [], downloadable_cloud
+            not_locally, not_remotely = [], []
+        else:
+            classifier = SyncClassifier.classify(local_files, cloud_files, timestamp)
+            action = classifier.get_action()
+            updated_local, updated_cloud = classifier.updated_local, classifier.updated_cloud
+            not_locally = classifier.not_existing_locally
+            not_remotely = classifier.not_existing_remotely
+
+        def paths(files):
+            return sorted(f.relative_path for f in files)
+
+        def newest(files):
+            stamps = [f.update_ts for f in files if f.update_ts is not None]
+            return max(stamps) if stamps else None
+
+        report = {
+            "action": action.name.lower(),
+            "local": {"files": len(local_files), "newest": newest(local_files)},
+            "cloud": {"files": len(downloadable_cloud), "newest": newest(downloadable_cloud)},
+            "updated_local": paths(updated_local),
+            "updated_cloud": paths(updated_cloud),
+            "not_existing_locally": paths(not_locally),
+            "not_existing_remotely": paths(not_remotely),
+        }
+        sys.stdout.write(json.dumps(report))
+        sys.stdout.flush()
+
     def clear(self, arguments, unknown_args):
         self.sync_path = os.path.normpath(arguments.path.strip('"'))
         self.sync_path = self.sync_path.replace("\\", os.sep)
