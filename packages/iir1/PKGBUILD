# iir1 — realtime IIR filter library (Bernd Porr). A build and runtime dependency of dosbox-staging.
#
# WHY IT IS HERE: dosbox-staging's CMakeLists makes `find_package(iir REQUIRED)` unconditional (its
# audio filters), and the pinned snapshot carries no iir1 (checked against build/snapshot.pin).
# AUR-only upstream; this is the AUR recipe (iir1 1.10.0-1), unchanged apart from the header.
#
# Ships the SHARED library: dosbox-staging links iir::iir when the target exists and only falls
# back to iir::iir_static, so the image needs libiir.so at runtime. The static archive and the
# CMake config are build-only; rootfs/conf/trim.list strips both from the image.

pkgname=iir1
pkgver=1.10.0
pkgrel=1
pkgdesc='DSP IIR realtime filter library written in C++'
arch=('aarch64')
url='https://github.com/berndporr/iir1'
license=('MIT')
depends=('gcc-libs')
makedepends=('cmake')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('13b53f14d276adf6cafd3564fcda1d4b3e72342108d1c40ec4b4f0c7fc3ac95a')

build() {
  cmake -B build -S "${pkgname}-${pkgver}" \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-dev
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
  install -Dm644 "${pkgname}-${pkgver}/COPYING" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
