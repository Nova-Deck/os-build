From a341f638fad21bb83f396e67966f10ae557fa06e Mon Sep 17 00:00:00 2001
From: Philippe Simons <simons.philippe@gmail.com>
Date: Thu, 19 Nov 2026 15:35:08 +0100
Subject: [PATCH] sync-saves: add --dry-run

Print what a sync would do as one JSON line per game on stdout, and
change nothing: no upload or download, no save path stored in
installed.json, and no creation of a missing save directory.

"status" is the SaveGameStatus a real sync acts on, from the same
check_savegame_state(); --skip-* and --force-* are not applied, so a
launcher can show a conflict to the user before choosing one. The line
also carries the save path checked, each side's newest time and the
last sync (Unix timestamps or null), and the cloud manifest a download
would take. A game without cloud saves reports "unsupported"; a
computed save path that still holds variables reports "no_save_path".

The update notice is suppressed, as for --json, so stdout stays JSON.
---
 legendary/cli.py | 39 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 39 insertions(+)

diff --git a/legendary/cli.py b/legendary/cli.py
index 62a31f3..877ccda 100644
--- a/legendary/cli.py
+++ b/legendary/cli.py
@@ -477,6 +477,12 @@ class LegendaryCLI:
                 if igame.app_name in latest_save:
                     # this should never happen unless cloud save support was removed from a game
                     logger.warning(f'{igame.app_name} has remote save(s) but does not support cloud saves?!')
+                if args.dry_run:
+                    self._print_json(dict(app_name=igame.app_name, status='unsupported'))
+                continue
+
+            if args.dry_run:
+                self._report_save_sync(args, igame, latest_save.get(igame.app_name))
                 continue
 
             logger.info(f'Checking "{igame.title}" ({igame.app_name})')
@@ -601,6 +607,34 @@ class LegendaryCLI:
                 igame.save_timestamp = time.time()
                 self.core.lgd.set_installed_game(igame.app_name, igame)
 
+    def _report_save_sync(self, args, igame, save):
+        """sync-saves --dry-run: print what a sync of this game would do as one JSON line on
+        stdout, and change nothing: no save path stored, no directory created, nothing
+        transferred.
+
+        "status" is the SaveGameStatus a real sync acts on, from the same check; --skip-* and
+        --force-* are not applied, so a caller can choose between them after seeing a conflict.
+        The save path is --save-path, else the stored one, else the computed one; "no_save_path"
+        when the computed one still holds variables. Times are Unix timestamps, or null.
+        """
+        report = dict(app_name=igame.app_name, status='no_save_path', save_path=None,
+                      local_newest=None, cloud_newest=None,
+                      cloud_manifest=save.manifest_name if save else None,
+                      last_sync=igame.save_timestamp)
+        save_path = args.save_path if args.app_name and args.save_path else igame.save_path
+        if not save_path:
+            computed = self.core.get_save_path(igame.app_name, platform=igame.platform)
+            logger.info(f'Computed save path: "{computed}"')
+            if '%' not in computed and '{' not in computed:
+                save_path = computed
+
+        if save_path:
+            res, (dt_l, dt_r) = self.core.check_savegame_state(save_path, igame.save_timestamp, save)
+            report.update(status=res.name.lower(), save_path=save_path,
+                          local_newest=dt_l.timestamp() if dt_l else None,
+                          cloud_newest=dt_r.timestamp() if dt_r else None)
+        self._print_json(report)
+
     def launch_game(self, args, extra):
         app_name = self._resolve_aliases(args.app_name)
         addon_app_name = None
@@ -3088,6 +3122,9 @@ def main():
                                    help='Disable save game file filtering')
     sync_saves_parser.add_argument('--accept-path', dest='accept_path', action='store_true',
                                    help=argparse.SUPPRESS)
+    sync_saves_parser.add_argument('--dry-run', dest='dry_run', action='store_true',
+                                   help='Print what a sync would do as JSON (one line per game) '
+                                        'and change nothing')
 
     clean_saves_parser.add_argument('--delete-incomplete', dest='delete_incomplete', action='store_true',
                                     help='Delete incomplete save files')
@@ -3311,6 +3348,8 @@ def main():
         disable_update_message = args.tsv
     if not disable_update_message and hasattr(args, 'csv'):
         disable_update_message = args.csv
+    if not disable_update_message and hasattr(args, 'dry_run'):
+        disable_update_message = args.dry_run
 
     # show note if update is available
     if not disable_update_message and cli.core.update_available and cli.core.update_notice_enabled():
-- 
2.56.1

