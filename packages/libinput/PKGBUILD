# libinput-tools WITHOUT the debug GUI — the `libinput` CLI our power-key scripts drive, minus gtk4.
#
# Recipe source: the pinned snapshot's own libinput-1.31.2-1 (Arch's), read from
# archlinux-deckard/archlinux/mash-20260528.1.pvt/sources/packages/libinput-1.31.2-1.src.tar.gz
# (sha256 fe72f25e6141cc90d6fb0c6f8abd0557860a843a7a82a5efbbabce5860d51a33).
#
# Why we build it: from 1.30 Arch splits the CLI (/usr/bin/libinput, /usr/lib/libinput/*) out of
# `libinput` into `libinput-tools`, and that package depends on gtk4 for ONE tool, `debug-gui` —
# resolving it adds 25 packages (~39 MiB compressed: gtk4, gstreamer, adwaita icons, …) to the
# image. novadeck-powerbuttond and novadeck-suspend need only `libinput debug-events` (a C tool),
# and without the split package both fail their `command -v libinput` check: the power key does
# nothing and a sleep resumes immediately (HW, Pocket ACE, 2026-09-23).
#
# Deviations from the upstream recipe, all in service of that:
#   - pkgname=(libinput-tools) only. The LIBRARY stays the snapshot's libinput — what gamescope,
#     Xwayland and every compositor link is not ours to rebuild. The tools are the same tag, so
#     `depends=(libinput=$pkgver)` pins the two together: a snapshot that moves libinput makes
#     this fail to resolve at relock instead of quietly mixing versions.
#   - -D debug-gui=false, so gtk4/cairo/glib2/libx11 leave makedepends and depends.
#   - -D tests=false and no check(): build-overlay always passes --nocheck, so `check` and the
#     test-only python modules leave makedepends.
#   - The python tools (measure/analyze/replay) keep shipping, their modules become optdepends:
#     python itself is on the image, and nothing we run calls them.
#   - arch=(aarch64): one aarch64 build serves every SoC.
#   - package() keeps only what the upstream `_pick tools` moved (usr/bin, usr/lib/libinput,
#     man, zsh) and deletes the rest of the install, which the snapshot's libinput already owns.

pkgname=libinput-tools
pkgver=1.31.2
pkgrel=1
pkgdesc="Input device management and event handling library (debug utilities, no GUI)"
url="https://wayland.freedesktop.org/libinput/doc/latest/"
arch=(aarch64)
license=(MIT)
depends=(
  glibc
  libevdev
  libgcc
  "libinput=$pkgver"
  libwacom
  lua54
  mtdev
  systemd-libs
)
optdepends=(
  'python: measure/analyze/replay tools'
  'python-libevdev: measure/analyze/replay tools'
  'python-pyudev: measure/analyze/replay tools'
  'python-yaml: replay tool'
)
makedepends=(
  git
  meson
  python
)
source=(
  "git+https://gitlab.freedesktop.org/libinput/libinput.git#tag=$pkgver"
)
b2sums=('8b0a76d3765e06283000745a91c95fecc8d2bfc7da36222ad0def041282f237ebd56006d11efd87c845a936631fea527666fee99b6e9e1e2f176681ff083ac9a')

build() {
  local meson_options=(
    # upstream recommends not building docs
    -D documentation=false
    -D debug-gui=false
    -D tests=false
  )

  arch-meson libinput build "${meson_options[@]}"
  meson compile -C build
}

package() {
  local staging="$srcdir/staging"
  rm -rf "$staging"
  meson install -C build --destdir "$staging"

  local d
  for d in usr/bin usr/lib/libinput usr/share/man usr/share/zsh; do
    [ -e "$staging/$d" ] || continue
    mkdir -p "$pkgdir/$(dirname "$d")"
    mv "$staging/$d" "$pkgdir/$d"
  done

  install -Dm644 libinput/COPYING -t "$pkgdir/usr/share/licenses/$pkgname"
}
