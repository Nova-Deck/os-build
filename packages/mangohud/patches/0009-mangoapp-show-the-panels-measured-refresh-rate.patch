From 400abfcf81c65e8f585355fca9fefa43eec93873 Mon Sep 17 00:00:00 2001
From: Matthew Schwartz <matthew.schwartz@linux.dev>
Date: Mon, 19 Oct 2026 18:22:54 -0700
Subject: [PATCH] mangoapp: show the panel's measured refresh rate from gamescope

Display Hz shows the mode's refresh rate, which stays at the maximum
under VRR while the panel itself runs anywhere down to its floor.

Newer gamescope builds send the rate the panel actually scans out, so
Display Hz shows that with one decimal and falls back to the mode's rate
otherwise. Fixed refresh panels now read as 90.0 or 59.9 as well.

Backported to 0.8.4: upstream's change sits on 22f24cb7, so the message
fields between outputHeight and scanoutRefreshmHz (displayRefresh, the
two flag bits, engineName, upscaler, wantedUpscaler) are added here too,
matching gamescope's layout. 0.8.4 compares msgrcv's size, which leaves
out msg_type, against offsetof, which counts it; upstream fixed that with
msg_bytes in 22f24cb7, so the new size check adds sizeof(msg_type) itself.
Without it a sender that stops right after scanoutRefreshmHz is never read.
---
diff --git a/src/app/main.cpp b/src/app/main.cpp
index 19c465fb..1ac241a3 100644
--- a/src/app/main.cpp
+++ b/src/app/main.cpp
@@ -222,6 +222,10 @@ static void msg_read_thread(){
                     if (msg_size > offsetof(mangoapp_msg_v1, latency_ns))
                         gamescope_frametime(mangoapp_v1->app_frametime_ns, mangoapp_v1->latency_ns);
 
+                    // msgrcv's size leaves out the leading msg_type, offsetof counts it
+                    if (msg_size + sizeof(hdr->msg_type) > offsetof(mangoapp_msg_v1, scanoutRefreshmHz))
+                        HUDElements.scanout_refresh = mangoapp_v1->scanoutRefreshmHz / 1000.f;
+
                     if (should_new_frame)
                     {
                         {
diff --git a/src/app/mangoapp_proto.h b/src/app/mangoapp_proto.h
index 8bc9c905..ba7161ee 100644
--- a/src/app/mangoapp_proto.h
+++ b/src/app/mangoapp_proto.h
@@ -17,6 +17,13 @@ struct mangoapp_msg_v1 {
     uint64_t latency_ns;
     uint32_t outputWidth;
     uint32_t outputHeight;
+    uint16_t displayRefresh;
+    bool bAppWantsHDR : 1;
+    bool bSteamFocused : 1;
+    char engineName[40];
+    uint8_t upscaler; // mangoapp_upscaler that produced the frame, LINEAR for none
+    uint8_t wantedUpscaler; // mangoapp_upscaler the user selected
+    uint32_t scanoutRefreshmHz; // refreshes the panel actually scanned out, follows VRR, 0 when unknown
     // WARNING: Always ADD fields, never remove or repurpose fields
 } __attribute__((packed));
 
diff --git a/src/hud_elements.cpp b/src/hud_elements.cpp
index 34a1e496..d88e6b62 100644
--- a/src/hud_elements.cpp
+++ b/src/hud_elements.cpp
@@ -1671,12 +1671,16 @@ void HudElements::hdr() {
 }
 
 void HudElements::refresh_rate() {
-    if (HUDElements.refresh > 0) {
+    if (HUDElements.refresh > 0 || HUDElements.scanout_refresh > 0) {
         ImGui::PushFont(HUDElements.sw_stats->font_secondary);
         ImguiNextColumnFirstItem();
         HUDElements.TextColored(HUDElements.colors.engine, "%s", "Display Hz");
         ImguiNextColumnOrNewRow();
-        right_aligned_text(HUDElements.colors.text, HUDElements.ralign_width, "%i", HUDElements.refresh);
+        // gamescope measures the panel's real rate, which VRR moves away from the mode's.
+        if (HUDElements.scanout_refresh > 0)
+            right_aligned_text(HUDElements.colors.text, HUDElements.ralign_width, "%.1f", HUDElements.scanout_refresh);
+        else
+            right_aligned_text(HUDElements.colors.text, HUDElements.ralign_width, "%i", HUDElements.refresh);
         ImGui::PopFont();
     }
 }
diff --git a/src/hud_elements.h b/src/hud_elements.h
index 405e0baa..4bb911d2 100644
--- a/src/hud_elements.h
+++ b/src/hud_elements.h
@@ -54,6 +54,7 @@ class HudElements{
         uint32_t vendorID;
         int hdr_status = 0;
         int refresh = 0;
+        float scanout_refresh = 0.f;
         unsigned int vsync = 10;
 
         enum display_servers {
