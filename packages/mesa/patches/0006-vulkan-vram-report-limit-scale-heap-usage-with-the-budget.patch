From a57a716fa742ecdd028447df877830ad2c40a5fb Mon Sep 17 00:00:00 2001
From: sunshineinabox <aqemail@gmail.com>
Date: Tue, 24 Nov 2026 12:57:06 -0800
Subject: [PATCH] vulkan/vram-report-limit: scale heap usage with the budget

The layer scales each heap's budget down to the reported size but passes
the driver's usage through, so an app that compares usage with budget
sees the heap fuller than it is by the inverse of that ratio.
Scale the usage by the same ratio.
---
 .../vram-report-limit-layer/vram_report_limit_layer.c      | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/vulkan/vram-report-limit-layer/vram_report_limit_layer.c b/src/vulkan/vram-report-limit-layer/vram_report_limit_layer.c
index 363635fccfe..8c58f86e983 100644
--- a/src/vulkan/vram-report-limit-layer/vram_report_limit_layer.c
+++ b/src/vulkan/vram-report-limit-layer/vram_report_limit_layer.c
@@ -637,6 +637,13 @@ vram_report_limit_tweak_memory_properties(
 
          vram_report_limit_apply_budget_percentage(
             percentage, &memory_budget_optional->heapBudget[i]);
+         /* Scale the usage by the same ratio, or an app that checks usage
+          * against budget sees the heap that much fuller than it is: with a
+          * 512 MiB report of a 3.3 GiB heap, Unity masked its memory types
+          * as full and reported "Out of memory" with no failing call.
+          */
+         vram_report_limit_apply_budget_percentage(
+            percentage, &memory_budget_optional->heapUsage[i]);
 
          assert(memory_budget_optional->heapBudget[i] <=
                 memory_properties->memoryHeaps[i].size);
-- 
