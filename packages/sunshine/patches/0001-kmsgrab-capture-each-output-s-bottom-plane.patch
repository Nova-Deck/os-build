From 6097ea3e8ffbdfa81de68aaa39a2db5170089beb Mon Sep 17 00:00:00 2001
From: Philippe Simons <simons.philippe@gmail.com>
Date: Sun, 22 Nov 2026 18:25:01 +0100
Subject: [PATCH] kmsgrab: capture each output's bottom plane, counted per CRTC

A compositor can scan out several planes on one CRTC. gamescope puts the
focused app on the bottom plane and its overlays on planes above it, and
only composes them into one plane when it has to, so the picture moves
between planes as it switches.

KMS capture counted every non-cursor plane with a framebuffer as a
monitor. Such an output was listed once per plane, the monitor index
of the last plane counted won, and the stream captured that plane: the
mostly transparent overlay, so the client saw black whenever gamescope
went back to scanning out several planes.

Count monitors per CRTC, capture the CRTC's bottom plane (lowest zpos),
and follow it from frame to frame. Moving to a plane of another size or
rotation reinitializes the capture, as a size change already did.
Plane type and zpos property IDs are cached, so following costs one
plane query per plane and one property query per candidate plane.
---
 src/platform/linux/kmsgrab.cpp | 135 ++++++++++++++++++++++++++++++++-
 1 file changed, 133 insertions(+), 2 deletions(-)

diff --git a/src/platform/linux/kmsgrab.cpp b/src/platform/linux/kmsgrab.cpp
index 8a08576..fd3beb6 100644
--- a/src/platform/linux/kmsgrab.cpp
+++ b/src/platform/linux/kmsgrab.cpp
@@ -921,9 +921,101 @@ namespace platf {
         return plane_it_t {fd.el, plane_res->planes + plane_res->count_planes};
       }
 
+      /**
+       * @brief Find the bottom plane scanning out a framebuffer on a CRTC.
+       *
+       * A compositor may scan out several planes on one CRTC (gamescope puts the focused app
+       * on the bottom plane and its overlays above it, and composes them all into one plane
+       * only when it has to). The bottom plane carries the picture; the planes above it are
+       * mostly transparent.
+       *
+       * @param crtc_id CRTC ID.
+       * @return The non-cursor plane with a framebuffer and the lowest zpos on the CRTC
+       *         (the first in plane order on a tie), or nullopt when the CRTC scans out none.
+       */
+      std::optional<std::uint32_t> bottom_plane_id(std::uint32_t crtc_id) {
+        std::optional<std::uint32_t> bottom;
+        std::uint64_t bottom_zpos = 0;
+        for (auto plane = begin(); plane != end(); ++plane) {
+          if (!plane->fb_id || plane->crtc_id != crtc_id) {
+            continue;
+          }
+
+          auto &info = plane_info(plane->plane_id);
+          if (info.cursor) {
+            continue;
+          }
+
+          auto zpos = plane_zpos(plane->plane_id, info);
+          if (!bottom || zpos < bottom_zpos) {
+            bottom = plane->plane_id;
+            bottom_zpos = zpos;
+          }
+        }
+        return bottom;
+      }
+
       file_t fd;  ///< DRM card file descriptor.
       file_t render_fd;  ///< Render fd.
       plane_res_t plane_res;  ///< Plane res.
+
+    private:
+      /**
+       * @brief Immutable facts about a plane, read once.
+       */
+      struct plane_info_t {
+        bool cursor;  ///< Whether the plane is a cursor plane.
+        std::optional<std::uint32_t> zpos_prop_id;  ///< ID of the plane's zpos property, if it has one.
+      };
+
+      /**
+       * @brief Return the cached immutable facts about a plane.
+       *
+       * @param plane_id Plane ID.
+       * @return The plane's type and zpos property ID.
+       */
+      const plane_info_t &plane_info(std::uint32_t plane_id) {
+        if (auto it = plane_infos.find(plane_id); it != std::end(plane_infos)) {
+          return it->second;
+        }
+
+        plane_info_t info {false, std::nullopt};
+        for (auto &[prop, val] : plane_props(plane_id)) {
+          if (prop->name == "type"sv) {
+            info.cursor = val == DRM_PLANE_TYPE_CURSOR;
+          } else if (prop->name == "zpos"sv) {
+            info.zpos_prop_id = prop->prop_id;
+          }
+        }
+        return plane_infos.emplace(plane_id, info).first->second;
+      }
+
+      /**
+       * @brief Read a plane's current zpos.
+       *
+       * @param plane_id Plane ID.
+       * @param info The plane's cached facts.
+       * @return The zpos, or 0 when the plane has no zpos property (the plane order then decides).
+       */
+      std::uint64_t plane_zpos(std::uint32_t plane_id, const plane_info_t &info) {
+        if (!info.zpos_prop_id) {
+          return 0;
+        }
+
+        obj_prop_t props {drmModeObjectGetProperties(fd.el, plane_id, DRM_MODE_OBJECT_PLANE)};
+        if (!props) {
+          return 0;
+        }
+
+        for (std::uint32_t i = 0; i < props->count_props; ++i) {
+          if (props->props[i] == *info.zpos_prop_id) {
+            return props->prop_values[i];
+          }
+        }
+        return 0;
+      }
+
+      std::map<std::uint32_t, plane_info_t> plane_infos;  ///< Plane facts by plane ID.
     };
 
     /**
@@ -1077,6 +1169,12 @@ namespace platf {
             continue;
           }
 
+          // Monitors are counted per CRTC, as in kms_display_names(), and the monitor's picture
+          // is its CRTC's bottom plane (see card_t::bottom_plane_id()).
+          std::vector<std::uint32_t> counted_crtcs;
+          std::uint32_t monitor_crtc = 0;
+          std::optional<std::uint32_t> monitor_plane;
+
           auto end = std::end(card);
           for (auto plane = std::begin(card); plane != end; ++plane) {
             // Skip unused planes
@@ -1088,8 +1186,15 @@ namespace platf {
               continue;
             }
 
-            if (monitor != monitor_index) {
-              ++monitor;
+            if (!monitor_crtc && std::ranges::find(counted_crtcs, plane->crtc_id) == std::end(counted_crtcs)) {
+              counted_crtcs.push_back(plane->crtc_id);
+              if (monitor++ == monitor_index) {
+                monitor_crtc = plane->crtc_id;
+                monitor_plane = card.bottom_plane_id(monitor_crtc);
+              }
+            }
+
+            if (!monitor_plane || plane->plane_id != *monitor_plane) {
               continue;
             }
 
@@ -1533,6 +1638,22 @@ namespace platf {
           }
         }
 
+        // Follow the CRTC's bottom plane: a compositor moves the picture between planes as it
+        // switches between scanning out several planes and composing them into one. A plane of
+        // another size is caught below; one rotated differently needs the orientation re-read.
+        if (auto bottom = card.bottom_plane_id(crtc_id); bottom && *bottom != (std::uint32_t) plane_id) {
+          auto rotation = [&](std::uint32_t id) {
+            return card.prop_value_by_name(card.plane_props(id), "rotation"sv);
+          };
+          if (rotation(*bottom) != rotation(plane_id)) {
+            BOOST_LOG(info) << "Reinitializing capture: bottom plane ["sv << *bottom << "] is rotated unlike plane ["sv << plane_id << ']';
+            return capture_e::reinit;
+          }
+
+          BOOST_LOG(debug) << "Capture follows the bottom plane from ["sv << plane_id << "] to ["sv << *bottom << ']';
+          plane_id = *bottom;
+        }
+
         plane_t plane = drmModeGetPlane(card.fd.el, plane_id);
         frame_timestamp = std::chrono::steady_clock::now();
 
@@ -2199,6 +2320,11 @@ namespace platf {
 
       auto crtc_to_monitor = kms::map_crtc_to_monitor(card.monitors(conn_type_count));
 
+      // One monitor per CRTC, not per plane: a compositor scanning out several planes on one
+      // CRTC would otherwise list that output once per plane, and the monitor index would
+      // select one of its planes rather than an output.
+      std::vector<std::uint32_t> counted_crtcs;
+
       auto end = std::end(card);
       for (auto plane = std::begin(card); plane != end; ++plane) {
         // Skip unused planes
@@ -2210,6 +2336,11 @@ namespace platf {
           continue;
         }
 
+        if (std::ranges::find(counted_crtcs, plane->crtc_id) != std::end(counted_crtcs)) {
+          continue;
+        }
+        counted_crtcs.push_back(plane->crtc_id);
+
         auto fb = card.fb(plane.get());
         if (!fb) {
           BOOST_LOG(error) << "Couldn't get drm fb for plane ["sv << plane->fb_id << "]: "sv << strerror(errno);
-- 
2.56.1

