From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Philippe Simons <simons.philippe@gmail.com>
Date: Mon, 23 Nov 2026 17:24:06 +0100
Subject: [PATCH] audio: let the host refuse to be muted by a client

A client that streams without "host audio" moves the host's default sink to
Sunshine's null sink, so the host falls silent. That suits one person playing
from another room, not a host who plays along: keep_host_audio = enabled
captures the host's own sink whatever the client asks.
---
 src/audio.cpp  | 6 ++++--
 src/config.cpp | 2 ++
 src/config.h   | 1 +
 3 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/src/audio.cpp b/src/audio.cpp
index 28a3d81..d38e7a7 100644
--- a/src/audio.cpp
+++ b/src/audio.cpp
@@ -183,6 +183,9 @@ namespace audio {
       return;
     }
 
+    // The client may ask to mute the host; the host's configuration has the last word.
+    const bool host_audio = config.flags[config_t::HOST_AUDIO] || config::audio.keep_host_audio;
+
     // Order of priority:
     // 1. Virtual sink
     // 2. Audio sink
@@ -193,7 +196,7 @@ namespace audio {
     }
 
     // Prefer the virtual sink if host playback is disabled or there's no other sink
-    if (ref->sink.null && (!config.flags[config_t::HOST_AUDIO] || sink->empty())) {
+    if (ref->sink.null && (!host_audio || sink->empty())) {
       auto &null = *ref->sink.null;
       switch (stream.channelCount) {
         case 2:
@@ -220,7 +223,6 @@ namespace audio {
     }
 
     auto frame_size = config.packetDuration * stream.sampleRate / 1000;
-    bool host_audio = config.flags[config_t::HOST_AUDIO];
     bool continuous_audio = config.flags[config_t::CONTINUOUS_AUDIO];
     auto mic = control->microphone(stream.mapping, stream.channelCount, stream.sampleRate, frame_size, continuous_audio, host_audio);
     if (!mic) {
diff --git a/src/config.cpp b/src/config.cpp
index e0e8647..0c7a57d 100644
--- a/src/config.cpp
+++ b/src/config.cpp
@@ -806,6 +806,7 @@ namespace config {
     {},  // virtual_sink
     true,  // stream audio
     true,  // install_steam_drivers
+    false,  // keep_host_audio
   };
 
   /**
@@ -1740,6 +1741,7 @@ namespace config {
     string_f(vars, "virtual_sink", audio.virtual_sink);
     bool_f(vars, "stream_audio", audio.stream);
     bool_f(vars, "install_steam_audio_drivers", audio.install_steam_drivers);
+    bool_f(vars, "keep_host_audio", audio.keep_host_audio);
 
     string_restricted_f(vars, "origin_web_ui_allowed", nvhttp.origin_web_ui_allowed, {"pc"sv, "lan"sv, "wan"sv});
 
diff --git a/src/config.h b/src/config.h
index 7861538..2768c79 100644
--- a/src/config.h
+++ b/src/config.h
@@ -229,6 +229,7 @@ namespace config {
     std::string virtual_sink;  ///< Virtual audio sink for audio routing
     bool stream;  ///< Enable audio streaming to clients
     bool install_steam_drivers;  ///< Install Steam audio drivers for enhanced compatibility
+    bool keep_host_audio;  ///< Keep playing on the host's own sink, even when the client asks to mute the host
   };
 
   /**
-- 
