From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Philippe Simons <simons.philippe@gmail.com>
Date: Tue, 24 Nov 2026 10:33:02 +0100
Subject: [PATCH] nvhttp: take the client from the request's own connection

A launch or a resume belonged to the last client verified on any
connection. Another client's handshake between a client's own handshake and its
request put the stream under the other client, where disabling the one who asked
does not end it.

The client is remembered with the request its connection is about to carry.
---
 src/nvhttp.cpp | 57 ++++++++++++++++++++++++++++++++++++++++++++------
 1 file changed, 51 insertions(+), 6 deletions(-)

diff --git a/src/nvhttp.cpp b/src/nvhttp.cpp
index 8e33cad..c234157 100644
--- a/src/nvhttp.cpp
+++ b/src/nvhttp.cpp
@@ -10,6 +10,8 @@
 #include <chrono>
 #include <filesystem>
 #include <format>
+#include <map>
+#include <memory>
 #include <mutex>
 #include <string>
 #include <utility>
@@ -83,6 +85,7 @@ namespace nvhttp {
 
     std::function<int(SSL *)> verify;  ///< Callback that validates a client's TLS certificate after handshake.
     std::function<void(std::shared_ptr<Response>, std::shared_ptr<Request>)> on_verify_failed;  ///< Handler used to return the pairing challenge when client verification fails.
+    std::function<void(std::shared_ptr<Request>)> on_verified;  ///< Called right after a client is verified, with the request its connection is about to carry.
 
   protected:
     boost::asio::ssl::context context;  ///< TLS server context configured with Sunshine's certificate and protocol policy.
@@ -135,6 +138,9 @@ namespace nvhttp {
               if (verify && !verify(session->connection->socket->native_handle())) {
                 this->write(session, on_verify_failed);
               } else {
+                if (on_verified) {
+                  on_verified(session->request);
+                }
                 this->read(session);
               }
             } else if (this->on_error) {
@@ -198,7 +204,7 @@ namespace nvhttp {
   client_t client_root;  ///< In-memory representation of the paired-client database.
   std::atomic<uint32_t> session_id_counter;  ///< Monotonic counter used to allocate GameStream session IDs.
 
-  // Set by TLS verify callback, read by launch/resume handler (single-threaded HTTPS server)
+  // Set by the TLS verify callback, taken by remember_client() before any other handshake can run (single-threaded HTTPS server)
   std::string last_verified_client_cert;  ///< Last client certificate accepted by the TLS verify callback.  // NOSONAR(cpp:S5421): intentionally mutable global
   std::string last_verified_client_name;  ///< Friendly name of last client certificate accepted by the TLS verify callback. // NOSONAR(cpp:S5421): intentionally mutable global
 
@@ -214,6 +220,42 @@ namespace nvhttp {
    * @brief Shared HTTPS request object received by GameStream handlers.
    */
   using req_https_t = std::shared_ptr<typename SimpleWeb::ServerBase<SunshineHTTPS>::Request>;
+
+  /**
+   * @brief The client a connection was verified as.
+   */
+  struct verified_client_t {
+    std::string cert;  ///< Certificate PEM string.
+    std::string name;  ///< Friendly name.
+  };
+
+  // Keyed by the request the connection carries: another client's handshake can come between a client's own
+  // handshake and its request. Every handler closes its connection, so a connection carries one request.
+  std::map<std::weak_ptr<req_https_t::element_type>, verified_client_t, std::owner_less<>> verified_clients;  ///< Clients of the connections that are open.  // NOSONAR(cpp:S5421): intentionally mutable global
+
+  /**
+   * @brief Tie the client that was just verified to its connection's request.
+   *
+   * @param request Request the connection is about to carry.
+   */
+  void remember_client(const req_https_t &request) {
+    std::erase_if(verified_clients, [](const auto &entry) {
+      return entry.first.expired();
+    });
+    verified_clients.insert_or_assign(request, verified_client_t {last_verified_client_cert, last_verified_client_name});
+  }
+
+  /**
+   * @brief Get the client that sent a request.
+   *
+   * @param request HTTP request data from the client.
+   * @return The client, or an empty one when the request is not a verified connection's.
+   */
+  verified_client_t client_of(const req_https_t &request) {
+    const auto it = verified_clients.find(request);
+    return it == verified_clients.end() ? verified_client_t {} : it->second;
+  }
+
   /**
    * @brief Shared HTTP response object passed to redirect and discovery handlers.
    */
@@ -464,9 +506,10 @@ namespace nvhttp {
    *
    * @param host_audio Host audio.
    * @param args Arguments forwarded to the callable or parser.
+   * @param client Client that asks for the session.
    * @return Constructed launch session object.
    */
-  std::shared_ptr<rtsp_stream::launch_session_t> make_launch_session(bool host_audio, const args_t &args) {
+  std::shared_ptr<rtsp_stream::launch_session_t> make_launch_session(bool host_audio, const args_t &args, const verified_client_t &client) {
     auto launch_session = std::make_shared<rtsp_stream::launch_session_t>();
 
     launch_session->id = ++session_id_counter;
@@ -510,8 +553,8 @@ namespace nvhttp {
       launch_session->rtsp_iv_counter = 0;
     }
     launch_session->rtsp_url_scheme = launch_session->rtsp_cipher ? "rtspenc://"s : "rtsp://"s;
-    launch_session->client_cert = last_verified_client_cert;
-    launch_session->client_name = last_verified_client_name;
+    launch_session->client_cert = client.cert;
+    launch_session->client_name = client.name;
 
     // Generate the unique identifiers for this connection that we will send later during RTSP handshake
     unsigned char raw_payload[8];
@@ -1375,7 +1418,7 @@ namespace nvhttp {
     }
 
     host_audio = util::from_view(get_arg(args, "localAudioPlayMode"));
-    auto launch_session = make_launch_session(host_audio, args);
+    auto launch_session = make_launch_session(host_audio, args, client_of(request));
 
     if (rtsp_stream::session_count() == 0) {
       // The display should be restored in case something fails as there are no other sessions.
@@ -1490,7 +1533,7 @@ namespace nvhttp {
     if (no_active_sessions && args.find("localAudioPlayMode"s) != std::end(args)) {
       host_audio = util::from_view(get_arg(args, "localAudioPlayMode"));
     }
-    const auto launch_session = make_launch_session(host_audio, args);
+    const auto launch_session = make_launch_session(host_audio, args, client_of(request));
 
     if (no_active_sessions) {
       // We want to prepare display only if there are no active sessions at
@@ -1673,6 +1716,8 @@ namespace nvhttp {
       return verified;
     };
 
+    https_server.on_verified = remember_client;
+
     https_server.on_verify_failed = [](resp_https_t resp, req_https_t req) {
       pt::ptree tree;
       auto g = util::fail_guard([&]() {
-- 
