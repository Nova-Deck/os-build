#!/bin/bash
# novadeck-android — Android apps and the Google Play Store, through Valve's Lepton (Steam app 3029110).
#
#   novadeck-android store            open the Play Store (what its Steam title runs)
#   novadeck-android run PACKAGE      open an app (what an app's Steam title runs)
#   novadeck-android install FILE...  sideload .apk / .apkm / .xapk / .apks (split bundles too)
#   novadeck-android list             installed apps that have a Steam title
#   novadeck-android remove PACKAGE   uninstall (the Steam title has to be deleted by hand)
#   novadeck-android stop             shut Android down
#
# ONE SHARED ANDROID. A normal Steam launch of an Android title gets a fresh Lepton container whose
# data is per-title; Play does not fit that, because everything it installs lives in ONE /data. So
# this runs one persistent Lepton container as a user service (novadeck-android.service, started on
# demand, stopped 10 minutes after the last app closes), and the Play Store plus every app installed
# into it are Steam non-Steam shortcuts that `am start` inside it. Lepton is handed a Steam launch
# with no APK (SteamAppId=novadeck-android), which is what keeps /data between runs. Valve's own
# Android titles keep taking Lepton's stock per-launch path and never see anything below.
#
# WHAT RIDES IN, beyond stock Lepton, and only for this container (NOVADECK_ANDROID_OVERLAY):
#   /usr/share/novadeck-android/sdk<N>/   Play Store + Play services + permissions, a touch keyboard,
#                                         the Steam pad key layout (packages/android-gapps, and
#                                         rootfs/android-shared). Built for ONE guest SDK.
#   ~/.local/share/novadeck-android/framework/lepton-<ver>/  services.jar with the SystemServer
#                                         services Lepton strips, and everything compiled against it.
#                                         Tied to one exact Lepton image, so it is BUILT HERE, inside
#                                         the running guest, the first time an image has none -- see
#                                         build_framework (tools: packages/lepton-framework).
#   ~/.local/share/novadeck-android/props-<ver>/  build.prop copies presenting a certified Pixel 5
#                                         build, generated from the installed Lepton at start.
# plus the host's /dev/input (gamepads -- Lepton's guest has no evdev of its own) and the identity
# Lepton writes into its runtime props.
set -euo pipefail

LEPTON_APPID=3029110
LEPTON_DIR="${HOME}/.local/share/Steam/steamapps/common/Lepton"
LEPTON="${LEPTON_DIR}/lepton"
SYS="${HOME}/.local/share/novadeck-android"    # shared Android: data, icons, generated props, titles
CTR=lepton-steamlaunch-novadeck-android
UNIT=novadeck-android.service
RUNDIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
READY="${RUNDIR}/novadeck-android.ready"
DESKTOP_DIR="${HOME}/.local/share/applications"
APK_INFO=/usr/lib/novadeck/apk-info
OVERLAY_ROOT=/usr/share/novadeck-android
FW_TOOLS=/usr/lib/novadeck/android-framework
FW_DIR="${SYS}/framework"
# Launchable system apps that get a Steam title too.
SYSTEM_TITLES=(com.android.vending)
# Touch keyboard shipped in the payload (Simple Keyboard, F-Droid).
IME=rkr.simplekeyboard.inputmethod/.latin.LatinIME

say() { echo "novadeck-android: $*" >&2; }
die() { say "$*"; exit 1; }

ensure_lepton() {
  [[ -x "$LEPTON" ]] && return 0
  say "downloading the Android runtime (Lepton) through Steam"
  novadeck-steam-url "steam://install/${LEPTON_APPID}" >/dev/null 2>&1 || true
  local i
  for ((i = 0; i < 360; i++)); do
    [[ -x "$LEPTON" ]] && sleep 20 && return 0  # let Steam finish writing the depot
    sleep 5
  done
  die "Lepton did not finish installing -- check Steam's Downloads page, then try again"
}

# The installed guest's Android SDK level, read from its own image.
guest_sdk() {
  sed -n 's/^ro\.build\.version\.sdk=//p' "${LEPTON_DIR}/images/rootfs/system/build.prop" 2>/dev/null | head -n1
}

# Idempotent edits to Steam's copy of Lepton, re-applied on every start because a Steam update
# overwrites the tool. Each one is keyed on NOVADECK_ANDROID_OVERLAY, which only this service sets,
# so a normal Steam launch of an Android title runs exactly Valve's code. A hunk whose anchor moved
# upstream is reported and skipped, never guessed at.
patch_lepton() {
  python3 - "${LEPTON_DIR}" <<'EOF'
import sys, pathlib
root = pathlib.Path(sys.argv[1])
def patch(name, old, new):
    f = root / name
    s = f.read_text()
    if new in s:
        return
    if old not in s:
        print(f"novadeck-android: WARN {name} changed upstream, edit skipped", file=sys.stderr)
        return
    f.write_text(s.replace(old, new, 1))

# A Steam launch with no APK boots straight to Android (like `lepton start dev`) but keeps its data
# the way a Steam game does.
patch("lepton",
      '        if ! is_steamlaunch && ! is_app; then\n            continue_boot_after_bake\n',
      '        # novadeck-android: shared Android without an app\n'
      '        if ! is_app; then\n            continue_boot_after_bake\n')
patch("lepton",
      '        if is_steamlaunch || [[ "${LEPTON_CONTEXT}" == *.apk ]]; then\n'
      '            if [[ -z "${APP_PACKAGE_ID}" ]]; then\n',
      '        # novadeck-android: the shared Android has no APK\n'
      '        if { is_steamlaunch && is_app; } || [[ "${LEPTON_CONTEXT}" == *.apk ]]; then\n'
      '            if [[ -z "${APP_PACKAGE_ID}" ]]; then\n')

# Per-app persistent data only makes sense with an app: an empty app id would move the whole compat
# dir into itself.
patch("liblepton/mounting.sh",
      '    if [[ -d "${STEAM_COMPAT_DATA_PATH:-}" ]]; then\n'
      '        PERSISTENT_DATA_PATH=',
      '    # novadeck-android: the shared Android has no app id\n'
      '    if [[ -d "${STEAM_COMPAT_DATA_PATH:-}" && -n "$(get_app_id)" ]]; then\n'
      '        PERSISTENT_DATA_PATH=')

# Gamepads. Lepton binds no /dev/input at all -- its guest reads touch/keyboard/pointer from the
# hwcomposer's Wayland pipes and nothing else. The host's live /dev/input goes in read-only and
# sync_pads links the current pads into the guest's own /dev/input. The whole directory rather than
# per-node binds, because Steam recreates its virtual pads and a per-node bind would go stale.
patch("liblepton/mounting.sh",
      '    # By default, we do not allow writes to msg\n',
      '    # novadeck-android: host input devices\n'
      '    if [[ -n "${NOVADECK_ANDROID_OVERLAY:-}" ]]; then\n'
      '        podman_mount_entry /dev/input /dev/host-input ro\n'
      '    fi\n\n'
      '    # By default, we do not allow writes to msg\n')

# The extra rootfs overlays, walked the same way as Lepton's own guestos slot.
patch("liblepton/mounting.sh",
      '    for OVERLAY in ${LEPTON_OVERLAY} ${GUESTOS_OVERLAY}; do\n',
      '    # novadeck-android: extra overlays\n'
      '    for OVERLAY in ${LEPTON_OVERLAY} ${GUESTOS_OVERLAY} ${NOVADECK_ANDROID_OVERLAY:-}; do\n')

# Lepton writes brand/model/manufacturer into its runtime props on every start. Match the identity
# in the generated build.props, or Google sees a Pixel 5 fingerprint on a "Valve Lepton" and
# refuses the device again.
patch("liblepton/properties.sh",
      '    props_echo "ro.product.brand=Steam Frame"\n'
      '    props_echo "ro.product.model=Lepton"\n'
      '    props_echo "ro.product.manufacturer=Valve"\n',
      '    # novadeck-android: certified identity\n'
      '    if [[ -n "${NOVADECK_ANDROID_PROPS:-}" ]]; then\n'
      '        props_echo "ro.product.brand=google"\n'
      '        props_echo "ro.product.model=Pixel 5"\n'
      '        props_echo "ro.product.manufacturer=Google"\n'
      '    else\n'
      '    props_echo "ro.product.brand=Steam Frame"\n'
      '    props_echo "ro.product.model=Lepton"\n'
      '    props_echo "ro.product.manufacturer=Valve"\n'
      '    fi\n')
EOF
}

# Google refuses Play sign-in on an uncertified build ("This device isn't Play Protect certified"),
# and Lepton identifies as a userdebug test-keys build. These present the certified Pixel 5 build of
# the SAME Android 11 release instead -- which is why they are generated only for an SDK-30 guest.
# Generated from the installed Lepton so they follow its updates; bump PROPS_REV when a value changes.
# ro.build.type stays Lepton's userdebug: with "user" the vendor interface check fails and "Android
# System: there's an internal problem with your device" appears on every start.
PROPS_REV=1
PROPS_FP=google/redfin/redfin:11/RQ3A.211001.001/7641976:user/release-keys
props_overlay() {
  local ver="$1" src="${LEPTON_DIR}/images/rootfs" out f
  out="${SYS}/props-${ver}"
  if [[ "$(cat "$out/.rev" 2>/dev/null)" != "$PROPS_REV" ]]; then
    rm -rf "$out"
    for f in system/build.prop system/system_ext/build.prop system/product/build.prop \
        vendor/build.prop vendor/odm/etc/build.prop; do
      [[ -f "$src/$f" ]] || continue
      mkdir -p "$out/${f%/*}"
      sed -E \
        -e "s#^(ro\.([a-z_]+\.)?build\.fingerprint)=.*#\1=${PROPS_FP}#" \
        -e "s#^(ro\.bootimage\.build\.fingerprint)=.*#\1=${PROPS_FP}#" \
        -e 's#^(ro\.([a-z_]+\.)?build\.tags)=.*#\1=release-keys#' \
        -e 's#^(ro\.product\.([a-z_]+\.)?brand)=.*#\1=google#' \
        -e 's#^(ro\.product\.([a-z_]+\.)?manufacturer)=.*#\1=Google#' \
        -e 's#^(ro\.product\.([a-z_]+\.)?model)=.*#\1=Pixel 5#' \
        -e 's#^(ro\.product\.([a-z_]+\.)?(name|device))=.*#\1=redfin#' \
        -e 's#^(ro\.build\.version\.incremental)=.*#\1=7641976#' \
        -e 's#^(ro\.build\.description)=.*#\1=redfin-user 11 RQ3A.211001.001 7641976 release-keys#' \
        -e 's#^(ro\.build\.version\.security_patch)=.*#\1=2021-10-05#' \
        "$src/$f" >"$out/$f"
    done
    if [[ -f "$out/system/build.prop" ]] && ! grep -q '^ro\.build\.fingerprint=' "$out/system/build.prop"; then
      echo "ro.build.fingerprint=${PROPS_FP}" >>"$out/system/build.prop"
    fi
    echo "$PROPS_REV" >"$out/.rev"
  fi
  echo "$out"
}

# --- the framework fix, built on the device ---------------------------------------------------
#
# Lepton comments SystemServer services out of services.jar (restore-services.py lists them), and
# apps that expect them crash -- the touch keyboard first. Restoring them edits Lepton's own jar,
# which only exists in the image Steam installed, and invalidates everything compiled against it,
# which only the guest's dex2oat can rebuild. So the fix is built HERE, once per Lepton image, in a
# running stock guest: baksmali and smali run under the guest's own ART (converted to dex at build
# time -- the host has no JVM), the smali edit and the jar repack run on the host's python3, and
# compile-odex.sh runs the guest's dex2oat. The result is kept per image version; a Lepton update
# that keeps the image (the tool is versioned separately) keeps the fix.

image_version() {
  local ver
  ver="$(cat "${LEPTON_DIR}/images/version.txt" 2>/dev/null || true)"
  [[ "$ver" =~ ^[A-Za-z0-9._-]+$ ]] && echo "$ver"
  return 0
}

# Whether this start should build the fix: the tools target this guest's SDK, and there is neither
# a fix nor a failed attempt for its image.
framework_wanted() {
  local ver
  ver="$(image_version)"
  [[ -n "$ver" && "$(guest_sdk)" == "$(cat "${FW_TOOLS}/api" 2>/dev/null)" ]] || return 1
  [[ ! -d "${FW_DIR}/lepton-${ver}" && ! -f "${FW_DIR}/lepton-${ver}.failed" ]]
}

# ART run from podman exec has none of init's environment: no PATH to the ART apex, no boot class
# path. -Xmx512m because a 1g heap asks for a 2 GB region below 4 GB, which the guest cannot find.
# One export per statement: a bare newline would end the export, leaving the rest unexported.
ART_ENV='export ANDROID_ROOT=/system ANDROID_DATA=/data ANDROID_ART_ROOT=/apex/com.android.art;
  export ANDROID_I18N_ROOT=/apex/com.android.i18n ANDROID_TZDATA_ROOT=/apex/com.android.tzdata;
  export PATH=/apex/com.android.art/bin:/system/bin;
  export BOOTCLASSPATH="$(grep -w BOOTCLASSPATH /init.environ.rc | awk "{print \$3}")"; '
FW_GUEST=/data/local/tmp/novadeck-fw

# Guest shell with ART's environment, stderr kept (the build log wants it); files in and out.
gsh() { podman exec -i "$CTR" /system/bin/sh -c "${ART_ENV}$1"; }
gput() { podman exec -i "$CTR" /system/bin/sh -c "cat >'$2'" <"$1"; }
gget() { podman exec "$CTR" /system/bin/sh -c "cat '$1'" >"$2"; }

# The steps. Run as their own process (`novadeck-android framework-steps WORK OUT`): bash ignores
# errexit in anything called from an `if` condition, subshells included, so in-process the steps
# would carry on past the first failure.
framework_steps() {
  local work="$1" api orig out="$2" g="$FW_GUEST"
  api="$(cat "${FW_TOOLS}/api")"
  orig="${LEPTON_DIR}/images/rootfs/system/framework/services.jar"
  gsh "rm -rf $g /data/local/tmp/out; mkdir -p $g/jar"
  gput "${FW_TOOLS}/baksmali.dex.jar" "$g/baksmali.dex.jar"
  gput "${FW_TOOLS}/smali.dex.jar" "$g/smali.dex.jar"
  gput "$orig" "$g/orig.jar"
  echo "== baksmali (guest ART)"
  gsh "cd $g/jar && unzip -q ../orig.jar classes.dex && cd .. &&
       dalvikvm64 -Xmx512m -cp $g/baksmali.dex.jar org.jf.baksmali.Main d -a $api jar/classes.dex -o classes"
  echo "== restore-services.py"
  gget "$g/classes/com/android/server/SystemServer.smali" "$work/SystemServer.smali"
  python3 "${FW_TOOLS}/restore-services.py" "$work/SystemServer.smali"
  grep -q '# novadeck: restored services' "$work/SystemServer.smali"
  gput "$work/SystemServer.smali" "$g/classes/com/android/server/SystemServer.smali"
  echo "== smali (guest ART)"
  gsh "cd $g && dalvikvm64 -Xmx512m -cp $g/smali.dex.jar org.jf.smali.Main a -a $api classes -o classes.new.dex"
  gget "$g/classes.new.dex" "$work/classes.new.dex"
  python3 "${FW_TOOLS}/repack-jar.py" "$orig" "$work/services.jar" "classes.dex=$work/classes.new.dex"
  echo "== compile-odex (guest dex2oat)"
  gput "$work/services.jar" /data/local/tmp/services.jar
  gput "${FW_TOOLS}/compile-odex.sh" /data/local/tmp/compile-odex.sh
  gsh "/system/bin/sh /data/local/tmp/compile-odex.sh"
  mkdir -p "$out"
  gsh "cd /data/local/tmp/out && tar cf - ." | tar xf - -C "$out"
  cp "$work/services.jar" "$out/system/framework/services.jar"
  # services.jar + services.{odex,vdex,art} + ethernet-service.{odex,vdex} + the two apex jars'
  # dex/vdex in dalvik-cache: compile-odex.sh's whole output.
  local n
  n="$(find "$out" -type f | wc -l)"
  [[ "$n" -eq 10 ]] || { echo "expected 10 files, got $n"; find "$out" -type f; exit 1; }
}

# Build the fix for image $1 into FW_DIR. Never fails the caller: a failed build leaves
# lepton-<ver>.failed (its log), so later starts boot stock without paying for it again.
build_framework() {
  local ver="$1" work out="${FW_DIR}/lepton-$1"
  mkdir -p "$FW_DIR"
  work="$(mktemp -d)"
  rm -rf "${out}.part"
  say "building the framework fix for Lepton image ${ver}"
  if "${BASH_SOURCE[0]}" framework-steps "$work" "${out}.part" >"${out}.log" 2>&1; then
    mv "${out}.part" "$out"
    rm -f "${out}.log"
    say "framework fix for Lepton image ${ver} built; restarting Android onto it"
  else
    rm -rf "${out}.part"
    mv "${out}.log" "${out}.failed"
    say "building the framework fix for Lepton image ${ver} FAILED -- see ${out}.failed;" \
        "Android runs without it"
  fi
  gsh "rm -rf $FW_GUEST /data/local/tmp/out /data/local/tmp/services.jar /data/local/tmp/compile-odex.sh" \
    >/dev/null 2>&1 || true
  rm -rf "$work"
}

# The overlay list for this start, and a plain statement of anything missing from it. Runs in a
# command substitution, so it cannot set variables for the caller -- cmd_daemon derives
# NOVADECK_ANDROID_PROPS from the same guest_sdk test.
overlay_dirs() {
  local ver sdk dirs=()
  ver="$(cat "${LEPTON_DIR}/images/version.txt" 2>/dev/null || true)"
  sdk="$(guest_sdk)"
  if [[ -d "${OVERLAY_ROOT}/sdk${sdk}" ]]; then
    dirs+=("${OVERLAY_ROOT}/sdk${sdk}")
  else
    say "Lepton's Android image ${ver:-(unknown)} is Android SDK ${sdk:-(unknown)}; this build carries Google Play" \
        "for SDK $(cd "$OVERLAY_ROOT" 2>/dev/null && compgen -G 'sdk*' | sed 's/^sdk//' | paste -sd, || echo none) only," \
        "so Android starts WITHOUT Play"
  fi
  if [[ -d "${FW_DIR}/lepton-${ver}" ]]; then
    dirs+=("${FW_DIR}/lepton-${ver}")
  elif framework_wanted; then
    say "no framework fix for Lepton image ${ver} yet; building it on this start (about a minute)"
  elif [[ -f "${FW_DIR}/lepton-${ver}.failed" ]]; then
    say "building the framework fix for Lepton image ${ver} failed before (${FW_DIR}/lepton-${ver}.failed;" \
        "delete it to retry); apps that need the services Lepton strips (keyboard, clipboard, auth) may crash"
  else
    say "the framework fix targets Android SDK $(cat "${FW_TOOLS}/api" 2>/dev/null || echo '(none)'), and Lepton's image" \
        "${ver:-(unknown)} is SDK ${sdk:-(unknown)}; apps that need the services Lepton strips may crash"
  fi
  if [[ "$sdk" == 30 ]]; then
    dirs+=("$(props_overlay "${ver:-unknown}")")
  fi
  echo "${dirs[*]}"
}

# Steam's pads (vendor 28de) when Steam Input is active, otherwise the others -- never both, or
# every press lands twice. "Virtual" does not mean Steam: InputPlumber's pad is a uinput device too,
# and it is the one Steam reads to make its own.
gamepad_nodes() {
  local steam=() other=() ev sys
  for sys in /sys/class/input/event*; do
    ev="${sys##*/}"
    [[ -r "/dev/input/${ev}" ]] || continue
    udevadm info -q property -n "/dev/input/${ev}" 2>/dev/null | grep -qx 'ID_INPUT_JOYSTICK=1' || continue
    if [[ "$(cat "${sys}/device/id/vendor" 2>/dev/null)" == 28de ]]; then
      steam+=("$ev")
    else
      other+=("$ev")
    fi
  done
  if ((${#steam[@]})); then echo "${steam[*]}"; else echo "${other[*]}"; fi
}

# App id of the Steam launch we are running under (the reaper's "SteamLaunch AppId=N"), found the
# same way gamescope finds a window's app.
steam_launch_appid() {
  local pid=$$ comm args
  while ((pid > 1)); do
    comm="$(cat "/proc/$pid/comm" 2>/dev/null)" || break
    if [[ "$comm" == reaper ]]; then
      args="$(tr '\0' '\n' <"/proc/$pid/cmdline")"
      grep -qx SteamLaunch <<<"$args" && sed -n 's/^AppId=\([0-9]\+\)$/\1/p' <<<"$args" | head -n1
      return 0
    fi
    pid="$(awk '{print $4}' "/proc/$pid/stat" 2>/dev/null)" || break
  done
  return 0
}

# Shell command inside Android. Stdin passes through (APK streaming).
asx() { podman exec -i "$CTR" /system/bin/sh -c "$1" 2>/dev/null; }

android_up() { [[ -f "$READY" ]] && systemctl --user -q is-active "$UNIT"; }

# A Wayland display plus the inode of its socket. A restarted gamescope reuses the NAME
# (gamescope-0) but binds a new socket, so the name alone cannot tell the two compositors apart.
display_instance() {
  local sock="$1"
  [[ "$sock" == /* ]] || sock="${RUNDIR}/${sock}"
  echo "$1 $(stat -Lc %i "$sock" 2>/dev/null)"
}

# The service has no display of its own: it draws on gamescope's Wayland socket, which only a
# process Steam launched knows. So the caller's value is handed to the user manager each start.
ensure_android() {
  local want="${GAMESCOPE_WAYLAND_DISPLAY:-}" i
  [[ -n "$want" ]] || die "GAMESCOPE_WAYLAND_DISPLAY is not set -- run this from a Steam title, inside the gamescope session"
  if android_up && [[ "$(cat "$READY")" == "$(display_instance "$want")" ]]; then
    return 0
  fi
  # gamescope restarted since Android started: its window lives on the dead socket.
  systemctl --user stop "$UNIT" 2>/dev/null || true
  systemctl --user set-environment NOVADECK_ANDROID_DISPLAY="$want"
  systemctl --user start "$UNIT"
  say "starting Android"
  # Up to 10 minutes: the first start with a new Lepton image boots twice around the framework
  # build, and on an SD card each leg is slow.
  for ((i = 0; i < 300; i++)); do
    android_up && return 0
    systemctl --user -q is-active "$UNIT" || break
    sleep 2
  done
  die "Android did not start (journalctl --user -u $UNIT)"
}

# --- titles -----------------------------------------------------------------------------------

add_title() {
  local pkg="$1" path apk meta label activity desktop icon="${SYS}/icons/${pkg}.png"
  path="$(asx "pm path $pkg" | sed -n 's/^package://p' | grep -m1 '\.apk$' || true)"
  [[ -n "$path" ]] || return 0
  # Read it through Android: installs are not reliably visible from the host side of Lepton's
  # /data overlay.
  apk="$(mktemp --suffix=.apk)"
  asx "cat '$path'" >"$apk" || true
  mkdir -p "${SYS}/icons"
  mapfile -t meta < <(python3 "$APK_INFO" "$apk" "$icon" 2>/dev/null || true)
  rm -f "$apk"
  activity="${meta[2]:-}"
  [[ -n "$activity" ]] || return 0   # nothing to open (services, libraries)
  label="${meta[1]:-$pkg}"
  write_desktop "$pkg" "$label" "$icon"
  grep -qx "$pkg" "${SYS}/titles" 2>/dev/null && return 0
  if steam_add "${DESKTOP_DIR}/novadeck-android-${pkg}.desktop" "$pkg"; then
    echo "$pkg" >>"${SYS}/titles"
    say "${label} added to the Steam library"
  fi
  return 0
}

write_desktop() {
  local pkg="$1" label="$2" icon="$3"
  [[ -f "$icon" ]] || icon=android-package-archive
  mkdir -p "$DESKTOP_DIR"
  cat >"${DESKTOP_DIR}/novadeck-android-${pkg}.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=${label}
Comment=Android app (${pkg})
Exec=/usr/bin/novadeck-android run ${pkg}
Icon=${icon}
Categories=Game;
EOF
}

# Is there a Steam shortcut for this package? Steam stores a .desktop add as exe
# "/usr/bin/novadeck-android", LaunchOptions '"run" "<pkg>"' and the .desktop as ShortcutPath.
steam_has() {
  grep -qaF -e "\"run\" \"$1\"" -e "novadeck-android-$1.desktop" \
    "${HOME}"/.local/share/Steam/userdata/*/config/shortcuts.vdf 2>/dev/null
}

# Add a shortcut and confirm Steam actually took it. The URL forward always "succeeds"; before the
# user has signed in and the library is up (first boot) Steam drops it silently, so shortcuts.vdf is
# the only honest answer.
steam_add() {
  local desktop="$1" pkg="$2" url i
  steam_has "$pkg" && return 0
  pgrep -u "$(id -u)" -x steam >/dev/null 2>&1 || return 1
  compgen -G "${HOME}/.local/share/Steam/userdata/[1-9]*/config/localconfig.vdf" >/dev/null || return 1
  url="steam://addnonsteamgame/$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$desktop")"
  touch /tmp/addnonsteamgamefile
  novadeck-steam-url "$url" >/dev/null 2>&1 || return 1
  for ((i = 0; i < 15; i++)); do
    sleep 2
    steam_has "$pkg" && return 0
  done
  return 1
}

# New apps get a title; uninstalled ones lose their desktop entry.
sync_titles() {
  local pkgs pkg f
  pkgs="$(asx "pm list packages -3" | sed -n 's/^package://p' || true)"
  pkgs+=$'\n'"$(printf '%s\n' "${SYSTEM_TITLES[@]}")"
  # Keyboards have a settings screen but are not something to launch.
  pkgs="$(grep -vxF -f <(asx "ime list -a -s" | cut -d/ -f1 || true) <<<"$pkgs" || true)"
  for pkg in $pkgs; do
    f="${DESKTOP_DIR}/novadeck-android-${pkg}.desktop"
    if [[ ! -f "$f" ]]; then
      add_title "$pkg"
    elif ! grep -qx "$pkg" "${SYS}/titles" 2>/dev/null; then
      steam_add "$f" "$pkg" && echo "$pkg" >>"${SYS}/titles"
    fi
  done
  for f in "${DESKTOP_DIR}"/novadeck-android-*.desktop; do
    [[ -f "$f" ]] || continue
    pkg="${f##*/novadeck-android-}"; pkg="${pkg%.desktop}"
    grep -qx "$pkg" <<<"$pkgs" || rm -f "$f"
  done
}

# Link the current pads into Android's /dev/input. EventHub watches that directory for
# create/delete, so relinking whenever a node changes (Steam recreates its virtual pad per launch)
# acts as a hot-plug.
PADS=""
sync_pads() {
  local ev want="" cmd="rm -f /dev/input/event*;"
  for ev in $(gamepad_nodes); do
    want+="${ev}:$(stat -c %i "/dev/input/${ev}") "
    cmd+=" ln -s /dev/host-input/${ev} /dev/input/${ev};"
  done
  [[ "$want" == "$PADS" ]] && return 0
  asx "$cmd" && PADS="$want"
}

# --- commands ---------------------------------------------------------------------------------

# Launch Lepton with this start's overlays and wait for Android to finish booting. LEPTON_PID is
# global: the TERM trap and a second boot both need the current one.
LEPTON_PID=""
start_android() {
  local overlays i
  overlays="$(overlay_dirs)"
  NOVADECK_ANDROID_PROPS=""
  [[ "$(guest_sdk)" == 30 ]] && NOVADECK_ANDROID_PROPS=1
  export NOVADECK_ANDROID_OVERLAY="$overlays" NOVADECK_ANDROID_PROPS

  "$LEPTON" waitforexitandrun &
  LEPTON_PID=$!
  for ((i = 0; i < 150; i++)); do
    [[ "$(asx "getprop sys.boot_completed" || true)" == 1 ]] && break
    kill -0 "$LEPTON_PID" 2>/dev/null || exit 1
    sleep 2
  done
}

# novadeck-android.service body.
cmd_daemon() {
  ensure_lepton
  patch_lepton
  mkdir -p "${SYS}/app" "${SYS}/data" "${SYS}/shadercache/fozpipelinesv6"
  # Present a 2D screen: a Steam launch otherwise runs the guest headless.
  touch "${SYS}/app/lepton-show-flatscreen"
  rm -f "$READY"

  export SteamAppId=novadeck-android
  export STEAM_COMPAT_INSTALL_PATH="${SYS}/app"
  export STEAM_COMPAT_CLIENT_INSTALL_PATH="${HOME}/.local/share/Steam"
  export STEAM_COMPAT_DATA_PATH="${SYS}/data"
  export STEAM_COMPAT_LIBRARY_PATHS="${SYS}"
  export STEAM_COMPAT_SHADER_PATH="${SYS}/shadercache"
  export STEAM_FOSSILIZE_DUMP_PATH="${SYS}/shadercache/fozpipelinesv6/steamapp_pipeline_cache"
  # Never let Lepton wipe the shared /data on an "early exit". Honoured from Lepton 3.x on; an older
  # Lepton wipes regardless, which costs the installed apps and the Google sign-in.
  export LEPTON_NO_CLEANUP=true
  export GAMESCOPE_WAYLAND_DISPLAY="${NOVADECK_ANDROID_DISPLAY:?started without a display -- use novadeck-android store/run}"
  local i ver
  trap 'rm -f "$READY"; kill -TERM "$LEPTON_PID" 2>/dev/null; wait "$LEPTON_PID"; exit 0' TERM INT

  start_android
  # A Lepton image this device has no framework fix for: build it in the stock guest that just
  # booted, then boot again onto it. Same unit throughout, so a caller waiting in ensure_android
  # keeps waiting instead of seeing the unit go inactive.
  if framework_wanted; then
    ver="$(image_version)"
    build_framework "$ver"
    if [[ -d "${FW_DIR}/lepton-${ver}" ]]; then
      kill -TERM "$LEPTON_PID" 2>/dev/null || true
      wait "$LEPTON_PID" || true
      start_android
    fi
  fi
  # Lepton ships no keyboard; ours is in the payload. Android treats the Wayland keyboard as a
  # hardware one and would hide the touch keyboard without show_ime_with_hard_keyboard.
  asx 'ime enable '"$IME"'; case "$(settings get secure default_input_method)" in ""|null) ime set '"$IME"';; esac;
       settings put secure show_ime_with_hard_keyboard 1' >/dev/null || true
  # No setup wizard runs here, and Android ignores Home ("user setup is in progress") until setup is
  # marked done. It gets reset, so set it on every boot.
  asx 'settings put secure user_setup_complete 1; settings put global device_provisioned 1' >/dev/null || true
  # Google checked this Android in under whatever identity it had before. With no account signed in
  # yet, clear that so it checks in again as the certified build.
  if [[ -n "$NOVADECK_ANDROID_PROPS" && "$(cat "${SYS}/props-rev" 2>/dev/null)" != "$PROPS_REV" ]]; then
    if ! asx 'dumpsys account' | grep -qE 'Account \{name=.*, type=com\.google\}'; then
      asx 'pm clear com.google.android.gsf; pm clear com.google.android.gms; pm clear com.android.vending' >/dev/null || true
    fi
    echo "$PROPS_REV" >"${SYS}/props-rev"
  fi
  display_instance "$GAMESCOPE_WAYLAND_DISPLAY" >"$READY"

  # Pads every 3 s; titles for apps installed from inside Android (the Play Store) every 15 s.
  for ((i = 0; ; i++)); do
    kill -0 "$LEPTON_PID" 2>/dev/null || break
    sync_pads || true
    ((i % 5)) || sync_titles || true
    sleep 3 &
    wait $! || true
  done
  rm -f "$READY"
  wait "$LEPTON_PID"
}

# Unpack FILE into DIR as base.apk (+ splits) and obb/.
unpack() {
  local src="$1" tmp="$2" f p
  case "${src,,}" in
    *.apk)
      cp "$src" "$tmp/base.apk"
      ;;
    *.apkm|*.xapk|*.apks|*.zip)
      mkdir "$tmp/x"
      unzip -qq -o "$src" -d "$tmp/x" 2>/dev/null \
        || die "cannot unpack $(basename "$src") (password-protected .apkm files are not supported)"
      # Bundletool .apks keep splits under splits/; the rest are flat.
      while IFS= read -r -d '' f; do cp "$f" "$tmp/"; done \
        < <(find "$tmp/x" -type f -iname '*.apk' -print0)
      [[ -f "$tmp/base.apk" || ! -f "$tmp/base-master.apk" ]] || mv "$tmp/base-master.apk" "$tmp/base.apk"
      if [[ ! -f "$tmp/base.apk" ]]; then
        # XAPK: the base is named <package>.apk
        p="$(jq -r '.package_name // empty' "$tmp/x/manifest.json" 2>/dev/null || true)"
        [[ -n "$p" && -f "$tmp/$p.apk" ]] && mv "$tmp/$p.apk" "$tmp/base.apk"
      fi
      [[ -f "$tmp/base.apk" ]] || die "no base APK in $(basename "$src")"
      if [[ -d "$tmp/x/Android/obb" ]]; then
        mkdir -p "$tmp/obb"
        find "$tmp/x/Android/obb" -type f -name '*.obb' -exec cp {} "$tmp/obb/" \;
      fi
      rm -rf "$tmp/x"
      ;;
    *) die "unsupported file: $(basename "$src") (use .apk, .apkm, .xapk or .apks)" ;;
  esac
}

# Subshell: die/trap stay local to one file.
cmd_install() (
  local src tmp meta pkg apks=() size sid f n=0
  src="$(realpath -- "$1")"
  [[ -f "$src" ]] || die "no such file: $1"
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  unpack "$src" "$tmp"

  mapfile -t meta < <(python3 "$APK_INFO" "$tmp/base.apk" 2>/dev/null || true)
  pkg="${meta[0]:-}"
  [[ "$pkg" =~ ^[A-Za-z0-9_.]+$ ]] || die "cannot read the package name from $(basename "$src")"

  ensure_android
  apks=("$tmp/base.apk")
  for f in "$tmp"/*.apk; do [[ "$f" == "$tmp/base.apk" ]] || apks+=("$f"); done
  # Stream into a PackageInstaller session (works for splits too).
  size=0
  for f in "${apks[@]}"; do size=$((size + $(stat -c %s "$f"))); done
  sid="$(asx "pm install-create -r -g -S $size" | sed -n 's/.*\[\([0-9]*\)\].*/\1/p' || true)"
  [[ -n "$sid" ]] || die "Android refused to install $(basename "$src")"
  for f in "${apks[@]}"; do
    asx "pm install-write -S $(stat -c %s "$f") $sid $((n++)).apk -" <"$f" >/dev/null \
      || die "copying $(basename "$src") into Android failed"
  done
  asx "pm install-commit $sid" | grep -q Success || die "Android could not install $(basename "$src")"
  if [[ -d "$tmp/obb" ]]; then
    asx "mkdir -p /sdcard/Android/obb/$pkg" || true
    for f in "$tmp"/obb/*.obb; do
      asx "cat > /sdcard/Android/obb/$pkg/${f##*/}" <"$f" || die "copying $(basename "$f") failed"
    done
  fi
  asx "appops set $pkg REQUEST_INSTALL_PACKAGES allow" >/dev/null || true
  add_title "$pkg"
  say "installed ${meta[1]:-$pkg}"
)

# NOVADECK_ANDROID_APPID on gamescope's root window: which Steam title the shared Android window
# belongs to (0 = none). Read by gamescope patch 0023.
set_window_appid() {
  [[ -n "${DISPLAY:-}" ]] || return 0
  xprop -root -f NOVADECK_ANDROID_APPID 32c -set NOVADECK_ANDROID_APPID "$1" 2>/dev/null || true
}

schedule_idle_stop() {
  systemctl --user stop novadeck-android-idle.timer 2>/dev/null || true
  systemd-run --user --quiet --collect --unit=novadeck-android-idle --on-active=600 \
    /usr/bin/novadeck-android idle-stop >/dev/null 2>&1 || true
}

cmd_run() {
  local pkg="$1" comp appid focus gone=0 home=0
  [[ "$pkg" =~ ^[A-Za-z0-9_.]+$ ]] || die "bad package name: $pkg"
  ensure_android
  asx "pm path $pkg" | grep -q '^package:' || die "${pkg} is not installed"
  comp="$(asx "cmd package resolve-activity --brief -c android.intent.category.LAUNCHER $pkg" | tail -n1 || true)"
  [[ "$comp" == */* ]] || die "${pkg} has nothing to open"

  # Tell gamescope the shared Android window belongs to this Steam title.
  appid="$(steam_launch_appid)"
  set_window_appid "${appid:-0}"
  # Toggling "install unknown apps" at runtime kills the app; grant it up front.
  asx "appops set $pkg REQUEST_INSTALL_PACKAGES allow; am start -n $comp" >/dev/null || true

  # Steam counts a title as running while it owns a window, so hand the shared window back on the
  # way out or Exit Game never finishes.
  trap 'set_window_appid 0; asx "am force-stop '"$pkg"'" >/dev/null || true; schedule_idle_stop; exit 0' TERM INT HUP
  # Stay alive -- Steam shows the title as running and keeps feeding it the controller -- while the
  # user is anywhere in Android (Home, Recents, other apps). End when Steam's Exit Game kills us, or
  # once the app has really closed and the Android home screen is up.
  while android_up; do
    sleep 3
    if asx "pidof $pkg" >/dev/null; then gone=0; else gone=$((gone + 1)); fi
    if ((gone >= 2)); then
      focus="$(asx "dumpsys window | grep -m1 mCurrentFocus" || true)"
      if [[ "$focus" == *launcher3* ]]; then home=$((home + 1)); else home=0; fi
      ((home < 2)) || break
    fi
  done
  set_window_appid 0
  schedule_idle_stop
}

# At login: a Play Store title, so there is something to start from. Needs no running Android --
# the APK ships in the image.
cmd_setup() {
  local i sdk desktop icon="${SYS}/icons/com.android.vending.png" apk
  steam_has com.android.vending && return 0
  apk="$(compgen -G "${OVERLAY_ROOT}/sdk*/system/product/priv-app/Phonesky/Phonesky.apk" | head -n1 || true)"
  [[ -n "$apk" ]] || die "no Play Store in this build (${OVERLAY_ROOT}/sdk*/)"
  mkdir -p "${SYS}/icons"
  python3 "$APK_INFO" "$apk" "$icon" >/dev/null 2>&1 || true
  write_desktop com.android.vending "Google Play Store" "$icon"
  desktop="${DESKTOP_DIR}/novadeck-android-com.android.vending.desktop"
  # First boot: Steam still has to be signed in and show the library. Keep trying for two hours, and
  # record the title only once Steam really has it.
  for ((i = 0; i < 360; i++)); do
    if steam_add "$desktop" com.android.vending; then
      grep -qx com.android.vending "${SYS}/titles" 2>/dev/null \
        || echo com.android.vending >>"${SYS}/titles"
      return 0
    fi
    sleep 20
  done
  die "Steam never accepted the Play Store shortcut (is anyone signed in?)"
}

cmd_idle_stop() {
  pgrep -f "novadeck-android run " >/dev/null && return 0
  systemctl --user stop "$UNIT"
}

cmd_list() {
  local f pkg
  for f in "${DESKTOP_DIR}"/novadeck-android-*.desktop; do
    [[ -f "$f" ]] || continue
    pkg="${f##*/novadeck-android-}"
    printf '%-40s %s\n' "${pkg%.desktop}" "$(sed -n 's/^Name=//p' "$f")"
  done
}

cmd_remove() {
  local pkg="$1"
  [[ "$pkg" =~ ^[A-Za-z0-9_.]+$ ]] || die "bad package name: $pkg"
  ensure_android
  asx "pm uninstall $pkg" | grep -q Success || die "${pkg} is not installed"
  rm -f "${DESKTOP_DIR}/novadeck-android-${pkg}.desktop" "${SYS}/icons/${pkg}.png"
  sed -i "/^${pkg//./\\.}\$/d" "${SYS}/titles" 2>/dev/null || true
  say "removed ${pkg} -- delete its title from the Steam library by hand"
}

case "${1:-}" in
  install) shift; (($#)) || die "usage: novadeck-android install FILE..."; for f; do cmd_install "$f"; done ;;
  run) [[ -n "${2:-}" ]] || die "usage: novadeck-android run PACKAGE"; cmd_run "$2" ;;
  store) cmd_run com.android.vending ;;
  list) cmd_list ;;
  remove) [[ -n "${2:-}" ]] || die "usage: novadeck-android remove PACKAGE"; cmd_remove "$2" ;;
  stop) systemctl --user stop "$UNIT" ;;
  daemon) cmd_daemon ;;
  idle-stop) cmd_idle_stop ;;
  setup) cmd_setup ;;
  framework-steps) framework_steps "$2" "$3" ;;  # internal: build_framework's worker
  *) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
