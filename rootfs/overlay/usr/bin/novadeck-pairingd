#!/usr/bin/python3
"""novadeck-pairingd — key-pairing agent for remote access.

WHY THIS EXISTS
    This image ships no desktop and no terminal, so there is no way for a user to put an SSH
    key on the device by hand, and no way for them to reach a shell to do it. Ejecting the
    storage and writing the key from another machine works today and stops working the moment
    the OS is installed to internal storage. So key delivery has to happen over the network,
    and it has to be safe to expose on whatever Wi-Fi the device happens to have joined.

THE CONSENT MODEL — read this before changing anything here
    The listening socket is unauthenticated by construction: the whole point is to accept a key
    from someone who has no credentials yet. What makes that safe is that the socket only exists
    while this daemon runs, and this daemon runs only while a human has turned the on-screen
    remote-access switch ON. Flipping the switch off stops the daemon and closes the port. The
    switch is the credential, and because there is no time window the switch position the UI
    shows is the honest truth about whether the device is accepting keys — turn it off once the
    key is exchanged.

    There is deliberately NO time window. An earlier design opened a bounded window measured from
    process start; it was dropped because the switch and the window could disagree (the UI showed
    "on" after the window had silently closed), and because the client re-asserts the switch
    position at boot regardless — so a window bought no protection a switched-off daemon does not
    already give. Accepting keys for exactly as long as the switch is on is both simpler and
    truthful to the UI.

    The unit has no [Install] section, so systemd never starts it on its own: it is started and
    stopped only by the switch helper (steamos-polkit-helpers/steamos-devkit-mode). Leaving the
    switch on does mean the client re-starts the daemon at the next boot — that is intended here,
    since the UI still shows the switch on.

WHAT IT GRANTS
    An approved registration appends one key to the session user's authorized_keys. That is all:
    sshd is already running (it ships enabled, key-only), so no port has to be opened here. It
    never sets a password, never touches root's authorized_keys (which would not survive a slot
    update anyway — /root is on the read-only root, the session user's home is a partition of its
    own), and never grants anything a second registration could escalate.
"""

import http.server
import json
import os
import pwd
import shutil
import subprocess
import sys
import tempfile

# The port and path the pairing tooling already speaks. Chosen for compatibility: it means a
# user can register with nothing but curl, and the existing third-party GUI clients also work.
SERVICE_PORT = 32000

# The account remote access is granted to. uid 1000, and its home is the shared data partition,
# so an installed key survives A/B updates untouched.
SESSION_USER = "deck"

# The mDNS advertisement. The type is the one existing pairing tooling already browses for, so
# third-party clients discover the device without knowing anything about this implementation.
#
# DNSSD_SERVICE_ID is not cosmetic: resolved derives the registration's bus object path from it
# by escaping the name (a '-' becomes '_2d'), so this id fixes the path
# /org/freedesktop/resolve1/dnssd/novadeck_2dpairing that the unit's ExecStopPost hardcodes to
# withdraw the advert. Changing it here without changing it there leaves the advert up after the
# switch goes off. See advertise() for why the withdrawal lives in the unit at all.
DNSSD_SERVICE_ID = "novadeck-pairing"
DNSSD_TYPE = "_steamos-devkit._tcp"

# Accepted key algorithms. Anything else is refused rather than passed to ssh-keygen, so an
# exotic or deprecated type cannot become a login on this device by accident.
ALLOWED_KEY_TYPES = {
    "ssh-ed25519",
    "sk-ssh-ed25519@openssh.com",
    "ecdsa-sha2-nistp256",
    "ecdsa-sha2-nistp384",
    "ecdsa-sha2-nistp521",
    "sk-ecdsa-sha2-nistp256@openssh.com",
    "ssh-rsa",
}

# An authorized_keys line may begin with OPTIONS (command=, environment=, permitopen=, ...)
# before the key type. A registration must never be able to smuggle those in, so a submitted
# line has to start with the key type itself and be exactly one line. This is the difference
# between installing a key and installing an arbitrary forced command.
MAX_BODY_BYTES = 8 * 1024


def log(msg):
    print(f"novadeck-pairingd: {msg}", file=sys.stderr, flush=True)


def parse_public_key(body):
    """Return a normalised single-line public key, or None if the body is not exactly that.

    Rejects: multiple lines, leading options, unknown algorithms, and anything ssh-keygen
    cannot read back as a key. The comment field is preserved (it is what the user sees when
    auditing authorized_keys later) but stripped of anything that could break the file format.
    """
    try:
        text = body.decode("utf-8")
    except UnicodeDecodeError:
        return None

    lines = [ln for ln in text.splitlines() if ln.strip()]
    if len(lines) != 1:
        return None

    fields = lines[0].split()
    if len(fields) < 2 or fields[0] not in ALLOWED_KEY_TYPES:
        return None

    keytype, blob = fields[0], fields[1]
    # Comment: collapse whitespace, drop control characters, and bound the length. The pairing
    # clients append their own marker here, which is fine — it is only ever a label.
    comment = " ".join(fields[2:])
    comment = "".join(c for c in comment if c.isprintable())[:120].strip()
    candidate = f"{keytype} {blob}" + (f" {comment}" if comment else "")

    # Final authority is ssh-keygen: if it cannot fingerprint the line, it is not a key.
    with tempfile.NamedTemporaryFile("w", suffix=".pub", delete=True) as tf:
        tf.write(candidate + "\n")
        tf.flush()
        try:
            subprocess.run(
                ["ssh-keygen", "-l", "-f", tf.name],
                check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10,
            )
        except (subprocess.CalledProcessError, subprocess.TimeoutExpired, OSError):
            return None

    return candidate


def install_key(key_line):
    """Append the key to the session user's authorized_keys. Returns True on success.

    Idempotent on the key blob, so re-registering the same key from the same machine is a
    no-op rather than a growing file.
    """
    try:
        ent = pwd.getpwnam(SESSION_USER)
    except KeyError:
        log(f"no such user: {SESSION_USER}")
        return False

    ssh_dir = os.path.join(ent.pw_dir, ".ssh")
    keyfile = os.path.join(ssh_dir, "authorized_keys")
    blob = key_line.split()[1]

    try:
        os.makedirs(ssh_dir, mode=0o700, exist_ok=True)
        os.chown(ssh_dir, ent.pw_uid, ent.pw_gid)
        os.chmod(ssh_dir, 0o700)

        existing = ""
        if os.path.exists(keyfile):
            with open(keyfile, "r", encoding="utf-8", errors="replace") as f:
                existing = f.read()
            if blob in existing:
                log("key already registered")
                return True

        # Write via a temp file in the same directory and rename, so a crash mid-write cannot
        # leave a truncated authorized_keys (which would lock out every already-paired machine).
        fd, tmp = tempfile.mkstemp(dir=ssh_dir)
        try:
            with os.fdopen(fd, "w") as f:
                if existing and not existing.endswith("\n"):
                    existing += "\n"
                f.write(existing + key_line + "\n")
            os.chown(tmp, ent.pw_uid, ent.pw_gid)
            os.chmod(tmp, 0o600)
            os.replace(tmp, keyfile)
        except Exception:
            os.unlink(tmp)
            raise
    except OSError as e:
        log(f"cannot install key: {e}")
        return False

    log(f"installed key for {SESSION_USER}")
    return True


class PairingHandler(http.server.BaseHTTPRequestHandler):
    server_version = "novadeck-pairingd"
    sys_version = ""
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        log(fmt % args)

    def _respond(self, code, payload, ctype="text/plain"):
        body = payload.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        # Compatibility endpoint: pairing clients ask which account to log in as.
        if self.path == "/login-name":
            self._respond(200, SESSION_USER + "\n")
            return
        if self.path == "/status":
            # If this endpoint can be reached at all, the daemon is running, i.e. the switch is
            # on and the device is accepting keys. There is no window, so nothing to count down.
            self._respond(200, json.dumps({"pairing_open": True}) + "\n",
                          ctype="application/json")
            return
        self._respond(404, "not found\n")

    def do_POST(self):
        if self.path != "/register":
            self._respond(404, "not found\n")
            return

        try:
            length = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            length = 0
        if length <= 0 or length > MAX_BODY_BYTES:
            self._respond(400, json.dumps({"error": "bad request body"}) + "\n",
                          ctype="application/json")
            return

        key_line = parse_public_key(self.rfile.read(length))
        if key_line is None:
            log(f"registration refused from {self.client_address[0]}: not a single valid key")
            self._respond(400, json.dumps({"error": "not a valid ssh public key"}) + "\n",
                          ctype="application/json")
            return

        log(f"registration accepted from {self.client_address[0]}")

        # sshd already runs (it ships enabled, key-only), so installing the key is the whole job.
        if not install_key(key_line):
            self._respond(500, json.dumps({"error": "failed to apply the key"}) + "\n",
                          ctype="application/json")
            return

        self._respond(200, json.dumps({"result": "registered", "user": SESSION_USER}) + "\n",
                      ctype="application/json")


class PairingServer(http.server.ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True

    def handle_error(self, request, client_address):
        """Log a peer hanging up as one line instead of a stack trace.

        This port is unauthenticated and internet-adjacent by design, so it gets scanned. A
        scanner that connects and drops raises ConnectionResetError inside the handler thread,
        and the default handler dumps a full traceback to stderr — i.e. into the journal, which
        on a device with no shell and no serial console is the only debugging channel there is.
        Drowning it in tracebacks from routine scans costs us the next real diagnosis. Faults
        that are genuinely ours still get the traceback.
        """
        exc = sys.exc_info()[1]
        if isinstance(exc, (ConnectionResetError, BrokenPipeError,
                            ConnectionAbortedError, TimeoutError)):
            log(f"client {client_address[0]} disconnected: {type(exc).__name__}")
            return
        super().handle_error(request, client_address)


def advertise():
    """Publish the pairing service over mDNS through systemd-resolved. Never raises.

    WHY RESOLVED AND NOT AVAHI. resolved already answers mDNS on this image — it is what
    resolves novadeck.local, since /etc/nsswitch.conf carries no mdns_minimal and nss-mdns is
    not installed — so avahi existed only to publish this one advert, and starting it put a
    SECOND responder on port 5353. avahi says so itself on every start: "Detected another IPv4
    mDNS stack running on this host. This makes mDNS unreliable and is thus not recommended."
    Publishing through the responder that is already there leaves one stack in every state.

    WHY THE ADVERT IS TAKEN DOWN BY THE UNIT AND NOT HERE. Measured on a Pocket ACE, systemd
    258, because both of the obvious assumptions are false:
      - a .dnssd file removed from /etc/systemd/dnssd plus `systemctl reload systemd-resolved`
        does NOT retract the advert; only a full restart does. So the file mechanism cannot
        express "stop advertising now", which is the one thing this daemon needs.
      - the registration is NOT bound to the caller's bus connection. Registering and exiting
        without unregistering leaves the advert live and the object still on the bus.
    Retraction therefore has to be explicit, and the unit's ExecStopPost is where it goes: that
    runs however this process ends — clean stop, crash, or kill — where a `finally` here runs
    only for some of those. UnregisterService accepts the object path from ANY connection, which
    is what lets a separate busctl call do it.

    KNOWN LIMIT: the registration lives in resolved's memory, so restarting systemd-resolved
    while the switch is on drops the advert until this daemon is restarted. That is the same
    standing the advert had under avahi — a convenience, never the mechanism. Pairing over the
    address shown in the on-screen network settings is unaffected, which is why every failure
    below is logged and swallowed.
    """
    try:
        from gi.repository import Gio, GLib
    except ImportError as exc:
        log(f"no gi bindings ({exc}) — not advertising, pair by address")
        return
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        # "%H" is expanded by resolved into the hostname, so the instance is novadeck._steamos-
        # devkit._tcp.local — the same name the avahi service file produced with replace-wildcards.
        args = GLib.Variant("(sssqqqaa{say})",
                            (DNSSD_SERVICE_ID, "%H", DNSSD_TYPE, SERVICE_PORT, 0, 0,
                             [{"login": SESSION_USER.encode()}]))
        path = bus.call_sync("org.freedesktop.resolve1", "/org/freedesktop/resolve1",
                             "org.freedesktop.resolve1.Manager", "RegisterService",
                             args, GLib.VariantType("(o)"),
                             Gio.DBusCallFlags.NONE, -1, None).unpack()[0]
        log(f"advertising {DNSSD_TYPE} on :{SERVICE_PORT} as {path}")
    except Exception as exc:                                     # noqa: BLE001 — see docstring
        log(f"could not advertise ({exc}) — pair by address")


def main():
    if os.geteuid() != 0:
        log("must run as root")
        return 1
    if shutil.which("ssh-keygen") is None:
        # Fail loudly at startup rather than accepting a registration we cannot validate.
        log("ssh-keygen not found — refusing to start")
        return 1

    server = PairingServer(("", SERVICE_PORT), PairingHandler)
    log(f"listening on :{SERVICE_PORT}, accepting keys until stopped")
    # Advertise only once the socket is bound. The avahi file this replaces was installed by an
    # ExecStartPre, i.e. before the daemon existed, so a client could discover the service and
    # then fail to connect to it; an advert for a port nothing answers on is worse than none.
    advertise()
    try:
        server.serve_forever(poll_interval=1.0)
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
