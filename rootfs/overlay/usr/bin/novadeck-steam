#!/bin/sh
# novadeck Steam shell launcher (SteamOS layer D) — the client gamescope hosts.
#
# This is what NOVADECK_SESSION_CMD points at in Phase 3 (replacing the Phase-2 vkcube liveness
# placeholder). novadeck-session execs gamescope, then gamescope execs THIS inside its Wayland
# display. We run the NATIVE arm64 Steam client in Big Picture / gamepad UI mode — the same
# -gamepadui/-steamdeck/-steamos3 flags SteamOS passes for the handheld Deck shell.
# x86 games launched from here go through FEX/Proton (later in Phase 3).
#
# The WHOLE Big Picture shell is baked offline (release can't fetch — Steam owns OOBE Wi-Fi):
# image/make-sdcard.sh pre-seeds the native client+runtime directly into the writable /home at image
# build, and we launch with -noverifyfiles so the client runs exactly the baked bits without
# attempting an (offline, doomed) self-update/repair.
set -eu

STEAM_HOME="${STEAM_HOME:-/home/deck}"
STEAM="${STEAM_HOME}/.local/share/Steam"
CLIENT="${STEAM}/steamrtarm64/steam"

export HOME="${STEAM_HOME}"

if [ ! -x "$CLIENT" ]; then
  echo "[novadeck-steam] native arm64 Steam not staged at ${STEAM}" >&2
  echo "[novadeck-steam] /home was not pre-seeded at image build — reflash the card" >&2
  exit 1
fi

# NOTE: do NOT route through ${STEAM}/steam.sh — that is the x86 wrapper; it execs ubuntu12_32/steam
# and ubuntu12_32/steam-runtime/amd64/* which are amd64 ELFs ("Exec format error" on aarch64).
#
# We launch the native client RAW ON THE HOST — NOT through the bundled SR3 runtime / pressure-vessel.
# This is the system-libs + raw-ELF path. It became possible once gtk2 moved onto the
# host: steamui.so NEEDs libgtk-x11-2.0.so.0 + libgdk_pixbuf-2.0.so.0, which we now BUILD from source
# as a novadeck overlay package (packages/gtk2/) and install into the base (customize-base.sh PKGS),
# so the host /usr/lib resolves them via ld.so.cache. Earlier this client was entered through
# pressure-vessel purely to borrow gtk2 from the runtime container; with gtk2 on the host that
# boundary is gone — and raw-host launch lets a plain LD_LIBRARY_PATH reach the loader (pressure-
# vessel built a fresh container env and DROPPED any LD_LIBRARY_PATH we exported on the host).

# steamrtarm64 holds the client's OWN bundled media stack — libvpx.so.6 + libav{codec,format,util}.so.*
# (pulled in by the first-launch self-update; the seed lacks them), which steamui.so NEEDs — plus the
# libibus shim the bootstrap symlinked into lib/aarch64-linux-gnu. Put these on LD_LIBRARY_PATH; gtk2/
# gdk_pixbuf come from the host /usr/lib (the gtk2 overlay), and ffmpeg's libav* are in the base too
# (customize-base.sh PKGS) as a fallback, but the client prefers its bundled video/ libs listed first.
STEAM_LD_PATH="${STEAM}/steamrtarm64:${STEAM}/steamrtarm64/video:${STEAM}/lib/aarch64-linux-gnu"
export LD_LIBRARY_PATH="${STEAM_LD_PATH}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

# Make the image-resident compat tool discoverable. novadeck bakes the arm64 Proton (its own WoW64
# FEX for x86 Windows games) into the OS slot at /usr/share/steam/compatibilitytools.d so it is
# replaced atomically with the OS and survives a factory reset — but the client only scans the
# per-user compatibilitytools.d and whatever this variable lists, NOT /usr/share by default. Keep
# the user path too, so anything the user drops there still registers.
export STEAM_EXTRA_COMPAT_TOOLS_PATHS="/usr/share/steam/compatibilitytools.d${STEAM_EXTRA_COMPAT_TOOLS_PATHS:+:${STEAM_EXTRA_COMPAT_TOOLS_PATHS}}"

# --- SteamUI QuickAccess / gamescope integration env (SteamOS "gamescope-session" parity) ---------
# ENV GATES SteamUI reads to decide which Quick-Access controls to expose. They pair with the
# gamescope --steam stats channel wired in novadeck-session — without the channel these do nothing,
# and without these the controls may not appear even with the channel.

# Refresh-rate SLIDER range — NOT the framerate cap (that is STEAM_GAMESCOPE_DYNAMIC_FPSLIMITER
# below; its choices are divisors of the CURRENT refresh and exist regardless of this range, which is
# why a 30/20 fps cap is selectable on a 60Hz board no matter what we put here).
# Per-board from the device-env registry, and set ONLY for a panel that really has more than one
# mode: most panel drivers we ship declare a SINGLE drm_display_mode (60Hz; 144 on the Pocket FIT), so
# there is nothing for gamescope to modeset to and the variable must stay UNSET. The old hardcoded
# Deck-LCD 40,60 was wrong both ways — it invented a 40Hz floor no panel of ours has a mode for, and
# capped the multi-mode boards (60,120 panels) at 60. novadeck-session does not export the NOVADECK_*
# facts (plain eval, no export), so resolve them here too.
DEV_ENV=/usr/lib/novadeck/device-env
if [ -x "$DEV_ENV" ]; then eval "$("$DEV_ENV" 2>/dev/null)" || true; fi
case "${NOVADECK_PANEL_REFRESH_RATES:-}" in
  *,*) export STEAM_DISPLAY_REFRESH_LIMITS="${NOVADECK_PANEL_REFRESH_RATES%%,*},${NOVADECK_PANEL_REFRESH_RATES##*,}" ;;
esac

# gamescope sets the gates below ITSELF in --steam mode (main.cpp UpdateCompatEnvVars) — but only into
# its own environment, so they reach the processes gamescope SPAWNS (mangoapp) and not this client:
# novadeck-session runs gamescope in the background and starts us as its SIBLING. Hence we set them by
# hand, exactly as the upstream SteamOS-derived session scripts do. All use gamescope's own values;
# gamescope's setenv()s are overwrite=0, so a value set here also wins there.
#
# Performance overlay -> mangoapp. Without these the client takes the LEGACY overlay path: it prepends
# `mangohud` to the game launch command (the Vulkan layer inside the game) instead of driving the
# mangoapp window gamescope already spawned, so the QuickAccess toggle/Level misbehave. The paired
# MANGOHUD_CONFIGFILE (the file SteamUI writes `preset=N` into) is exported by novadeck-session and
# inherited here.
export STEAM_USE_MANGOAPP=1
export STEAM_MANGOAPP_PRESETS_SUPPORTED=1      # QuickAccess "Level" selector -> mangoapp presets
export STEAM_MANGOAPP_HORIZONTAL_SUPPORTED=1   # allow the horizontal HUD bar layout
export STEAM_DISABLE_MANGOAPP_ATOM_WORKAROUND=1 # mangoapp sets GAMESCOPE_EXTERNAL_OVERLAY itself now
# QuickAccess frame-rate cap: the client writes the cap, gamescope's WSI layer in the GAME process
# reads GAMESCOPE_LIMITER_FILE (exported by novadeck-session). Both ends need this gate; our WSI layer
# is on (ENABLE_GAMESCOPE_WSI=1 in the session).
export STEAM_GAMESCOPE_DYNAMIC_FPSLIMITER=1
# Scaling controls gamescope implements unconditionally (NIS + integer/fit/fill/stretch).
export STEAM_GAMESCOPE_NIS_SUPPORTED=1
export STEAM_GAMESCOPE_FANCY_SCALING_SUPPORT=1
# Per-game Xwayland isolation. novadeck-session passes --xwayland-count 2, so the second nested
# Xwayland exists and this is what makes the client actually USE it for games (gamescope sets this gate
# itself whenever the count is >1). BISECT POINT: this is the one gate here that changes game-launch
# behaviour rather than just exposing a control — drop it first if a title regresses.
export STEAM_MULTIPLE_XWAYLANDS=1
# SteamRT's xdg-open hands http(s):// to the client instead of a (nonexistent) desktop browser.
export SRT_URLOPEN_PREFER_STEAM=1
# Storage. These two are THE gate on the SD-card format and eject actions, and nothing an OS ships
# elsewhere substitutes for them. The client's own drive model lives in steamui.so
# (CSystemStorageDeviceManagerLinux, which speaks UDisks2 directly — hence the udisks2 dependency);
# it reads these at session start and reports them back to the shell as is_adopt_supported /
# is_unmount_supported in StorageDeviceManager.GetState. Settings > Storage renders `Format Drive`
# only when is_adopt_supported, and `Unmount` only when is_unmount_supported, BEFORE it asks the OS
# anything — which is why shipping the helpers, the polkit action and the D-Bus interface changed
# nothing on their own (#42). Unmount also closes the "card pulled while mounted" hole, which today
# ends in `JBD2: I/O error ... Aborting journal`.
export STEAM_ALLOW_DRIVE_ADOPT=1
export STEAM_ALLOW_DRIVE_UNMOUNT=1
#
# Hands the hardware volume keys to the client's own handler. CONFIRMED ON HARDWARE 2026-09-03 on a
# Pocket ACE (SM8550) and on SM8250 — Thor Lite and Pocket Max: with this set, pressing volume
# up/down moves the PipeWire sink. The client does the whole job, and NOTHING of ours touches the
# sink any more: novadeck-hotkeyd, which used to, has been REMOVED outright — with volume handed
# over, all it had left were brightness keys that no board we support actually carries. (The
# QuickAccess brightness slider never went through it; gamescope writes the backlight itself, which
# is what usr/lib/udev/rules.d/60-novadeck-perf-acls.rules grants it.)
#
# This used to sit in the DELIBERATELY NOT SET list below, on the grounds that "volume keys are
# ours (novadeck-hotkeyd)" — that agent no longer exists. The FACT that justified it — no peer
# distro ships an OS-level volume
# handler, they all rely on the client — re-checked and still true. The INFERENCE drawn from it did
# not survive: a peer running the SAME native arm64 client on this SoC family carries no volume
# daemon at all, only this gate plus enough input plumbing to keep KEY_VOLUME* ungrabbed. And the
# gate string IS present in the steamrtarm64/steamui.so we bake, so the code path exists here.
#
# The recorded negative ("the arm64 client draws its OSD but never moves the sink", a Pocket S2)
# was taken with the handler NEVER ARMED — this gate has never been set on any build we ship, and a
# running Pocket ACE session was checked on 2026-09-03 to confirm it is absent from the client's
# environ. So that test measured a handler that was switched off, and proved nothing either way.
# The lesson is the reusable part: a gate that was never set cannot have been tested.
#
# WHERE THE KEYS ACTUALLY ARE, measured on an ACE 2026-09-03 — worth keeping, because a comment
# here once claimed they arrive on the AYANEO MCU's keyboard interface and they do not. They are on
# two DIFFERENT nodes, neither of them the MCU, each advertising that one keycode and nothing else:
#
#   KEY_VOLUMEUP   (115)  gpio-keys   event3  /devices/platform/gpio-keys
#   KEY_VOLUMEDOWN (114)  pmic_resin  event1  ...pon@1300:resin  (the PMIC's volume-down line)
#
# and InputPlumber claimed only event4 + event5 (CompositeDevice0.SourceDevicePaths), so it grabs
# neither. That is what made a dead sink implicate the handler and nothing upstream of it. There is
# also no KEY_MUTE on that board at all.
export STEAM_ENABLE_VOLUME_HANDLER=1
#
# DELIBERATELY NOT SET (gamescope/ChimeraOS set some of these; each would advertise a control this
# board cannot honour, or collides with something of ours):
#   STEAM_GAMESCOPE_TEARING_SUPPORTED / _HAS_TEARING_SUPPORT — gamescope gates them on
#     SupportsTearing(), which is FALSE here (msm exposes no DRM_CAP_ATOMIC_ASYNC_PAGE_FLIP).
#   STEAM_GAMESCOPE_HDR_SUPPORTED, STEAM_GAMESCOPE_VRR_SUPPORTED — no HDR/VRR on this DSI panel.
#   STEAM_GAMESCOPE_COLOR_MANAGED / _VIRTUAL_WHITE — belongs to the night-mode/colour work.
#   STEAM_USE_DYNAMIC_VRS — RADV-only.
#   STEAM_ENABLE_DYNAMIC_BACKLIGHT — adaptive brightness needs an ambient-light sensor. Almost none of
#     the boards we support have one, and for any that do there is most likely no upstream driver, so
#     nothing would publish an iio light channel for the client to read. We used to set it =1 with an
#     HW-TBD comment, which advertised an adaptive-brightness toggle that cannot do anything. If a
#     board with a WORKING ALS ever lands, derive this per-board from the device-env registry the way
#     STEAM_DISPLAY_REFRESH_LIMITS is derived above — do not restore a blanket =1.

# Power off / reboot from the client's own menu, WITHOUT it calling logind. Armed, the client touches
# a sentinel file and exits cleanly instead; whoever hosts it does the actual power action once the
# client is gone. That ordering is the entire point: the client asking logind directly races its own
# teardown, and a client SIGKILLed mid-write is one that did not finish flushing config or cloud
# saves. steamui.so calls it exactly that — "Enabling SteamOS shutdown workaround".
#
# ARMED ONLY WHEN SOMETHING IS LISTENING, and that condition is load-bearing rather than defensive.
# novadeck-session defines these paths and acts on them after we return; it is the only host that
# does. Arm the gate with no consumer and the client exits, SDDM relaunches the session, and the
# device comes back to Big Picture instead of powering off — shutdown silently stops working. So a
# standalone run leaves the gate alone and the client keeps its own logind path, which is what
# shipped before any of this existed. Do not "simplify" this into an unconditional export.
if [ -n "${NOVADECK_REBOOT_SENTINEL:-}" ] && [ -n "${NOVADECK_SHUTDOWN_SENTINEL:-}" ]; then
  export STEAMOS_STEAM_REBOOT_SENTINEL="$NOVADECK_REBOOT_SENTINEL"
  export STEAMOS_STEAM_SHUTDOWN_SENTINEL="$NOVADECK_SHUTDOWN_SENTINEL"
fi

# Client-side defaults SteamOS/gamescope sessions set for the Big Picture shell (harmless, standard).
export SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS=0      # keep the shell up when it loses focus
export vk_xwayland_wait_ready=false            # don't block on buffers idling before present to gamescope

# -steamdeck/-steamos3: Deck handheld behaviour. -gamepadui: Big Picture as the shell.
#
# NOT -deckard, and this is not a preference. -deckard asserts Steam Frame device identity, which
# sets ON_FRAME in the client's UI bundle, and the guided-tour wrapper reads
#
#     onButtonDown: ON_FRAME ? void 0 : e.onAction   (same for onActivate and onKeyDown)
#
# so under -deckard the ONE screen that says "PRESS any button to continue" has nothing listening,
# on a device the same client serves the Deck step list to. A fresh card cannot get past it: no
# button, no keyboard, no synthetic DOM or vgp_* event dismisses it, and a release card has no SSH
# to escape from. Measured on HW 2026-08-19 by reading the live listeners under both flags, one
# variable changed — -steamdeck wires vgp_onbuttondown, -deckard leaves only focus/direction.
# The tour itself fires whenever Deck_GuidedTourVersionSeen reads absent, which is every freshly
# flashed card, so this is the normal first-boot path and not an edge case.
#
# NO -steampal. It was here only because an early flag set was copied wholesale from a peer distro,
# the same way the pinned-client trio below arrived; nothing here ever established what it does for
# us. It is a SECOND device-identity assertion, so at best redundant and plausibly contradictory.
# It is also EXONERATED for the welcome screen — a clean single-trial fresh login without it still
# showed the tour — so it stays dropped on the copied-wholesale reasoning alone. Dropped 2026-08-19.
#
# -noverifyfiles: skip the client's startup file-verification pass. We bake a hand-assembled offline
#   shell (pre-seeded into /home by make-sdcard.sh) that won't checksum-match Valve's manifests, and there's no network
#   at first boot (Steam owns OOBE Wi-Fi) — so verification can only waste time re-hashing the baked
#   tree or stall trying to re-fetch. This leaves the SELF-UPDATE path intact.
# NO -noshaders, deliberately — and an earlier comment here called it a "pure CPU/battery saver,
#   safe to keep", which is WRONG on recent Protons and is why this took two passes to fix.
#   The flag disables Steam's shader pre-caching (background shader download + compile), but those
#   same shader depots ALSO deliver Proton's pre-transcoded media. Without them a Media Foundation
#   video title falls back to MEDIACONV_BLANK_VIDEO_FILE and plays BLACK videos, so what reads like
#   a battery tweak silently breaks cutscenes and logo videos.
#
#   The cost of leaving it off is real but bounded: the first launch of each game runs a fossilize
#   "Processing Vulkan shaders" pass, which is heavy on CPU and iowait on an SD card. That pass is
#   EXPECTED and is not a hang — do not "fix" it by putting this flag back.
#
#   Scope note, so this is not mis-cited as a cure-all for black video: it only reaches titles that
#   decode through Media Foundation (mfplat/winegstreamer/mediaconv). A game bundling an in-process
#   decoder — Bink, say, where only binkw64.dll is mapped — never touches that path, so a black or
#   stalled video there has a different cause and this flag is not it.
#
# NO -cef-enable-vaapi, deliberately. It reads like the switch for hardware video decode in CEF
#   ("Enable VA-API video decoding on Linux", per steamclient.so) and it is a NO-OP here. Measured
#   on device 2026-08-19 by diffing the webhelper argv with and without it: the only difference is
#   that it adds `VaapiVideoDecodeLinuxGL` to --enable-features, and Valve's arm64 libcef.so
#   contains no VA-API at all (it is built use_v4l2_codec=true, and VA-API is impossible on Adreno
#   anyway — no video engine; the VPU is separate silicon Mesa never touches).
#
#   Everything that actually matters is ALREADY the arm64 client's default: it passes
#   --ignore-gpu-blocklist and --enable-features=PlatformHEVCDecoderSupport,V4L2VideoDecode, and it
#   does NOT pass --disable-accelerated-video-decode. So there is nothing here to turn on.
#
#   And you do not want it on. See docs/video-decode.md: CEF's V4L2 path on iris is SLOWER than
#   plain CPU decode on this hardware. What gates it is a /dev/video-dec0 symlink, which we
#   deliberately do not ship.
#
# DO NOT add -nobootstrapupdate / -skipinitialbootstrap / -norepairfiles here. Those
# implement a PINNED-client model: the client downloads an update but the bootstrap is
# forbidden from applying it, so the running client never advances — even across reboots (HW-observed
# 2026-07-03: update downloaded, SteamUI relaunched, logo/version unchanged). We want the Deck-faithful
# self-updating client, so those three were removed. -noshaders was a separate question and is
# also gone now, for the media reason above.
# Word-splitting on the extra-args is intentional (sh).
: "${NOVADECK_STEAM_ARGS:=-gamepadui -steamos3 -steamdeck -noverifyfiles}"

# CEF remote-debugging, ALWAYS on (2026-08-08, was NOVADECK_DEBUG-gated). Steam's Big Picture UI
# is CEF; this sentinel makes the client open its DevTools port. It is the ONLY path Decky Loader
# has for injecting its UI into SteamUI — no sentinel, no plugin surface, the loader just polls
# forever — and it is what every SteamOS-with-Decky install runs with. Unconditional rather than
# keyed to the baked loader so the debugger is also there for SteamUI investigation on ANY image
# (the freeze hunts have all wanted it). The port binds localhost only.
: >"${STEAM}/.cef-enable-remote-debugging" 2>/dev/null \
  && echo "[novadeck-steam] CEF remote debugging enabled (${STEAM}/.cef-enable-remote-debugging)" >&2

# Do NOT set STEAM_CEF_GPU_CMD_PREFIX here. steamclient.so turns it into `--gpu-launcher='%s'` and
# those quotes reach Chromium LITERALLY — it does not shell-parse the value — so the wrapper path
# can never resolve. Confirmed on device 2026-08-19: the argv really did read
# `--gpu-launcher='/usr/lib/novadeck/cef-gpu-launcher'`. It failed harmlessly (Chromium fell back to
# the zygote rather than losing the renderer), but it is not an injection point that works. If a
# Chromium switch ever genuinely has to be added, find another way in.

# Run from the client dir. Steam's bootstrapper resolves some helper paths relative to cwd, so launch
# with steamrtarm64/ as the working directory.
cd "${STEAM}/steamrtarm64"

# Steam's bootstrapper exits to relaunch itself whenever the client requests a restart — most
# notably right after the first-launch self-update ("Update complete, launching... / Shutdown"),
# and on every in-UI "Restart Steam". It signals this with exit code 42. Without a loop the client
# would simply be gone after that first restart and the session would end mid-update instead of
# entering Big Picture, so: loop and relaunch on 42 (mirrors SteamOS's steam-jupiter wrapper); any
# other exit code is a genuine shutdown, so propagate it and let the session end as intended.
#
# The reason above used to read "gamescope hosts THIS script as its `--` child", which is NOT how
# this session is built — novadeck-session backgrounds gamescope with no `--` client and runs us
# separately, so we are gamescope's SIBLING, not its child. The loop is right either way; only the
# justification was stale. That sibling relationship is also why the exit code needs no recovering:
# 42 arrives here directly. A session that DOES put the client under `gamescope --` cannot see it —
# gamescope's own status masks it — and has to smuggle it out through a temp file, which is what the
# 42-handling in other distributions' launchers is working around. Do not import that machinery.
#
# Past the 42 restart the client previously failed to render the Big Picture UI with
#   dlmopen steamui.so failed: libgtk-x11-2.0.so.0: cannot open shared object file
# (gtk2) and then libvpx.so.6 (media stack). gtk2 is now resolved from the host /usr/lib (overlay),
# and the media libs from steamrtarm64 via LD_LIBRARY_PATH above — no pressure-vessel needed.
status=42
while [ "$status" -eq 42 ]; do
  set +e
  "$CLIENT" $NOVADECK_STEAM_ARGS "$@"
  status=$?
  set -e
done
exit "$status"
