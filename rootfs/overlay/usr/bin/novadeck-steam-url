#!/bin/sh
# novadeck-steam-url URL — hand a steam:// URL to the RUNNING Steam client. Never starts one.
#
# SteamOS does this with `steam -ifrunning <url>` behind steamos-add-to-steam; neither exists here.
# Our client is the raw native binary (see novadeck-steam), so this runs that binary the same way
# novadeck-steam does -- same HOME, same LD_LIBRARY_PATH, same cwd -- with -ifrunning, which makes a
# second instance forward its command line to the first and exit rather than start a client.
#
# steam://addnonsteamgame/<path> is honoured only when /tmp/addnonsteamgamefile exists: the client
# treats that file as proof the request came from a local tool and not a web page. The caller
# (novadeck-android) touches it.
#
# THE ONLY PROOF THIS WORKED IS THE CLIENT'S OWN STATE. The forward exits 0 whether or not the
# running client acted on it, so callers must check the outcome (novadeck-android greps
# shortcuts.vdf) rather than this exit status.
set -eu

[ $# -eq 1 ] || { echo "usage: novadeck-steam-url steam://..." >&2; exit 2; }
case "$1" in steam://*) ;; *) echo "novadeck-steam-url: not a steam:// URL: $1" >&2; exit 2 ;; esac

STEAM="${HOME}/.local/share/Steam"
CLIENT="${STEAM}/steamrtarm64/steam"
[ -x "$CLIENT" ] || { echo "novadeck-steam-url: no Steam client at $CLIENT" >&2; exit 1; }
pgrep -u "$(id -u)" -x steam >/dev/null 2>&1 \
  || { echo "novadeck-steam-url: Steam is not running" >&2; exit 1; }

export LD_LIBRARY_PATH="${STEAM}/steamrtarm64:${STEAM}/steamrtarm64/video:${STEAM}/lib/aarch64-linux-gnu${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
cd "${STEAM}/steamrtarm64"
exec "$CLIENT" -ifrunning "$1"
