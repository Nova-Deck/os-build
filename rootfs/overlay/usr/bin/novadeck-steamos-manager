#!/usr/bin/env python3
import os
import signal
import shlex
import subprocess
import sys
import warnings

import gi

gi.require_version("Gio", "2.0")
from gi.repository import GLib, Gio


warnings.filterwarnings("ignore", category=DeprecationWarning)

BUS_NAME = "com.steampowered.SteamOSManager1"
OBJECT_PATH = "/com/steampowered/SteamOSManager1"
IFACE_MANAGER = "com.steampowered.SteamOSManager1.Manager2"
# PerformanceProfile1 and GpuPerformanceLevel1 make SteamUI's own Performance panel the ONE
# surface for the power profile and the GPU clock, globally AND per game: with "Use per-game
# profile" on, Steam writes the game's profile and clock here at launch and the global ones back
# at exit (HW-verified 2026-09-29, Pocket ACE). Both relay to powerd, which owns the hardware.
# They were unexported from 2026-08-08 to 2026-09-29, while the Decky plugin carried both: two
# live surfaces for one setting fought, and the client of that time never drew a GPU clock
# control on this device. The current client draws "Manual GPU Clock" and its slider, so the
# plugin gave the controls up instead. PerformanceProfile maps to powerd's Profile, which is
# also what is in force: nothing else overrides it per game any more.
#
# The re-emit is load-bearing: SteamUI SKIPS a write that matches its view of the property
# ("already in the desired state"), so a change made anywhere else must reach it as a signal.
#
# SessionManagement1 and Manager2 are the interfaces STEAMUI CALLS, so only something owning
# this bus name can answer them. SteamUI's power menu offers "Switch to Desktop"
# unconditionally and wedges on a "Switching to Desktop…" popup when the call fails
# (HW-observed with this service masked), so the switch must resolve (see switch_session).
IFACE_SESSION = "com.steampowered.SteamOSManager1.SessionManagement1"
IFACE_OBJECT_MANAGER = "org.freedesktop.DBus.ObjectManager"
IFACE_PROFILE = "com.steampowered.SteamOSManager1.PerformanceProfile1"
IFACE_GPU = "com.steampowered.SteamOSManager1.GpuPerformanceLevel1"
POWER_BUS = "org.novadeck.Power"
POWER_PATH = "/org/novadeck/Power"
POWER_IFACE = "org.novadeck.Power1"
PROPS = "org.freedesktop.DBus.Properties"
POWER_GET_TIMEOUT_MS = 1000
POWER_SET_TIMEOUT_MS = 5000

# Our property names -> powerd's.
PROFILE_PROPS = {
    "AvailablePerformanceProfiles": "AvailableProfiles",
    "PerformanceProfile": "Profile",
    "SuggestedDefaultPerformanceProfile": "SuggestedDefaultProfile",
}
GPU_PROPS = {
    "AvailableGpuPerformanceLevels": "AvailableGpuPerformanceLevels",
    "GpuPerformanceLevel": "GpuPerformanceLevel",
    "ManualGpuClock": "ManualGpuClock",
    "ManualGpuClockMin": "ManualGpuClockMin",
    "ManualGpuClockMax": "ManualGpuClockMax",
}
POWERD_TO_STEAM = {
    powerd: (iface, ours)
    for iface, props in ((IFACE_PROFILE, PROFILE_PROPS), (IFACE_GPU, GPU_PROPS))
    for ours, powerd in props.items()
}
# Writes read back the applied value, so the announcement is what powerd actually took.
WRITABLE = {
    (IFACE_PROFILE, "PerformanceProfile"): "Profile",
    (IFACE_GPU, "GpuPerformanceLevel"): "GpuPerformanceLevel",
    (IFACE_GPU, "ManualGpuClock"): "ManualGpuClock",
}

# NO Storage1/Job1 HERE, DELIBERATELY, and this note is the whole record of why.
#
# We implemented both — the names, signatures and job indirection copied faithfully from Valve's own
# steamos-manager — on the theory that Settings > Storage formatted cards by calling this bus name.
# It does not, and never did. With every unhandled method logged with its arguments, the count of
# calls the client made to Storage1 on hardware was ZERO (2026-09-02). The client's format path is
# entirely internal: a native StorageDeviceManager inside steamui.so that speaks UDisks2 itself and
# execs /usr/bin/steamos-polkit-helpers/steamos-format-device directly — measured in pkexec's own
# journal line on 2026-09-03. Nothing was ever on the other end of this interface.
#
# So it came out. It cost nothing to keep except the belief that it did something, which is the
# expensive part: it was implemented while chasing the missing Format action, and having it present
# made "the client is refusing our interface" keep looking plausible for another round.
#
# If a front end of OUR own ever needs to format a card without root — the Decky plugin is the
# candidate — the thing to call is the helper, not to resurrect Valve's interface for one caller.


ROOT_XML = f"""
<node>
  <interface name="{IFACE_OBJECT_MANAGER}">
    <method name="GetManagedObjects">
      <arg type="a{{oa{{sa{{sv}}}}}}" name="objects" direction="out"/>
    </method>
    <signal name="InterfacesAdded">
      <arg type="o" name="object"/>
      <arg type="a{{sa{{sv}}}}" name="interfaces"/>
    </signal>
    <signal name="InterfacesRemoved">
      <arg type="o" name="object"/>
      <arg type="as" name="interfaces"/>
    </signal>
  </interface>
</node>
"""


INTERFACES_XML = f"""
  <interface name="{IFACE_MANAGER}">
    <method name="ReloadConfig"/>
    <property name="DeviceModel" type="(ss)" access="read"/>
  </interface>
  <interface name="{IFACE_SESSION}">
    <method name="SwitchToDesktopMode"/>
    <method name="SwitchToGameMode"/>
    <method name="SwitchToLoginMode">
      <arg type="s" name="type" direction="in"/>
    </method>
    <method name="SwitchToDesktopSession">
      <arg type="s" name="session" direction="in"/>
    </method>
    <method name="ValidDesktopSessions">
      <arg type="as" name="sessions" direction="out"/>
    </method>
    <method name="CleanTemporarySessions"/>
    <property name="DefaultDesktopSession" type="s" access="readwrite"/>
    <property name="DefaultLoginMode" type="s" access="readwrite"/>
  </interface>
  <interface name="{IFACE_PROFILE}">
    <property name="AvailablePerformanceProfiles" type="as" access="read"/>
    <property name="PerformanceProfile" type="s" access="readwrite"/>
    <property name="SuggestedDefaultPerformanceProfile" type="s" access="read"/>
  </interface>
  <interface name="{IFACE_GPU}">
    <property name="AvailableGpuPerformanceLevels" type="as" access="read"/>
    <property name="GpuPerformanceLevel" type="s" access="readwrite"/>
    <property name="ManualGpuClock" type="u" access="readwrite"/>
    <property name="ManualGpuClockMin" type="u" access="read"/>
    <property name="ManualGpuClockMax" type="u" access="read"/>
  </interface>
"""




def shell_env():
    helper = os.environ.get("NOVADECK_DEVICE_ENV", "/usr/lib/novadeck/device-env")
    command = (
        f'eval "$({shlex.quote(helper)})"; '
        'for name in "${!NOVADECK_@}"; do printf "%s=%s\\n" "$name" "${!name}"; done'
    )
    proc = subprocess.run(
        ["bash", "-c", command],
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    env = {}
    for line in proc.stdout.splitlines():
        if "=" in line:
            key, value = line.split("=", 1)
            env[key] = value
    return env


class PowerClient:
    def __init__(self):
        self.props = Gio.DBusProxy.new_for_bus_sync(
            Gio.BusType.SYSTEM,
            Gio.DBusProxyFlags.NONE,
            None,
            POWER_BUS,
            POWER_PATH,
            PROPS,
            None,
        )

    def get(self, name):
        result = self.props.call_sync(
            "Get",
            GLib.Variant("(ss)", (POWER_IFACE, name)),
            Gio.DBusCallFlags.NONE,
            POWER_GET_TIMEOUT_MS,
            None,
        )
        return result.get_child_value(0).get_variant()

    def set(self, name, value):
        self.props.call_sync(
            "Set",
            GLib.Variant("(ssv)", (POWER_IFACE, name, value)),
            Gio.DBusCallFlags.NONE,
            POWER_SET_TIMEOUT_MS,
            None,
        )

    def subscribe_changed(self, handler):
        """Call `handler` on every powerd PropertiesChanged, whoever caused it — the Decky
        plugin and powerd itself included — so a client caching on our emits-change
        properties never skips a legitimate set."""
        return self.props.get_connection().signal_subscribe(
            POWER_BUS,
            PROPS,
            "PropertiesChanged",
            POWER_PATH,
            None,
            Gio.DBusSignalFlags.NONE,
            handler,
        )


class NovadeckSteamOSManager:
    def __init__(self):
        self.env = shell_env()
        self.device_id = self.env.get("NOVADECK_DEVICE_ID", "novadeck")
        self.device_name = self.env.get("NOVADECK_DEVICE_NAME", "NovaDeck")
        self.default_login_mode = self.env.get("NOVADECK_STEAM_DEFAULT_LOGIN_MODE", "game")
        self.default_desktop_session = self.env.get("NOVADECK_STEAM_DESKTOP_SESSION", "")
        self.valid_desktop_sessions = ()
        self.power = PowerClient()
        self.connection = None
        self.power_subscription = None
        self.last_emitted = {}

    def node_xml(self):
        return f"<node>{INTERFACES_XML}</node>"

    def managed_objects(self):
        objects = {}
        for iface in self.node.interfaces:
            props = {}
            for prop in iface.properties:
                try:
                    value = self.get_property(iface.name, prop.name)
                except Exception as exc:
                    print(
                        f"novadeck-steamos-manager: skipping {iface.name}.{prop.name}: {exc}",
                        file=sys.stderr,
                    )
                    continue
                if value is not None:
                    props[prop.name] = value
            objects.setdefault(OBJECT_PATH, {})[iface.name] = props
        return objects

    def emit_properties(self, iface, changed):
        # A write through us emits here AND comes back via the powerd subscription; drop the
        # second one rather than announcing a change that did not happen.
        fresh = {}
        for prop, value in changed.items():
            text = value.print_(True)
            if self.last_emitted.get((iface, prop)) == text:
                continue
            self.last_emitted[(iface, prop)] = text
            fresh[prop] = value
        if not fresh:
            return
        self.connection.emit_signal(
            None,
            OBJECT_PATH,
            "org.freedesktop.DBus.Properties",
            "PropertiesChanged",
            GLib.Variant("(sa{sv}as)", (iface, fresh, [])),
        )

    def on_power_changed(self, _conn, _sender, _path, _iface, _signal, params):
        """Re-announce a powerd-side change under our own interfaces and property names."""
        if params.n_children() < 2 or params.get_child_value(0).get_string() != POWER_IFACE:
            return
        changed = params.get_child_value(1)
        by_iface = {}
        for i in range(changed.n_children()):
            entry = changed.get_child_value(i)
            target = POWERD_TO_STEAM.get(entry.get_child_value(0).get_string())
            if target is None:
                continue  # powerd property with no SteamOSManager equivalent (fan, temp, ...)
            iface, prop = target
            by_iface.setdefault(iface, {})[prop] = entry.get_child_value(1).get_variant()
        for iface, props in by_iface.items():
            self.emit_properties(iface, props)

    def get_property(self, iface, prop):
        if iface == IFACE_PROFILE:
            return self.power.get(PROFILE_PROPS[prop])
        if iface == IFACE_GPU:
            return self.power.get(GPU_PROPS[prop])
        if iface == IFACE_MANAGER and prop == "DeviceModel":
            return GLib.Variant("(ss)", (self.device_id, self.device_name))
        if iface == IFACE_SESSION:
            if prop == "DefaultDesktopSession":
                return GLib.Variant("s", self.default_desktop_session)
            if prop == "DefaultLoginMode":
                return GLib.Variant("s", self.default_login_mode)
        return None

    def set_property(self, iface, prop, value):
        powerd_prop = WRITABLE.get((iface, prop))
        if powerd_prop is not None:
            print(f"novadeck-steamos-manager: set {iface}.{prop} = {value.print_(True)}",
                  file=sys.stderr, flush=True)
            self.power.set(powerd_prop, value)
            self.emit_properties(iface, {prop: self.power.get(powerd_prop)})
            return
        if iface == IFACE_SESSION and prop == "DefaultDesktopSession":
            session = value.get_string()
            if session not in self.valid_desktop_sessions:
                raise ValueError(session)
            self.default_desktop_session = session
            self.emit_properties(iface, {prop: value})
            return
        if iface == IFACE_SESSION and prop == "DefaultLoginMode":
            mode = value.get_string()
            if mode not in ("game", "desktop"):
                raise ValueError(mode)
            self.default_login_mode = mode
            self.emit_properties(iface, {prop: value})
            return
        raise KeyError(prop)

    def switch_session(self, target):
        """Every switch restarts the one session we have. There is no desktop.

        FAILING IS NOT AN OPTION HERE, which is the whole reason this is not a
        raise. SteamUI's power menu offers "Switch to Desktop" unconditionally —
        it does not consult ValidDesktopSessions, and it does not care whether
        this service exists at all — and on the error path it sits on a
        "Switching to Desktop…" popup forever (HW-observed 2026-08-09, both with
        the interface raising NotImplementedError and with the whole service
        masked). A wedged shell is a worse answer than an unexpected one.

        So the honest reply to "switch" on a device with exactly one session is
        to restart that session: the popup dies with the compositor and the user
        lands back in game mode a few seconds later. SIGKILL, because gamescope
        ignores SIGTERM long enough for logind to give up (its slow-shutdown
        wedge), and sddm's autologin brings the session straight back —
        both measured on hardware.

        Scheduled off the main loop rather than run inline so the D-Bus reply is
        actually delivered first; killing the session from inside the call would
        take the bus connection down with it and the caller would see the error
        path this exists to avoid.
        """
        GLib.timeout_add(500, self._restart_session)

    def _restart_session(self):
        session = self.graphical_session()
        if session:
            subprocess.run(["/usr/bin/loginctl", "kill-session", session, "--signal=SIGKILL"],
                           check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                           timeout=10)
        else:
            print("novadeck-steamos-manager: no graphical session to restart", file=sys.stderr)
        return False  # one-shot

    @staticmethod
    def graphical_session():
        """The seat0 session of the session user — the one the compositor runs in."""
        try:
            out = subprocess.check_output(
                ["/usr/bin/loginctl", "list-sessions", "--no-legend"],
                text=True, timeout=5)
        except (OSError, subprocess.SubprocessError):
            return ""
        for line in out.splitlines():
            fields = line.split()
            if len(fields) >= 4 and fields[3] == "seat0":
                return fields[0]
        return ""

    def switch_login_mode(self, mode):
        if mode == "desktop":
            self.switch_session("desktop")
            return
        if mode in ("", "game", "gamemode", "steam"):
            self.switch_session("gamemode")
            return
        raise ValueError(mode)

    def handle_root_method_call(self, _conn, _sender, _path, iface, method, _params, invocation):
        if iface == IFACE_OBJECT_MANAGER and method == "GetManagedObjects":
            invocation.return_value(GLib.Variant("(a{oa{sa{sv}}})", (self.managed_objects(),)))
            return
        self.refuse_unknown(iface, method, _params, invocation)

    def handle_method_call(self, _conn, _sender, _path, iface, method, _params, invocation):
        if iface == IFACE_MANAGER and method == "ReloadConfig":
            # Nothing cached to reload: every settings read goes live to powerd. Answered rather
            # than dropped because SteamOS clients call it and an UnknownMethod looks like a fault.
            invocation.return_value(None)
            return
        if iface == IFACE_SESSION:
            if method == "ValidDesktopSessions":
                invocation.return_value(GLib.Variant("(as)", (list(self.valid_desktop_sessions),)))
                return
            if method == "SwitchToDesktopMode":
                try:
                    self.switch_session("desktop")
                except Exception as exc:
                    invocation.return_dbus_error(f"{BUS_NAME}.Error.SwitchFailed", str(exc))
                    return
                invocation.return_value(None)
                return
            if method == "SwitchToDesktopSession":
                try:
                    values = _params.unpack()
                    if values and values[0] not in self.valid_desktop_sessions:
                        raise ValueError(values[0])
                    self.switch_session("desktop")
                except Exception as exc:
                    invocation.return_dbus_error(f"{BUS_NAME}.Error.SwitchFailed", str(exc))
                    return
                invocation.return_value(None)
                return
            if method == "SwitchToGameMode":
                try:
                    self.switch_session("gamemode")
                except Exception as exc:
                    invocation.return_dbus_error(f"{BUS_NAME}.Error.SwitchFailed", str(exc))
                    return
                invocation.return_value(None)
                return
            if method == "SwitchToLoginMode":
                try:
                    values = _params.unpack()
                    mode = values[0] if values else self.default_login_mode
                    self.switch_login_mode(mode)
                except Exception as exc:
                    invocation.return_dbus_error(f"{BUS_NAME}.Error.SwitchFailed", str(exc))
                    return
                invocation.return_value(None)
                return
            # Steam probes this on SteamOS; novadeck does not create temporary sessions.
            if method == "CleanTemporarySessions":
                invocation.return_value(None)
                return
        self.refuse_unknown(iface, method, _params, invocation)

    def refuse_unknown(self, iface, method, params, invocation):
        """Answer UnknownMethod, and SAY SO IN THE JOURNAL.

        THIS LOG LINE IS THE POINT. A client that asks for something we do not implement gets a
        D-Bus error it handles silently — a control it simply does not draw — and the only outward
        sign is a feature that is missing for no stated reason. That cost real time twice: the OS
        Update Channel picker (a contract we answered that nobody read), and Settings > Storage
        offering no Format action with no evidence anywhere on the device about what it wanted.

        The parameters are logged too, because the method name alone does not say which device or
        which signature the caller had in mind, and a refused call is the one moment that
        information exists."""
        try:
            args = params.unpack() if params is not None else ()
        except Exception:
            args = "<unreadable>"
        print(
            f"novadeck-steamos-manager: UNHANDLED {iface}.{method}{args!r} — "
            "answered UnknownMethod; if SteamUI wanted this, that is why the control is missing",
            file=sys.stderr,
            flush=True,
        )
        invocation.return_dbus_error(f"{BUS_NAME}.Error.UnknownMethod", method)

    def handle_get_property(self, _conn, _sender, _path, iface, prop):
        try:
            return self.get_property(iface, prop)
        except Exception:
            return None

    def handle_set_property(self, _conn, _sender, _path, iface, prop, value):
        try:
            self.set_property(iface, prop, value)
            return True
        except Exception as exc:
            print(f"novadeck-steamos-manager: set {iface}.{prop} failed: {exc}", file=sys.stderr)
            return False

    def register(self, connection):
        self.connection = connection
        self.root_node = Gio.DBusNodeInfo.new_for_xml(ROOT_XML)
        self.node = Gio.DBusNodeInfo.new_for_xml(self.node_xml())
        connection.register_object(
            "/",
            self.root_node.interfaces[0],
            self.handle_root_method_call,
            None,
            None,
        )
        for iface in self.node.interfaces:
            connection.register_object(
                OBJECT_PATH,
                iface,
                self.handle_method_call,
                self.handle_get_property,
                self.handle_set_property,
            )
        # bus_acquired can fire again after a reconnect; one powerd subscription is enough
        if self.power_subscription is None:
            self.power_subscription = self.power.subscribe_changed(self.on_power_changed)


def main():
    system_bus = "--system" in sys.argv
    loop = GLib.MainLoop()
    manager = NovadeckSteamOSManager()
    # Which bus we own decides whether a format runs directly or through pkexec (see handle_storage).
    manager.system_bus = system_bus

    def bus_acquired(connection, _name):
        manager.register(connection)

    def name_lost(_connection, _name):
        loop.quit()

    owner_id = Gio.bus_own_name(
        Gio.BusType.SYSTEM if system_bus else Gio.BusType.SESSION,
        BUS_NAME,
        Gio.BusNameOwnerFlags.NONE,
        bus_acquired,
        None,
        name_lost,
    )
    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, lambda _signum, _frame: loop.quit())
    try:
        loop.run()
    finally:
        Gio.bus_unown_name(owner_id)


if __name__ == "__main__":
    main()
