#!/usr/bin/bash
# Remote-access switch. SteamUI's Settings > System > Developer page calls this by absolute
# path (confirmed in the baked seed's steamui.so, and in the device journal); it is the ONLY
# switch the shipped client offers that maps onto remote access, so it is the switch we hang it
# off. It gates the key-delivery daemon, NOT the SSH server.
#
# sshd itself ships ON and is never touched here (see 60-novadeck-sshd.preset). That is safe
# because access is key-only: no account has a password and no key is baked, so a running sshd
# with no authorized key admits nobody. The sensitive thing is the unauthenticated port that
# ACCEPTS a key, and that is novadeck-pairingd, which is what this switch turns on and off.
#
# ON  = start the pairing daemon: it listens on :32000 and accepts one SSH public key, which it
#       appends to deck's authorized_keys. There is no time window — it accepts keys for as long
#       as it runs, so the switch position the UI shows is the honest truth about whether the
#       device is accepting keys. Turn it off once the key is exchanged.
# OFF = stop the daemon. The port closes and no more keys are accepted. Keys already installed
#       are left in place (in deck's home, which survives A/B updates), so an already-paired
#       machine keeps working and does not need to re-pair.
#
# The client tracks the switch position itself (no query verb is invoked and nothing in it
# inspects unit state), so this only has to apply the change, not report it. Note the client
# ALSO asserts the remembered position at session start, so leaving the switch on means the
# daemon comes back up on boot — that is intended under this design (the UI says on, so it is on).
#
# Self-elevates through pkexec against a dedicated action declared in
# /usr/share/polkit-1/actions/org.novadeck.policy, limited to an ACTIVE session.
# --disable-internal-agent means an unauthorized caller fails outright instead of hanging on an
# auth prompt that nothing in the gamepad session can draw.
set -eu

case "${1:-}" in
    --enable|enable)   action=enable  ;;
    --disable|disable) action=disable ;;
    # EINVAL. An unrecognised verb must not be read as "disable" -- a future client that calls
    # this with a query or a new subcommand would otherwise silently drop remote access.
    *) echo "usage: ${0##*/} --enable|--disable" >&2; exit 22 ;;
esac

if [ "${EUID:-$(id -u)}" -ne 0 ]; then
    exec pkexec --disable-internal-agent "$0" "$@"
fi

if [ "$action" = enable ]; then
    exec systemctl start novadeck-pairingd.service
fi

exec systemctl stop novadeck-pairingd.service
