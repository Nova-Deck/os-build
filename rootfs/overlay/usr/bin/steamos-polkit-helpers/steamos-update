#!/usr/bin/bash
# SteamUI's OOBE "System Update" step and Settings > System call this path (confirmed in the baked
# seed's steamui.so):
#   /usr/bin/steamos-polkit-helpers/steamos-update [check|--supports-duplicate-detection]
#
# THIS WRAPPER IS NOT A PRIVILEGE BOUNDARY, despite where it lives. On SteamOS the polkit-helpers
# directory holds pkexec wrappers shipped by jupiter-hw-support, which we do not bake — so the path
# is only a path here, and the name is the only reason this file exists at all. The real client
# needs no privileges: rauc's own bus policy lets any local user drive the installer, and the
# bundle signature is what actually gates an install. See novadeck-update's header.
#
# It stays a separate file rather than a symlink so this comment has somewhere to live: the next
# person to find a stub-shaped script in a polkit-helpers directory should not have to guess
# whether the privilege escalation went missing.
exec /usr/bin/novadeck-update "$@"
