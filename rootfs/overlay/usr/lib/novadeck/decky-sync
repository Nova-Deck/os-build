#!/bin/bash
# novadeck decky-sync — seed Decky Loader + the baked system plugins into the deck user's
# homebrew tree on /home.
#
# WHY A SYNC AT ALL: the loader must live on /home (it self-updates, and plugins the user
# installs land next to it — none of that is writable on the read-only root), but /home is
# exactly what a reflash wipes and an OTA preserves. So the image carries the payload under
# /usr/share and this oneshot materializes it, Before=plugin_loader.service:
#   fresh flash        -> /home/deck/homebrew is empty -> full seed
#   OTA with a bump    -> bundled loader differs from what the image last seeded -> re-seed
#   normal boot        -> everything matches -> no-op
#
# LOADER SEED POLICY — sha marker, not version compare. A version compare (sort -V, newest
# wins) would let a newer image seed over an older loader and leave self-updates alone, but it
# cannot express a rollback. We track the sha256 of the loader WE last seeded
# (.novadeck-seeded) instead:
#   - marker matches the installed loader  -> the operator never self-updated; the image's pin
#     is authoritative, so a CHANGED bundle re-seeds — including a deliberate pin downgrade,
#     which a version compare would silently refuse (and a refused downgrade is exactly the
#     "candidate that cannot be rolled back" shape the OTA design forbids).
#   - marker differs from the installed loader -> Decky self-updated; hands off. The operator
#     chose a loader; the image stops second-guessing it until the next fresh seed.
# PLUGINS have no such split: the baked ones are image content (novadeck-control ships the UI
# for the image's OWN game-tweaks contract), so they are force-replaced every boot. User-installed
# plugins live in the same directory under different names and are untouched.
set -euo pipefail

# Env-overridable roots, defaults are the real device paths. The overrides exist for the offline
# suite (tests/test-decky.sh) ONLY — same pattern as NOVADECK_PERF_PROC in novadeck_perf.py: the
# suite drives every branch below against a fabricated tree, no root and no device needed.
user_name="${NOVADECK_DECKY_USER:-deck}"
user_group="${NOVADECK_DECKY_GROUP:-${user_name}}"
homebrew="${NOVADECK_DECKY_HOMEBREW:-/home/${user_name}/homebrew}"
loader_src="${NOVADECK_DECKY_LOADER:-/usr/share/decky-loader/PluginLoader}"
plugins_src="${NOVADECK_DECKY_PLUGINS:-/usr/share/decky-plugins}"
seed_marker="${homebrew}/services/.novadeck-seeded"

# No existence guard on the loader: it ships in every image (asserted at build time by
# rootfs/guard-rootfs.sh), and set -e makes the sha256sum below fail this unit loudly anyway
# if a broken image ever reaches a device.
install -d -m 0755 "${homebrew}" "${homebrew}/services" "${homebrew}/plugins" "${homebrew}/settings"

bundled_sha=$(sha256sum "${loader_src}" | cut -d' ' -f1)
installed_sha=""
[[ ! -f "${homebrew}/services/PluginLoader" ]] \
  || installed_sha=$(sha256sum "${homebrew}/services/PluginLoader" | cut -d' ' -f1)
seeded_sha=$(cat "${seed_marker}" 2>/dev/null || true)

if [[ -z "${installed_sha}" || ( "${installed_sha}" == "${seeded_sha}" && "${installed_sha}" != "${bundled_sha}" ) ]]; then
  install -pm 0755 "${loader_src}" "${homebrew}/services/PluginLoader"
  printf '%s\n' "${bundled_sha}" >"${seed_marker}"
fi

# First seed only: pin new installs to Decky's prerelease branch ({"branch": 1}) — that is where
# upstream lands its Steam-on-ARM fixes, and the native arm64 client is what this image runs.
# Never rewritten after that: the file is loader-owned state (the user can switch branches in
# Decky's own settings).
if [[ ! -f "${homebrew}/settings/loader.json" ]]; then
  printf '{\n  "branch": 1\n}\n' >"${homebrew}/settings/loader.json"
fi

# Baked system plugins: force-replace by name (image content, see header). cp -a preserves the
# modes the image baked; the rm guards against a plugin shrinking (a stale dist/ file would
# otherwise survive the copy).
if [[ -d "${plugins_src}" ]]; then
  for plugin in "${plugins_src}"/*/; do
    [[ -d "${plugin}" ]] || continue
    name=$(basename "${plugin}")
    rm -rf "${homebrew}/plugins/${name}"
    cp -a "${plugin}" "${homebrew}/plugins/${name}"
  done
fi

# services/ and settings/ belong to the user: the loader self-updates and writes its settings on
# the user's behalf, and a root-owned leftover would turn those into EACCES.
#
# plugins/ IS DELIBERATELY NOT HERE. Decky owns that directory's ownership and re-asserts it
# seconds after this unit finishes, so chowning it was dead work that only made this file lie
# about the resulting state (measured on device: services/ and settings/ deck-owned, plugins/
# root-owned, ctime 3s past our exit). Upstream v3.2.8-pre1, two places:
#   * main.py, at import: chown(PRIVILEGED_PATH/plugins, EFFECTIVE_USER) -- non-recursive, gated
#     on CHOWN_PLUGIN_PATH which DEFAULTS TO "1". The loader is root (User=root, upstream's own
#     unit), so EFFECTIVE_USER is root.
#   * browser.py, per plugin on load: chown(plugin_dir, EFFECTIVE_USER if root_plugin else
#     HOST_USER, recursive) -- so a dir's owner tracks the uid its backend will run as. OUR two
#     plugins declare flags:["root"], which is exactly why they land root-owned.
# That second line is also why a store plugin cannot be stranded by this: without the root flag
# it is chowned to the host user instead. Nothing here needs to help.
chown "${user_name}:${user_group}" "${homebrew}"
chown -R "${user_name}:${user_group}" "${homebrew}/services" "${homebrew}/settings"
