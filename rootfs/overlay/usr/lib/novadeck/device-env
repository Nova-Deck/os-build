#!/bin/bash
# novadeck device-env — emit NOVADECK_* per-board facts for userspace consumers.
#
# Single runtime source of truth for the unified image: resolves the devicetree
# model string to a profile conf layered over defaults.conf, then prints a fixed
# set of NOVADECK_* assignments (shell-quoted) on stdout. Consumers eval it:
#     eval "$(/usr/lib/novadeck/device-env)"
#
# novadeck-powerd reads NOVADECK_SOC_CLASS (underclock-table key); novadeck-session
# reads the panel/output block. Hardware truth still lives in the DTS — this only
# re-exports the subset userspace needs plus knobs with no DTS home (fake-output-mm,
# suspend mode). The rotation itself, rotation-shader and gamepad-quirk are
# deliberately NOT carried: novadeck uses upstream composite rotation (auto-engaged
# off the connector) and a fixed InputPlumber config. NOVADECK_PANEL_ORIENTATION only
# says whether the native mode needs swapping into the landscape logical canvas.
set -euo pipefail

device_dir=${NOVADECK_DEVICE_DIR:-/usr/lib/novadeck/devices}

source "$device_dir/defaults.conf"

model=${NOVADECK_MODEL:-}
if [[ -z "$model" ]]; then
    model=$(tr -d '\0' </sys/firmware/devicetree/base/model 2>/dev/null || true)
fi
case "$model" in
    "AYANEO Pocket ACE")         profile=ayaneo-pocket-ace ;;
    "AYANEO Pocket DMG")         profile=ayaneo-pocket-dmg ;;
    "AYANEO Pocket DS")          profile=ayaneo-pocket-ds ;;
    "AYANEO Pocket EVO")         profile=ayaneo-pocket-evo ;;
    "AYANEO Pocket S 1K")        profile=ayaneo-pocket-s1k ;;
    "AYANEO Pocket S 2K")        profile=ayaneo-pocket-s2k ;;
    "AYANEO Pocket S2")          profile=ayaneo-pocket-s2 ;;
    "AYN Odin 2")                profile=ayn-odin-2 ;;
    "AYN Odin 2 Mini")           profile=ayn-odin-2-mini ;;
    "AYN Odin 2 Portal")         profile=ayn-odin-2-portal ;;
    "AYN Odin 3")                profile=ayn-odin-3 ;;
    "AYN Thor")                  profile=ayn-thor ;;
    "AYN Thor Lite")             profile=ayn-thor-lite ;;
    "KONKR Pocket FIT")          profile=konkr-pocket-fit ;;
    "KONKR Pocket FIT Elite")    profile=konkr-pocket-fit-elite ;;
    "MANGMI Air Y Pro")          profile=mangmi-air-y-pro ;;
    "MANGMI Pocket Max")         profile=mangmi-pocket-max ;;
    "Retroid Pocket 5")          profile=retroid-pocket-5 ;;
    "Retroid Pocket 6")          profile=retroid-pocket-6 ;;
    "Retroid Pocket 6 TOP-DPAD") profile=retroid-pocket-6 ;;
    "Retroid Pocket Flip2")      profile=retroid-pocket-flip2 ;;
    "Retroid Pocket Mini")       profile=retroid-pocket-mini ;;
    "Retroid Pocket Mini V2")    profile=retroid-pocket-mini-v2 ;;
    "Retroid Pocket Nova")       profile=retroid-pocket-nova ;;
    *)                           profile= ;;
esac

if [[ -n "$profile" && -r "$device_dir/$profile.conf" ]]; then
    source "$device_dir/$profile.conf"
fi

# The DPU SSPP inline rotator (SM8550/SM8650, kernel 0528/0529) caps the PRE-ROTATION source at
# 1088 lines. gamescope's logical canvas is a portrait panel's native mode swapped to landscape, so
# that source height is the panel's native WIDTH. The plane advertises ROTATE_90 unconditionally (a
# static capability the driver cannot qualify per-mode), so on a panel over the cap gamescope stops
# rotating in its own composite and every flip is then rejected -- "invalid height for inline
# rot:1440 max:1088" -- with nothing ever scanned out: a BLACK SCREEN, not a slow one.
#
# HW-measured 2026-09-12, all three boards on one card:
#     Pocket ACE  1080x1620  native width 1080  -> scanout rotation, 0 flip errors
#     Pocket FIT  1080x1920  native width 1080  -> scanout rotation, 0 flip errors
#     Pocket S2   1440x2560  native width 1440  -> over the cap
# The cap is on the PER-PIPE source, so a plane split in two would halve it; the split needs
# >138 Hz on the S2's timing (514 MHz max MDP core clock / (1440 x 2585)), and it runs at 60.
# If that panel ever gains a high-refresh mode, re-measure before assuming this still applies.
# 1088 is real hardware, not a stale constant: raising it to 1448 blue-screened the S2 (2026-09-12).
#
# A board over the cap renders its output at most this tall, and the same plane scales it back up
# to the panel at scanout. Every gamescope this image starts on the panel needs it -- the Steam
# session (session.conf) AND the installer's (installer-session), whose UI fills the whole output.
# One rule here so the two cannot drift: they did, and the installer went black on the S2.
# A landscape-native panel (the Air Y Pro's 1280x960) is never rotated, however wide it is.
NOVADECK_ROTATED_OUTPUT_MAX_HEIGHT=
if [[ "${NOVADECK_PANEL_ORIENTATION:-portrait}" != landscape && "${NOVADECK_PANEL_NATIVE_WIDTH:-0}" -gt 1088 ]]; then
    NOVADECK_ROTATED_OUTPUT_MAX_HEIGHT=1080
fi

vars=(
    NOVADECK_DEVICE_ID
    NOVADECK_DEVICE_NAME
    NOVADECK_SOC_CLASS
    NOVADECK_SUSPEND_MODE
    NOVADECK_PRIMARY_CONNECTOR
    NOVADECK_PANEL_TYPE
    NOVADECK_PANEL_ORIENTATION
    NOVADECK_PANEL_NATIVE_WIDTH
    NOVADECK_PANEL_NATIVE_HEIGHT
    NOVADECK_PANEL_REFRESH_RATES
    NOVADECK_PANEL_HDR_NITS
    NOVADECK_PANEL_HDR_FALL
    NOVADECK_GAMESCOPE_FAKE_OUTPUT_MM
    NOVADECK_ROTATED_OUTPUT_MAX_HEIGHT
)

for var in "${vars[@]}"; do
    printf '%s=%q\n' "$var" "${!var:-}"
done
