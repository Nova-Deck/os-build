#!/usr/bin/env python3
"""Hand a game a per-game FEX configuration, then exec it.

    game-launch COMMAND [ARGS...]

Apply this game's tuning to our own environment, then become the command we were given. TWO
CALLERS, and the second is why this is not simply "the Proton wrapper":

  1. The in-tool shim in the Protons we BAKE (assemble-rootfs.sh rewrites their `commandline`),
     which calls us with the tool's own `proton` entry point. Automatic and stateless — but it
     only ever fronts a Proton whose toolmanifest.vdf is ours to rewrite.

  2. Steam LAUNCH OPTIONS, `game-launch %command%`, written per game by novadeck-control.
     `%command%` expands to the whole chain Steam assembled, so this fronts WHATEVER tool it
     picked — including Valve's own arm64 Proton (app 4628740), which the client now selects by
     default for Windows titles and which is user data we do not own. Without this, those
     launches get no profile, no per-game FEX config and no `cores` topology, and say nothing.

Both shapes are the same job — `%command%` is just a command — so both are the same code path.

Launch options also run on the HOST side of pressure-vessel, where our /usr paths exist. Inside
a container they do not (docs/windows-games-fex.md).

Proton generates its own FEX config *only when FEX_APP_CONFIG is unset*, and honours a pre-set
value otherwise. So exporting FEX_APP_CONFIG here is a supported override, not a hack — and it
is also what lets the two callers stack without fighting: whichever runs first wins, the inner
one then leaves it alone.

FEX_APP_CONFIG IS ONE SLOT, NOT A STACK (issue #50). Valve's fex-compat-tool — and Proton — skip
generating their curated per-title config entirely when the variable is already set, so exporting
it does not out-rank Steam's curation, it PREVENTS it. Two consequences shape this file: we only
claim the slot when the user explicitly tuned FEX (an enabled game with only perf tweaks exports
nothing and Steam's own curation keeps working), and when we do claim it we first reproduce the
curation from the same env vars Valve's tool reads (steam_curated), so our overrides sit ON TOP
of Steam's per-title knowledge instead of erasing it.

Failing to tune FEX must never stop a game from launching: every error below degrades to "exec
the command with whatever config it would have picked itself".
"""

import json
import os
import pathlib
import sys
import time

sys.path.insert(0, "/usr/lib/novadeck")
try:
    import novadeck_perf
except ImportError:  # per-game tuning must never be what stops a launch
    novadeck_perf = None

BASE_CONFIG = pathlib.Path("/usr/share/fex-emu/Config.json")
PROFILES = pathlib.Path("/usr/share/novadeck/fex-profiles.json")
TWEAKS = pathlib.Path("/etc/novadeck/game-tweaks.json")

PROG = "game-launch"

STALE_AFTER = 24 * 60 * 60  # generated configs are per-launch; reap yesterday's


def appid():
    """Steam exports the running appid under one of three names, depending on the launch path."""
    for key in ("STEAM_COMPAT_APP_ID", "SteamAppId", "SteamGameId"):
        value = os.environ.get(key, "").strip()
        # 0 is Valve's "no app" sentinel — Steam invokes the compat tool with it
        # for prefix setup and tool probing, which is not a game to tune.
        if value.isdigit() and value != "0":
            return value
    return None


def load_profiles():
    with PROFILES.open(encoding="utf-8") as f:
        contract = json.load(f)
    profiles = contract.get("profiles")
    if not isinstance(contract.get("defaults"), dict) or not isinstance(profiles, dict):
        raise ValueError("fex-profiles.json: missing 'defaults' or 'profiles'")
    if "default" not in profiles:
        raise ValueError("fex-profiles.json: no 'default' profile to fall back to")
    for name, profile in profiles.items():
        if not isinstance(profile, dict) or not isinstance(profile.get("config"), dict):
            raise ValueError(f"fex-profiles.json: profile '{name}' has no config object")
    return contract


def load_tweaks(defaults):
    """User overrides. Absent or malformed means 'no overrides', never a launch failure."""
    tweaks = json.loads(json.dumps(defaults))  # deep copy; defaults must stay pristine
    try:
        with TWEAKS.open(encoding="utf-8") as f:
            loaded = json.load(f)
    except (OSError, ValueError):
        return tweaks
    if not isinstance(loaded, dict):
        return tweaks
    if isinstance(loaded.get("global"), dict):
        tweaks["global"].update(loaded["global"])
    if isinstance(loaded.get("games"), dict):
        tweaks["games"] = loaded["games"]
    return tweaks


def settings_for(tweaks, game_id):
    """Global settings, overlaid with this game's if it has an entry that is explicitly enabled."""
    settings = dict(tweaks.get("global", {}))
    game = tweaks.get("games", {}).get(str(game_id)) if game_id else None
    if isinstance(game, dict) and game.get("enabled") is True:
        settings.update(game)
    return settings


def resolve_config(settings, profiles):
    """The user's EXPLICIT tuning choice, or None when they made none.

    None used to fall back to the default profile — a restatement of the base config's values —
    which looked harmless but was the issue #50 clobber: writing those values into FEX_APP_CONFIG
    overrode Steam's per-title TSO/Multiblock curation with our defaults on every launch that had
    any tweak enabled. Nothing explicit now means nothing resolved; the caller decides whether a
    config is written at all.
    """
    profile_id = settings.get("fexProfile")
    if isinstance(profile_id, str) and profile_id in profiles:
        return profiles[profile_id]["config"]
    explicit = settings.get("fexConfig")
    if isinstance(explicit, dict):
        return explicit
    return None


def steam_curated():
    """Steam's per-title FEX curation, reproduced from the same env its compat tool reads.

    Because FEX_APP_CONFIG is one slot (see the module docstring), claiming it silences Valve's
    fex-compat-tool's own config generation — so anything it would have said has to be restated
    here first, from the same inputs (`generate_app_config` in the shipped tool, and upstream
    `Source/Steam/CompatTool.cpp`): STEAM_FEX_TSOENABLED / STEAM_FEX_MULTIBLOCK carry the
    appinfo-driven per-title baseline, and STEAM_COMPAT_FEX_CONFIG carries the user's choices in
    Steam's OWN per-title FEX UI. Outside Steam (system-FEX launches) none of these exist and
    this contributes nothing.

    STEAM_COMPAT_FEX_CONFIG keys are TRI-STATE, matching upstream CompatTool.cpp after
    `2b0d94536` ("Become more picky about configs"): `Key:1` sets it, `Key:0` clears it, an
    absent key contributes NOTHING. The release python tool still pins every absent key to 0;
    upstream declared that a bug, and reproducing it here would pin TSO/Multiblock/thunks the
    user never touched — the exact seizure this file exists to avoid.
    """
    config = {}
    thunks = {}
    for env_name, key in (("STEAM_FEX_TSOENABLED", "TSOEnabled"), ("STEAM_FEX_MULTIBLOCK", "Multiblock")):
        value = os.environ.get(env_name)
        if value is None:
            continue
        try:
            config[key] = "1" if int(value) else "0"
        except ValueError:
            pass  # same as Valve's tool: a malformed value contributes nothing
    ui = os.environ.get("STEAM_COMPAT_FEX_CONFIG", "")

    def flag(option):
        if f"{option}:1" in ui:
            return True
        if f"{option}:0" in ui:
            return False
        return None

    for option, key in (("TSOEnabled", "TSOEnabled"), ("Multiblock", "Multiblock")):
        chosen = flag(option)
        if chosen is not None:
            config[key] = "1" if chosen else "0"
    for option, name in (("ThunksDB_GL", "GL"), ("ThunksDB_Vulkan", "Vulkan")):
        chosen = flag(option)
        if chosen is not None:
            thunks[name] = 1 if chosen else 0
    return config, thunks


def resolve_thunks(settings, base_thunks):
    """EXPLICIT overrides only. An absent one is silence, not a value.

    ThunksDB is the one thing in this file that must not be restated. FEX walks every config
    layer it has -- its own global and user configs, then per-application and per-Steam-appid
    ones, then FEX_APP_CONFIG last -- and applies ThunksDB PER LIBRARY NAME, later layers
    winning; a layer with no ThunksDB property is skipped entirely
    (FileManagement.cpp, FileManager::FileManager). So omitting a name defers to whoever owns
    it, while naming one seizes it at the highest priority there is.

    Restating the base here therefore does NOT mean "keep the default" -- it PINS it, over the
    reading FEX's own per-title curation. That matters because the FEX reading this file is
    usually not the one whose config we copied: Valve's compat tool ships its own thunk libs and
    fills ThunksDB from STEAM_COMPAT_FEX_CONFIG (Steam's per-title FEX UI) -- but only when
    FEX_APP_CONFIG is unset, so when we DO write a config, steam_curated() restates its mapping
    and this function's result overlays it. FEX also has a Steam_<appid>_<exe> config mechanism
    of its own; that one is a real lower layer and stays theirs.

    Getting this backwards is what broke it before: an absent override defaulted to "on", which
    reverted the thunkless base config on every launch and SIGSEGV'd Valve's FEX on native
    x86-64 Linux titles. Defaulting to the base value instead would fix the crash but keep the
    pin, so the default is now no key at all.

    base_thunks is consulted only to bound the namespace -- the base config decides which thunks
    EXIST, the same rule the `allowed` filter enforces for Config keys.
    """
    chosen = settings.get("thunks")
    if not isinstance(chosen, dict):
        return {}
    return {name: 1 if chosen[name] else 0 for name in base_thunks if name in chosen}


def config_dir():
    """Where the generated config lands. /usr is read-only, so it cannot live beside the base.

    THE CACHE DIR, not $XDG_RUNTIME_DIR, and the difference is load-bearing whenever a title runs
    inside pressure-vessel: PV shares the cache path into the container and does NOT share the
    runtime dir, so a config written there is simply invisible to the FEX that reads it — and FEX
    skips an unreadable FEX_APP_CONFIG SILENTLY, which surfaces as "the profile did nothing"
    rather than as an error. That is not a hypothetical any more: our Protons run INSIDE SLR4
    today, because assemble-rootfs.sh leaves `require_tool_appid` intact (it asserts it rather
    than stripping it). The runtime dir would break per-game tuning for every Proton title.

    A relative XDG_CACHE_HOME is invalid per the XDG spec and would be re-anchored by portable
    FEX, so it is rejected rather than joined.
    """
    cache = os.environ.get("XDG_CACHE_HOME")
    if cache and pathlib.Path(cache).is_absolute():
        return pathlib.Path(cache) / "novadeck-fex"
    return pathlib.Path.home() / ".cache" / "novadeck-fex"


def reap_stale(directory):
    cutoff = time.time() - STALE_AFTER
    for old in directory.glob("*.json"):
        try:
            if old.stat().st_mtime < cutoff:
                old.unlink()
        except OSError:
            pass


def write_config(settings, game_id, profiles):
    with BASE_CONFIG.open(encoding="utf-8") as f:
        config = json.load(f)

    # PATH BINDINGS BELONG TO THE FEX THAT SHIPPED THEM, never to us. The base config is the
    # SYSTEM FEX's, so it names the system rootfs and the system thunk directories; handing those
    # to a different FEX — Proton's bundled WoW64 build, or Steam's own FEX compat tool — points it
    # at a tree that is not its own and empties the rootfs it was going to use. Each FEX resolves
    # these from its own global or template config, so drop them and pass tuning only.
    for key in ("RootFS", "ThunkGuestLibs", "ThunkHostLibs"):
        config.get("Config", {}).pop(key, None)

    resolved = resolve_config(settings, profiles)
    thunk_overrides = resolve_thunks(settings, config.get("ThunksDB", {}))
    if resolved is None and not thunk_overrides:
        # Nothing explicit — don't claim the slot at all (issue #50). FEX_APP_CONFIG is one
        # slot: Valve's compat tool and Proton generate Steam's curated per-title config only
        # when it is unset, so a config written here "for completeness" erases that curation.
        return None

    # Seed with Steam's curation FIRST, so our explicit choices override it rather than erase it:
    # base config -> Steam's per-title curation -> the user's explicit profile/thunks.
    curated_config, curated_thunks = steam_curated()
    config.setdefault("Config", {}).update(curated_config)

    if resolved is not None:
        # Only keys some profile actually declares may be overridden — a typo in game-tweaks.json
        # must not inject arbitrary keys into FEX's config.
        allowed = set().union(*(profile["config"].keys() for profile in profiles.values()))
        config["Config"].update({k: v for k, v in resolved.items() if k in allowed})

    # No override means no ThunksDB key at all -- see resolve_thunks. An empty object would be
    # equivalent to FEX (it iterates the members and there are none), so this is for the reader:
    # a config with no ThunksDB plainly states that we are not touching anyone's thunks.
    thunks = {**curated_thunks, **thunk_overrides}
    if thunks:
        config["ThunksDB"] = thunks
    else:
        config.pop("ThunksDB", None)

    directory = config_dir()
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    reap_stale(directory)

    # PID-qualified: two games can run concurrently (a launcher spawning the real title).
    name = f"{game_id or 'global'}.{os.getpid()}.json"
    target = directory / name
    tmp = target.with_name(f".{name}.tmp")
    try:
        with tmp.open("w", encoding="utf-8") as f:
            json.dump(config, f, indent=2, sort_keys=True)
            f.write("\n")
        os.replace(tmp, target)  # atomic: FEX must never read a half-written config
    finally:
        tmp.unlink(missing_ok=True)
    return target


def apply_env(settings):
    """Per-game environment. Applied last and verbatim, so it can override anything above it.

    WINE_CPU_TOPOLOGY is derived from the same `cores` key novadeck-powerd enforces as an
    affinity pin, so Wine reports the CPUs the game will actually be given rather than the
    machine's full set. It lives here rather than in the daemon because env must exist before
    exec and this is Wine-only — the scheduling half of `cores` is applied post-launch by the
    daemon, on every launch path (see docs/per-game-perf.md). Set "wineTopology": false to pin
    without also reshaping what Wine reports.
    """
    cores = None
    if novadeck_perf is not None and "cores" in settings:
        try:
            cores = novadeck_perf.resolve_cores(settings.get("cores"))
        except ValueError as exc:
            print(f"{PROG}: ignoring bad 'cores' ({exc})", file=sys.stderr)
    if (cores and settings.get("wineTopology") is not False
            and "WINE_CPU_TOPOLOGY" not in os.environ):
        os.environ["WINE_CPU_TOPOLOGY"] = f"{len(cores)}:{','.join(map(str, cores))}"

    extra = settings.get("env")
    if not isinstance(extra, dict):
        return
    for key, value in extra.items():
        try:
            if value is None:  # null is a tombstone: unset rather than set-to-empty
                os.environ.pop(str(key), None)
            else:
                os.environ[str(key)] = str(value)
        except (ValueError, OSError) as exc:
            # one malformed name must not cost the rest of the entries
            print(f"{PROG}: bad env entry {key!r}: {exc}", file=sys.stderr)


def main():

    if len(sys.argv) < 2:
        raise SystemExit(f"usage: {PROG} COMMAND [ARGS...]   ({PROG} %command% from launch options)")
    command = sys.argv[1]

    settings = {}
    try:
        contract = load_profiles()
        settings = settings_for(load_tweaks(contract["defaults"]), appid())
        # An explicit FEX_APP_CONFIG in the environment is a deliberate user override; leave
        # it be. The per-game env below still applies — it is a separate knob.
        #
        # It is also what makes the two callers compose: with launch options in play, the outer
        # game-launch writes the config and the in-tool shim then finds it already set and does
        # not write a second one.
        if "FEX_APP_CONFIG" not in os.environ:
            written = write_config(settings, appid(), contract["profiles"])
            if written is not None:  # nothing explicit: Steam's own curation keeps the slot
                os.environ["FEX_APP_CONFIG"] = str(written)
    except Exception as exc:  # noqa: BLE001 - a tuning failure must not block the launch
        print(f"{PROG}: no FEX config written ({exc}); using Proton's own", file=sys.stderr)

    try:
        apply_env(settings)
    except Exception as exc:  # noqa: BLE001 - same contract as the FEX block above
        print(f"{PROG}: per-game env skipped ({exc})", file=sys.stderr)

    try:
        os.execv(command, [command, *sys.argv[2:]])
    except OSError as exc:
        raise SystemExit(f"{PROG}: cannot exec {command}: {exc}")


if __name__ == "__main__":
    main()
