#!/usr/bin/env python3
"""The Exe behind every alien-game Steam shortcut — the ownership anchor, not yet a launcher.

    store-launch <store>:<game_id> [user params...]

Steam runs this when the user presses Play on an alien-game entry. Until milestone 6 lands the
actual launch chain, pressing Play must fail LOUDLY AND SAY WHY (screens must say what the code
knows): one line in the store home's log naming the token and the reason, exit 64.

Three things about this file are load-bearing beyond what it does:

  - ITS BASENAME IS THE OWNERSHIP PROOF. Every destructive act on a shortcut entry first checks
    that the entry's Exe basename is this file's name (shortcuts.is_ours). Tags and LaunchOptions
    are never proof — foreign tools copy both, which is how unifideck's incident UD-006 deleted
    users' own games. Renaming this file orphans every entry ever written; don't.

  - argv[1] IS THE IDENTITY CONTRACT. The entry's LaunchOptions carries nothing but the token,
    and Steam splits options into argv — so argv[1] is `<store>:<game_id>`, and anything after it
    is the user's own params, kept but unused until milestone 6. The token grammar here and the
    one shortcuts.entry_fields() emits are pinned against each other by the offline suite.

  - IT NEVER TRUSTS ITS ENVIRONMENT. Steam launches shortcuts with its own LD_LIBRARY_PATH (and
    a user may add LD_PRELOAD), so both are scrubbed before any native child runs — the same
    first move unifideck's launcher makes. An argv that fails the grammar is refused WITHOUT
    logging: an unvalidated token must never reach a file another component parses.

The store home is asked from /usr/lib/novadeck/store-env, the single path declaration, exactly
as the plugin's paths.py does; NOVADECK_STORE_ENV overrides it for the offline suite. If the
answer cannot be had, the refusal still prints to stderr — a broken store-env must not turn
"press Play" into silence.
"""
import datetime
import os
import re
import shlex
import subprocess
import sys

STORE_ENV = os.environ.get("NOVADECK_STORE_ENV", "/usr/lib/novadeck/store-env")
# The same grammar entry_fields() enforces when it writes an entry; the suite pins the pair.
TOKEN = re.compile(r"^(epic|gog):[A-Za-z0-9][A-Za-z0-9._-]*$")
PROG = "store-launch"
LOG_NAME = "store-launch.log"
# EX_UNAVAILABLE territory is arguable, but 64 is this milestone's published contract
# (.claude/plans/alien-games-library-entry.plan.md) and the gate asserts it.
EXIT_NOT_YET = 64


def scrubbed_env():
    env = dict(os.environ)
    env.pop("LD_PRELOAD", None)
    env.pop("LD_LIBRARY_PATH", None)
    return env


def store_home():
    out = subprocess.run([STORE_ENV], capture_output=True, text=True, check=True,
                         env=scrubbed_env(), timeout=10).stdout
    for line in out.splitlines():
        key, _, raw = line.partition("=")
        if key == "NOVADECK_STORE_HOME" and raw:
            parts = shlex.split(raw)
            if parts:
                return parts[0]
    raise ValueError("store-env named no NOVADECK_STORE_HOME")


def main():
    token = sys.argv[1] if len(sys.argv) > 1 else ""
    if not TOKEN.fullmatch(token):
        print(f"usage: {PROG} <epic|gog>:<game_id> [params...]   (got {token!r})", file=sys.stderr)
        raise SystemExit(2)

    stamp = datetime.datetime.now().isoformat(timespec="seconds")
    extra = f" params={shlex.join(sys.argv[2:])}" if len(sys.argv) > 2 else ""
    line = f"{stamp} {token}{extra} — not launched: the launch path arrives in milestone 6\n"
    try:
        with open(os.path.join(store_home(), LOG_NAME), "a", encoding="utf-8") as f:
            f.write(line)
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        print(f"{PROG}: could not log the attempt ({exc})", file=sys.stderr)
    print(f"{PROG}: {line.strip()}", file=sys.stderr)
    raise SystemExit(EXIT_NOT_YET)


if __name__ == "__main__":
    main()
