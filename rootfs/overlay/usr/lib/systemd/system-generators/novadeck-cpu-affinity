#!/bin/sh
# systemd generator: CPUAffinity= drop-ins for the services in /usr/lib/novadeck/cpu-affinity.conf,
# resolved against THIS device's core layout, so the image needs no per-SoC CPU numbers.
#
# Clusters come from /sys/devices/system/cpu/cpu*/cpu_capacity: the DT's capacity-dmips-mhz,
# rescaled by each core's top frequency once cpufreq is up. Our cpufreq driver is built in, so the
# rescaled values exist before userspace; that matters on the SM8250, whose DT gives the prime core
# the same dmips as the other three A77s and only its higher clock sets it apart.
#
#   interactive = every online CPU outside the highest-capacity cluster
#   background  = the lowest-capacity cluster
#
# Same reading of the topology as novadeck_perf.py's little/prime presets. Both classes always
# include cpu0, the one CPU the suspend engine never offlines. With fewer than two capacity levels
# (symmetric cores, or no cpu_capacity at all) nothing is written: every service keeps every CPU.
#
# A generator must never fail the boot: problems are reported on stderr (the journal) and the
# offending line is skipped. Runs before any unit starts; writes into the generator dir ($1).
#
# NOVADECK_SYS_CPU and NOVADECK_CPU_AFFINITY_CONF override the inputs for tests/test-cpu-affinity.sh.

out=${1:-}
[ -n "$out" ] || { echo "novadeck-cpu-affinity: no output directory" >&2; exit 0; }
sys=${NOVADECK_SYS_CPU:-/sys/devices/system/cpu}
conf=${NOVADECK_CPU_AFFINITY_CONF:-/usr/lib/novadeck/cpu-affinity.conf}
[ -r "$conf" ] || exit 0
[ -r "$sys/online" ] || exit 0

# "0-3,5,7-8" -> one CPU number per line
expand() {
  echo "$1" | tr ',' '\n' | while IFS=- read -r a b; do
    [ -n "$a" ] || continue
    [ -n "$b" ] || b=$a
    i=$a
    while [ "$i" -le "$b" ]; do echo "$i"; i=$((i + 1)); done
  done
}

caps=""
for c in $(expand "$(cat "$sys/online")"); do
  f=$sys/cpu$c/cpu_capacity
  [ -r "$f" ] || exit 0
  caps="$caps$c $(cat "$f")
"
done
min=$(printf '%s' "$caps" | awk 'NF==2 {print $2}' | sort -n | head -1)
max=$(printf '%s' "$caps" | awk 'NF==2 {print $2}' | sort -n | tail -1)
[ -n "$min" ] && [ "$min" != "$max" ] || exit 0

background=$( { echo 0; printf '%s' "$caps" | awk -v m="$min" 'NF==2 && $2==m {print $1}'; } | sort -nu | tr '\n' ' ')
interactive=$( { echo 0; printf '%s' "$caps" | awk -v m="$max" 'NF==2 && $2!=m {print $1}'; } | sort -nu | tr '\n' ' ')

while read -r unit class rest; do
  case "$unit" in ''|'#'*) continue ;; esac
  case "$unit" in
    *.service) ;;
    *) echo "novadeck-cpu-affinity: $conf: '$unit' is not a .service, skipped" >&2; continue ;;
  esac
  case "$class" in
    interactive) cpus=$interactive ;;
    background)  cpus=$background ;;
    *) echo "novadeck-cpu-affinity: $conf: $unit: unknown class '$class', skipped" >&2; continue ;;
  esac
  mkdir -p "$out/$unit.d"
  printf '# Generated by novadeck-cpu-affinity (class %s), see /usr/lib/novadeck/cpu-affinity.conf\n[Service]\nCPUAffinity=%s\n' \
    "$class" "${cpus% }" >"$out/$unit.d/50-novadeck-cpus.conf"
done <"$conf"
exit 0
