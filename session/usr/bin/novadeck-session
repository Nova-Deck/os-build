#!/bin/sh
# novadeck gamescope-session — boot the device into a gamescope compositor (SteamOS layer B).
#
# This is the SESSION PLUMBING: a long-running gamescope on the DRM/KMS backend that hosts the
# Deck-UI client. The native arm64 Steam shell lands in Phase 3; until then the session runs a
# liveness placeholder (see /etc/novadeck/session.conf — swap NOVADECK_SESSION_CMD to `steam ...`
# in Phase 3, no unit change). It reuses the exact seat + rotation path the Phase-2 smoke
# validated on HW (devices/sm8650/bringup-phase2.md step 1).
set -eu

CONF=/etc/novadeck/session.conf
[ -r "$CONF" ] && . "$CONF"
: "${NOVADECK_SESSION_CMD:=vkcube}"
: "${NOVADECK_GAMESCOPE_EXTRA:=}"

# --- Internal panel selection -> landscape LOGICAL output (--prefer-output/-W/-H/-r) -------------
# The rotation-shader patch sizes gamescope's scanout buffer by SWAPPING g_nOutputWidth/Height for a
# 90/270 panel, so the LOGICAL canvas (-W/-H) the client fills must be the panel's PORTRAIT native
# mode swapped to LANDSCAPE. Omit it and gamescope adopts the portrait connector mode as the logical
# size, covering only a min(W,H) square of the panel.
#
# Some devices wire two panels on DSI: pick the LARGEST connected one (by native area) and pin it
# with --prefer-output so gamescope scans out that connector even when more than one is present. We
# read all of this at runtime from sysfs; session.conf may override any of it, and we fall back to a
# generic landscape default if detection finds nothing. (sysfs exposes the mode resolution but not
# its refresh, so -r stays a configurable default; gamescope clamps it to the nearest supported rate.)
detect_panel() {
  best_area=0
  for modes in /sys/class/drm/card*-DSI-*/modes; do
    [ -r "$modes" ] || continue
    dir=${modes%/modes}
    [ "$(cat "$dir/status" 2>/dev/null)" = connected ] || continue
    native=$(head -n1 "$modes" 2>/dev/null)   # preferred (native) mode, e.g. WIDTHxHEIGHT
    case "$native" in [0-9]*x[0-9]*) ;; *) continue ;; esac
    pw=${native%x*}; ph=${native#*x}
    area=$(( pw * ph ))
    [ "$area" -gt "$best_area" ] || continue
    best_area=$area
    NOVADECK_GAMESCOPE_W=$ph                   # swap portrait WxH -> landscape HxW
    NOVADECK_GAMESCOPE_H=$pw
    conn=${dir##*/}                            # card0-DSI-1
    NOVADECK_GAMESCOPE_OUTPUT=${conn#card*-}   # -> DSI-1
  done
  [ "$best_area" -gt 0 ]
}
if [ -z "${NOVADECK_GAMESCOPE_W:-}" ] || [ -z "${NOVADECK_GAMESCOPE_H:-}" ]; then
  detect_panel || { NOVADECK_GAMESCOPE_W=1920; NOVADECK_GAMESCOPE_H=1080; }
fi
: "${NOVADECK_GAMESCOPE_OUTPUT:=}"
: "${NOVADECK_GAMESCOPE_REFRESH:=60}"

# Force the real DRM/KMS backend: a stray WAYLAND_DISPLAY/DISPLAY makes gamescope try to nest under
# a (non-existent) parent compositor and fail with "Failed to connect to wayland socket".
unset WAYLAND_DISPLAY DISPLAY
# The unit provides a deck-owned XDG_RUNTIME_DIR via RuntimeDirectory= (/run/novadeck-session) for
# gamescope's wayland socket. Fall back to it for manual runs. Note: the deck user cannot create
# dirs under /run, so a bare manual invocation relies on the unit (or the tester) having made it.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/novadeck-session}"
mkdir -p "$XDG_RUNTIME_DIR"; chmod 700 "$XDG_RUNTIME_DIR"

# Keep the gamescope WSI Vulkan layer ON, matching upstream gamescope and ChimeraOS
# gamescope-session-plus (which exports ENABLE_GAMESCOPE_WSI=1). The FROG WSI layer is the STANDARD
# present path: it carries the framerate limiter / frame pacing, latency control, adaptive-sync hints
# AND HDR — so turning it off (implicit-sync fallback) degrades all of those, not just HDR. It is not
# a free toggle. Overridable from the env / session.conf; defaults to on.
#
# KNOWN CAVEAT (devices/sm8650/bringup-phase2.md step 1e): with WSI on, RE-LAUNCHING gamescope after a
# prior instance intermittently wedges — the next client blocks forever in drm_syncobj_array_wait_timeout
# on a buffer-release fence that never signals (a userspace explicit-sync / linux-drm-syncobj race, NOT
# stale GPU/DRM-master state; a graceful SIGTERM teardown wedges the same ~50% as SIGKILL and dmesg shows
# zero GPU faults). A true power-on (L1) is always clean (10/10); only re-launch (L2) is affected. The
# release product boots gamescope ONCE per power-on, so this should not bite in normal use. Residual
# risk: Restart=on-failure or a deliberate session restart takes the L2 path — if that proves a real
# problem, set ENABLE_GAMESCOPE_WSI=0 (implicit sync, 8/8 clean re-launch) at the cost of the WSI
# features above. Distinct from the earlier crash ValveSoftware/gamescope#1520 (fixed pre-3.16.17).
export ENABLE_GAMESCOPE_WSI="${ENABLE_GAMESCOPE_WSI:-1}"

# Patched gamescope (from-source overlay): --use-rotation-shader rotates the portrait-native Pocket
# S2 panel in the GPU composite and scans out a ROTATE_0 buffer (the msm DPU can't ROTATE_90 a
# LINEAR plane). NOTE: --immediate-flips is deliberately NOT passed — it is a no-op on this HW. The
# msm DPU does not advertise DRM_CAP_ATOMIC_ASYNC_PAGE_FLIP, so gamescope logs "Immediate flips are
# not supported by the KMS driver" and drops the async flag (SupportsTearing()==false).
GS_ARGS="--backend drm --use-rotation-shader -W $NOVADECK_GAMESCOPE_W -H $NOVADECK_GAMESCOPE_H -r $NOVADECK_GAMESCOPE_REFRESH"
# Pin the chosen connector (DRM name, e.g. DSI-1) so gamescope scans out the intended panel on
# multi-panel devices. -O takes a comma-separated preference list; a single name is fine.
if [ -n "$NOVADECK_GAMESCOPE_OUTPUT" ]; then
  GS_ARGS="$GS_ARGS --prefer-output $NOVADECK_GAMESCOPE_OUTPUT"
fi

# No graphical logind seat exists for this system service, and the holo libseat is built with only
# the logind+seatd backends (no 'builtin'), so connect to the PERSISTENT root seatd.service
# (ExecStart=seatd -g seat, pulled in + ordered before us by the unit). We run as the unprivileged
# deck user — deck is in the `seat` group, so it can open /run/seatd.sock, and seatd brokers the
# privileged DRM-master/VT handoff to gamescope. Force the seatd backend (no logind session to
# attach to) and point libseat at the daemon's socket.
#
# NOT seatd-launch: that spawns its OWN seatd as the calling user, which needs root — incompatible
# with User=deck. The root seatd.service owns the socket's lifecycle, so no stale-socket cleanup
# here (and deck could not remove it anyway).
export LIBSEAT_BACKEND=seatd
export SEATD_SOCK="${SEATD_SOCK:-/run/seatd.sock}"

# Word-splitting on GS_ARGS / the session command is intentional (sh, not bash).
exec gamescope $GS_ARGS $NOVADECK_GAMESCOPE_EXTRA -- $NOVADECK_SESSION_CMD
