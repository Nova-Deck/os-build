[Unit]
Description=novadeck gamescope session (SteamOS layer B — Deck UI shell)
# (Design + validation notes: devices/<soc>/bringup-phase2.md step 2. No Documentation= URI —
# systemd only accepts URIs there and rejects free text with "Invalid URL".)
# Controllers should be present inside the session, and basic multi-user state up first.
# The Steam tree must be staged (novadeck-steam-bootstrap) before the shell launcher runs — pull
# it in and order after it (the oneshot self-skips once staged, so steady-state boots pay nothing).
# seatd.service is the PERSISTENT root seat broker (seatd -g seat): the session runs as the
# unprivileged deck user and connects to its socket (deck is in the `seat` group). Pull it in and
# order after it so the socket exists before gamescope opens the seat.
# user@1000.service is the deck user's systemd --user manager. It is brought up at boot because deck
# is configured to LINGER (/var/lib/systemd/linger/deck baked into the RO root); starting it gives us
# a real per-user runtime: /run/user/1000 (created by user-runtime-dir@1000.service, which user@ pulls
# in + orders before) AND the user D-Bus session bus (dbus.socket inside the manager, at
# /run/user/1000/bus). Pull it in + order after it so both exist before gamescope/Steam start.
After=systemd-user-sessions.service inputplumber.service getty@tty1.service novadeck-steam-bootstrap.service seatd.service user@1000.service
Wants=inputplumber.service novadeck-steam-bootstrap.service seatd.service user@1000.service
# Own VT1: gamescope's DRM backend takes DRM master and the panel, so getty/fbcon must not fight it.
Conflicts=getty@tty1.service

[Service]
Type=simple
# Run the Deck shell as the unprivileged deck user (uid 1000), NOT root — matches SteamOS/Armada
# (Steam refuses to run well as root, and /home/deck is deck-owned). Privileged seat/DRM-master
# handoff is brokered by the root seatd.service; deck's `seat`/`video`/`render`/`input` group
# membership (baked into the base) grants the socket + device access. systemd seeds HOME, USER and
# the user's supplementary groups from the passwd db.
User=deck
Group=deck
# Give the session a REAL per-user runtime instead of a bare service RuntimeDirectory. deck lingers
# (see After=user@1000.service above), so logind has already created /run/user/1000 (deck-owned, 0700)
# and the user D-Bus session bus lives at /run/user/1000/bus. Point XDG_RUNTIME_DIR there — that is
# where gamescope puts its Wayland socket, where PipeWire will land its sockets (audio bring-up), and
# what Steam/CEF expect — and hand the client an explicit DBUS_SESSION_BUS_ADDRESS so it talks to the
# user bus (without a session bus Steam's CEF transport fails, e.g. the 0x3008/0x3009 popup). The
# user manager owns this dir's lifecycle, so no RuntimeDirectory= here.
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/usr/bin/novadeck-session
Restart=on-failure
RestartSec=2
# NO VT/TTY binding. The working manual run (and nova-gamescope-smoke) have no controlling VT —
# seatd's VT-bound seat activates a VT itself. Binding the service to tty1 (TTYPath/StandardInput=tty)
# clashed with that seat activation and made gamescope exit immediately at boot. Let seatd own the
# VT; Conflicts=getty@tty1 (above) is enough to keep a getty off the panel.
StandardInput=null
StandardOutput=journal
StandardError=journal

# Phase-2: shipped installed-but-DISABLED. Validate first with `systemctl start novadeck-session`
# (see bringup-phase2.md step 2); flip to boot-enabled (preset) once on-HW and Steam lands.
[Install]
WantedBy=graphical.target
