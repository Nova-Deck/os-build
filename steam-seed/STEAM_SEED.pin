# novadeck Steam seed pin — what steam-seed/fetch-steam-seed.sh stages for the /home pre-seed.
#
# The native arm64 Steam BOOTSTRAP client + the arm64 SR3 runtime are fetched HERE, on the build host;
# the fetcher then RUNS Steam's updater under arm64 qemu so Steam self-installs the COMPLETE client tree
# from the CDN AT BUILD TIME and writes its `.installed` manifest. images/make-sdcard.sh pre-seeds that
# finished tree DIRECTLY into the /home partition (a ready-to-run /home/deck/.local/share/Steam) so first
# boot fetches nothing, copies nothing, and needs NO self-heal. This is critical: the OS side never has
# network before Steam's OOBE owns Wi-Fi (an OS-side fetch would deadlock — see steam-must-be-baked-
# offline), and once the seed tracks the exact live build, Steam no longer self-updates to complete a
# partial tree. Shipping a genuinely-installed tree (real `.installed`) is what removes that dependency.
#
# channel:     Steam client channel (arm64 publicbeta line — NOT the x86 default).
# runtime_url: the arm64 steamrt3 runtime tarball the native client links against.
channel: steamdeck_publicbeta
runtime_url: https://repo.steampowered.com/steamrt3c/images/latest-public-beta/steam-runtime-steamrt-arm64.tar.xz
