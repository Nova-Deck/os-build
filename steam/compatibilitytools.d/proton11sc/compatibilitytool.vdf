"compatibilitytools"
{
	"compat_tools"
	{
		// novadeck self-chaining Proton 11 ARM64 tool. Registers a USER-selectable
		// compat tool so an x86 Windows game can be forced onto Valve's Proton 11
		// ARM64 (appid 4628740) + its bundled WoW64 FEX (libwow64fex.dll) — Valve's
		// precompiled x86->arm64 emulator, no -deckard and no own-shipped FEX.
		//
		// install_path is resolved relative to the directory holding THIS vdf, so
		// "." means this subdir (where toolmanifest.vdf + novadeck-chain live). A
		// wrong value makes Steam miss toolmanifest.vdf and reject the tool at launch
		// with "unsupported version 0" (it still registers from the fields here).
		"proton11sc"
		{
			"install_path" "."
			"display_name" "Proton 11.0 (ARM64) [novadeck]"
			"from_oslist"  "windows"
			"to_oslist"    "linux"
		}
	}
}
