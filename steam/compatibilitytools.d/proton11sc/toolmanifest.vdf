"manifest"
{
	// No require_tool_appid on purpose: Valve's official Proton 11 ARM64 requires
	// tool 4185400 (SLR 4.0 Arm64), but that dependency is never registered as a
	// compat tool on a non-Deckard client, so the stock path dies with AppError_51.
	// novadeck-chain invokes the SLR 4.0 Arm64 container and Proton itself instead.
	// NOTE: comments must stay INSIDE this block - a comment before the root key
	// makes the local-tool manifest parser default version to 0 ("unsupported
	// version 0") and the tool is rejected before it ever runs.
	"version"     "2"
	"commandline" "/novadeck-chain %verb%"
}
