#!/bin/sh
# novadeck Steam shell launcher (SteamOS layer D) — the client gamescope hosts.
#
# This is what NOVADECK_SESSION_CMD points at in Phase 3 (replacing the Phase-2 vkcube liveness
# placeholder). novadeck-session execs gamescope, then gamescope execs THIS inside its Wayland
# display. We run the NATIVE arm64 Steam client in Big Picture / gamepad UI mode — the same
# -gamepadui/-steamdeck/-steamos3 flags SteamOS and our peers (ROCKNIX, Armada) pass for the
# handheld Deck shell. x86 games launched from here go through FEX/Proton (later in Phase 3).
#
# Steam self-updates and downloads the rest of the UI on first launch; the bootstrap oneshot
# (novadeck-steam-bootstrap.service) only staged the seed client+runtime into the writable home.
set -eu

STEAM_HOME="${STEAM_HOME:-/home/deck}"
STEAM="${STEAM_HOME}/.local/share/Steam"
CLIENT="${STEAM}/steamrtarm64/steam"

export HOME="${STEAM_HOME}"

if [ ! -x "$CLIENT" ]; then
  echo "[novadeck-steam] native arm64 Steam not staged at ${STEAM}" >&2
  echo "[novadeck-steam] run /usr/lib/novadeck/steam-bootstrap.sh (or its first-boot unit) first" >&2
  exit 1
fi

# NOTE: do NOT route through ${STEAM}/steam.sh — that is the x86 wrapper; it execs ubuntu12_32/steam
# and ubuntu12_32/steam-runtime/amd64/* which are amd64 ELFs ("Exec format error" on aarch64).
#
# We launch the native client THROUGH its bundled SR3 runtime via pressure-vessel, NOT raw on the
# host. Reason: steamui.so NEEDs libgtk-x11-2.0.so.0 + libgdk_pixbuf-2.0.so.0, which holo does not
# package — and SteamOS itself ships NO system gtk2 (verified against the SteamOS 3.8.10 rootfs:
# absent from /usr/lib, /usr/lib32, and the pacman set). Those libs exist ONLY inside the bundled
# steam-runtime-steamrt-arm64 tree, and only resolve (correct sonames, via ldconfig) when entered
# through pressure-vessel. The runtime's generic runner `run -- <cmd>` sets up that container; inside
# it `libgtk-x11-2.0.so.0 => /lib/aarch64-linux-gnu/...` resolves (HW-verified 2026-06-29). This is
# the SteamOS-faithful path — SteamOS's own client likewise gets gtk2 from Steam's runtime, not the
# OS. Armada's `dnf install gtk2` (system lib + raw ELF) is a Fedora-only shortcut we do NOT copy.
RUNTIME="${STEAM}/steam-runtime-steamrt-arm64"
RUN="${RUNTIME}/run"
if [ ! -x "$RUN" ]; then
  echo "[novadeck-steam] steam runtime runner missing: ${RUN}" >&2
  echo "[novadeck-steam] run /usr/lib/novadeck/steam-bootstrap.sh (stages the runtime) first" >&2
  exit 1
fi

# steamrtarm64 holds the client's OWN bundled libs — its media stack libvpx.so.6 +
# libav{codec,format,util}.so.* (pulled in by the first-launch self-update; the seed lacks them),
# which steamui.so NEEDs — plus the libibus shim the bootstrap symlinked into lib/aarch64-linux-gnu.
# These must be on LD_LIBRARY_PATH, but pressure-vessel builds a FRESH container environment and
# DROPS any LD_LIBRARY_PATH we export on the host. So set it INSIDE the container instead, via `env`
# on the wrapped command below — the client (and its dlmopen of steamui.so) then sees steamrtarm64.
# (gtk2/gdk_pixbuf come from the runtime's own /lib; with this path every steamui.so dep resolves —
# HW-verified 2026-06-29, 0 "not found". Armada needs no such trick: it runs raw on the host where a
# plain host LD_LIBRARY_PATH reaches the loader, but it has no pressure-vessel boundary to cross.)
STEAM_LD_PATH="${STEAM}/steamrtarm64:${STEAM}/steamrtarm64/video:${STEAM}/lib/aarch64-linux-gnu"

# -steamdeck/-steamos3/-steampal: Deck handheld behaviour. -gamepadui: Big Picture as the shell.
# Word-splitting on the extra-args is intentional (sh).
: "${NOVADECK_STEAM_ARGS:=-gamepadui -steamos3 -steampal -steamdeck}"

# Steam's bootstrapper exits to relaunch itself whenever the client requests a restart — most
# notably right after the first-launch self-update ("Update complete, launching... / Shutdown"),
# and on every in-UI "Restart Steam". It signals this with exit code 42. gamescope hosts THIS
# script as its `--` child, so a bare `exec` would let the process die on that first restart and
# gamescope would tear the whole session down mid-update instead of entering Big Picture. Loop and
# relaunch on 42 (mirrors SteamOS's steam-jupiter wrapper and the ROCKNIX/Armada launchers); any
# other exit code is a genuine shutdown, so propagate it and let the session end as intended.
#
# Past the 42 restart the client previously failed to render the Big Picture UI with
#   dlmopen steamui.so failed: libgtk-x11-2.0.so.0: cannot open shared object file
# (gtk2) and then libvpx.so.6 (media stack). Both are fixed here: entering the runtime via
# `${RUN} --` provides gtk2/gdk_pixbuf, and `env LD_LIBRARY_PATH=${STEAM_LD_PATH}` inside the
# container provides steamrtarm64's bundled media libs (see the STEAM_LD_PATH note above).
status=42
while [ "$status" -eq 42 ]; do
  set +e
  "$RUN" -- env "LD_LIBRARY_PATH=${STEAM_LD_PATH}" "$CLIENT" $NOVADECK_STEAM_ARGS "$@"
  status=$?
  set -e
done
exit "$status"
