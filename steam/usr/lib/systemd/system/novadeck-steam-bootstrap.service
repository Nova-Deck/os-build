[Unit]
Description=novadeck native arm64 Steam offline factory-reset re-seeder (SteamOS layer D)
# NOTE: does NOT run on a normal boot. make-sdcard.sh pre-seeds /home/deck at image-build time, so a
# healthy boot needs no copy. This unit is the OFFLINE FACTORY-RESET path: it rebuilds /home/deck
# from the pristine RECOVERY seed baked in the RO root (/usr/share/novadeck/steam-seed) — OFFLINE, no
# network (Steam's OOBE owns Wi-Fi). Left UNENABLED; a reset flow starts it on demand. Needs /home
# mounted and the deck user present (baked into the base).
RequiresMountsFor=/home
After=home.mount novadeck-grow-home.service systemd-sysusers.service
# Must finish staging the seed into /home/deck BEFORE SDDM autologins deck into the Steam shell, so
# order ahead of the display manager (this oneshot is RemainAfterExit, so sddm.service — which is
# After= us by this Before= — waits for the copy to complete).
Before=sddm.service
# Always run: the script self-skips the ~1GB copy when already seeded but ALWAYS repairs /home/deck
# ownership (a prior/older seed can leave the home present yet root-owned, blocking Steam). No
# ConditionPathExists here — gating on "Steam present" is exactly what skipped the ownership repair.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/novadeck/steam-bootstrap.sh
# Local copy of a ~1GB seed onto a slow card; don't let the default kill it mid-copy.
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal

[Install]
# Intentionally left UNENABLED (no preset, no *.target.wants symlink): /home ships pre-seeded, so
# nothing pulls this in at boot. A factory-reset flow starts it on demand (systemctl start). WantedBy
# is retained only so a reset flow could optionally wire it in.
WantedBy=graphical.target
