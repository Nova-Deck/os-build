// Authorize the Steam gamepadui (running as the unprivileged `deck` user) to manage
// NetworkManager (the OOBE Wi-Fi picker), invoke the steamos-polkit-helpers it calls via pkexec,
// and set the timezone.
//
// WHY (NetworkManager): HW-confirmed 2026-07-01, the OOBE Wi-Fi connect failed with NM audit
//   op="connection-add" uid=1000 result="fail" reason="Insufficient privileges"
// The gamepadui's AddConnection maps to org.freedesktop.NetworkManager.settings.modify.system.
// That action's defaults are allow_active=yes / allow_inactive=yes — but they only apply to a
// subject on a logind SESSION. The novadeck shell is a LINGERING systemd service
// (novadeck-session.service, User=deck) with NO logind session, so polkit classifies it as neither
// active nor inactive and falls through to allow_any=auth_admin → no auth agent → denied. Hence an
// explicit rule that does NOT gate on `subject.active`. Single-user appliance: scope to uid 1000
// "deck" and to NetworkManager's own action namespace. (Regdom was a red herring — the WCN7850 is a
// self-managed phy and learns its country from the AP; the connect never got that far.)
polkit.addRule(function(action, subject) {
    if (subject.user != "deck")
        return;
    if (action.id.indexOf("org.freedesktop.NetworkManager.") == 0)
        return polkit.Result.YES;
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/bin/steamos-polkit-helpers/steamos-set-timezone")
        return polkit.Result.YES;
    if (action.id == "org.freedesktop.timedate1.set-timezone")
        return polkit.Result.YES;
});
