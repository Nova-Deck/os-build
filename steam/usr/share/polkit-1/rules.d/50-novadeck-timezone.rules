// Let the Steam gamepadui (deck user) set the system timezone from the OOBE without an auth prompt.
//
// Everything else deck needs is now covered by STOCK polkit: since the shell boots through SDDM
// autologin it is a real ACTIVE seat0 logind session, so NetworkManager's OOBE Wi-Fi connect
// (org.freedesktop.NetworkManager.settings.modify.system, allow_active=yes) is authorized with no
// rule at all. Timezone is the one exception — org.freedesktop.timedate1.set-timezone defaults to
// auth_admin_keep even for an active session — so grant it here, gated on the SteamOS/armada pattern
// (active session + wheel; deck is in wheel). Mirrors _reference/armada/.../50-armada-timezone.rules.
//
// This REPLACES the old 50-novadeck-steamos.rules "no-active" bypass, which existed only because the
// pre-SDDM lingering-service shell had no logind session (subject.active was false). See the
// session-active-seat work / [[wifi-connect-fails-after-list]].
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.timedate1.set-timezone" &&
        subject.active && subject.isInGroup("wheel"))
        return polkit.Result.YES;
});
